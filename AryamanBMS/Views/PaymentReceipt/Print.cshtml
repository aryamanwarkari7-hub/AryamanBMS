@model AryamanBMS.Models.PaymentReceiptModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Receipt @Model.ReceiptNo</title>
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />
</head>
<body class="receipt-print-page">

    <div class="no-print">
        <button type="button" id="printButton">Print</button>
        <a href="#" id="receiptBackLink">Back</a>
    </div>

    <div class="receipt-print-header">
        <div>
            <h2>PAYMENT RECEIPT</h2>
            <p>
                <strong>Receipt No:</strong> @Model.ReceiptNo<br />
                <strong>Date:</strong> @Model.ReceiptDate.ToString("dd-MMM-yyyy")
            </p>
        </div>
        <div>
            <p>
                <strong>Received From:</strong><br />
                @(Model.Client?.ClientName ?? "")
            </p>
        </div>
    </div>

    <table>
        <tr>
            <th>Against Invoice</th>
            <td>@(Model.Invoice?.InvoiceNo ?? "")</td>
        </tr>
        <tr>
            <th>Amount Received</th>
            <td class="text-right"><strong>₹@Model.AmountReceived.ToString("N2")</strong></td>
        </tr>
        <tr>
            <th>Payment Mode</th>
            <td>@Model.PaymentMode</td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(Model.TransactionNo))
        {
            <tr>
                <th>Transaction No</th>
                <td>@Model.TransactionNo</td>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ReferenceNo))
        {
            <tr>
                <th>Reference No</th>
                <td>@Model.ReferenceNo</td>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(Model.BankName))
        {
            <tr>
                <th>Bank Name</th>
                <td>@Model.BankName</td>
            </tr>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ReceivedBy))
        {
            <tr>
                <th>Received By</th>
                <td>@Model.ReceivedBy</td>
            </tr>
        }
    </table>

    @if (!string.IsNullOrWhiteSpace(Model.Remarks))
    {
        <p><strong>Remarks:</strong> @Model.Remarks</p>
    }

    @if (Model.IsCancelled)
    {
        <p class="receipt-cancelled"><strong>*** THIS RECEIPT HAS BEEN CANCELLED ***</strong></p>
    }

    <script src="~/js/payment-receipt-print.js" asp-append-version="true"></script>
</body>
</html>

@model AryamanBMS.Models.PaymentReceiptModel

@{
    ViewData["Title"] = "Edit Payment Receipt";
}

<div class="module-header">

    <div>
        <h1 class="module-title">EDIT PAYMENT RECEIPT</h1>
        <p class="module-subtitle">
            Update receipt information for @Model.ReceiptNo
        </p>
    </div>

    <div class="module-header-actions">

        <a asp-action="Details"
           asp-route-id="@Model.PaymentReceiptId"
           class="btn-app btn-primary-app">
            <i class="bi bi-eye"></i>
            Details
        </a>

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

</div>

<form asp-action="Edit"
      asp-route-id="@Model.PaymentReceiptId"
      method="post"
      id="paymentReceiptForm">

    @Html.AntiForgeryToken()

    <input asp-for="PaymentReceiptId" type="hidden" />
    <input asp-for="ReceiptNo" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="app-alert-danger">
    </div>

    <div class="app-card form-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Receipt Information</h2>
                <p class="card-subtitle">
                    Update client, invoice and receipt date information.
                </p>
            </div>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="ReceiptNo"
                           class="form-label">
                        Receipt No
                    </label>

                    <input asp-for="ReceiptNo"
                           class="app-input"
                           readonly />

                    <span asp-validation-for="ReceiptNo"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ReceiptDate"
                           class="form-label">
                        Receipt Date
                    </label>

                    <input asp-for="ReceiptDate"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="ReceiptDate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClientId"
                           class="form-label">
                        Client
                    </label>

                    <select asp-for="ClientId"
                            asp-items="ViewBag.Clients"
                            id="clientSelect"
                            class="app-select">
                        <option value="">Select Client</option>
                    </select>

                    <span asp-validation-for="ClientId"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="InvoiceId"
                           class="form-label">
                        Invoice
                    </label>

                    <select asp-for="InvoiceId"
                            id="invoiceSelect"
                            class="app-select"
                            data-selected-invoice="@Model.InvoiceId"
                            data-invoice-url="@Url.Action("GetInvoicesByClient", "PaymentReceipt")"
                            data-mode="edit">
                        <option value="">Select Invoice</option>
                    </select>

                    <span asp-validation-for="InvoiceId"
                          class="validation-message"></span>
                </div>

            </div>

            <div id="invoiceDetails"
                 class="app-alert-info is-hidden">

                <div class="form-grid-3">

                    <div>
                        <strong>Invoice Amount</strong>
                        <p>₹ <span id="invoiceAmount">0.00</span></p>
                    </div>

                    <div>
                        <strong>Available Balance</strong>
                        <p>₹ <span id="invoiceBalance">0.00</span></p>
                    </div>

                    <div>
                        <strong>Current Receipt</strong>
                        <p>₹ <span id="currentReceiptAmount">@Model.AmountReceived.ToString("N2")</span></p>
                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="app-card form-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Payment Details</h2>
                <p class="card-subtitle">
                    Update amount received and reference information.
                </p>
            </div>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="AmountReceived"
                           class="form-label">
                        Amount Received
                    </label>

                    <input asp-for="AmountReceived"
                           id="amountReceived"
                           type="number"
                           min="0"
                           step="0.01"
                           class="app-input"
                           placeholder="0.00" />

                    <span asp-validation-for="AmountReceived"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PaymentMode"
                           class="form-label">
                        Payment Mode
                    </label>

                    <select asp-for="PaymentMode"
                            class="app-select">
                        <option value="Cash">Cash</option>
                        <option value="Cheque">Cheque</option>
                        <option value="NEFT">NEFT</option>
                        <option value="RTGS">RTGS</option>
                        <option value="UPI">UPI</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                    </select>

                    <span asp-validation-for="PaymentMode"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="BankName"
                           class="form-label">
                        Bank Name
                    </label>

                    <input asp-for="BankName"
                           class="app-input"
                           placeholder="Enter bank name" />

                    <span asp-validation-for="BankName"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="TransactionNo"
                           class="form-label">
                        Transaction No
                    </label>

                    <input asp-for="TransactionNo"
                           class="app-input"
                           placeholder="Cheque / UTR / transaction number" />

                    <span asp-validation-for="TransactionNo"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ReferenceNo"
                           class="form-label">
                        Reference No
                    </label>

                    <input asp-for="ReferenceNo"
                           class="app-input"
                           placeholder="Optional reference number" />

                    <span asp-validation-for="ReferenceNo"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ReceivedBy"
                           class="form-label">
                        Received By
                    </label>

                    <input asp-for="ReceivedBy"
                           class="app-input"
                           placeholder="Name of receiver" />

                    <span asp-validation-for="ReceivedBy"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Remarks"
                       class="form-label">
                    Remarks
                </label>

                <textarea asp-for="Remarks"
                          class="app-input"
                          rows="4"
                          placeholder="Additional remarks or notes"></textarea>

                <span asp-validation-for="Remarks"
                      class="validation-message"></span>
            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-body form-actions">

            <button type="submit"
                    class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Update Receipt
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.PaymentReceiptId"
               class="btn-app btn-secondary-app">
                Cancel
            </a>

        </div>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/payment-receipt-form.js" asp-append-version="true"></script>
}

@model AryamanBMS.Models.GenerateEsicSnapshotInput

@{
    ViewData["Title"] = "Generate ESIC Snapshot";
}

<div class="module-header">

    <div>
        <h1 class="module-title">Generate ESIC Snapshot</h1>
        <p class="module-subtitle">
            Generate monthly ESIC liability from salary records.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Snapshot Period</h2>
            <p class="card-subtitle">
                Select the month and year for ESIC snapshot generation.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="Generate"
              method="post">

            <div asp-validation-summary="All"
                 class="app-alert-danger">
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Month"
                           class="form-label">
                        Month
                    </label>

                    <select asp-for="Month"
                            class="app-select">
                        @for (int month = 1; month <= 12; month++)
                        {
                            <option value="@month"
                                    selected="@(month == Model.Month)">
                                @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(month)
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Month"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Year"
                           class="form-label">
                        Year
                    </label>

                    <select asp-for="Year"
                            class="app-select">
                        @for (int year = DateTime.Now.Year - 2; year <= DateTime.Now.Year + 1; year++)
                        {
                            <option value="@year"
                                    selected="@(year == Model.Year)">
                                @year
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Year"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="app-alert-info">
                This will aggregate ESIC employee deductions and employer contributions from salary records for the selected period. Pending snapshots can be recalculated. Filed or paid snapshots are locked.
            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-lightning-charge"></i>
                    Generate
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
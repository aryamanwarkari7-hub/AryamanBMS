@model IEnumerable<AryamanBMS.Models.FinancialAuditDocumentModel>

@{
    ViewData["Title"] = "Bank Statements, Financial & Audit Records";
    var filterFY = ViewBag.FilterFinancialYear as string;
    var filterCategory = ViewBag.FilterCategory as string;

    string CategoryLabel(string cat) => cat switch
    {
        "BankStatement" => "Bank Statement",
        "AuditReport" => "Audit Report",
        "CADocument" => "CA Document",
        "CSDocument" => "CS Document",
        _ => "Other"
    };

    string CategoryBadge(string cat) => cat switch
    {
        "BankStatement" => "badge-primary",
        "AuditReport" => "badge-success",
        "CADocument" => "badge-info",
        "CSDocument" => "badge-warning",
        _ => "badge-secondary"
    };
}

<div class="module-header">
    <div>
        <h1 class="module-title">Financial &amp; Audit Records</h1>
        <p class="module-subtitle">
            CA, CS, audit report and bank statement documents
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i> Upload Document
        </a>
    </div>
</div>

<div>

    @if (TempData["Success"] != null)
    {
        <div class="app-alert-success">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="app-alert-danger">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Category filter tabs -->
    <ul class="nav nav-pills mb-3 flex-wrap gap-1">
        <li class="nav-item">
            <a class="nav-link @(string.IsNullOrEmpty(filterCategory) ? "active" : "")"
               asp-action="Index">All</a>
        </li>
        @foreach (var c in new[] { "BankStatement", "AuditReport", "CADocument", "CSDocument", "Other" })
        {
            <li class="nav-item">
                <a class="nav-link @(filterCategory == c ? "active" : "")"
                   asp-action="Index" asp-route-category="@c">
                    @CategoryLabel(c)
                </a>
            </li>
        }
    </ul>

    <div class="app-card">
        <div class="card-body">
            <div class="table-responsive">

                <table class="app-table" id="financialAuditTable">

                    <thead >
                        <tr>
                            <th>Category</th>
                            <th>Financial Year</th>
                            <th>File Name</th>
                            <th>Remarks</th>
                            <th>Uploaded On</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <span class="@CategoryBadge(item.DocumentCategory)">
                                            @CategoryLabel(item.DocumentCategory)
                                        </span>
                                    </td>
                                    <td>@item.FinancialYear</td>
                                    <td>
                                        <i class="bi bi-file-earmark-text"></i>
                                        @item.FileName
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>
                                    <td>@item.UploadedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                    <td class="text-center">

                                        <a asp-action="Details" asp-route-id="@item.FinancialAuditDocumentId"
                                           class="btn-app btn-icon btn-primary-app" title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit" asp-route-id="@item.FinancialAuditDocumentId"
                                           class="btn-app btn-icon btn-secondary-app" title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a asp-action="Download" asp-route-id="@item.FinancialAuditDocumentId"
                                           class="btn-app btn-icon btn-success-app" title="Download">
                                            <i class="bi bi-download"></i>
                                        </a>

                                        <button class="btn-app btn-icon btn-danger-app"
                                                onclick="deleteDocument(@item.FinancialAuditDocumentId, '@item.FileName')"
                                                title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>

                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">
                                    <i class="bi bi-bank fs-2 mb-2 d-block"></i>
                                    No documents found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function deleteDocument(id, fileName) {
            Swal.fire({
                title: 'Delete Document?',
                text: `"${fileName}" will be permanently deleted.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Delete',
                confirmButtonColor: '#dc3545',
                cancelButtonText: 'Cancel'
            }).then((result) => {
                if (result.isConfirmed) {
                    var form = $('<form/>', { action: '/FinancialAuditDocument/Delete', method: 'post' });
                    form.append('@Html.AntiForgeryToken()');
                    form.append($('<input/>', { type: 'hidden', name: 'id', value: id }));
                    $('body').append(form);
                    form.submit();
                }
            });
        }
    </script>
}

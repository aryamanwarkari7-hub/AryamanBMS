@model IEnumerable<AryamanBMS.Models.FinancialAuditDocumentModel>

@{
    ViewData["Title"] = "Financial Audit Documents";

    string filterFY = ViewBag.FilterFinancialYear as string ?? "";
    string filterCategory = ViewBag.FilterCategory as string ?? "";
    string search = ViewBag.Search as string ?? "";
    string statusFilter = ViewBag.Status as string ?? "";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    string sortBy = ViewBag.SortBy as string ?? "UploadedOn";
    string sortOrder = ViewBag.SortOrder as string ?? "desc";

    string CategoryLabel(string cat) => cat switch
    {
        "BankStatement" => "Bank Statement",
        "AuditReport" => "Audit Report",
        "CADocument" => "CA Document",
        "CSDocument" => "CS Document",
        _ => "Other"
    };

    string CategoryBadge(string cat) => cat switch
    {
        "BankStatement" => "badge-primary",
        "AuditReport" => "badge-success",
        "CADocument" => "badge-info",
        "CSDocument" => "badge-warning",
        _ => "badge-secondary"
    };
}

<div class="module-header">
    <div>
        <h1 class="module-title">FINANCIAL AUDIT DOCUMENTS</h1>
        <p class="module-subtitle">
            Manage bank statements, audit reports, CA documents and CS records.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            Upload Document
        </a>

        <a asp-action="ExportCsv"
           asp-route-financialYear="@filterFY"
           asp-route-category="@filterCategory"
           asp-route-search="@search"
           asp-route-status="@statusFilter"
           asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
           asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
           class="btn-app btn-secondary-app">
            <i class="bi bi-download"></i>
            Export
        </a>
    </div>
</div>

<div class="app-card form-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Filters</h2>
            <p class="card-subtitle">
                Filter documents by financial year and document category.
            </p>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Index" method="get">
            <input type="hidden" name="category" value="@filterCategory" />

            <div class="filter-row">
                <div class="filter-field">
                    <input name="financialYear"
                           value="@filterFY"
                           class="app-input"
                           placeholder="Ex: 2026-27" />
                </div>

                <div class="filter-field filter-field-wide">
                    <input name="search"
                           value="@search"
                           class="app-input"
                           placeholder="File name, FY, category or remarks" />
                </div>

                <div class="filter-field">
                    <select name="status" class="app-select">
                        <option value="">All Statuses</option>
                        <option value="Active" selected="@(statusFilter == "Active")">Active</option>
                        <option value="Archived" selected="@(statusFilter == "Archived")">Archived</option>
                        <option value="Finalized" selected="@(statusFilter == "Finalized")">Finalized</option>
                    </select>
                </div>

                <div class="filter-field">
                    <select name="sortBy" class="app-select">
                        <option value="UploadedOn" selected="@(sortBy == "UploadedOn")">Sort by Uploaded</option>
                        <option value="Category" selected="@(sortBy == "Category")">Sort by Category</option>
                        <option value="FinancialYear" selected="@(sortBy == "FinancialYear")">Sort by FY</option>
                        <option value="FileName" selected="@(sortBy == "FileName")">Sort by File Name</option>
                        <option value="Status" selected="@(sortBy == "Status")">Sort by Status</option>
                    </select>
                </div>

                <div class="filter-field">
                    <select name="sortOrder" class="app-select">
                        <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                    </select>
                </div>

                <div class="filter-field">
                    <input type="date"
                           name="fromDate"
                           value="@fromDate?.ToString("yyyy-MM-dd")"
                           class="app-input" />
                </div>

                <div class="filter-field">
                    <input type="date"
                           name="toDate"
                           value="@toDate?.ToString("yyyy-MM-dd")"
                           class="app-input" />
                </div>

                <div class="filter-actions">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-search"></i>
                        Load
                    </button>

                    <a asp-action="Index" class="btn-app btn-secondary-app">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="app-card table-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Document Register</h2>
            <p class="card-subtitle">
                Uploaded financial and audit records.
            </p>
        </div>
    </div>

    <div class="card-body">
        <div class="module-header-actions justify-content-start mb-3">

            <a asp-action="Index"
               asp-route-financialYear="@filterFY"
               asp-route-search="@search"
               asp-route-status="@statusFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(string.IsNullOrEmpty(filterCategory) ? "btn-primary-app" : "btn-secondary-app")">
                All
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@filterFY"
               asp-route-search="@search"
               asp-route-status="@statusFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-category="BankStatement"
               class="btn-app @(filterCategory == "BankStatement" ? "btn-primary-app" : "btn-secondary-app")">
                Bank Statements
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@filterFY"
               asp-route-search="@search"
               asp-route-status="@statusFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-category="AuditReport"
               class="btn-app @(filterCategory == "AuditReport" ? "btn-primary-app" : "btn-secondary-app")">
                Audit Reports
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@filterFY"
               asp-route-search="@search"
               asp-route-status="@statusFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-category="CADocument"
               class="btn-app @(filterCategory == "CADocument" ? "btn-primary-app" : "btn-secondary-app")">
                CA Documents
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@filterFY"
               asp-route-search="@search"
               asp-route-status="@statusFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-category="CSDocument"
               class="btn-app @(filterCategory == "CSDocument" ? "btn-primary-app" : "btn-secondary-app")">
                CS Documents
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@filterFY"
               asp-route-search="@search"
               asp-route-status="@statusFilter"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-category="Other"
               class="btn-app @(filterCategory == "Other" ? "btn-primary-app" : "btn-secondary-app")">
                Other
            </a>

        </div>
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Financial Year</th>
                        <th>File Name</th>
                        <th>Remarks</th>
                        <th>Uploaded On</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <span class="@CategoryBadge(item.DocumentCategory)">
                                        @CategoryLabel(item.DocumentCategory)
                                    </span>
                                </td>

                                <td>@item.FinancialYear</td>

                                <td>
                                    <i class="bi bi-file-earmark-text"></i>
                                    @item.FileName
                                </td>

                                <td>@(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)</td>

                                <td>@item.UploadedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>

                                <td class="text-center">
                                    @if (item.IsFinalized)
                                    {
                                        <span class="badge-primary">Finalized</span>
                                    }
                                    else if (item.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Archived</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="table-actions">
                                        <a asp-action="Details"
                                           asp-route-id="@item.FinancialAuditDocumentId"
                                           class="btn-app btn-icon btn-primary-app"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (!item.IsFinalized)
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@item.FinancialAuditDocumentId"
                                               class="btn-app btn-icon btn-secondary-app"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        }

                                        @if (item.IsActive)
                                        {
                                            <a asp-action="Download"
                                               asp-route-id="@item.FinancialAuditDocumentId"
                                               class="btn-app btn-icon btn-success-app"
                                               title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>

                                            @if (!item.IsFinalized)
                                            {
                                                <button type="button"
                                                        class="btn-app btn-icon btn-danger-app"
                                                        onclick="changeDocumentStatus(@item.FinancialAuditDocumentId)"
                                                        title="Archive">
                                                    <i class="bi bi-archive"></i>
                                                </button>
                                            }
                                        }
                                        else if (!item.IsFinalized)
                                        {
                                            <button type="button"
                                                    class="btn-app btn-icon btn-success-app"
                                                    onclick="changeDocumentStatus(@item.FinancialAuditDocumentId)"
                                                    title="Activate">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">
                                No financial audit documents found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if ((ViewBag.TotalPages ?? 1) > 1)
        {
            <div class="pagination-container">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-financialYear="@filterFY"
                       asp-route-category="@filterCategory"
                       asp-route-search="@search"
                       asp-route-status="@statusFilter"
                       asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortOrder="@sortOrder"
                       class="page-link-app @(i == ViewBag.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }
            </div>
        }
    </div>
</div>

<form id="financialAuditDocumentStatusForm"
      asp-action="Delete"
      method="post"
      class="d-none">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" value="" />
</form>

@section Scripts
{
    <script src="~/js/status-toggle-form.js" asp-append-version="true"></script>
    <script src="~/js/financial-audit-document.js" asp-append-version="true"></script>
}

@model AryamanBMS.Models.FinancialAuditDocumentModel

@{
    ViewData["Title"] = "Document Details";

    string CategoryLabel(string cat) => cat switch
    {
        "BankStatement" => "Bank Statement",
        "AuditReport" => "Audit Report",
        "CADocument" => "CA Document",
        "CSDocument" => "CS Document",
        _ => "Other"
    };

    string CategoryBadge(string cat) => cat switch
    {
        "BankStatement" => "badge-primary",
        "AuditReport" => "badge-success",
        "CADocument" => "badge-info",
        "CSDocument" => "badge-warning",
        _ => "badge-secondary"
    };
}

<div class="module-content">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-bank text-primary"></i>
                Document Details
            </h3>
            <small class="card-subtitle">
                <span class="@CategoryBadge(Model.DocumentCategory)">
                    @CategoryLabel(Model.DocumentCategory)
                </span>
            </small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Download" asp-route-id="@Model.FinancialAuditDocumentId" class="btn-app btn-success-app">
                <i class="bi bi-download"></i> Download
            </a>
            <a asp-action="Index" class="btn-app btn-secondary-app">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="row">

        <div class="col-md-8">
            <div class="app-card">
                <div class="card-header"><strong>Document Information</strong></div>
                <div class="card-body">

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Category</label>
                            <div>
                                <span class="@CategoryBadge(Model.DocumentCategory) fs-6">
                                    @CategoryLabel(Model.DocumentCategory)
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Financial Year</label>
                            <div>@Model.FinancialYear</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold">File Name</label>
                        <div>
                            <i class="bi bi-file-earmark-text"></i>
                            @Model.FileName
                        </div>
                    </div>

                    <div class="mb-2">
                        <label class="fw-bold">Remarks</label>
                        <div class="border rounded p-3 bg-light">
                            @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks" : Model.Remarks)
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="app-card">
                <div class="card-header"><strong>Upload Info</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="fw-bold">Uploaded On</label>
                        <div>@Model.UploadedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    </div>
                </div>
            </div>

            <div class="app-card">
                <div class="card-body">
                    <a asp-action="Download" asp-route-id="@Model.FinancialAuditDocumentId"
                       class="btn-app btn-success-app w-100">
                        <i class="bi bi-download"></i> Download Document
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>
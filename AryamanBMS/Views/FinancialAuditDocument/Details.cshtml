@model AryamanBMS.Models.FinancialAuditDocumentModel

@{
    ViewData["Title"] = "Audit Document Details";

    string CategoryLabel(string cat) => cat switch
    {
        "BankStatement" => "Bank Statement",
        "AuditReport" => "Audit Report",
        "CADocument" => "CA Document",
        "CSDocument" => "CS Document",
        _ => "Other"
    };

    string CategoryBadge(string cat) => cat switch
    {
        "BankStatement" => "badge-primary",
        "AuditReport" => "badge-success",
        "CADocument" => "badge-info",
        "CSDocument" => "badge-warning",
        _ => "badge-secondary"
    };
}

<div class="module-header">
    <div>
        <h1 class="module-title">AUDIT DOCUMENT DETAILS</h1>
        <p class="module-subtitle">
            View uploaded financial audit document details.
        </p>
    </div>

    <div class="module-header-actions">
        @if (Model.IsActive)
        {
            <a asp-action="Download"
               asp-route-id="@Model.FinancialAuditDocumentId"
               class="btn-app btn-success-app">
                <i class="bi bi-download"></i>
                Download
            </a>
        }

        <a asp-action="Edit"
           asp-route-id="@Model.FinancialAuditDocumentId"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit Details
        </a>

        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="app-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Document Information</h2>
            <p class="card-subtitle">
                Category, financial year and file details.
            </p>
        </div>
    </div>

    <div class="card-body">
        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label">Category</label>
                <span class="@CategoryBadge(Model.DocumentCategory)">
                    @CategoryLabel(Model.DocumentCategory)
                </span>
            </div>

            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <strong>@Model.FinancialYear</strong>
            </div>

            <div class="form-group">
                <label class="form-label">File Name</label>
                <strong>@Model.FileName</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Uploaded On</label>
                <strong>@Model.UploadedOn.ToString("dd-MMM-yyyy hh:mm tt")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Status</label>
                @if (Model.IsActive)
                {
                    <span class="badge-success">Active</span>
                }
                else
                {
                    <span class="badge-secondary">Archived</span>
                }
            </div>
        </div>
    </div>
</div>

<div class="app-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Remarks</h2>
            <p class="card-subtitle">
                Additional notes for this audit document.
            </p>
        </div>
    </div>

    <div class="card-body">
        @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks added." : Model.Remarks)
    </div>
</div>

<div class="app-card">
    <div class="card-body form-actions">
        @if (Model.IsActive)
        {
            <a asp-action="Download"
               asp-route-id="@Model.FinancialAuditDocumentId"
               class="btn-app btn-success-app">
                <i class="bi bi-download"></i>
                Download
            </a>
        }

        

        <button type="button"
                class="btn-app @(Model.IsActive ? "btn-danger-app" : "btn-success-app")"
                onclick="changeDocumentStatus(@Model.FinancialAuditDocumentId)">
            <i class="bi @(Model.IsActive ? "bi-archive" : "bi-arrow-counterclockwise")"></i>
            @(Model.IsActive ? "Archive" : "Activate")
        </button>
    </div>
</div>

@section Scripts
{
    <script>
        function changeDocumentStatus(id) {
            if (!confirm("Do you want to change this document status?")) {
                return;
            }

            var form = $('<form/>', {
                action: '/FinancialAuditDocument/Delete',
                method: 'post'
            });

            form.append('@Html.AntiForgeryToken()');

            form.append($('<input/>', {
                type: 'hidden',
                name: 'id',
                value: id
            }));

            $('body').append(form);
            form.submit();
        }
    </script>
}
@model AryamanBMS.Models.FinancialAuditDocumentModel

@{
    ViewData["Title"] = "Edit Audit Document";
}

<div class="module-header">
    <div>
        <h1 class="module-title">EDIT AUDIT DOCUMENT</h1>
        <p class="module-subtitle">
            Update audit document details or replace the uploaded file.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Details"
           asp-route-id="@Model.FinancialAuditDocumentId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<form asp-action="Edit"
      asp-route-id="@Model.FinancialAuditDocumentId"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="hidden" asp-for="FinancialAuditDocumentId" />

    <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Document Details</h2>
                <p class="card-subtitle">
                    Finalized audit documents cannot be edited.
                </p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-3">
                <div class="form-group">
                    <label asp-for="DocumentCategory" class="form-label">
                        Category <span class="validation-message">*</span>
                    </label>

                    <select asp-for="DocumentCategory" class="app-select">
                        <option value="">Select Category</option>
                        <option value="BankStatement">Bank Statement</option>
                        <option value="AuditReport">Audit Report</option>
                        <option value="CADocument">CA Document</option>
                        <option value="CSDocument">CS Document</option>
                        <option value="Other">Other</option>
                    </select>

                    <span asp-validation-for="DocumentCategory" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FinancialYear" class="form-label">
                        Financial Year <span class="validation-message">*</span>
                    </label>

                    <input asp-for="FinancialYear"
                           class="app-input"
                           placeholder="Ex: 2026-27" />

                    <span asp-validation-for="FinancialYear" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Current File</label>
                    <strong>@Model.FileName</strong>
                </div>
            </div>

            <div class="form-group">
                <label for="uploadFile" class="form-label">
                    Replace File
                </label>

                <input type="file"
                       id="uploadFile"
                       name="uploadFile"
                       class="app-input"
                       accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />

                <p class="card-subtitle">
                    Leave blank to keep the existing file.
                </p>
            </div>

            <div class="form-group">
                <label asp-for="Remarks" class="form-label">Remarks</label>

                <textarea asp-for="Remarks"
                          class="app-input"
                          rows="4"
                          placeholder="Optional notes about this document"></textarea>

                <span asp-validation-for="Remarks" class="validation-message"></span>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-body form-actions">
            <button type="submit" class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Update Document
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.FinancialAuditDocumentId"
               class="btn-app btn-secondary-app">
                Cancel
            </a>
        </div>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

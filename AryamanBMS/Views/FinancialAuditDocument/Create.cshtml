@model AryamanBMS.Models.FinancialAuditDocumentModel

@{
    ViewData["Title"] = "Upload Document";
}

<div class="module-content">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-bank text-primary"></i>
                Upload Document
            </h3>
            <small class="card-subtitle">Bank statement, audit report, CA / CS document</small>
        </div>
        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="app-card">

        <div class="card-header">
            <strong>Document Details</strong>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

                <div class="row">

                    <!-- Category -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="DocumentCategory" class="form-label">
                            Category <span class="validation-message">*</span>
                        </label>
                        <select asp-for="DocumentCategory" class="app-select">
                            <option value="">-- Select Category --</option>
                            <option value="BankStatement">Bank Statement</option>
                            <option value="AuditReport">Audit Report</option>
                            <option value="CADocument">CA Document</option>
                            <option value="CSDocument">CS Document</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="DocumentCategory" class="validation-message"></span>
                    </div>

                    <!-- Financial Year -->
                    <div class="col-md-4 mb-3">
                        <label asp-for="FinancialYear" class="form-label">
                            Financial Year <span class="validation-message">*</span>
                        </label>
                        <input asp-for="FinancialYear" class="app-input"
                               placeholder="e.g. 2025-26" />
                        <span asp-validation-for="FinancialYear" class="validation-message"></span>
                    </div>

                    <!-- File Upload -->

                    <div class="col-md-4 mb-3">
                        <label for="uploadFile" class="form-label">
                            File <span class="validation-message">*</span>
                        </label>
                        <input type="file" id="uploadFile" name="uploadFile" class="app-input"
                               accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" required />
                        <small class="card-subtitle">PDF, Word, Excel, or image</small>
                    </div>

                </div>

                <div class="row">

                    <!-- Remarks -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="app-input" rows="2"
                                  placeholder="Optional notes about this document"></textarea>
                        <span asp-validation-for="Remarks" class="validation-message"></span>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-check-circle"></i> Upload
                    </button>
                    <a asp-action="Index" class="btn-app btn-secondary-app">Cancel</a>
                </div>

            </form>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
@model AryamanBMS.Models.PtMonthlySnapshotModel

@{
    ViewData["Title"] = "PT Snapshot Details";

    string monthName =
        System.Globalization.CultureInfo.CurrentCulture
            .DateTimeFormat
            .GetMonthName(Model.Month);

    string statusBadgeClass =
        Model.Status switch
        {
            FinancialConstants.StatutoryStatus.Paid => "badge-success",
            FinancialConstants.StatutoryStatus.Filed => "badge-info",
            _ => "badge-warning"
        };
}

<div class="module-header">

    <div>
        <h1 class="module-title">PT Snapshot Details</h1>
        <p class="module-subtitle">
            @monthName @Model.Year | FY @Model.FinancialYear
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>



<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Liability Summary</h2>
            <p class="card-subtitle">
                PT liability generated from salary records.
            </p>
        </div>

        <span class="@statusBadgeClass">
            @Model.Status
        </span>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Employee Count</label>
                <div>@Model.EmployeeCount</div>
            </div>

            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <div>@Model.FinancialYear</div>
            </div>

            <div class="form-group">
                <label class="form-label">Total Payable</label>
                <div><strong>INR @Model.TotalPayable.ToString("N2")</strong></div>
            </div>

            <div class="form-group">
                <label class="form-label">Filed On</label>
                <strong>
                    @(Model.FiledOn?.ToString("dd MMM yyyy HH:mm") ?? "-")
                </strong>
            </div>

            <div class="form-group">
                <label class="form-label">Filed By User ID</label>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.FiledByUserId)
                                        ? "-"
                                        : Model.FiledByUserId)
                </strong>
            </div>

            <div class="form-group">
                <label class="form-label">Paid On</label>
                <strong>
                    @(Model.PaidOn?.ToString("dd MMM yyyy HH:mm") ?? "-")
                </strong>
            </div>

            <div class="form-group">
                <label class="form-label">Paid By User ID</label>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.PaidByUserId)
                                        ? "-"
                                        : Model.PaidByUserId)
                </strong>
            </div>

        </div>

        <div class="form-actions">

            @if (Model.Status == FinancialConstants.StatutoryStatus.Pending)
            {
                <form asp-action="MarkFiled"
                      asp-route-id="@Model.PtSnapshotId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn-app btn-primary-app">
                        <i class="bi bi-flag"></i>
                        Mark as Filed
                    </button>
                </form>
            }

            @if (Model.Status == FinancialConstants.StatutoryStatus.Filed)
            {
                <form asp-action="MarkPaid"
                      asp-route-id="@Model.PtSnapshotId"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn-app btn-success-app">
                        <i class="bi bi-check-circle"></i>
                        Mark as Paid
                    </button>
                </form>
            }

        </div>

    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Challan Details</h2>
            <p class="card-subtitle">
                Record PT challan payment information.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Challan No.</th>
                        <th>Payment Date</th>
                        <th>Bank</th>
                        <th>Mode</th>
                        <th class="text-end">Amount Paid</th>
                        <th class="text-end">Interest</th>
                        <th class="text-end">Late Fee</th>
                        <th class="text-center">Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Challans.Any())
                    {
                        foreach (var challan in Model.Challans)
                        {
                            <tr>
                                <td>@(challan.ChallanNumber ?? "-")</td>
                                <td>@(challan.PaymentDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                <td>@(challan.BankName ?? "-")</td>
                                <td>@(challan.PaymentMode ?? "-")</td>
                                <td class="text-end">INR @challan.AmountPaid.ToString("N2")</td>
                                <td class="text-end">INR @challan.InterestAmount.ToString("N2")</td>
                                <td class="text-end">INR @challan.LateFee.ToString("N2")</td>
                                <td class="text-center">
                                    <span class="badge-success">@challan.Status</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="empty-state">
                                No PT challan recorded yet.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

@if (Model.Status != FinancialConstants.StatutoryStatus.Paid)
{
    <div class="app-card form-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Add Challan</h2>
                <p class="card-subtitle">
                    Add payment details before marking PT as paid.
                </p>
            </div>
        </div>

        <div class="card-body">

            <form asp-action="AddChallan"
                  method="post">
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="PtSnapshotId"
                       value="@Model.PtSnapshotId" />

                <div class="form-grid-4">

                    <div class="form-group">
                        <label class="form-label">Challan Number</label>
                        <input type="text"
                               name="ChallanNumber"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Payment Date</label>
                        <input type="date"
                               name="PaymentDate"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Bank Name</label>
                        <input type="text"
                               name="BankName"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Payment Mode</label>
                        <input type="text"
                               name="PaymentMode"
                               class="app-input"
                               placeholder="NEFT / Online" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Amount Paid</label>
                        <input type="number"
                               step="0.01"
                               name="AmountPaid"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Interest</label>
                        <input type="number"
                               step="0.01"
                               name="InterestAmount"
                               class="app-input"
                               value="0" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Late Fee</label>
                        <input type="number"
                               step="0.01"
                               name="LateFee"
                               class="app-input"
                               value="0" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Remarks</label>
                        <input type="text"
                               name="Remarks"
                               class="app-input" />
                    </div>

                </div>

                <div class="form-actions">
                    <button type="submit"
                            class="btn-app btn-primary-app">
                        <i class="bi bi-plus-circle"></i>
                        Add Challan
                    </button>
                </div>

            </form>

        </div>

    </div>
}

<div class="app-card table-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Documents</h2>
            <p class="card-subtitle">
                Upload PT challan, return or supporting documents.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Document Type</th>
                        <th>File Name</th>
                        <th>Remarks</th>
                        <th>Uploaded By</th>
                        <th>Uploaded On</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Documents.Any())
                    {
                        foreach (var document in Model.Documents)
                        {
                            <tr>
                                <td>
                                    <span class="badge-secondary">
                                        @document.DocumentType
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="Pt"
                                       asp-action="DownloadDocument"
                                       asp-route-id="@document.PtDocumentId"
                                       class="app-link">
                                        <i class="bi bi-download"></i>
                                        @document.FileName
                                    </a>
                                </td>

                                <td>@(document.Remarks ?? "-")</td>

                                <td>@(string.IsNullOrWhiteSpace(document.UploadedByUserId) ? "-" : document.UploadedByUserId)</td>

                                <td>@document.UploadedOn.ToString("dd-MMM-yyyy")</td>

                                <td>
                                    @if (document.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Archived</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="table-actions">
                                        @if (Model.Status == FinancialConstants.StatutoryStatus.Pending)
                                        {
                                        <form asp-action="DeleteDocument"
                                              method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden"
                                                   name="id"
                                                   value="@document.PtDocumentId" />

                                            <input type="hidden"
                                                   name="snapshotId"
                                                   value="@Model.PtSnapshotId" />

                                            <button type="submit"
                                                    class="btn-app btn-icon btn-danger-app"
                                                    title="Archive"
                                                    onclick="return confirm('Archive this document?');">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="empty-state">
                                No PT documents uploaded yet.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Upload Document</h2>
            <p class="card-subtitle">
                Upload PT challan, return or related supporting file.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="UploadDocument"
              method="post"
              enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="snapshotId"
                   value="@Model.PtSnapshotId" />

            <div class="form-grid-3">

                <div class="form-group">
                    <label class="form-label">Document Type</label>
                    <select name="documentType"
                            class="app-select">
                        <option value="">Select Document Type</option>
                        <option value="Challan">Challan</option>
                        <option value="Return">Return</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">File</label>
                    <input type="file"
                           name="file"
                           class="app-input"
                           accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                           required />
                    <small class="form-text">
                        PDF, Word, Excel, JPG or PNG only. Maximum size: 10 MB.
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label">Remarks</label>
                    <input type="text"
                           name="remarks"
                           class="app-input" />
                </div>

            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-upload"></i>
                    Upload
                </button>
            </div>

        </form>

    </div>

</div>

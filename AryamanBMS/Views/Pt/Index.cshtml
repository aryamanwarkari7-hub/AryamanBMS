@model List<AryamanBMS.Models.PtMonthlySnapshotModel>

@{
    ViewData["Title"] = "PT Records";
}

<div class="module-header">

    <div>
        <h1 class="module-title">PT Records</h1>
        <p class="module-subtitle">
            Monthly Professional Tax liability and challan tracking.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Generate"
           class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            Generate Snapshot
        </a>
    </div>

</div>



<div class="dashboard-grid">

    <div class="stats-card">
        <div class="stats-label">Snapshots</div>
        <div class="stats-number">@Model.Count</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Pending</div>
        <div class="stats-number">@Model.Count(x => x.Status == FinancialConstants.StatutoryStatus.Pending)</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Filed</div>
        <div class="stats-number">@Model.Count(x => x.Status == FinancialConstants.StatutoryStatus.Filed)</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Paid</div>
        <div class="stats-number">@Model.Count(x => x.Status == FinancialConstants.StatutoryStatus.Paid)</div>
    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">PT Snapshot Register</h2>
            <p class="card-subtitle">
                Review generated monthly Professional Tax liability snapshots.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Period</th>
                        <th>Financial Year</th>
                        <th class="text-end">Employees</th>
                        <th class="text-end">Total Payable</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            string badgeClass =
                            item.Status switch
                            {
                                FinancialConstants.StatutoryStatus.Paid => "badge-success",
                                FinancialConstants.StatutoryStatus.Filed => "badge-info",
                                _ => "badge-warning"
                            };

                            <tr>
                                <td>
                                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month)
                                    @item.Year
                                </td>

                                <td>@item.FinancialYear</td>

                                <td class="text-end">@item.EmployeeCount</td>

                                <td class="text-end">
                                    <strong>INR @item.TotalPayable.ToString("N2")</strong>
                                </td>

                                <td class="text-center">
                                    <span class="@badgeClass">@item.Status</span>
                                </td>

                                <td class="text-center">
                                    <div class="table-actions">
                                        <a asp-action="Details"
                                           asp-route-id="@item.PtSnapshotId"
                                           class="btn-app btn-icon btn-primary-app"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="empty-state">
                                No PT snapshots generated yet.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>
@model AryamanBMS.Models.DesignationModel

<div class="module-header">

    <div>
        <h1 class="module-title">Add Designation</h1>
        <p class="module-subtitle">Create a new designation</p>
    </div>

</div>

<div class="app-card">

    <div class="card-body">

        <form asp-action="Create" method="post">

            <div class="form-grid-2">

                <div class="form-group">
                    <label class="form-label">
                        Designation Name
                    </label>

                    <select id="designationSelection"
                            class="app-select">

                        <option value="">Select Designation</option>

                        <option value="Software Developer">Software Developer</option>
                        <option value="Senior Software Engineer">Senior Software Engineer</option>
                        <option value="Team Lead">Team Lead</option>
                        <option value="Project Manager">Project Manager</option>
                        <option value="Business Analyst">Business Analyst</option>
                        <option value="QA Engineer">QA Engineer</option>
                        <option value="HR Executive">HR Executive</option>
                        <option value="HR Manager">HR Manager</option>
                        <option value="Accountant">Accountant</option>
                        <option value="Administrator">Administrator</option>
                        <option value="System Administrator">System Administrator</option>

                        <option value="__NEW__">
                            + Add New Designation
                        </option>

                    </select>

                </div>

                <div class="form-group d-none"
                     id="newDesignationGroup">

                    <label class="form-label">
                        New Designation Name
                    </label>

                    <input asp-for="DesignationName"
                           id="designationName"
                           class="app-input" />
                    <span asp-validation-for="DesignationName"
                          class="text-danger"></span> 

                </div>

                <div class="form-group">
                    <label class="form-label">
                        Display Code
                    </label>

                    <input asp-for="DisplayCode"
                           id="designationCode"
                           class="app-input"
                           readonly />
                    <span asp-validation-for="DisplayCode"
                          class="text-danger"></span>
                </div>

                <div class="form-group">

                    <div class="d-flex justify-content-between align-items-center mb-2">

                        <label class="form-label mb-0">
                            Department
                        </label>

                        

                    </div>

                    <select asp-for="DepartmentId"
                            id="departmentDropdown"
                            class="app-select">

                        <option value="">Select Department</option>

                        @foreach (var department in ViewBag.Departments)
                        {
                            <option value="@department.Id">
                                @department.DepartmentName
                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">
                    <label class="form-label">
                        Status
                    </label>

                    <select asp-for="IsActive"
                            class="app-select">

                        <option value="true">Active</option>
                        <option value="false">Inactive</option>

                    </select>
                </div>

            </div>

            <div class="mt-4">

                <button type="submit"
                        class="btn-app btn-primary-app">
                    Save
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>




@section Scripts {
    <script src="~/js/master-data.js" asp-append-version="true"></script>
}
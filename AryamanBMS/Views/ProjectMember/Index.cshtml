@model IEnumerable<AryamanBMS.Models.ProjectMemberModel>

@{
    ViewData["Title"] = "Project Members";
    var project = ViewBag.Project as AryamanBMS.Models.ProjectModel;
    int currentPage = ViewBag.CurrentPage ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count();

    var pagination = new AryamanBMS.ViewModels.PaginationViewModel
    {
        CurrentPage = currentPage,
        PageSize = pageSize,
        TotalRecords = totalRecords,
        ControllerName = "ProjectMember",
        ActionName = "AllMembers",
        RouteValues = new Dictionary<string, string>()
    };

    if (project != null) pagination.RouteValues["projectId"] = project.Id.ToString();
    if (!string.IsNullOrWhiteSpace(ViewBag.SearchText as string)) pagination.RouteValues["searchText"] = (ViewBag.SearchText as string)!;
}

<div class="module-header">
    <div>
        <h1 class="module-title">Project Members</h1>
        <p class="module-subtitle">
            @(project != null
                        ? $"{project.ProjectCode} - {project.ProjectName}"
                        : "Manage assigned project members")
        </p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Add"
           asp-route-projectId="@project?.Id"
           class="btn-app btn-primary-app">
            <i class="bi bi-person-plus"></i>
            Add Member
        </a>

        <a asp-controller="Project"
           asp-action="Details"
           asp-route-id="@project?.Id"
           class="btn-app btn-secondary-app">
            Back
        </a>
    </div>
</div>



<div class="app-card table-card">
    <div class="card-header">
        <h5 class="card-title">Assigned Members</h5>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="app-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Employee Code</th>
                    <th>Employee Name</th>
                    <th>Department</th>
                    <th>Designation</th>
                    <th>Project Role</th>
                    <th>Assigned On</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.Any())
                {
                    int serialNumber = ((currentPage - 1) * pageSize) + 1;
                    foreach (var member in Model)
                    {
                        <tr>
                            <td>@serialNumber</td>
                            <td>@member.Employee?.EmployeeCode</td>

                            <td>@member.Employee?.FullName</td>

                            <td>
                                @(member.Employee?.Department?.DepartmentName ?? "-")
                            </td>

                            <td>
                                @(member.Employee?.Designation?.DesignationName ?? "-")
                            </td>

                            <td>
                                @(member.RoleInProject ?? "-")
                            </td>

                            <td>
                                @member.AssignedOn.ToString("dd-MM-yyyy")
                            </td>

                            <td>
                                @if (member.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        Active
                                    </span>
                        serialNumber++;
                        }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td>
                                <form asp-action="Remove"
                                      asp-route-id="@member.Id"
                                      method="post"
                                      onsubmit="return confirm('Remove this project member?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn-app btn-danger-app btn-icon"
                                            title="Remove">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="text-center text-muted">
                            No project members assigned.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <partial name="_Pagination" model="pagination" />
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-body">
        <form asp-action="AllMembers" method="get" class="filter-form-row">
            <input type="hidden" name="projectId" value="@project?.Id" />
            <input type="text" name="searchText" value="@ViewBag.SearchText" class="app-input flex-grow-1" placeholder="Search employee, role, or project" />
            <button type="submit" class="btn-app btn-primary-app"><i class="bi bi-search"></i> Search</button>
            <a asp-action="AllMembers" asp-route-projectId="@project?.Id" class="btn-app btn-secondary-app">Reset</a>
        </form>
    </div>
</div>

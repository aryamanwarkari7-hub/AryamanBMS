@using AryamanBMS.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUserModel> UserManager

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentUser =
        await UserManager.GetUserAsync(User);

    var userName =
        currentUser?.FullName ?? currentUser?.UserName ?? "User";

    var role =
        (currentUser != null)
            ? (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault()
            : "";

    var initials = string.Empty;

    if (!string.IsNullOrWhiteSpace(userName))
    {
        var nameParts = userName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (nameParts.Length == 1)
        {
            initials = nameParts[0][0].ToString().ToUpper();
        }
        else
        {
            initials = $"{nameParts.First()[0]}{nameParts.Last()[0]}".ToUpper();
        }
    }

    bool isFinanceUser =
        User.IsInRole("Admin") ||
        User.IsInRole("Finance");

    bool isEmployeeOnly =
        User.IsInRole("Employee") &&
        !isFinanceUser;

    
}

<div class="top-navbar">

        <button class="mobile-sidebar-toggle"
                type="button"
                aria-label="Open navigation"
                aria-controls="sidebarAccordion"
                aria-expanded="false"
                data-sidebar-toggle>
            <i class="bi bi-list"></i>
        </button>

    <div class="navbar-left">

        <h4 class="page-title">
            @ViewData["Title"]
        </h4>

        <div class="page-subtitle">
            Welcome, @userName
        </div>

    </div>

    @{
        var activityStatus = currentUser?.ActivityStatus ?? "Offline";
        var activityClass = activityStatus.ToLower().Replace(" ", "-");
    }

    <div class="navbar-actions">
        @await Component.InvokeAsync("NotificationBell")
        
        <div class="navbar-user dropdown">
        
            <div class="activity-avatar"
                 data-bs-toggle="dropdown"
                 aria-expanded="false"
                 role="button">
        
                <div class="user-avatar">
        
                    @if (!string.IsNullOrWhiteSpace(currentUser?.ProfilePhotoPath))
                    {
                        <img src="@currentUser.ProfilePhotoPath"
                             alt="@userName"
                             class="user-avatar-img" />
                    }
                    else
                    {
                        @initials
                    }
        
                </div>
        
                <span class="activity-dot activity-@activityClass"
                      title="@activityStatus">
                </span>
        
            </div>
        
            @if (!string.IsNullOrWhiteSpace(
                    currentUser?.ActivityStatusMessage))
            {
                <div class="avatar-status-bubble"
                     title="@currentUser.ActivityStatusMessage">
        
                    @currentUser.ActivityStatusMessage
        
                </div>
            }
        
            <div class="dropdown-menu dropdown-menu-end activity-status-menu">
        
                <div class="activity-menu-header">
        
                    <strong>@userName</strong>
        
                    <span>@activityStatus</span>
        
                </div>
        
                <form asp-controller="Account"
                      asp-action="UpdateActivityStatus"
                      method="post"
                      class="activity-status-form">
        
                    @Html.AntiForgeryToken()
        
                    <input type="hidden"
                           name="returnUrl"
                           value="@Context.Request.Path@Context.Request.QueryString" />
        
                    <button type="submit"
                            name="activityStatus"
                            value="Available"
                            class="dropdown-item activity-status-option">
        
                        <span class="activity-menu-dot activity-available"></span>
        
                        Available
        
                    </button>
        
                    <button type="submit"
                            name="activityStatus"
                            value="Busy"
                            class="dropdown-item activity-status-option">
        
                        <span class="activity-menu-dot activity-busy"></span>
        
                        Busy
        
                    </button>
        
                    <button type="submit"
                            name="activityStatus"
                            value="Do Not Disturb"
                            class="dropdown-item activity-status-option">
        
                        <span class="activity-menu-dot activity-do-not-disturb"></span>
        
                        Do Not Disturb
        
                    </button>
        
                </form>
        
                <div class="dropdown-divider"></div>
        
                <a asp-controller="Account"
                   asp-action="Profile"
                   class="dropdown-item">
        
                    <i class="bi bi-person-circle"></i>
        
                    My Profile
        
                </a>
        
                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="navbar-logout-form">
        
                    @Html.AntiForgeryToken()
        
                    <button type="submit"
                            class="dropdown-item navbar-logout-item">
        
                        <i class="bi bi-box-arrow-right"></i>
        
                        Logout
        
                    </button>
        
                </form>
        
            </div>
        
        </div>
    </div>

</div>
@* =============================
    LAYOUT
   ============================= *@
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@using AryamanBMS.Models
@using Microsoft.AspNetCore.Identity
@inject UserManager<ApplicationUserModel> UserManager

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="csrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - AryamanBMS</title>
    @*Bootsrap*@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @*Bootsrap Icons*@
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @*Css Links*@
    <link rel="stylesheet" href="~/css/variables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/notification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/birthday-celebration.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/navbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/gantt.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/timeline.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-communication.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/leaves.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/components/cards.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/buttons.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/forms.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/page-header.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/tables.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/badges.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components/alerts.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/components/avatar.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/modules/payslip-print.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/invoice-print.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/modules/detail-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/print.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/lib/cropper/cropper.min.css" asp-append-version="true" />


    <link rel="stylesheet" href="~/AryamanBMS.styles.css" asp-append-version="true" />
</head>
<body>

    <div class="app-layout">

        <partial name="_Sidebar" />
        <div class="sidebar-backdrop" data-sidebar-close></div>


        <div class="main-content">

            <partial name="_Navbar" />

            @if (TempData["Success"] != null)
            {
                <div class="alert-message-app alert-success-app">
                    <i class="bi bi-check-circle-fill"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Warning"] != null)
            {
                <div class="alert-message-app alert-warning-app">
                    <i class="bi bi-info-circle-fill"></i>

                    <div>
                        @TempData["Warning"]
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert-message-app alert-error-app">
                    <i class="bi bi-exclamation-triangle-fill"></i>

                    <div>
                        @foreach (var error in TempData["Error"]?.ToString()?.Split(
                                            Environment.NewLine,
                                            StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>())
                        {
                            <div>@error</div>
                        }
                    </div>
                </div>
            }

            @if (TempData["BirthdayCelebrationMessage"] != null)
            {
                <div id="birthdayCelebrationData"
                     data-name="@TempData["BirthdayCelebrationName"]"
                     data-message="@TempData["BirthdayCelebrationMessage"]"
                     hidden>
                </div>
            }

            @RenderBody()

        </div>
        

    </div>    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        var layoutUser = await UserManager.GetUserAsync(User);
        var enableToast =
            (layoutUser?.EnableNotificationToast ?? true)
                .ToString()
                .ToLowerInvariant();
        var enableSound =
            (layoutUser?.EnableNotificationSound ?? false)
                .ToString()
                .ToLowerInvariant();

        <script>
            window.aryamanAppBasePath = "@Url.Content("~/")";
            window.aryamanNotificationPreferences = {
                toast: @Html.Raw(enableToast),
                sound: @Html.Raw(enableSound)
            };
        </script>
        <script src="~/lib/signalr/signalr.min.js" asp-append-version="true"></script>
        <script src="~/js/notification-realtime.js" asp-append-version="true"></script>
    }
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/birthday-celebration.js" asp-append-version="true"></script>

    @* /* Profile cropper */ *@
    <script src="~/lib/cropper/cropper.min.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/activity-heartbeat.js" asp-append-version="true"></script>
    }
</body>
</html>

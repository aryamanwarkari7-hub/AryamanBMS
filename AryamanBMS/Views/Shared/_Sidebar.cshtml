                                    <span>Tracker</span>
                                    <i class="bi bi-chevron-down ms-auto"></i>
                                </button>

                                <div class="collapse @(isProjectTrackingActive ? "show" : "")"
                                     id="projectTrackingSubMenu"
                                     data-bs-parent="#projectSubAccordion">

                                    @if (isAdminHrOrMaster || managesProjects)
                                    {
                                        @* ==========================================
                                            PROJECT TASK UPDATES
                                        ========================================== *@
                                        <a asp-controller="TaskTracker"
                                           asp-action="Index"
                                           class="submenu-item nested-item @(currentController == "TaskTracker" ? "active-menu" : "")">
                                            <i class="bi bi-activity"></i>
                                            <span>Task Updates</span>
                                        </a>
                                    }

                                    @* ==========================================
                                        PROJECT MEETINGS
                                    ========================================== *@
                                    <a asp-controller="MOM"
                                       asp-action="Index"
                                       class="submenu-item nested-item @(currentController == "MOM" ? "active-menu" : "")">
                                        <i class="bi bi-journal-text"></i>
                                        <span>Meetings</span>
                                    </a>

                                    @if (isAdminHrOrMaster)
                                    {
                                        @* ==========================================
                                            PROJECT RISKS
                                        ========================================== *@

                                    <span>Audit Docs</span>
                                </a>

                                <a asp-controller="Notice"
                                   asp-action="Index"
                                   class="submenu-item nested-item @(currentController == "Notice" ? "active-menu" : "")">
                                    <i class="bi bi-bell"></i>
                                    <span>Notices</span>
                                </a>

                            </div>

                        </div>

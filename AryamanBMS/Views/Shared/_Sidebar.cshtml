                               asp-action="Index"
                               class="submenu-item @(currentController == "PasswordChangeLog" ? "active-menu" : "")">
                                <i class="bi bi-shield-lock"></i>
                                <span>Password Change Logs</span>
                            </a>
                        
                    </div>

                </div>

            </div>
        }

        @* ==========================================
           HR & ADMINISTRATION
        ========================================== *@

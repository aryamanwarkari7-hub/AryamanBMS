                               asp-action="MyTasks"
                               class="submenu-item @(currentController == "EmployeeProject" ? "active-menu" : "")">
                                <i class="bi bi-list-check"></i>
                                <span>My Tasks</span>
                            </a>
                        }
                        else
                        {
                            @* ==========================================
                                PROJECT DASHBOARD
                             ========================================== *@
                            <a asp-controller="Project"
                               asp-action="Overview"
                               class="submenu-item @(currentController == "Project" && currentAction == "Overview" ? "active-menu" : "")">
                                <i class="bi bi-speedometer2"></i>
                                <span>Dashboard</span>
                            </a>


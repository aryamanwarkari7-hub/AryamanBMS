                                ========================================== *@
                                <a asp-controller="Attendance"
                                   asp-action="MyMonthly"
                                   class="submenu-item nested-item @(currentController == "Attendance" && currentAction == "MyMonthly" ? "active-menu" : "")">

                                    <i class="bi bi-calendar3"></i>
                                    <span>Monthly Attendance</span>

                                </a>
                            }

                            @if (isAdminHrOrMaster)
                            {
                                @* ==========================================
                                    ATTENDANCE DASHBOARD
                                ========================================== *@
                                <a asp-controller="Attendance"
                                   asp-action="Dashboard"
                                   class="submenu-item nested-item @(currentController == "Attendance" && currentAction == "Dashboard" ? "active-menu" : "")">


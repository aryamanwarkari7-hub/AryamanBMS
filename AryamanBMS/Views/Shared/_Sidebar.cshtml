                                               asp-action="Index"
                                               class="submenu-item nested-item @(currentController == "Receivables" ? "active-menu" : "")">
                                                <i class="bi bi-graph-up-arrow"></i>
                                                <span>Receivables</span>
                                            </a>

                                            <a asp-controller="CreditNote"
                                               asp-action="Index"
                                               class="submenu-item nested-item @(currentController == "CreditNote" ? "active-menu" : "")">
                                                <i class="bi bi-file-minus"></i>
                                                <span>Credit Notes</span>
                                            </a>

                                            <a asp-controller="DebitNote"
                                               asp-action="Index"
                                               class="submenu-item nested-item @(currentController == "DebitNote" ? "active-menu" : "")">
                                                <i class="bi bi-file-plus"></i>
                                                <span>Debit Notes</span>
                                            </a>
                                        }

                                    </div>

                                </div>

                                <div class="submenu-nested">

                                    <button class="submenu-item submenu-toggle @(isPurchasesActive ? "active-menu" : "")"

    </div>

    <div class="sidebar-footer">

        <div class="user-profile d-flex flex-row justify-content-between">

            @{
                var sidebarActivityStatus = currentUser?.ActivityStatus ?? "Offline";
                var sidebarActivityClass = sidebarActivityStatus.ToLower().Replace(" ", "-");
            }

            <div class="activity-avatar sidebar-footer-avatar">

                <div class="user-avatar">

                    @if (!string.IsNullOrWhiteSpace(currentUser?.ProfilePhotoPath))
                    {
                        <img src="@currentUser.ProfilePhotoPath"
                             alt="@userName"
                             class="user-avatar-img" />
                    }
                    else
                    {
                        @initials
                    }

                </div>

                <span class="activity-dot activity-@sidebarActivityClass"
                      title="@sidebarActivityStatus">
                </span>

            </div>

            <div class="user-details">

                <div class="user-name text-wrap">
                    @userName
                </div>

                <div class="user-role">
                    @role
                </div>

                <div class="user-activity-status">
                    @sidebarActivityStatus
                </div>

            </div>

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="logout-btn"
                        title="Logout">
                    Logout
                </button>

            </form>

        </div>

    </div>

</div>

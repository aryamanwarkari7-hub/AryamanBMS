@using AryamanBMS.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using AryamanBMS.Repositories.Interfaces

@inject AryamanBMS.Repositories.Interfaces.IEmployeeRepository EmployeeRepository
@inject AryamanBMS.Repositories.Interfaces.IProjectMemberRepository ProjectMemberRepository
@inject UserManager<ApplicationUserModel> UserManager
@inject IProjectRepository ProjectRepository

@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var currentUser =
        await UserManager.GetUserAsync(User);

    var userName =
        currentUser?.FullName ?? currentUser?.UserName ?? "User";

    var role =
        currentUser != null
            ? (await UserManager.GetRolesAsync(currentUser)).FirstOrDefault()
            : "";

    var isAdmin =
        currentUser != null &&
        await UserManager.IsInRoleAsync(currentUser, "Admin");

    var isHR =
        currentUser != null &&
        await UserManager.IsInRoleAsync(currentUser, "HR");

    var isEmployee =
        currentUser != null &&
        await UserManager.IsInRoleAsync(currentUser, "Employee");

    

    var isFinance =
        currentUser != null &&
        await UserManager.IsInRoleAsync(currentUser, "Finance");

    var isMaster =
        currentUser != null &&
        await UserManager.IsInRoleAsync(currentUser, "Master");

    var isAdminOrHR = isAdmin || isHR;
    var isAdminHrOrMaster = isAdmin || isHR || isMaster;

    var isEmployeeOnly =
        isEmployee && !isAdmin && !isHR && !isMaster;

    var hasEmployeeProjectAccess = false;
    var managesProjects = false;

    if (isEmployeeOnly && currentUser != null)
    {
        var linkedEmployee =
            await EmployeeRepository.Employees
                .AsNoTracking()
                .FirstOrDefaultAsync(x =>
                    x.ApplicationUserId == currentUser.Id);

        if (linkedEmployee != null)
        {
            managesProjects = await ProjectRepository.Projects
                .AnyAsync(p =>
                    p.IsActive &&
                    p.ProjectManagerId == linkedEmployee.Id);

            hasEmployeeProjectAccess = managesProjects;
        }
    }

    var canAccessProjectManagement =  isAdminHrOrMaster || isEmployeeOnly;

    var canAccessAccounts =
        isAdmin || isFinance || isMaster;

    var initials = string.Empty;

    if (!string.IsNullOrWhiteSpace(userName))
    {
        var nameParts = userName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        if (nameParts.Length == 1)
        {
            initials = nameParts[0][0].ToString().ToUpper();
        }
        else
        {
            initials = $"{nameParts.First()[0]}{nameParts.Last()[0]}".ToUpper();
        }
    }

    bool isLeaveOpen =
    currentController == "LeaveType" ||
    currentController == "LeaveBalance" ||
    currentController == "LeaveApplication" ||
    currentController == "CompOffCredit";

    bool isMasterSetupActive =
    currentController == "User" ||
    currentController == "Role" ||
    currentController == "Department" ||
    currentController == "Designation"||
    currentController == "LoginHistory" ||
    currentController == "PasswordChangeLog";

    bool isAttendanceActive = currentController == "Attendance";

    bool isLeaveActive =
    currentController == "LeaveApplication" ||
    currentController == "LeaveBalance" ||
    currentController == "LeaveType" ||
    currentController == "CompOffCredit";

    bool isSalaryActive =
        currentController == "Salary" ||
        currentController == "SalaryStructure" ||
        currentController == "SalaryAdvance" ||
        currentController == "SalaryPaymentBatch" ||
        currentController == "FullAndFinalSettlement";

    bool isLetterActive = currentController == "Letter";

    bool isHrActive =
         currentController == "Employee" ||
         isAttendanceActive ||
         isLeaveActive ||
         isSalaryActive ||
         isLetterActive;

    bool isEmployeeActive = currentController == "Employee";

    bool isEmployeeSelfServiceActive =
    currentController == "ExpenseVoucher" ||
    currentController == "OfficeAsset";

    bool isProjectSetupActive =
    (currentController == "Project" && currentAction != "Overview") ||
    currentController == "ProjectMember";

    bool isProjectPlanningActive =
        currentController == "ProjectTask" ||
        currentController == "ProjectFlow";

    bool isProjectTrackingActive =
        currentController == "TaskTracker" ||
        currentController == "MOM" ||
        currentController == "Risk";

    bool isEmployeeProjectActive =
    currentController == "EmployeeProject";

    bool isProjectActive =
        (currentController == "Project" && currentAction == "Overview") ||
        isProjectSetupActive ||
        isProjectPlanningActive ||
        isProjectTrackingActive ||
        isEmployeeProjectActive;

    bool isSalesActive =
        currentController == "Client" ||
        currentController == "Proposal" ||
        currentController == "ProposalTemplate" ||
        currentController == "PurchaseOrder" ||
        currentController == "BillingMilestone" ||
        currentController == "Invoice" ||
        currentController == "AdvanceReceipt" ||
        currentController == "Receivables" ||
        currentController == "PaymentReceipt" ||
        currentController == "CreditNote" ||
        currentController == "DebitNote";

    bool isPurchasesActive =
        currentController == "Vendor" ||
        currentController == "ExpenseVoucher" ||
        currentController == "VendorPayment" ||
        currentController == "ExpenseCategory" ||
        currentController == "PurchaseReport" ||
        currentController == "OfficeAsset";

    bool isAccountsBillingActive =
        isSalesActive ||
        isPurchasesActive;

    bool isComplianceDocumentsActive =
        currentController == "Gst" ||
        currentController == "Pf" ||
        currentController == "Esic" ||
        currentController == "Pt" ||
        currentController == "CompanyProfile" ||
        currentController == "CompanyDocument" ||
        currentController == "CompanyDocumentCategory" ||
        currentController == "FinancialAuditDocument" ||
        currentController == "Notice";

    bool isAccountsActive =
        isAccountsBillingActive ||
        (!isMaster && isComplianceDocumentsActive);
}


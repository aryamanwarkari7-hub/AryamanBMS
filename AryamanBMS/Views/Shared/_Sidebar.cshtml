                    </div>

                    <i class="bi bi-chevron-down"></i>
                </button>

                <div class="collapse @(isProjectActive ? "show" : "")"
                     id="projectMenu"
                     data-bs-parent="#sidebarAccordion">

                    <div class="submenu" id="projectSubAccordion">

                        @if (isEmployeeOnly && !managesProjects)
                        {
                            @* ==========================================
                                EMPLOYEE-ASSIGNED PROJECT
                             ========================================== *@

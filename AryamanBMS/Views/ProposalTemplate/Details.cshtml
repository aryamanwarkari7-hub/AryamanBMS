@model AryamanBMS.Models.ProposalTemplateModel

@{
    ViewData["Title"] =
        "Proposal Template Details";
}

<div class="module-header">

    <div>
        <h1 class="module-title">
            Proposal Template Details
        </h1>

        <p class="module-subtitle">
            @Model.TemplateName
            — Rev @Model.VersionNumber
        </p>
    </div>

    <div class="module-header-actions">

        

        <a asp-action="Download"
           asp-route-id="@Model.ProposalTemplateId"
           class="btn-app btn-primary-app">

            <i class="bi bi-download"></i>
            Download

        </a>



        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit"
               asp-route-id="@Model.ProposalTemplateId"
               class="btn-app btn-secondary-app">

                <i class="bi bi-pencil"></i>
                Edit

            </a>
        }

        <a asp-action="Index"
           class="btn-app btn-secondary-app">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">
            Template Information
        </h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">
                    Template Name
                </label>
                <div>@Model.TemplateName</div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Version
                </label>
                <div>Rev @Model.VersionNumber</div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Original File
                </label>
                <div>@Model.OriginalFileName</div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    File Size
                </label>
                <div>
                    @((Model.FileSize / 1024m)
                                        .ToString("N2")) KB
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Status
                </label>

                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge-secondary">
                            Previous Version
                        </span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Uploaded On
                </label>

                <div>
                    @Model.UploadedOn.ToString(
                    "dd-MMM-yyyy hh:mm tt")
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Uploaded By User ID
                </label>

                <div>
                    @Model.UploadedByUserId
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Remarks
                </label>

                <div>
                    @(Model.Remarks ?? "-")
                </div>
            </div>

        </div>

    </div>

</div>
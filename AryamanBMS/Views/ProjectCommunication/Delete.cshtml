@model AryamanBMS.Models.ProjectCommunicationModel

@{
    ViewData["Title"] = "Delete Project Communication";
}

<div class="module-header">

    <div>

        <h1 class="module-title">
            Delete Project Communication
        </h1>

        <p class="module-subtitle">
            Confirm deletion.
        </p>

    </div>

    <a asp-action="Index"
       asp-route-projectId="@Model.ProjectId"
       class="btn-app btn-secondary-app">

        <i class="bi bi-arrow-left"></i>

        Back

    </a>

</div>

<div class="app-card">

    <div class="card-header">

        <h5 class="card-title">
            Communication Summary
        </h5>

    </div>

    <div class="card-body">

        <div class="details-grid">

            <div>

                <strong>Subject</strong>

                <p>@Model.Subject</p>

            </div>

            <div>

                <strong>Status</strong>

                <p>@Model.Status</p>

            </div>

            <div>

                <strong>Communication Type</strong>

                <p>@Model.CommunicationType</p>

            </div>

            <div>

                <strong>Created On</strong>

                <p>
                    @Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")
                </p>

            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">

        <h5 class="card-title">
            Message
        </h5>

    </div>

    <div class="card-body">

        <div class="detail-note-box">

            @Model.Message

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-body">

        <div class="app-alert-warning">

            <i class="bi bi-exclamation-triangle-fill"></i>

            <strong>Confirm Deletion</strong>

            <p class="mb-0 mt-2">

                This project communication will be marked as inactive
                and will no longer appear in the Project Communication
                timeline.

            </p>

        </div>

    </div>

</div>

<form asp-action="DeleteConfirmed"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div class="app-card">

        <div class="card-body form-actions">

            <button type="submit"
                    class="btn-app btn-danger-app">

                <i class="bi bi-trash"></i>

                Delete Communication

            </button>

            <a asp-action="Index"
               asp-route-projectId="@Model.ProjectId"
               class="btn-app btn-secondary-app">

                <i class="bi bi-arrow-left"></i>

                Cancel

            </a>

        </div>

    </div>

</form>
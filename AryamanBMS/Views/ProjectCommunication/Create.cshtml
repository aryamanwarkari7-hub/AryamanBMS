@model AryamanBMS.Models.ProjectCommunicationModel

@{
    ViewData["Title"] = "New Project Communication";
}

<div class="module-header">

    <div>

        <h1 class="module-title">
            New Project Communication
        </h1>

        <p class="module-subtitle">
            Create a new project communication.
        </p>

    </div>

    <a asp-action="Index"
       asp-route-projectId="@Model.ProjectId"
       class="btn-app btn-secondary-app">

        <i class="bi bi-arrow-left"></i>

        Back

    </a>

</div>

<form asp-action="Create" method="post" enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="app-alert-danger"></div>

    
    <input asp-for="ProjectId" type="hidden" />
    

    <div class="app-card form-card">

        <div class="card-header">

            <h5 class="card-title">
                Communication Details
            </h5>

        </div>

        <div class="card-body">
            <div class="form-group">

                <label class="form-label">
                    Communication Subject
                </label>

                <input asp-for="Subject"
                       class="app-input" 
                       placeholder="Enter communication subject" />

                <span asp-validation-for="Subject"
                      class="validation-message"></span>

            </div>
            <div class="form-group mt-3">

                <label class="form-label">
                    Communication Subject
                </label>

                <textarea asp-for="Message"
                          rows="6"
                          class="app-textarea"
                          placeholder="Enter communication details...">
</textarea>

                <span asp-validation-for="Message"
                      class="validation-message"></span>

            </div>
            <div class="form-group mt-3">

                <label class="form-label">
                    Status
                </label>

                <select asp-for="Status"
                        class="app-select">

                    <option value="Open" selected>
                        Open
                    </option>

                    <option value="Information">
                        Information
                    </option>

                    <option value="Action Required">
                        Action Required
                    </option>

                    <option value="Closed">
                        Closed
                    </option>

                </select>

            </div>
            <div class="form-group mt-3">

                <label class="form-label">Documents</label>

                <div id="communicationDocumentsContainer">
                    <div class="border-bottom pb-3 mb-3 communication-document-row">
                        <input name="uploadedDocuments[0].DocumentName"
                               class="app-input mb-2"
                               maxlength="200"
                               placeholder="Document name, e.g. Client approval" />
                        <input name="uploadedDocuments[0].File"
                               type="file"
                               accept=".pdf,.doc,.docx,.xlsx"
                               class="app-input" />
                        <button type="button" class="btn-app btn-danger-app btn-sm mt-2 remove-communication-document">Remove</button>
                    </div>
                </div>

                <button type="button" id="addCommunicationDocument" class="btn-app btn-secondary-app btn-sm">
                    <i class="bi bi-plus-lg"></i> Add Document
                </button>

                <small class="text-muted d-block mt-2">
                    Optional: PDF, DOC, DOCX, or XLSX. Maximum file size: 20 MB each.
                </small>

            </div>
        </div>

    </div>
   
    <div class="app-card ">

        <div class="card-body form-actions">

           
                <button type="submit"
                        class="btn-app btn-primary-app">

                    <i class="bi bi-check-circle"></i>

                    Create Communication

                </button>

                <a asp-action="Index"
                   asp-route-projectId="@Model.ProjectId"
                   class="btn-app btn-secondary-app">

                    <i class="bi bi-arrow-left"></i>

                    Cancel

                </a>
           

        </div>

    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/project-communication-documents.js" asp-append-version="true"></script>
}

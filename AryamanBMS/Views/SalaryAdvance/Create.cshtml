@model AryamanBMS.Models.SalaryAdvanceModel

@{
    ViewData["Title"] = "Create Salary Advance";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Create Salary Advance</h1>
        <p class="module-subtitle">Record an approved advance and recovery plan</p>
    </div>

    <a asp-action="Index" class="btn-app btn-secondary-app">Back</a>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

    <div class="app-card">
        <div class="card-body">
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="EmployeeId" class="form-label">Employee</label>
                    <select asp-for="EmployeeId" class="app-select">
                        <option value="">Select Employee</option>
                        @foreach (var employee in ViewBag.Employees)
                        {
                            <option value="@employee.Id">@employee.EmployeeCode - @employee.FullName</option>
                        }
                    </select>
                    <span asp-validation-for="EmployeeId" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AdvanceDate" class="form-label">Advance Date</label>
                    <input asp-for="AdvanceDate" type="date" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="AdvanceAmount" class="form-label">Advance Amount</label>
                    <input asp-for="AdvanceAmount" type="number" step="0.01" class="app-input" />
                    <span asp-validation-for="AdvanceAmount" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MonthlyRecoveryAmount" class="form-label">Monthly Recovery</label>
                    <input asp-for="MonthlyRecoveryAmount" type="number" step="0.01" class="app-input" />
                    <span asp-validation-for="MonthlyRecoveryAmount" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RecoveryStartMonth" class="form-label">Recovery Start Month</label>
                    <input asp-for="RecoveryStartMonth" type="number" min="1" max="12" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="RecoveryStartYear" class="form-label">Recovery Start Year</label>
                    <input asp-for="RecoveryStartYear" type="number" class="app-input" />
                </div>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks" class="app-textarea" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-body">
            <button type="submit" class="btn-app btn-primary-app">Save Advance</button>
            <a asp-action="Index" class="btn-app btn-secondary-app">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

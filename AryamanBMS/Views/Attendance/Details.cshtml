@model AryamanBMS.Models.AttendanceModel

@{
    ViewData["Title"] = "Attendance Details";

    string statusClass = Model.Status switch
    {
        "P" or "Present" => "badge-success",
        "A" or "Absent" => "badge-danger",
        "L" or "Leave" => "badge-warning",
        "H" or "Holiday" => "badge-info",
        _ => "badge-secondary"
    };

    string statusText = Model.Status switch
    {
        "P" => "Present",
        "A" => "Absent",
        "L" => "Leave",
        "H" => "Holiday",
        _ => Model.Status
    };
}

<div class="module-header">
    <div>
        <h1 class="module-title">Attendance Details</h1>
        <p class="module-subtitle">
            Attendance record for @(Model.Employee?.FullName ?? "employee")
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit
        </a>

        <a asp-action="Register"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee Code</div>
            <div class="detail-summary-value">
                @(Model.Employee?.EmployeeCode ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee</div>
            <div class="detail-summary-value">
                @(Model.Employee?.FullName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Attendance Date</div>
            <div class="detail-summary-value">
                @Model.AttendanceDate.ToString("dd-MMM-yyyy")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@statusClass">@statusText</span>
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Attendance Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Employee Code</span>
                        <strong class="detail-info-value">
                            @(Model.Employee?.EmployeeCode ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Employee Name</span>
                        <strong class="detail-info-value">
                            @(Model.Employee?.FullName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Attendance Date</span>
                        <strong class="detail-info-value">
                            @Model.AttendanceDate.ToString("dd-MMM-yyyy")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Status</span>
                        <strong class="detail-info-value">
                            <span class="@statusClass">@statusText</span>
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Day Value</span>
                        <strong class="detail-info-value">
                            @Model.AttendanceValue.ToString("0.##")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Record Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Created On</span>
                        <strong class="detail-info-value">
                            @Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Remarks</span>
                        <strong class="detail-info-value">
                            @(Model.Remarks ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

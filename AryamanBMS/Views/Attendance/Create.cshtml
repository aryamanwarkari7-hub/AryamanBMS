@model AryamanBMS.Models.AttendanceModel

@{
    ViewData["Title"] = "Create Attendance";
}

<div class="module-header">

    <div>
        <h1 class="module-title">
            Create Attendance
        </h1>

        <p class="module-subtitle">
            Add attendance manually
        </p>
    </div>

</div>

<div class="app-card">

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="ModelOnly"
                 class="validation-message mb-3">
            </div>

            <div class="form-grid-2">

                <div class="form-group">

                    <label class="form-label">
                        Employee
                    </label>

                    <select asp-for="EmployeeId"
                            class="app-select">

                        <option value="">
                            Select Employee
                        </option>

                        @foreach (var employee in ViewBag.Employees)
                        {
                            <option value="@employee.Id">
                                @employee.EmployeeCode -
                                @employee.FirstName
                                @employee.LastName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="AttendanceDate"
                           class="form-label">
                        Attendance Date
                    </label>

                    <input asp-for="AttendanceDate"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="AttendanceDate"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label class="form-label">
                        Attendance Type
                    </label>

                    <select asp-for="IsOffDayWork"
                            class="app-select"
                            id="attendanceType">

                        <option value="false">
                            Normal Attendance
                        </option>

                        <option value="true">
                            Off-Day Work
                        </option>

                    </select>

                </div>

                <div class="form-group"
                     id="offDayTypeGroup"
                     style="display:none;">

                    <label asp-for="OffDayType"
                           class="form-label">
                        Off-Day Type
                    </label>

                    <select asp-for="OffDayType"
                            class="app-select">

                        <option value="">
                            Select Off-Day Type
                        </option>

                        <option value="WO">
                            Weekly Off
                        </option>

                        <option value="H">
                            Holiday
                        </option>

                    </select>

                    <span asp-validation-for="OffDayType"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="Status"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Status"
                            class="app-select"
                            id="attendanceStatus">

                        <option value="P">Present</option>
                        <option value="A">Absent</option>
                        <option value="L">Leave</option>
                        <option value="H">Holiday</option>
                        <option value="WO">Week Off</option>
                        <option value="OD">On Duty</option>

                    </select>

                </div>

                <div class="form-group">

                    <label asp-for="AttendanceValue"
                           class="form-label">
                        Day Value
                    </label>

                    <select asp-for="AttendanceValue"
                            class="app-select">

                        <option value="1">
                            Full Day
                        </option>

                        <option value="0.5">
                            Half Day
                        </option>

                    </select>

                </div>

            </div>

            <div id="offDayTimeGroup"
                 class="form-grid-2 mt-3"
                 style="display:none;">

                <div class="form-group">

                    <label asp-for="CheckInTime"
                           class="form-label">
                        Check In Time
                    </label>

                    <input asp-for="CheckInTime"
                           type="datetime-local"
                           class="app-input" />

                    <span asp-validation-for="CheckInTime"
                          class="validation-message">
                    </span>

                </div>

                <div class="form-group">

                    <label asp-for="CheckOutTime"
                           class="form-label">
                        Check Out Time
                    </label>

                    <input asp-for="CheckOutTime"
                           type="datetime-local"
                           class="app-input" />

                    <span asp-validation-for="CheckOutTime"
                          class="validation-message">
                    </span>

                </div>

            </div>

            <div class="form-group mt-3">

                <label asp-for="Remarks"
                       class="form-label">
                    Remarks
                </label>

                <input asp-for="Remarks"
                       class="app-input" />

            </div>

            <div class="mt-4">

                <button type="submit"
                        class="btn-app btn-primary-app">

                    <i class="bi bi-check-circle"></i>
                    Save Attendance

                </button>

                <a asp-action="Register"
                   class="btn-app btn-secondary-app">

                    Cancel

                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {

            const attendanceType =
                document.getElementById("attendanceType");

            const offDayTypeGroup =
                document.getElementById("offDayTypeGroup");

            const offDayTimeGroup =
                document.getElementById("offDayTimeGroup");

            function updateOffDayFields() {

                const isOffDayWork =
                    attendanceType.value === "true";

                offDayTypeGroup.style.display =
                    isOffDayWork ? "" : "none";

                offDayTimeGroup.style.display =
                    isOffDayWork ? "" : "none";
            }

            attendanceType.addEventListener(
                "change",
                updateOffDayFields);

            updateOffDayFields();
        });
    </script>
}
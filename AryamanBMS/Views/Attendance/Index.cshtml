@model AryamanBMS.Models.AttendanceModel

@{
    ViewData["Title"] = "My Attendance";

    var today = DateTime.Today;
    string? calendarStatus = ViewBag.TodayCalendarStatus as string;
    var statusText = Model == null
        ? calendarStatus == "H"
            ? "Holiday"
            : calendarStatus == "WO"
                ? "Week Off"
                : "Not Marked"
        : Model.Status == "P"
            ? "Present"
            : Model.Status == "L"
                ? "Leave"
                : Model.Status == "A"
                    ? "Absent"
                    : Model.Status == "M"
                        ? "Missing"
                        : Model.Status == "H"
                            ? "Holiday"
                            : Model.Status == "WO"
                                ? "Week Off"
                                : Model.Status;

    string FormatTime(DateTime? value)
    {
        return value.HasValue ? value.Value.ToString("hh:mm tt") : "-";
    }

    string FormatWorkingHours(double? hours)
    {
        if (!hours.HasValue || hours.Value <= 0)
        {
            return "-";
        }

        var totalMinutes = (int)Math.Round(hours.Value * 60);
        var h = totalMinutes / 60;
        var m = totalMinutes % 60;

        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }
}

<div class="module-header">
    <div>
        <h1 class="module-title">My Attendance</h1>
        <p class="module-subtitle">Mark today’s attendance and review your work hours</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="MyMonthly" class="btn-app btn-secondary-app">
            <i class="bi bi-calendar3"></i>
            Monthly View
        </a>

        <a asp-controller="Employee" asp-action="MyDashboard" class="btn-app btn-primary-app">
            <i class="bi bi-speedometer2"></i>
            My Dashboard
        </a>
    </div>
</div>

<div class="dashboard-grid">
    <div class="stats-card">
        <div class="stats-label">Today Date</div>
        <div class="stats-number">@today.ToString("dd MMM yyyy")</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Attendance Status</div>
        <div class="stats-number">@statusText</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Check In Time</div>
        <div class="stats-number">@FormatTime(Model?.CheckInTime)</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Total Working Hours</div>
        <div class="stats-number">@FormatWorkingHours(Model?.WorkingHours)</div>
    </div>
</div>

<div class="main-dashboard-layout attendance-main-layout">

    <div class="app-card dashboard-section-card">
        <div class="card-header">
            <h5 class="card-title">Mark your Attendance</h5>
        </div>

        <div class="card-body">
            @if (Model == null && !string.IsNullOrWhiteSpace(calendarStatus))
            {
                <div class="empty-state">
                    Attendance is not required today.
                </div>
            }
            else if (Model == null || (Model.Status == "P" && Model.CheckInTime == null))
            {
                <form asp-action="CheckIn"
                      method="post"
                      class="attendance-action-form">

                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">Work Location</label>
                        <select name="locationType" class="app-select" required>
                            <option value="">Select Work Location</option>
                            <option value="Office">Office</option>
                            <option value="Site">Site</option>
                        </select>
                    </div>

                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Check In Time
                    </button>
                </form>
            }
            else if (Model.CheckOutTime == null && Model.Status != "L")
            {
                <form asp-action="CheckOut"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to check out now? Your checkout time will be recorded as the current time.');">

                    @Html.AntiForgeryToken()

                    <div class="attendance-action-compact">

                        <button type="submit"
                                class="btn-app btn-danger-app">

                            <i class="bi bi-box-arrow-right"></i>
                            Check Out Time

                        </button>

                    </div>

                </form>
            }
            else
            {
                <div class="empty-state">
                    Attendance completed for today.
                </div>
            }

            <div class="attendance-inline-actions">
                <div class="dashboard-list-title">Quick Actions</div>

                <div class="attendance-quick-actions">
                    <a asp-action="MyMonthly" class="attendance-quick-link">
                        <i class="bi bi-calendar3"></i>
                        <span>
                            <strong>Monthly Attendance</strong>
                            <small>Review this month</small>
                        </span>
                    </a>

                    <a asp-controller="LeaveApplication"
                       asp-action="Create"
                       asp-route-mine="true"
                       class="attendance-quick-link">
                        <i class="bi bi-calendar-plus"></i>
                        <span>
                            <strong>Apply Leave</strong>
                            <small>Create leave request</small>
                        </span>
                    </a>

                    <a asp-controller="LeaveApplication"
                       asp-action="Index"
                       asp-route-mine="true"
                       class="attendance-quick-link">
                        <i class="bi bi-calendar-event"></i>
                        <span>
                            <strong>Leave Applications</strong>
                            <small>Track request status</small>
                        </span>
                    </a>

                    <a asp-controller="Employee" asp-action="MyDashboard" class="attendance-quick-link">
                        <i class="bi bi-speedometer2"></i>
                        <span>
                            <strong>My Dashboard</strong>
                            <small>Open employee workspace</small>
                        </span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card dashboard-section-card">
        <div class="card-header">
            <h5 class="card-title">Today’s Record</h5>
        </div>

        <div class="card-body">
            <div class="profile-stack">
                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-calendar"></i>
                        Date
                    </span>
                    <strong>@today.ToString("dd-MMM-yyyy")</strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-check-circle"></i>
                        Status
                    </span>
                    <strong>
                        <span class="badge-success">@statusText</span>
                    </strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-box-arrow-in-right"></i>
                        Check In Time
                    </span>
                    <strong>@FormatTime(Model?.CheckInTime)</strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-box-arrow-right"></i>
                        Check Out Time
                    </span>
                    <strong>@FormatTime(Model?.CheckOutTime)</strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-geo-alt"></i>
                        Working Location
                    </span>
                    <strong>@(string.IsNullOrWhiteSpace(Model?.LocationType) ? "-" : Model.LocationType)</strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-hourglass-split"></i>
                        Working Hours
                    </span>
                    <strong>@FormatWorkingHours(Model?.WorkingHours)</strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-chat-left-text"></i>
                        Remarks
                    </span>
                    <strong>@(string.IsNullOrWhiteSpace(Model?.Remarks) ? "-" : Model.Remarks)</strong>
                </div>
            </div>
        </div>
    </div>

</div>


@model PagedListViewModel<AttendanceModel>

@{
    ViewData["Title"] = "Attendance Register";

    bool isMaster = User.IsInRole("Master");
}

<div class="module-header">

    <div>
        <h1 class="module-title">
            Attendance Register
        </h1>

        <p class="module-subtitle">
            Manage employee attendance records
        </p>
    </div>

    <div class="d-flex flex-wrap gap-2">

        @if (!isMaster)
        {
            <a asp-action="Create" class="btn-app btn-primary-app">

                <i class="bi bi-plus-circle"></i>
                Add Attendance

            </a>
        }

        <a asp-action="Dashboard" class="btn-app btn-secondary-app">

            <i class="bi bi-grid"></i>
            Dashboard

        </a>

        <a asp-action="Summary" class="btn-app btn-secondary-app">

            <i class="bi bi-bar-chart"></i>
            Attendance Summary

        </a>

        @if (!isMaster)
        {
            <a asp-action="ExportExcel" asp-route-searchText="@ViewBag.SearchText" asp-route-fromDate="@ViewBag.FromDate"
               asp-route-toDate="@ViewBag.ToDate" class="btn-app btn-success-app">

                <i class="bi bi-file-earmark-excel"></i>
                Export Excel

            </a>
        }

    </div>

</div>

<div class="app-card mb-3">

    <div class="card-body">

        <form asp-action="Register" method="get">

            <div class="filter-form-row">

                <div class="flex-grow-1">
                    <label class="form-label">
                        Employee
                    </label>

                    <input type="text" name="searchText" value="@ViewBag.SearchText" class="app-input w-100"
                           placeholder="Employee Code / Name / Mobile / Email" autocomplete="off" />
                </div>

                <div>
                    <label class="form-label">
                        From
                    </label>

                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="app-input" />
                </div>

                <div>
                    <label class="form-label">
                        To
                    </label>

                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="app-input" />
                </div>

                <div>
                    <label class="form-label">Sort By</label>
                    <select name="sortBy" class="app-select">
                        <option value="AttendanceDate" selected="@(ViewBag.SortBy == "AttendanceDate")">Date</option>
                        <option value="Employee" selected="@(ViewBag.SortBy == "Employee")">Employee</option>
                        <option value="Status" selected="@(ViewBag.SortBy == "Status")">Status</option>
                        <option value="AttendanceValue" selected="@(ViewBag.SortBy == "AttendanceValue")">Day Value
                        </option>
                    </select>
                </div>

                <div>
                    <label class="form-label">Order</label>
                    <select name="sortOrder" class="app-select">
                        <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Descending</option>
                        <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Ascending</option>
                    </select>
                </div>

                <div class="filter-form-actions">
                    <button type="submit" class="btn-app btn-primary-app">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                    <a asp-action="Register" class="btn-app btn-secondary-app">

                        <i class="bi bi-arrow-counterclockwise"></i>
                        Reset

                    </a>
                </div>

            </div>

        </form>

    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">

        <h5 class="card-title">
            Attendance List
        </h5>

    </div>

    <div class="card-body">

        @if (!Model.Items.Any())
        {
            <div class="empty-state">

                <i class="bi bi-calendar-x"></i>

                <p class="mb-0">
                    No attendance records found.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="app-table">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>ID</th>
                            <th>Date</th>
                            <th>Employee Code</th>
                            <th>Employee Name</th>
                            <th>Status</th>
                            <th>Day Value</th>
                            <th>Location</th>
                            <th>Working Hours</th>
                            <th>Remarks</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int serialNumber = ((Model.Pagination.CurrentPage - 1) * Model.Pagination.PageSize) + 1;
                        }
                        @foreach (var attendance in Model.Items)
                        {
                            <tr>
                                <td>@serialNumber</td>

                                <td>
                                    @attendance.Id
                                </td>

                                <td>
                                    @(attendance.AttendanceDate.ToString("dd-MMM-yyyy"))
                                </td>

                                <td>
                                    @(attendance.Employee?.EmployeeCode
                                      ?? "-")
                                </td>

                                <td>
                                    @(attendance.Employee?.FullName
                                      ?? "-")
                                </td>

                                <td>

                                    @switch (attendance.Status)
                                    {
                                        case "P":
                                            <span class="badge-success">
                                                Present
                                            </span>
                                            break;

                                        case "A":
                                            <span class="badge-danger">
                                                Absent
                                            </span>
                                            break;

                                        case "M":
                                            <span class="badge-danger">
                                                Missing
                                            </span>
                                            break;

                                        case "L":
                                            <span class="badge-warning">
                                                Leave
                                            </span>
                                            break;

                                        case "H":
                                            <span class="badge-primary">
                                                Holiday
                                            </span>
                                            break;

                                        case "WO":
                                            <span class="badge-secondary">
                                                Week Off
                                            </span>
                                            break;

                                        case "OD":
                                            <span class="badge-info">
                                                On Duty
                                            </span>
                                            break;

                                        default:
                                            <span>-</span>
                                            break;
                                    }

                                </td>

                                <td>
                                    @attendance.AttendanceValue.ToString("0.##")
                                </td>

                                <td>
                                    @(attendance.LocationType ?? "-")
                                </td>

                                <td>
                                    <span
                                        title="Check In: @(attendance.CheckInTime.HasValue
                                                                                                                                                                                                                    ? attendance.CheckInTime.Value.ToString("hh:mm tt")
                                                                                                                                                                                                : "-") | Check Out: @(attendance.CheckOutTime.HasValue
                                                                                                                                                                                                                    ? attendance.CheckOutTime.Value.ToString("hh:mm tt")
                                                                                                                                                                                                : "-")">
                                        @attendance.WorkingHours.ToString("0.00") hrs
                                    </span>
                                </td>

                                <td>
                                    @(attendance.Remarks ?? "-")
                                </td>

                                <td>

                                    @if (attendance.Id > 0)
                                    {
                                        <div class="table-actions justify-content-end">

                                            <a asp-action="Details" asp-route-id="@attendance.Id"
                                               class="btn-app btn-primary-app btn-icon" title="View attendance"
                                               aria-label="View attendance">

                                                <i class="bi bi-eye"></i>

                                            </a>

                                            @if (!isMaster)
                                            {
                                                <a asp-action="Edit" asp-route-id="@attendance.Id"
                                                   class="btn-app btn-secondary-app btn-icon" title="Edit attendance"
                                                   aria-label="Edit attendance">

                                                    <i class="bi bi-pencil"></i>

                                                </a>

                                            
                                                <a asp-action="Delete" asp-route-id="@attendance.Id"
                                                   class="btn-app btn-danger-app btn-icon" title="Delete attendance"
                                                   aria-label="Delete attendance">

                                                    <i class="bi bi-trash"></i>

                                                </a>
                                            }

                                        </div>
                                    }
                                    else
                                    {
                                        @if (attendance.Status == "M" && !isMaster)
                                        {
                                            <div class="table-actions justify-content-end">

                                                <a asp-action="Create" asp-route-employeeId="@attendance.EmployeeId"
                                                   asp-route-attendanceDate="@attendance.AttendanceDate.ToString("yyyy-MM-dd")"
                                                   asp-route-status="A" class="btn-app btn-primary-app btn-icon"
                                                   title="Mark attendance" aria-label="Mark attendance">

                                                    <i class="bi bi-plus-circle"></i>

                                                </a>

                                            </div>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    }

                                </td>

                            </tr>
                            serialNumber++;
                        }

                    </tbody>

                </table>

            </div>
        }

        <partial name="_Pagination" model="Model.Pagination" />

    </div>

</div>

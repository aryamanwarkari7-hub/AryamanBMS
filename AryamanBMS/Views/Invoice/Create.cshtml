@model AryamanBMS.Models.InvoiceModel

@{
    ViewData["Title"] = "Create Invoice";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Add Invoice</h1>
        <p class="module-subtitle">Create invoice for client billing</p>
    </div>

    <a asp-action="Index" class="btn-app btn-secondary-app">
        <i class="bi bi-arrow-left"></i>
        Back
    </a>
</div>

<form asp-action="Create"
      method="post"
      enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    <input type="hidden"
           asp-for="InvoiceStatus"
           value="Draft" />


    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Invoice Information</h5>
        </div>

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="validation-message">
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="InvoiceNo" class="form-label">Invoice No</label>
                    <input asp-for="InvoiceNo" class="app-input" readonly />
                    <span asp-validation-for="InvoiceNo" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="InvoiceType"
                           class="form-label">
                        Invoice Type
                    </label>

                    <select asp-for="InvoiceType"
                            id="InvoiceType"
                            class="app-select">

                        <option value="Tax Invoice">
                            Tax Invoice
                        </option>

                        <option value="Proforma Invoice">
                            Proforma Invoice
                        </option>

                    </select>

                    <span asp-validation-for="InvoiceType"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="InvoiceDate" class="form-label">Invoice Date</label>
                    <input asp-for="InvoiceDate" type="date" class="app-input" />
                    <span asp-validation-for="InvoiceDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ClientId" class="form-label">Client</label>
                    <select asp-for="ClientId" class="app-select" id="ClientId">
                        <option value="">Select Client</option>
                        @foreach (var client in ViewBag.Clients)
                        {
                            <option value="@client.ClientId"
                                    data-gst="@client.GSTNumber"
                                    data-address="@client.Address">
                                @client.ClientName
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ClientId" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ProjectId" class="form-label">
                        Project
                    </label>

                    <select asp-for="ProjectId"
                            class="app-select">

                        <option value="">Select Project</option>

                        @foreach (var project in ViewBag.Projects)
                        {
                            <option value="@project.Id">
                                @project.ProjectCode - @project.ProjectName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="ProjectId"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PurchaseWorkOrderId"
                           class="form-label">
                        Purchase / Work Order
                    </label>

                    <select asp-for="PurchaseWorkOrderId"
                            id="PurchaseWorkOrderId"
                            class="app-select">

                        <option value="">
                            Select Purchase Order
                        </option>

                        @if (ViewBag.PurchaseOrders != null)
                        {
                            foreach (var order in ViewBag.PurchaseOrders)
                            {
                                <option value="@order.PurchaseOrderId">
                                    @order.OrderNumber - @order.OrderTitle
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="PurchaseWorkOrderId"
                          class="validation-message"></span>
                </div>

                <div class="form-group gst-section">
                    <label asp-for="GSTNo"
                           class="form-label">
                        GST No
                    </label>

                    <input asp-for="GSTNo"
                           class="app-input" />

                    <span asp-validation-for="GSTNo"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group gst-section">
                    <label asp-for="SACCode"
                           class="form-label">
                        SAC Code
                    </label>

                    <input asp-for="SACCode"
                           class="app-input" />

                    <span asp-validation-for="SACCode"
                          class="validation-message"></span>
                </div>

                

                <div class="form-group gst-section">
                    <div class="form-check">

                        <input asp-for="IsInterState"
                               class="form-check-input" />

                        <label asp-for="IsInterState"
                               class="form-check-label">
                            Interstate Invoice
                        </label>

                    </div>

                    <small class="form-text">
                        Select when the client state differs from the company state.
                    </small>
                </div>

                <div class="form-group">
                    <label asp-for="DueDate" class="form-label">Due Date</label>
                    <input asp-for="DueDate" type="date" class="app-input" />
                    <span asp-validation-for="DueDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PaymentTerms" class="form-label">Payment Terms</label>
                    <input asp-for="PaymentTerms"
                           class="app-input"
                           placeholder="Ex: 30 Days" />
                    <span asp-validation-for="PaymentTerms" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="InvoiceStatus" class="form-label">Invoice Status</label>
                    <select asp-for="InvoiceStatus"
                            class="app-select">
                        <option value="Draft">Draft</option>
                        <option value="Issued">Issued</option>
                    </select>
                    <span asp-validation-for="InvoiceStatus" class="validation-message"></span>
                </div>

            </div>

            <div class="form-group mt-3">
                <label asp-for="BillingAddress" class="form-label">Billing Address</label>
                <textarea asp-for="BillingAddress"
                          class="app-input"
                          rows="3"></textarea>
                <span asp-validation-for="BillingAddress" class="validation-message"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Remarks" class="form-label">Remarks</label>
                <textarea asp-for="Remarks"
                          class="app-input"
                          rows="2"></textarea>
                <span asp-validation-for="Remarks" class="validation-message"></span>
            </div>

            <div class="form-group mt-3">
                <label class="form-label">Attachment</label>
                <input type="file"
                       name="Attachment"
                       class="app-input" />
            </div>

        </div>
    </div>

    <div class="app-card table-card">
        <div class="card-header">
            <h5 class="card-title">Invoice Items</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="app-table" id="itemTable">
                    <thead>
                        <tr>
                            <th>Item</th>
                            <th>Description</th>
                            <th>Qty</th>
                            <th>Unit</th>
                            <th>Rate</th>
                            <th class="gst-column">GST %</th>
                            <th class="gst-column">GST Amt</th>
                            <th>Amount</th>
                            <th></th>
                        </tr>
                    </thead>

                    <tbody>
                        <tr>
                            <td>
                                <input name="InvoiceDetails[0].ItemName"
                                       class="app-input" />
                            </td>

                            <td>
                                <input name="InvoiceDetails[0].Description"
                                       class="app-input" />
                            </td>

                            <td>
                                <input name="InvoiceDetails[0].Qty"
                                       class="app-input qty"
                                       type="number"
                                       step="0.01"
                                       value="1" />
                            </td>

                            <td>
                                <select name="InvoiceDetails[0].Unit"
                                        class="app-select">
                                    <option value="Service">Service</option>
                                    <option value="Hour">Hour</option>
                                    <option value="Day">Day</option>
                                    <option value="Month">Month</option>
                                    <option value="Project">Project</option>
                                    <option value="Job">Job</option>
                                    <option value="User">User</option>
                                    <option value="License">License</option>
                                    <option value="Milestone">Milestone</option>
                                </select>
                            </td>

                            <td>
                                <input name="InvoiceDetails[0].Rate"
                                       class="app-input rate"
                                       type="number"
                                       step="0.01"
                                       value="0" />
                            </td>

                            <td class="gst-column">
                                <input name="InvoiceDetails[0].GSTPercent"
                                       class="app-input gst"
                                       type="number"
                                       step="0.01"
                                       value="18" />
                            </td>

                            <td class="gst-column">
                                <input name="InvoiceDetails[0].GSTAmount"
                                       class="app-input gstAmount"
                                       readonly />
                            </td>

                            <td>
                                <input name="InvoiceDetails[0].Amount"
                                       class="app-input amount"
                                       value="0.00"
                                       readonly />
                            </td>

                            <td>
                                <button type="button"
                                        class="btn-app btn-icon btn-danger-app removeRow">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="mt-3">
                <button type="button"
                        id="btnAddRow"
                        class="btn-app btn-success-app">
                    <i class="bi bi-plus-circle"></i>
                    Add Item
                </button>
            </div>

        </div>
    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Invoice Summary</h5>
        </div>

        <div class="card-body">
            <table class="app-table">
                <tbody>
                    <tr>
                        <th>Sub Total</th>
                        <td>
                            <input asp-for="SubTotal"
                                   id="SubTotal"
                                   class="app-input"
                                   readonly />
                        </td>
                    </tr>

                    <tr>
                        <th>Discount</th>
                        <td>
                            <input asp-for="Discount"
                                   id="Discount"
                                   class="app-input"
                                   value="0" />
                        </td>
                    </tr>

                    <tr class="gst-summary-row">
                        <th>GST</th>
                        <td>
                            <input asp-for="GSTAmount"
                                   id="GSTAmount"
                                   class="app-input"
                                   readonly />
                        </td>
                    </tr>

                    <tr>
                        <th>Grand Total</th>
                        <td>
                            <input asp-for="GrandTotal"
                                   id="GrandTotal"
                                   class="app-input"
                                   readonly />
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="app-card">
        <div class="card-body">
            <button type="submit"
                    class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Save Invoice
            </button>

            <button type="submit"
                    name="action"
                    value="SavePrint"
                    class="btn-app btn-success-app">
                <i class="bi bi-printer"></i>
                Save & Print
            </button>

            <button type="reset"
                    class="btn-app btn-secondary-app">
                <i class="bi bi-arrow-counterclockwise"></i>
                Reset
            </button>

            <a asp-action="Index"
               class="btn-app btn-secondary-app">
                <i class="bi bi-x-circle"></i>
                Cancel
            </a>
        </div>
    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(function () {

            var rowIndex =
                $("#itemTable tbody tr").length;

            function isProforma() {
                return $("#InvoiceType").val() ===
                    "Proforma Invoice";
            }

            function updateInvoiceTypeUI() {
                var proforma = isProforma();

                $(".gst-section").toggle(!proforma);
                $(".gst-column").toggle(!proforma);
                $(".gst-summary-row").toggle(!proforma);

                if (proforma) {
                    $("#IsInterState").prop(
                        "checked",
                        false);

                    $(".gst").val("0");
                    $(".gstAmount").val("0.00");
                    $("#GSTAmount").val("0.00");
                } else {
                    $(".gst").each(function () {
                        var currentValue =
                            parseFloat($(this).val()) || 0;

                        if (currentValue === 0) {
                            $(this).val("18");
                        }
                    });
                }

                calculateTotals();
            }

            $("#InvoiceType").on(
                "change",
                updateInvoiceTypeUI);

            $("#ClientId").change(function () {
                var selectedOption =
                    $(this).find("option:selected");

                var gstNo =
                    selectedOption.data("gst") || "";

                var billingAddress =
                    selectedOption.data("address") || "";

                $("#GSTNo").val(gstNo);
                $("#BillingAddress").val(
                    billingAddress);
            });

            $("#btnAddRow").click(function () {

                var defaultGst =
                    isProforma() ? 0 : 18;

                var gstDisplay =
                    isProforma()
                        ? "display:none;"
                        : "";

                var html = `
                    <tr>
                        <td>
                            <input name="InvoiceDetails[${rowIndex}].ItemName"
                                   class="app-input" />
                        </td>

                        <td>
                            <input name="InvoiceDetails[${rowIndex}].Description"
                                   class="app-input" />
                        </td>

                        <td>
                            <input name="InvoiceDetails[${rowIndex}].Qty"
                                   class="app-input qty"
                                   type="number"
                                   step="0.01"
                                   value="1" />
                        </td>

                        <td>
                            <select name="InvoiceDetails[${rowIndex}].Unit"
                                    class="app-select">

                                <option value="Service">Service</option>
                                <option value="Hour">Hour</option>
                                <option value="Day">Day</option>
                                <option value="Month">Month</option>
                                <option value="Project">Project</option>
                                <option value="Job">Job</option>
                                <option value="User">User</option>
                                <option value="License">License</option>
                                <option value="Milestone">Milestone</option>

                            </select>
                        </td>

                        <td>
                            <input name="InvoiceDetails[${rowIndex}].Rate"
                                   class="app-input rate"
                                   type="number"
                                   step="0.01"
                                   value="0" />
                        </td>

                        <td class="gst-column"
                            style="${gstDisplay}">

                            <input name="InvoiceDetails[${rowIndex}].GSTPercent"
                                   class="app-input gst"
                                   type="number"
                                   step="0.01"
                                   value="${defaultGst}" />
                        </td>

                        <td class="gst-column"
                            style="${gstDisplay}">

                            <input name="InvoiceDetails[${rowIndex}].GSTAmount"
                                   class="app-input gstAmount"
                                   value="0.00"
                                   readonly />
                        </td>

                        <td>
                            <input name="InvoiceDetails[${rowIndex}].Amount"
                                   class="app-input amount"
                                   value="0.00"
                                   readonly />
                        </td>

                        <td>
                            <button type="button"
                                    class="btn-app btn-icon btn-danger-app removeRow">

                                <i class="bi bi-trash"></i>

                            </button>
                        </td>
                    </tr>`;

                $("#itemTable tbody").append(html);

                rowIndex++;
                calculateTotals();
            });

            $(document).on(
                "click",
                ".removeRow",
                function () {

                    if ($("#itemTable tbody tr").length > 1) {
                        $(this).closest("tr").remove();

                        reIndex();
                        calculateTotals();
                    }
                });

            $(document).on(
                "keyup change",
                ".qty,.rate,.gst,#Discount",
                calculateTotals);

            function reIndex() {
                $("#itemTable tbody tr").each(
                    function (index) {

                        $(this)
                            .find("input, select")
                            .each(function () {

                                var name =
                                    $(this).attr("name");

                                if (name) {
                                    name = name.replace(
                                        /InvoiceDetails\[\d+\]/,
                                        "InvoiceDetails[" +
                                        index +
                                        "]");

                                    $(this).attr(
                                        "name",
                                        name);
                                }
                            });
                    });

                rowIndex =
                    $("#itemTable tbody tr").length;
            }

            function calculateTotals() {
                var subTotal = 0;
                var gstTotal = 0;
                var proforma = isProforma();

                $("#itemTable tbody tr").each(
                    function () {

                        var row = $(this);

                        var qty =
                            parseFloat(
                                row.find(".qty").val()) || 0;

                        var rate =
                            parseFloat(
                                row.find(".rate").val()) || 0;

                        var gstPercent =
                            proforma
                                ? 0
                                : parseFloat(
                                    row.find(".gst").val()) || 0;

                        var taxableAmount =
                            qty * rate;

                        var gstAmount =
                            taxableAmount *
                            gstPercent / 100;

                        if (proforma) {
                            row.find(".gst").val("0");
                        }

                        row.find(".gstAmount")
                            .val(gstAmount.toFixed(2));

                        /*
                         * Amount contains taxable amount only.
                         * GST is stored separately.
                         */
                             row.find(".amount").val(taxableAmount.toFixed(2));

                        subTotal += taxableAmount;
                        gstTotal += gstAmount;
                    });

                var discount =
                    parseFloat(
                        $("#Discount").val()) || 0;

                if (discount < 0) {
                    discount = 0;
                }

                if (discount > subTotal) {
                    discount = subTotal;
                }

                var grandTotal =
                    subTotal -
                    discount +
                    (proforma ? 0 : gstTotal);

                $("#SubTotal")
                    .val(subTotal.toFixed(2));

                $("#GSTAmount")
                    .val(
                        proforma
                            ? "0.00"
                            : gstTotal.toFixed(2));

                $("#GrandTotal")
                    .val(grandTotal.toFixed(2));
            }

            updateInvoiceTypeUI();
        });
                $("#PurchaseWorkOrderId").on("change", function () {
            var orderId = $(this).val();

            if (!orderId) {
                return;
            }

            $.get(
                '@Url.Action("GetPurchaseOrderDetails", "Invoice")',
                { id: orderId },
                function (data) {
                    $("#ClientId").val(data.clientId);
                    $("#ProposalId").val(data.proposalId || "");
                    $("#DueDate").val(
                        data.deliveryDueDate
                            ? data.deliveryDueDate.substring(0, 10)
                            : ""
                    );

                    if (data.remarks) {
                        $("#Remarks").val(data.remarks);
                    }
                }
            ).fail(function () {
                alert("Purchase Order details could not be loaded.");
            });
        });
    </script>
}
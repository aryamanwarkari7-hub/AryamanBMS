@model AryamanBMS.Models.InvoiceModel

@{
    ViewData["Title"] = "Invoice Details";

    string StatusBadge(string status) => status switch
    {
        "Paid" => "badge-success",
        "Partially Paid" => "badge-warning",
        "Cancelled" => "badge-danger",
        "Draft" => "badge-secondary",
        "Generated" => "badge-info",
        "Sent" => "badge-primary",
        "Issued" => "badge-success",
        "Overdue" => "badge-danger",
        _ => "badge-secondary"
    };

    bool isProforma = Model.InvoiceType == "Proforma Invoice";
    bool isExportUnderLut = Model.TaxTreatment == "ExportUnderLUT";

    bool hideGstColumns = isProforma || isExportUnderLut;
    bool hasDocx = ViewBag.CurrentDocx is bool docx && docx;
    bool hasPdf = ViewBag.CurrentPdf is bool pdf && pdf;

    string taxType = Model.IsInterState
        ? "Interstate - IGST"
        : "Intrastate - CGST + SGST";
}

<div class="module-header">
    <div>
        <h1 class="module-title">@Model.InvoiceNo</h1>
        <p class="module-subtitle">
            Invoice details, billing items, tax summary and document actions
        </p>
    </div>

    <div class="module-header-actions">
        <form asp-action="GenerateDocuments"
              asp-route-id="@Model.InvoiceId"
              method="post"
              class="d-inline">
            @Html.AntiForgeryToken()

            <button type="submit" class="btn-app btn-success-app">
                <i class="bi bi-file-earmark-plus"></i>
                @(hasDocx || hasPdf ? "Regenerate Documents" : "Generate Documents")
            </button>
        </form>

        @if (hasDocx)
        {
            <a asp-action="DownloadCurrentDocument"
               asp-route-id="@Model.InvoiceId"
               asp-route-format="DOCX"
               class="btn-app btn-primary-app">
                <i class="bi bi-file-earmark-word"></i>
                Download DOCX
            </a>
        }

        @if (hasPdf)
        {
            <a asp-action="DownloadCurrentDocument"
               asp-route-id="@Model.InvoiceId"
               asp-route-format="PDF"
               class="btn-app btn-danger-app">
                <i class="bi bi-file-earmark-pdf"></i>
                Download PDF
            </a>
        }

        <a asp-action="DocumentHistory"
           asp-route-id="@Model.InvoiceId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-clock-history"></i>
            Document History
        </a>

        <a asp-action="Print"
           asp-route-id="@Model.InvoiceId"
           class="btn-app btn-success-app">
            <i class="bi bi-printer"></i>
            Preview / Print
        </a>

        @if (Model.InvoiceStatus == "Draft")
        {
            <form asp-action="Issue"
                  asp-route-id="@Model.InvoiceId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-app btn-success-app"
                        data-confirm="Issue this invoice? It will no longer be freely editable.">
                    <i class="bi bi-send"></i>
                    Issue Invoice
                </button>
            </form>

            <a asp-action="Edit"
               asp-route-id="@Model.InvoiceId"
               class="btn-app btn-primary-app">
                <i class="bi bi-pencil"></i>
                Edit Invoice
            </a>
        }

        @if (Model.InvoiceStatus != "Cancelled" && Model.PaymentStatus != "Paid")
        {
            <a asp-action="Cancel"
               asp-route-id="@Model.InvoiceId"
               class="btn-app btn-danger-app">
                <i class="bi bi-x-circle"></i>
                Cancel Invoice
            </a>
        }

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Invoice Status</div>
            <div class="detail-summary-value">
                <span class="@StatusBadge(Model.InvoiceStatus)">
                    @Model.InvoiceStatus
                </span>
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Payment Status</div>
            <div class="detail-summary-value">
                <span class="@StatusBadge(Model.PaymentStatus)">
                    @Model.PaymentStatus
                </span>
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Grand Total</div>
            <div class="detail-summary-value">
                ₹ @Model.GrandTotal.ToString("N2")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Balance</div>
            <div class="detail-summary-value">
                ₹ @Model.BalanceAmount.ToString("N2")
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Invoice Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Invoice No</span>
                        <strong class="detail-info-value">@Model.InvoiceNo</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Invoice Type</span>
                        <strong class="detail-info-value">
                            <span class="badge-info">@Model.InvoiceType</span>
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Invoice Date</span>
                        <strong class="detail-info-value">
                            @Model.InvoiceDate.ToString("dd-MMM-yyyy")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Due Date</span>
                        <strong class="detail-info-value">
                            @(Model.DueDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Client</span>
                        <strong class="detail-info-value">
                            @(Model.Client?.ClientName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Project</span>
                        <strong class="detail-info-value">
                            @(Model.ProjectName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Payment Terms</span>
                        <strong class="detail-info-value">
                            @(Model.PaymentTerms ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">GST and Billing</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    @if (isExportUnderLut)
                    {
                        <div class="detail-info-row">
                            <span class="detail-info-label">Tax Treatment</span>
                            <strong class="detail-info-value">
                                <span class="badge-info">Export under LUT</span>
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Customer Country</span>
                            <strong class="detail-info-value">
                                @(Model.CustomerCountryName ?? "-")
                                (@(Model.CustomerCountryIso2Code ?? "-"))
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">LUT Reference</span>
                            <strong class="detail-info-value">
                                @(Model.LutReference ?? "-")
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Export Declaration</span>
                            <strong class="detail-info-value">
                                Supply meant for export under Letter of Undertaking
                                without payment of integrated tax.
                            </strong>
                        </div>
                    }
                    else if (!isProforma)
                    {
                        <div class="detail-info-row">
                            <span class="detail-info-label">GST No</span>
                            <strong class="detail-info-value">
                                @(Model.GSTNo ?? "-")
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Tax Type</span>
                            <strong class="detail-info-value">@taxType</strong>
                        </div>
                    }

                    @if (!isProforma)
                    {
                        <div class="detail-info-row">
                            <span class="detail-info-label">SAC Code</span>
                            <strong class="detail-info-value">
                                @(Model.SACCode ?? "-")
                            </strong>
                        </div>
                    }

                    <div class="detail-info-row">
                        <span class="detail-info-label">Billing Address</span>
                        <strong class="detail-info-value">
                            @(string.IsNullOrWhiteSpace(Model.BillingAddress) ? "-" : Model.BillingAddress)
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Remarks</span>
                        <strong class="detail-info-value">
                            @(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card table-card">
        <div class="card-header">
            <h5 class="card-title">Invoice Items</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Item</th>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th>Unit</th>
                            <th class="text-end">Rate</th>

                            @if (!hideGstColumns)
                            {
                                <th class="text-end">GST %</th>
                                <th class="text-end">GST Amount</th>
                            }

                            <th class="text-end">Amount</th>
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int sr = 1;
                        }

                        @if (Model.InvoiceDetails.Any())
                        {
                            foreach (var item in Model.InvoiceDetails)
                            {
                                <tr>
                                    <td>@sr</td>
                                    <td>@item.ItemName</td>
                                    <td>@item.Description</td>
                                    <td class="text-end">@item.Qty.ToString("N2")</td>
                                    <td>@item.Unit</td>
                                    <td class="text-end">@item.Rate.ToString("N2")</td>

                                    @if (!hideGstColumns)
                                    {
                                        <td class="text-end">@item.GSTPercent.ToString("N2")</td>
                                        <td class="text-end">@item.GSTAmount.ToString("N2")</td>
                                    }

                                    <td class="text-end">@item.Amount.ToString("N2")</td>
                                </tr>

                                sr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="@(hideGstColumns ? 7 : 9)" class="empty-state">
                                    No invoice items found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Invoice Summary</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Sub Total</span>
                        <strong class="detail-info-value">
                            ₹ @Model.SubTotal.ToString("N2")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Discount</span>
                        <strong class="detail-info-value">
                            ₹ @Model.Discount.ToString("N2")
                        </strong>
                    </div>

                    @if (!hideGstColumns)
                    {
                        if (Model.IsInterState)
                        {
                            <div class="detail-info-row">
                                <span class="detail-info-label">IGST</span>
                                <strong class="detail-info-value">
                                    ₹ @Model.GSTAmount.ToString("N2")
                                </strong>
                            </div>
                        }
                        else
                        {
                            <div class="detail-info-row">
                                <span class="detail-info-label">CGST</span>
                                <strong class="detail-info-value">
                                    ₹ @((Model.GSTAmount / 2).ToString("N2"))
                                </strong>
                            </div>

                            <div class="detail-info-row">
                                <span class="detail-info-label">SGST</span>
                                <strong class="detail-info-value">
                                    ₹ @((Model.GSTAmount / 2).ToString("N2"))
                                </strong>
                            </div>
                        }
                    }

                    <div class="detail-info-row">
                        <span class="detail-info-label">Grand Total</span>
                        <strong class="detail-info-value">
                            ₹ @Model.GrandTotal.ToString("N2")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Payment Summary</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Paid Amount</span>
                        <strong class="detail-info-value">
                            <span class="badge-success">
                                ₹ @Model.PaidAmount.ToString("N2")
                            </span>
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Balance</span>
                        <strong class="detail-info-value">
                            <span class="badge-danger">
                                ₹ @Model.BalanceAmount.ToString("N2")
                            </span>
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Payment Status</span>
                        <strong class="detail-info-value">
                            <span class="@StatusBadge(Model.PaymentStatus)">
                                @Model.PaymentStatus
                            </span>
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.AttachmentPath))
    {
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Attachment</h5>
            </div>

            <div class="card-body">
                <a asp-action="DownloadAttachment"
                   asp-route-id="@Model.InvoiceId"
                   class="btn-app btn-primary-app">
                    <i class="bi bi-paperclip"></i>
                    Download Attachment
                </a>
            </div>
        </div>
    }

</div>
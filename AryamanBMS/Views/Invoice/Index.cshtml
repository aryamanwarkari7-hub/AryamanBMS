@model AryamanBMS.Models.InvoiceTrackerViewModel

@{
    ViewData["Title"] = "Invoice Tracker";

    string currentSearch = Context.Request.Query["search"];
    string currentClientId = Context.Request.Query["clientId"];
    string currentInvoiceStatus =
        Context.Request.Query["invoiceStatus"];
    string currentPaymentStatus =
        Context.Request.Query["paymentStatus"];
}

<div class="module-header">

    <div>
        <h1 class="module-title">Invoice Tracker</h1>
        <p class="module-subtitle">
            Manage invoice generation, payment status and balances
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            New Invoice
        </a>
    </div>

</div>

<div class="dashboard-grid">

    <div class="stats-card">
        <div class="stats-label">Total Invoices</div>
        <div class="stats-number">
            @Model.TotalInvoices
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Invoice Amount</div>
        <div class="stats-number">
            ₹ @Model.TotalInvoiceAmount.ToString("N2")
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Amount Received</div>
        <div class="stats-number">
            ₹ @Model.TotalReceivedAmount.ToString("N2")
        </div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Outstanding</div>
        <div class="stats-number">
            ₹ @Model.TotalOutstandingAmount.ToString("N2")
        </div>
    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Filters</h5>
    </div>

    <div class="card-body">

        <form method="get">

            <div class="form-grid-3">

                <div class="form-group">
                    <input type="text"
                           name="search"
                           value="@currentSearch"
                           class="app-input"
                           placeholder="Invoice, client or project" />
                </div>

                <div class="form-group">
                    <select name="clientId"
                            class="app-select">

                        <option value="">All Clients</option>

                        @foreach (var client in Model.Clients)
                        {
                            <option value="@client.ClientId"
                                    selected="@(currentClientId == client.ClientId.ToString())">
                                @client.ClientName
                            </option>
                        }

                    </select>
                </div>

                <div class="form-group">
                    <select name="invoiceStatus"
                            class="app-select">

                        <option value="">All Invoice Statuses</option>

                        <option value="Draft"
                                selected="@(currentInvoiceStatus == "Draft")">
                            Draft
                        </option>

                        <option value="Issued"
                                selected="@(currentInvoiceStatus == "Issued")">
                            Issued
                        </option>

                        <option value="Cancelled"
                                selected="@(currentInvoiceStatus == "Cancelled")">
                            Cancelled
                        </option>

                    </select>
                </div>

                <div class="form-group">
                    <select name="paymentStatus"
                            class="app-select">

                        <option value="">All Payment Statuses</option>

                        <option value="Unpaid"
                                selected="@(currentPaymentStatus == "Unpaid")">
                            Unpaid
                        </option>

                        <option value="Partially Paid"
                                selected="@(currentPaymentStatus == "Partially Paid")">
                            Partially Paid
                        </option>

                        <option value="Paid"
                                selected="@(currentPaymentStatus == "Paid")">
                            Paid
                        </option>

                    </select>
                </div>

                <div class="form-group">
                    <button type="submit"
                            class="btn-app btn-primary-app w-100">
                        <i class="bi bi-search"></i>
                        Apply
                    </button>
                </div>

                <div class="form-group">
                    <a asp-action="Index"
                       class="btn-app btn-secondary-app w-100">
                        Reset
                    </a>
                </div>

            </div>

        </form>

    </div>

</div>

<div class="app-card table-card">
    <div class="card-header">
        <h5 class="card-title">Invoices</h5>
    </div>
    <div class="card-body table-responsive">


        <table class="app-table"
               id="invoiceTable">


            <thead>

                <tr>

                    <th>Invoice No</th>

                    <th>Date</th>

                    <th>Client</th>

                    <th>Project</th>

                    <th>Amount</th>

                    <th>Paid</th>

                    <th>Balance</th>

                    <th>Invoice Status</th>

                    <th>Payment Status</th>

                    <th>Action</th>

                </tr>

            </thead>






            <tbody>


                @foreach (var item in Model.Invoices)
                {

                    <tr>


                        <td>
                            @item.InvoiceNo
                        </td>


                        <td>
                            @item.InvoiceDate.ToString("dd-MMM-yyyy")
                        </td>



                        <td>
                            @(item.Client?.ClientName ?? "-")
                        </td>




                        <td>
                            @item.ProjectName
                        </td>



                        <td>
                            @item.GrandTotal.ToString("N2")
                        </td>



                        <td>
                            @item.PaidAmount.ToString("N2")
                        </td>

                        <td>
                            @item.BalanceAmount.ToString("N2")
                        </td>

                        <td>
                            @if (item.InvoiceStatus == "Issued")
                            {
                                <span class="badge-success">Issued</span>
                            }
                            else if (item.InvoiceStatus == "Cancelled")
                            {
                                <span class="badge-danger">Cancelled</span>
                            }
                            else
                            {
                                <span class="badge-warning">Draft</span>
                            }
                        </td>

                        <td>
                            @if (item.PaymentStatus == "Paid")
                            {
                                <span class="badge-success">Paid</span>
                            }
                            else if (item.PaymentStatus == "Partially Paid")
                            {
                                <span class="badge-warning">
                                    Partially Paid
                                </span>
                            }
                            else
                            {
                                <span class="badge-danger">Unpaid</span>
                            }
                        </td>





                        <td>

                            <div class="table-actions">
                            <a asp-action="Details"
                               asp-route-id="@item.InvoiceId"
                               class="btn-app btn-icon btn-primary-app">

                                <i class="bi bi-eye"></i>

                            </a>

                            
                            @if (item.InvoiceStatus != "Cancelled" &&
                            
                            item.PaymentStatus != "Paid")
                            
                            {
                                <a asp-action="Edit"
                                   asp-route-id="@item.InvoiceId"
                                   class="btn-app btn-icon btn-secondary-app">
                                
                                    <i class="bi bi-pencil"></i>
                                
                                </a>
                             }

                            @if (item.InvoiceStatus != "Cancelled" &&
                                                        item.PaidAmount == 0)
                            {
                                <a asp-action="Delete"
                                   asp-route-id="@item.InvoiceId"
                                   class="btn-app btn-icon btn-danger-app"
                                   title="Cancel Invoice">
                                    <i class="bi bi-x-circle"></i>
                                </a>
                            }



                            <a asp-action="Print"
                               asp-route-id="@item.InvoiceId"
                               class="btn-app btn-icon btn-success-app">

                                <i class="bi bi-printer"></i>

                            </a>
                            </div>


                        </td>


                    </tr>

                }


            </tbody>


        </table>


    </div>


</div>


@model AryamanBMS.ViewModels.CompOffRequestViewModel

@{
    ViewData["Title"] = "Request Comp Off";
}

<div class="module-header">
    <div>
        <h1 class="module-title">
            Request Comp Off
        </h1>

        <p class="module-subtitle">
            Request Comp Off for approved work completed on a Holiday or Weekly Off.
        </p>
    </div>

    <a asp-controller="Attendance"
       asp-action="Index"
       class="btn-app btn-secondary-app">

        <i class="bi bi-arrow-left"></i>
        Back

    </a>
</div>


<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">
            Comp Off Request Information
        </h5>
    </div>

    <div class="card-body">

        <form asp-action="Request"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3">
            </div>

            <div class="row g-3">

                <div class="col-md-6">

                    <label asp-for="WorkedDate"
                           class="form-label">
                        Worked Date
                    </label>

                    <select asp-for="WorkedDate"
                            class="app-select">

                        @foreach (var attendance in ViewBag.EligibleAttendances)
                        {
                            <option value="@attendance.AttendanceDate.ToString("yyyy-MM-dd")">
                                @attendance.AttendanceDate.ToString("dd-MMM-yyyy")
                                -
                                @(attendance.OffDayType == "H"
                                    ? "Holiday"
                                    : "Weekly Off")
                                -
                                @attendance.WorkingHours.ToString("0.##") hrs
                            </option>
                        }

                    </select>

                    <span asp-validation-for="WorkedDate"
                          class="text-danger">
                    </span>

                    <small class="text-muted">
                        Only completed Holiday and Weekly Off work is shown.
                    </small>

                </div>

                <div class="col-md-6">

                    <label asp-for="CreditDays"
                           class="form-label">
                    </label>

                    <select asp-for="CreditDays"
                            class="app-select">

                        <option value="1.0">
                            Full Day
                        </option>

                        <option value="0.5">
                            Half Day
                        </option>

                    </select>

                    <span asp-validation-for="CreditDays"
                          class="text-danger">
                    </span>

                </div>

                <div class="col-12">

                    <div class="app-card mt-2">

                        <div class="card-header">
                            <h5 class="card-title">
                                Worked Attendance
                            </h5>
                        </div>

                        <div class="card-body">

                            <div class="profile-stack">

                                <div class="profile-info-row">
                                    <span>
                                        <i class="bi bi-calendar"></i>
                                        Off-Day Type
                                    </span>

                                    <strong id="offDayTypeDisplay">
                                        @(Model.OffDayType == "H"
                                            ? "Holiday"
                                            : Model.OffDayType == "WO"
                                                ? "Weekly Off"
                                                : "-")
                                    </strong>
                                </div>

                                <div class="profile-info-row">
                                    <span>
                                        <i class="bi bi-box-arrow-in-right"></i>
                                        Check In
                                    </span>

                                    <strong id="checkInDisplay">
                                        @(Model.CheckInTime.HasValue
                                            ? Model.CheckInTime.Value.ToString("hh:mm tt")
                                            : "-")
                                    </strong>
                                </div>

                                <div class="profile-info-row">
                                    <span>
                                        <i class="bi bi-box-arrow-right"></i>
                                        Check Out
                                    </span>

                                    <strong id="checkOutDisplay">
                                        @(Model.CheckOutTime.HasValue
                                            ? Model.CheckOutTime.Value.ToString("hh:mm tt")
                                            : "-")
                                    </strong>
                                </div>

                                <div class="profile-info-row">
                                    <span>
                                        <i class="bi bi-hourglass-split"></i>
                                        Working Hours
                                    </span>

                                    <strong id="workingHoursDisplay">
                                        @Model.WorkingHours.ToString("0.##") hrs
                                    </strong>
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <div class="col-12">

                    <label asp-for="Remarks"
                           class="form-label">
                    </label>

                    <textarea asp-for="Remarks"
                              class="app-input"
                              rows="4"
                              maxlength="500"
                              placeholder="Describe the work performed and why Comp Off is requested">
                    </textarea>

                    <span asp-validation-for="Remarks"
                          class="text-danger">
                    </span>

                </div>

            </div>

            <div class="d-flex gap-2 mt-4">

                <button type="submit"
                        class="btn-app btn-primary-app">

                    <i class="bi bi-send"></i>
                    Submit Request

                </button>

                <a asp-controller="Attendance"
                   asp-action="Index"
                   class="btn-app btn-secondary-app">

                    Cancel

                </a>

            </div>

        </form>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        const eligibleAttendances = @Html.Raw(
                                    System.Text.Json.JsonSerializer.Serialize(
                                            ((IEnumerable<AryamanBMS.Models.AttendanceModel>)
                                                    ViewBag.EligibleAttendances)
                                                    .Select(x => new
                                    {
                                                            date = x.AttendanceDate.ToString("yyyy-MM-dd"),

                                                            offDayType = x.OffDayType,

                                                            checkIn = x.CheckInTime.HasValue
                    ? x.CheckInTime.Value.ToString("hh:mm tt")
                    : "-",

                                                            checkOut = x.CheckOutTime.HasValue
                    ? x.CheckOutTime.Value.ToString("hh:mm tt")
                    : "-",

                                                            workingHours = x.WorkingHours
                                    })
                    )
                    );

        const workedDateSelect =
            document.getElementById("WorkedDate");

        const offDayTypeDisplay =
            document.getElementById("offDayTypeDisplay");

        const checkInDisplay =
            document.getElementById("checkInDisplay");

        const checkOutDisplay =
            document.getElementById("checkOutDisplay");

        const workingHoursDisplay =
            document.getElementById("workingHoursDisplay");

        function updateAttendanceDetails() {

            const selectedDate =
                workedDateSelect.value;

            const attendance =
                eligibleAttendances.find(
                    x => x.date === selectedDate
                );

            if (!attendance) {
                offDayTypeDisplay.textContent = "-";
                checkInDisplay.textContent = "-";
                checkOutDisplay.textContent = "-";
                workingHoursDisplay.textContent = "-";
                return;
            }

            offDayTypeDisplay.textContent =
                attendance.offDayType === "H"
                    ? "Holiday"
                    : attendance.offDayType === "WO"
                        ? "Weekly Off"
                        : "-";

            checkInDisplay.textContent =
                attendance.checkIn;

            checkOutDisplay.textContent =
                attendance.checkOut;

            workingHoursDisplay.textContent =
                Number(attendance.workingHours)
                    .toFixed(2) + " hrs";
        }

        workedDateSelect.addEventListener(
            "change",
            updateAttendanceDetails
        );

        updateAttendanceDetails();
    </script>
}
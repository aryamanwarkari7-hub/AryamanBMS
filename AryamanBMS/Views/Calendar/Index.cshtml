@{
    ViewData["Title"] = "Calendar";
}

<link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.css" rel="stylesheet" />

<div class="module-header">
    <div>
        <h1 class="module-title">Calendar</h1>
        <p class="module-subtitle">
            Leaves, task deadlines, and scheduled meetings in one view.
        </p>
    </div>

    <div class="module-header-meta">
        <span class="module-meta-pill info">
            <i class="bi bi-calendar3"></i>
            My Schedule
        </span>
    </div>
</div>

<div class="app-card calendar-card">
    <div class="card-header">
        <div class="card-heading">
            <h2 class="card-title">Work Calendar</h2>
            <p class="card-subtitle">Track upcoming leave, meetings, and task dates.</p>
        </div>

        <div class="calendar-filter-bar" data-calendar-filters>
            <button type="button" class="calendar-filter active" data-filter="All">
                <i class="calendar-dot all"></i>
                All
            </button>

            <button type="button" class="calendar-filter active" data-filter="Holiday">
                <i class="calendar-dot holiday"></i>
                Holiday
            </button>

            <button type="button"
                    class="calendar-filter active"
                    data-filter="Birthday">
                <i class="calendar-dot birthday"></i>
                Birthday
            </button>

            <button type="button"
                    class="calendar-filter active"
                    data-filter="WeeklyOff">
                <i class="calendar-dot weekly-off"></i>
                Weekly Off
            </button>

            <button type="button" class="calendar-filter active" data-filter="Leave">
                <i class="calendar-dot leave"></i>
                Leave
            </button>

            <button type="button" class="calendar-filter active" data-filter="Attendance">
                <i class="calendar-dot attendance"></i>
                Attendance
            </button>

            <button type="button" class="calendar-filter active" data-filter="Task">
                <i class="calendar-dot task"></i>
                Task
            </button>

            <button type="button" class="calendar-filter active" data-filter="Meeting">
                <i class="calendar-dot meeting"></i>
                Meeting
            </button>

            <button type="button" class="calendar-filter active" data-filter="Billing">
                <i class="calendar-dot billing"></i>
                Billing
            </button>
        </div>
    </div>

    <div class="card-body">
        <div class="calendar-shell">
            <div id="employeeCalendar"
                 data-personal-only="@(ViewBag.PersonalOnly == true ? "true" : "false")"></div>
        </div>
    </div>
</div>

@if (User.IsInRole("Admin") || User.IsInRole("HR") || User.IsInRole("Master"))
{
    <div class="modal fade" id="calendarManualEventModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content calendar-modal">
                <form id="calendarManualEventForm" method="post" action="javascript:void(0);">
                    @Html.AntiForgeryToken()

                    <div class="modal-header">
                        <div>
                            <h5 class="modal-title" id="calendarManualEventModalTitle">Calendar Event</h5>
                            <p class="calendar-modal-subtitle">Create or update a manual calendar event.</p>
                        </div>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Close">
                        </button>
                    </div>

                    <div class="modal-body">
                        <input type="hidden" id="manualEventId" name="Id" />

                        <div class="form-group">
                            <label class="form-label" for="manualEventTitle">Title</label>
                            <input type="text"
                                   class="app-input"
                                   id="manualEventTitle"
                                   name="Title"
                                   maxlength="160"
                                   required />
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="manualEventDescription">Description</label>
                            <textarea class="app-input"
                                  id="manualEventDescription"
                                  name="Description"
                                  maxlength="1000"
                                  rows="3">
                            </textarea>
                        </div>

                        <div class="form-group">
                            <label class="form-label" for="manualEventType">Type</label>
                            <select class="app-input" id="manualEventType" name="EventType">
                                <option value="Manual">Manual</option>
                                <option value="Reminder">Reminder</option>
                                <option value="Training">Training</option>
                                <option value="Review">Review</option>
                                <option value="Company Event">Company Event</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-check d-flex align-items-center gap-2 m-0">
                                <input type="checkbox"
                                       class="form-check-input"
                                       id="manualEventIsAllDay"
                                       name="IsAllDay"
                                       value="true" />
                                <span class="form-check-label">All day</span>
                            </label>
                            <input type="hidden" name="IsAllDay" value="false" />
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label" for="manualEventStart">Start</label>
                                    <input type="datetime-local"
                                           class="app-input"
                                           id="manualEventStart"
                                           name="StartDateTime"
                                           required />
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="form-group">
                                    <label class="form-label" for="manualEventEnd">End</label>
                                    <input type="datetime-local"
                                           class="app-input"
                                           id="manualEventEnd"
                                           name="EndDateTime" />
                                </div>
                            </div>
                        </div>

                        <input type="hidden"
                               id="manualEventVisibilityScope"
                               name="VisibilityScope"
                               value="All" />

                        <div class="calendar-modal-error" id="calendarManualEventError"></div>
                    </div>

                    <div class="modal-footer">
                        <button type="button"
                                class="btn-app btn-danger-app d-none"
                                id="calendarDeleteManualEventButton">
                            <i class="bi bi-trash"></i>
                            Delete
                        </button>

                        <button type="button"
                                class="btn-app btn-secondary-app"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="btn-app btn-primary-app">
                            <i class="bi bi-save"></i>
                            Save
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.15/index.global.min.js"></script>
    <script src="~/js/calendar.js" asp-append-version="true"></script>
}

@model IEnumerable<AryamanBMS.Models.LeaveTypeModel>

@{
    ViewData["Title"] = "Leave Types";

    var isMaster = User.IsInRole("Master");
}
<div class="module-header">

    <div>
        <h1 class="module-title">
            Leave Types
        </h1>

        <p class="module-subtitle">
            Manage leave policies
        </p>
    </div>

    @if (!isMaster)
    {
        <a asp-action="Create" class="btn-app btn-primary-app">

            <i class="bi bi-plus-lg"></i>
            Add Leave Type

        </a>
    }

</div>

<div class="app-card">

    <div class="card-body">

        <form asp-action="Index" method="get" class="filter-form-row">

            <div class="form-group">
                <label class="form-label">Search</label>
                <input type="text" name="searchText" value="@ViewBag.SearchText" class="app-input"
                       placeholder="Leave code or name" />
            </div>

            <div class="form-group">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="app-select">
                    <option value="LeaveName" selected="@(ViewBag.SortBy == "LeaveName")">Leave Name</option>
                    <option value="LeaveCode" selected="@(ViewBag.SortBy == "LeaveCode")">Leave Code</option>
                    <option value="Status" selected="@(ViewBag.SortBy == "Status")">Status</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Order</label>
                <select name="sortOrder" class="app-select">
                    <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Ascending</option>
                    <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Descending</option>
                </select>
            </div>

            <div class="filter-form-actions">
                <button type="submit" class="btn-app btn-primary-app">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index" class="btn-app btn-secondary-app">
                    <i class="bi bi-arrow-clockwise"></i>
                    Reset
                </a>
            </div>

        </form>
    </div>
</div>

<div class="app-card table-card">

    <div class="card-body">

        <div class="app-alert-info mb-3">
            Leave types are categories only. Paid leave eligibility is calculated from the annual 18-day financial-year
            pool.
        </div>

        <div class="table-responsive">

            <table class="app-table" id="leaveTypeTable">

                <thead>

                    <tr>
                        <th>Code</th>
                        <th>Name</th>

                        <th>Carry Forward</th>

                        <th>Status</th>
                        @if (!isMaster)
                        {
                            <th>Actions</th>
                        }
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.LeaveCode</td>

                            <td>@item.LeaveName</td>

                        

                            <td>
                                @(item.IsCarryForward ? "Yes" : "No")
                            </td>

                        

                            <td>

                                @if (item.IsActive)
                                {
                                    <span class="badge-success">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-danger">
                                        Inactive
                                    </span>
                                }

                            </td>

                            @if (!isMaster)
                            {
                                <td>

                                    <div class="table-actions">

                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-app btn-secondary-app btn-icon">

                                            <i class="bi bi-pencil"></i>

                                        </a>

                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-app btn-danger-app btn-icon"
                                           title="Deactivate">

                                            <i class="bi bi-trash"></i>

                                        </a>

                                    </div>

                                </td>
                            }

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts
{
    <script src="~/js/table-filter.js" asp-append-version="true"></script>
}

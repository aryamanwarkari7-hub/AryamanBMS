@model GstDashboardViewModel

@{
    ViewData["Title"] = $"GST Dashboard - {Model.FinancialYear}";

    string monthName = new System.Globalization.CultureInfo("en-US")
        .DateTimeFormat
        .GetMonthName(Model.Month);

    string GstrStatusClass(string status)
    {
        return status == "Filed" || status == "Paid"
            ? "badge-success"
            : status == "Pending"
                ? "badge-warning"
                : "badge-secondary";
    }

    string snapshotButtonText =
    Model.SnapshotStatus == "Pending"
        ? "Generate Snapshot"
        : "Regenerate Snapshot";

    bool canRegenerateSnapshot =
    Model.SnapshotStatus != "Filed";
}

<div class="module-header">

    <div>
        <h1 class="module-title">GST DASHBOARD</h1>
        <p class="module-subtitle">
            @monthName @Model.Year (FY: @Model.FinancialYear)
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<div class="dashboard-grid">

    <div class="stats-card">
        <div class="stats-label">Output GST</div>
        <div class="stats-number">₹ @Model.OutputGST.ToString("N2")</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Input GST</div>
        <div class="stats-number">₹ @Model.InputGST.ToString("N2")</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Net GST Payable</div>
        <div class="stats-number">₹ @Model.NetGSTPayable.ToString("N2")</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">ITC Carry Forward</div>
        <div class="stats-number">₹ @Model.InputCreditCarryForward.ToString("N2")</div>
    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">GST Calculation Summary</h2>
            <p class="card-subtitle">
                Output GST, input GST and net payable calculation.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="app-card">

                <div class="card-header">
                    <div>
                        <h2 class="card-title">Sales Summary</h2>
                        <p class="card-subtitle">
                            GST collected on sales invoices.
                        </p>
                    </div>
                </div>

                <div class="card-body">

                    <div class="form-grid-2">

                        <div class="form-group">
                            <label class="form-label">Taxable Amount</label>
                            <strong>₹ @Model.SalesTaxable.ToString("N2")</strong>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Output GST</label>
                            <strong>₹ @Model.OutputGST.ToString("N2")</strong>
                        </div>

                    </div>

                </div>

            </div>

            <div class="app-card">

                <div class="card-header">
                    <div>
                        <h2 class="card-title">Purchase Summary</h2>
                        <p class="card-subtitle">
                            Input tax credit from eligible expenses.
                        </p>
                    </div>
                </div>

                <div class="card-body">

                    <div class="form-grid-2">

                        <div class="form-group">
                            <label class="form-label">Input GST</label>
                            <strong>₹ @Model.InputGST.ToString("N2")</strong>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Expense Vouchers</label>
                            <strong>@Model.ExpenseVoucherCount</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Net GST Calculation</h2>
            <p class="card-subtitle">
                Final GST payable or refundable for selected period.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Output GST</label>
                <strong>₹ @Model.OutputGST.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Less: Input GST</label>
                <strong>₹ @Model.InputGST.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Net GST Payable</label>
                <strong>₹ @Model.NetGSTPayable.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">ITC Carry Forward</label>
                <strong>₹ @Model.InputCreditCarryForward.ToString("N2")</strong>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Compliance Status</h2>
            <p class="card-subtitle">
                GST return and challan status for this period.
            </p>
        </div>
    </div>

    @if (Model.SnapshotId > 0 &&
        Model.SnapshotStatus != "Filed")
    {
        <div class="app-card">

            <div class="card-header">
                <div>
                    <h2 class="card-title">Update GST Compliance</h2>
                    <p class="card-subtitle">
                        Record return filing and challan payment details.
                    </p>
                </div>
            </div>

            <div class="card-body">

                <div class="form-grid-2">

                    <div class="app-card">

                        <div class="card-header">
                            <h3 class="card-title">GSTR-1</h3>
                        </div>

                        <div class="card-body">

                            <form asp-controller="Gst"
                                  asp-action="UpdateReturn"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="snapshotId"
                                       value="@Model.SnapshotId" />

                                <input type="hidden"
                                       name="returnType"
                                       value="GSTR1" />

                                <div class="form-group">
                                    <label class="form-label">Status</label>

                                    <select name="status"
                                            class="app-select"
                                            required>
                                        <option value="Pending"
                                                selected="@(Model.Gstr1Status == "Pending")">
                                            Pending
                                        </option>

                                        <option value="Filed"
                                                selected="@(Model.Gstr1Status == "Filed")">
                                            Filed
                                        </option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">ARN Number</label>

                                    <input type="text"
                                           name="arnNumber"
                                           class="app-input"
                                           maxlength="100"
                                           value="@Model.Gstr1ArnNumber" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Filed Date</label>

                                    <input type="date"
                                           name="filedDate"
                                           class="app-input"
                                           value="@(Model.Gstr1FiledDate?.ToString("yyyy-MM-dd"))" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Remarks</label>

                                    <textarea name="remarks"
                                          class="app-textarea"
                                          maxlength="500">@Model.Gstr1Remarks</textarea>
                                </div>

                                <button type="submit"
                                        class="btn-app btn-primary-app">
                                    Save GSTR-1
                                </button>

                            </form>

                        </div>

                    </div>

                    <div class="app-card">

                        <div class="card-header">
                            <h3 class="card-title">GSTR-3B</h3>
                        </div>

                        <div class="card-body">

                            <form asp-controller="Gst"
                                  asp-action="UpdateReturn"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="snapshotId"
                                       value="@Model.SnapshotId" />

                                <input type="hidden"
                                       name="returnType"
                                       value="GSTR3B" />

                                <div class="form-group">
                                    <label class="form-label">Status</label>

                                    <select name="status"
                                            class="app-select"
                                            required>
                                        <option value="Pending"
                                                selected="@(Model.Gstr3BStatus == "Pending")">
                                            Pending
                                        </option>

                                        <option value="Filed"
                                                selected="@(Model.Gstr3BStatus == "Filed")">
                                            Filed
                                        </option>
                                    </select>
                                </div>

                                <div class="form-group">
                                    <label class="form-label">ARN Number</label>

                                    <input type="text"
                                           name="arnNumber"
                                           class="app-input"
                                           maxlength="100"
                                           value="@Model.Gstr3BArnNumber" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Filed Date</label>

                                    <input type="date"
                                           name="filedDate"
                                           class="app-input"
                                           value="@(Model.Gstr3BFiledDate?.ToString("yyyy-MM-dd"))" />
                                </div>

                                <div class="form-group">
                                    <label class="form-label">Remarks</label>

                                    <textarea name="remarks"
                                          class="app-textarea"
                                          maxlength="500">@Model.Gstr3BRemarks</textarea>
                                </div>

                                <button type="submit"
                                        class="btn-app btn-primary-app">
                                    Save GSTR-3B
                                </button>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

        </div>

        <div class="app-card">

            <div class="card-header">
                <div>
                    <h2 class="card-title">GST Challan</h2>
                    <p class="card-subtitle">
                        Record payment details for this GST period.
                    </p>
                </div>
            </div>

            <div class="card-body">

                <form asp-controller="Gst"
                      asp-action="UpdateChallan"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="snapshotId"
                           value="@Model.SnapshotId" />

                    <div class="form-grid-3">

                        <div class="form-group">
                            <label class="form-label">Challan Number</label>

                            <input type="text"
                                   name="challanNumber"
                                   class="app-input"
                                   maxlength="100"
                                   value="@Model.ChallanNumber"
                                   required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Status</label>

                            <select name="status"
                                    class="app-select"
                                    required>
                                <option value="Pending"
                                        selected="@(Model.ChallanStatus == "Pending")">
                                    Pending
                                </option>

                                <option value="Paid"
                                        selected="@(Model.ChallanStatus == "Paid")">
                                    Paid
                                </option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Amount Paid</label>

                            <input type="number"
                                   name="amountPaid"
                                   class="app-input"
                                   min="0"
                                   step="0.01"
                                   value="@Model.AmountPaid" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Payment Date</label>

                            <input type="date"
                                   name="paymentDate"
                                   class="app-input"
                                   value="@(Model.PaymentDate?.ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Payment Mode</label>

                            <input type="text"
                                   name="paymentMode"
                                   class="app-input"
                                   maxlength="50"
                                   value="@Model.PaymentMode" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Bank Name</label>

                            <input type="text"
                                   name="bankName"
                                   class="app-input"
                                   maxlength="100"
                                   value="@Model.BankName" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">CPIN</label>

                            <input type="text"
                                   name="cpin"
                                   class="app-input"
                                   maxlength="100"
                                   value="@Model.CPIN" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">CIN</label>

                            <input type="text"
                                   name="cin"
                                   class="app-input"
                                   maxlength="100"
                                   value="@Model.CIN" />
                        </div>

                    </div>

                    <div class="form-group">
                        <label class="form-label">Remarks</label>

                        <textarea name="remarks"
                              class="app-textarea"
                              maxlength="500">@Model.ChallanRemarks</textarea>
                    </div>

                    <button type="submit"
                            class="btn-app btn-success-app">
                        Save Challan
                    </button>

                </form>

                <div class="table-responsive">

                    <table class="app-table">

                        <thead>
                            <tr>
                                <th>Challan No.</th>
                                <th>Payment Date</th>
                                <th>Mode</th>
                                <th>Bank</th>
                                <th>CPIN</th>
                                <th>CIN</th>
                                <th class="text-end amount-column">Amount</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>

                        <tbody>
                            @if (Model.Challans.Any())
                            {
                                foreach (var challan in Model.Challans)
                                {
                                    <tr>
                                        <td>@challan.ChallanNumber</td>
                                        <td>@(challan.PaymentDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                        <td>@(string.IsNullOrWhiteSpace(challan.PaymentMode) ? "-" : challan.PaymentMode)</td>
                                        <td>@(string.IsNullOrWhiteSpace(challan.BankName) ? "-" : challan.BankName)</td>
                                        <td>@(string.IsNullOrWhiteSpace(challan.CPIN) ? "-" : challan.CPIN)</td>
                                        <td>@(string.IsNullOrWhiteSpace(challan.CIN) ? "-" : challan.CIN)</td>
                                        <td class="text-end amount-column">
                                            ₹ @challan.AmountPaid.ToString("N2")
                                        </td>
                                        <td class="text-center">
                                            <span class="@GstrStatusClass(challan.Status)">
                                                @challan.Status
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="8"
                                        class="empty-state">
                                        No GST challans recorded for this period.
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

            </div>

        </div>
    }

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">GSTR-1</label>
                <span class="@GstrStatusClass(Model.Gstr1Status)">
                    @Model.Gstr1Status
                </span>
            </div>

            <div class="form-group">
                <label class="form-label">GSTR-3B</label>
                <span class="@GstrStatusClass(Model.Gstr3BStatus)">
                    @Model.Gstr3BStatus
                </span>
            </div>

            <div class="form-group">
                <label class="form-label">Challan</label>
                <span class="@GstrStatusClass(Model.ChallanStatus)">
                    @Model.ChallanStatus
                </span>
            </div>

        </div>

    </div>

</div>

@if (Model.SnapshotStatus == "Filed")
{
    <div class="app-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">GST Filing Audit</h2>
                <p class="card-subtitle">
                    Filing and lock information for this GST period.
                </p>
            </div>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label class="form-label">Filed By User ID</label>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.FiledByUserId)
                                            ? "-"
                                            : Model.FiledByUserId)
                                                              </strong>
                                                          </div>

                <div class="form-group">
                    <label class="form-label">Filed On</label>
                    <strong>
                        @(Model.FiledOn?.ToString("dd MMM yyyy HH:mm")
                                            ?? "-")
                </strong>
            </div>

            </div>

        </div>

    </div>
}


@if (Model.SnapshotStatus == "Filed" &&
     User.IsInRole("Admin"))
{
    <form asp-controller="Gst"
          asp-action="ReopenSnapshot"
          method="post"
          class="w-100 mt-3">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="month"
               value="@Model.Month" />

        <input type="hidden"
               name="year"
               value="@Model.Year" />

        <div class="form-group">
            <label class="form-label">
                Reopen Reason
            </label>

            <textarea name="reason"
                  class="app-textarea"
                  maxlength="500"
                  required></textarea>
        </div>

        <button type="submit"
                class="btn-app btn-warning-app"
                onclick="return confirm('Reopen this filed GST period?')">

            <i class="bi bi-unlock"></i>
            Reopen GST Period

        </button>

    </form>
}

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Document Statistics</h2>
            <p class="card-subtitle">
                Source documents used for GST calculation.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Invoices Created</label>
                <strong>@Model.InvoiceCount</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Expense Vouchers</label>
                <strong>@Model.ExpenseVoucherCount</strong>
            </div>

        </div>

    </div>

</div>

@if (Model.SnapshotId > 0)
{
    <div class="app-card table-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">GST Documents</h2>
                <p class="card-subtitle">
                    Upload and manage GST working files, return copies and challans.
                </p>
            </div>
        </div>

        <div class="card-body">

            @if (Model.SnapshotStatus != "Filed")
            {
                <form asp-action="UploadDocument"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="snapshotId"
                           value="@Model.SnapshotId" />

                    <div class="form-grid-4">

                        <div class="form-group">
                            <label class="form-label">Document Type</label>

                            <select name="documentType"
                                    class="app-select"
                                    required>
                                <option value="">Select Type</option>
                                <option value="Working">Working</option>
                                <option value="GSTR1">GSTR-1</option>
                                <option value="GSTR3B">GSTR-3B</option>
                                <option value="Challan">Challan</option>
                                <option value="Excel">Excel</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label class="form-label">File</label>

                            <input type="file"
                                   name="file"
                                   class="app-input"
                                   required />
                        </div>

                        <div class="form-group">
                            <label class="form-label">Remarks</label>

                            <input type="text"
                                   name="remarks"
                                   class="app-input"
                                   maxlength="500"
                                   placeholder="Optional remarks" />
                        </div>

                        <div class="form-group">
                            <label class="form-label">&nbsp;</label>

                            <button type="submit"
                                    class="btn-app btn-primary-app">
                                <i class="bi bi-upload"></i>
                                Upload
                            </button>
                        </div>

                    </div>

                </form>
            }

            <div class="table-responsive">

                <table class="app-table">

                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>File Name</th>
                            <th>Uploaded On</th>
                            <th>Uploader</th>
                            <th>Remarks</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Documents.Any())
                        {
                            foreach (var document in Model.Documents)
                            {
                                <tr>
                                    <td>@document.DocumentType</td>
                                    <td>@document.FileName</td>
                                    <td>@document.UploadedOn.ToString("dd-MMM-yyyy")</td>
                                    <td>@(string.IsNullOrWhiteSpace(document.UploadedByUserId) ? "-" : document.UploadedByUserId)</td>
                                    <td>@(string.IsNullOrWhiteSpace(document.Remarks) ? "-" : document.Remarks)</td>
                                    <td>
                                        <div class="table-actions">
                                            <a asp-action="DownloadDocument"
                                               asp-route-id="@document.GstDocumentId"
                                               class="btn-app btn-icon btn-primary-app"
                                               title="Download">
                                                <i class="bi bi-download"></i>
                                            </a>

                                            @if (Model.SnapshotStatus != "Filed")
                                            {
                                                <form asp-action="DeleteDocument"
                                                      method="post">

                                                    @Html.AntiForgeryToken()

                                                    <input type="hidden"
                                                           name="id"
                                                           value="@document.GstDocumentId" />

                                                    <input type="hidden"
                                                           name="snapshotId"
                                                           value="@Model.SnapshotId" />

                                                    <button type="submit"
                                                            class="btn-app btn-icon btn-danger-app"
                                                            onclick="return confirm('Delete this GST document?')"
                                                            title="Delete">
                                                        <i class="bi bi-trash"></i>
                                                    </button>

                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6"
                                    class="empty-state">
                                    No GST documents uploaded for this period.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>
}

<div class="app-card">

    <div class="card-body form-actions">

        <a asp-action="Index"
           asp-route-month="@Model.Month"
           asp-route-year="@Model.Year"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back to GST
        </a>

        @if (canRegenerateSnapshot)
        {
            <form method="post"
                  asp-action="Generate">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="month"
                       value="@Model.Month" />

                <input type="hidden"
                       name="year"
                       value="@Model.Year" />

                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-arrow-clockwise"></i>
                    @snapshotButtonText
                </button>

            </form>


        }

        @if (Model.SnapshotStatus != "Filed" &&
                Model.Gstr1Status == "Filed" &&
                Model.Gstr3BStatus == "Filed" &&
                Model.ChallanStatus == "Paid")
        {
            <form method="post"
                  asp-action="LockSnapshot">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="month"
                       value="@Model.Month" />

                <input type="hidden"
                       name="year"
                       value="@Model.Year" />

                <button type="submit"
                        class="btn-app btn-danger-app"
                        onclick="return confirm('File and permanently lock this GST period?')">

                    <i class="bi bi-lock"></i>
                    File & Lock

                </button>

            </form>
        }
        else
        {
            <span class="badge-warning">
                Complete GSTR-1, GSTR-3B and Challan before locking
            </span>
        }

        @if (Model.SnapshotStatus == "Filed" &&
                User.IsInRole("Admin"))
        {
            <form asp-controller="Gst"
                  asp-action="ReopenSnapshot"
                  method="post"
                  class="w-100 mt-3">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="month"
                       value="@Model.Month" />

                <input type="hidden"
                       name="year"
                       value="@Model.Year" />

                <div class="form-group">
                    <label class="form-label">
                        Reopen Reason
                    </label>

                    <textarea name="reason"
                          class="app-textarea"
                          maxlength="500"
                          required></textarea>
                </div>

                <button type="submit"
                        class="btn-app btn-warning-app"
                        onclick="return confirm('Reopen this filed GST period?')">

                    <i class="bi bi-unlock"></i>
                    Reopen GST Period

                </button>

            </form>
        }

    </div>

</div>

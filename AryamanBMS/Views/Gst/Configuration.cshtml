@using AryamanBMS.Models 
@model AryamanBMS.ViewModels.GstConfigurationViewModel

@{
    ViewData["Title"] = "GST Configuration";

    var lutDocuments = ViewBag.LutDocuments as List<GstLutDocumentModel>
    ?? new List<GstLutDocumentModel>();

    var states = new Dictionary<string, string>
    {
        { "AN", "Andaman and Nicobar Islands" },
        { "AP", "Andhra Pradesh" },
        { "AR", "Arunachal Pradesh" },
        { "AS", "Assam" },
        { "BR", "Bihar" },
        { "CH", "Chandigarh" },
        { "CG", "Chhattisgarh" },
        { "DD", "Daman and Diu" },
        { "DL", "Delhi" },
        { "DN", "Dadra and Nagar Haveli" },
        { "GA", "Goa" },
        { "GJ", "Gujarat" },
        { "HR", "Haryana" },
        { "HP", "Himachal Pradesh" },
        { "JK", "Jammu and Kashmir" },
        { "JH", "Jharkhand" },
        { "KA", "Karnataka" },
        { "KL", "Kerala" },
        { "LA", "Ladakh" },
        { "LD", "Lakshadweep" },
        { "MP", "Madhya Pradesh" },
        { "MH", "Maharashtra" },
        { "MN", "Manipur" },
        { "ML", "Meghalaya" },
        { "MZ", "Mizoram" },
        { "NL", "Nagaland" },
        { "OD", "Odisha" },
        { "PY", "Puducherry" },
        { "PB", "Punjab" },
        { "RJ", "Rajasthan" },
        { "SK", "Sikkim" },
        { "TN", "Tamil Nadu" },
        { "TS", "Telangana" },
        { "TR", "Tripura" },
        { "UP", "Uttar Pradesh" },
        { "UK", "Uttarakhand" },
        { "WB", "West Bengal" }
    };
}

<div class="module-header">

    <div>
        <h1 class="module-title">GST CONFIGURATION</h1>
        <p class="module-subtitle">
            Manage company GST registration details and default GST rates.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <div class="app-alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="app-alert-danger">
        @TempData["Error"]
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="app-alert-warning">
        @TempData["Warning"]
    </div>
}

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Company GST Details</h2>
            <p class="card-subtitle">
                These details are used for GST compliance and reporting.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="UpdateCompanyGst"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-grid-3">

                <div class="form-group">
                    <label asp-for="CompanyName"
                           class="form-label">
                        Company Name
                    </label>

                    <input asp-for="CompanyName"
                           class="app-input"
                           maxlength="200"
                           placeholder="Enter company legal name" />

                    <span asp-validation-for="CompanyName"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CompanyGstin"
                           class="form-label">
                        GSTIN
                    </label>

                    <input asp-for="CompanyGstin"
                           class="app-input"
                           maxlength="15"
                           placeholder="27ABCDE1234F1Z5" />

                    <span asp-validation-for="CompanyGstin"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="RegisteredState"
                           class="form-label">
                        Registered State
                    </label>

                    <select asp-for="RegisteredState"
                            class="app-select">
                        <option value="">Select State</option>

                        @foreach (var state in states)
                        {
                            <option value="@state.Key">
                                @state.Value
                            </option>
                        }
                    </select>

                    <span asp-validation-for="RegisteredState"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-check-circle"></i>
                    Save Company Details
                </button>
            </div>

        </form>

    </div>

</div>

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Export under LUT</h2>
            <p class="card-subtitle">
                Required before issuing zero-rated export invoices.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="UpdateLut" method="post">

            @Html.AntiForgeryToken()

            <div class="form-grid-3">

                <div class="form-group">
                    <label asp-for="LutReference" class="form-label">
                        LUT Reference
                    </label>

                    <input asp-for="LutReference"
                           class="app-input"
                           maxlength="100"
                           placeholder="Enter LUT reference" />
                </div>

                <div class="form-group">
                    <label asp-for="LutValidFrom" class="form-label">
                        Valid From
                    </label>

                    <input asp-for="LutValidFrom"
                           type="date"
                           class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="LutValidTo" class="form-label">
                        Valid To
                    </label>

                    <input asp-for="LutValidTo"
                           type="date"
                           class="app-input" />
                </div>

            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-check-circle"></i>
                    Save LUT Details
                </button>
            </div>

        </form>

        <hr class="my-4" />

        <form asp-action="UploadLutDocument"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <h3 class="card-title mb-3">Upload LUT Document</h3>

            <div class="form-grid-4">

                <div class="form-group">
                    <label class="form-label">LUT PDF Document</label>

                    <input type="file"
                           name="lutDocument"
                           class="app-input"
                           accept=".pdf,application/pdf"
                           required />

                    <small class="text-muted">
                        PDF only. The document is stored securely.
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label">LUT Reference</label>

                    <input type="text"
                           name="lutReference"
                           class="app-input"
                           maxlength="100"
                           value="@Model.LutReference"
                           required />
                </div>

                <div class="form-group">
                    <label class="form-label">Valid From</label>

                    <input type="date"
                           name="lutValidFrom"
                           class="app-input"
                           value="@(Model.LutValidFrom?.ToString("yyyy-MM-dd"))"
                           required />
                </div>

                <div class="form-group">
                    <label class="form-label">Valid To</label>

                    <input type="date"
                           name="lutValidTo"
                           class="app-input"
                           value="@(Model.LutValidTo?.ToString("yyyy-MM-dd"))"
                           required />
                </div>

            </div>

            <div class="form-actions">
                <button type="submit" class="btn-app btn-primary-app">
                    <i class="bi bi-upload"></i>
                    Upload and Activate LUT
                </button>
            </div>

        </form>

        @if (lutDocuments.Any())
        {
            <div class="mt-4">
                <h3 class="card-title mb-3">Active LUT Document</h3>

                @foreach (var document in lutDocuments)
                {
                    <div class="app-alert-info mb-2">
                        <strong>@document.OriginalFileName</strong>

                        <div class="mt-1">
                            LUT: @document.LutReference
                            · Valid: @document.LutValidFrom?.ToString("dd-MMM-yyyy")
                            to @document.LutValidTo?.ToString("dd-MMM-yyyy")
                        </div>

                        <small>
                            Uploaded on @document.UploadedOn.ToString("dd-MMM-yyyy HH:mm")
                        </small>

                        <div class="mt-2">
                            <a asp-action="DownloadLutDocument"
                               asp-route-id="@document.GstLutDocumentId"
                               class="btn-app btn-secondary-app">
                                <i class="bi bi-download"></i>
                                Download LUT
                            </a>
                        </div>
                    </div>
                }
            </div>
        }

    </div>

</div>

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">GST Rates</h2>
            <p class="card-subtitle">
                IGST should equal CGST plus SGST.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="UpdateGstRates"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-grid-3">

                <div class="form-group">
                    <label asp-for="CgstRate"
                           class="form-label">
                        CGST Rate %
                    </label>

                    <input asp-for="CgstRate"
                           type="number"
                           class="app-input"
                           min="0"
                           max="100"
                           step="0.01" />

                    <span asp-validation-for="CgstRate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SgstRate"
                           class="form-label">
                        SGST Rate %
                    </label>

                    <input asp-for="SgstRate"
                           type="number"
                           class="app-input"
                           min="0"
                           max="100"
                           step="0.01" />

                    <span asp-validation-for="SgstRate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="IgstRate"
                           class="form-label">
                        IGST Rate %
                    </label>

                    <input asp-for="IgstRate"
                           type="number"
                           class="app-input"
                           min="0"
                           max="100"
                           step="0.01" />

                    <span asp-validation-for="IgstRate"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-check-circle"></i>
                    Save GST Rates
                </button>
            </div>

        </form>

    </div>

</div>

<div class="app-card">

    <div class="card-body">
        <div class="form-grid-2">
            <div class="form-group">
                <label class="form-label">Active Configuration</label>
                <span class="@(Model.IsActive ? "badge-success" : "badge-secondary")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </div>

            <div class="form-group">
                <label class="form-label">Last Updated On</label>
                <div>@Model.LastUpdatedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
            </div>
        </div>
    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

@model AryamanBMS.Models.ProposalModel

@{
    ViewData["Title"] = "Proposal Details";

    string badgeClass = Model.Status switch {
        "Draft"       => "badge-secondary",
        "Sent"        => "badge-primary",
        "UnderReview" => "badge-info",
        "Accepted"    => "badge-success",
        "Rejected"    => "badge-danger",
        "Expired"     => "badge-warning",
        _             => "badge-secondary"
    };

    string badgeLabel = Model.Status == "UnderReview" ? "Under Review" : Model.Status;
}

<div class="module-header">

    <div>
        <h1 class="module-title">Proposal Details</h1>
        <p class="module-subtitle">
            <strong>@Model.ProposalNumber</strong>
            <span class="@badgeClass">@badgeLabel</span>
        </p>
    </div>

    <div class="module-header-actions">

        @if (Model.IsActive && !Model.IsConverted)
        {
            <form asp-controller="Proposal"
                  asp-action="RegenerateDocument"
                  asp-route-id="@Model.ProposalId"
                  method="post"
                  class="d-inline">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-app btn-success-app"
                        onclick="return confirm('Generate a new proposal document version?');">

                    <i class="bi bi-arrow-repeat"></i>
                    Regenerate Document

                </button>
            </form>
        }

        <a asp-controller="Proposal"
           asp-action="DocumentHistory"
           asp-route-id="@Model.ProposalId"
           class="btn-app btn-secondary-app">

            <i class="bi bi-clock-history"></i>
            Document History

        </a>

        @if (!string.IsNullOrWhiteSpace(Model.FilePath))
        {
            <a asp-controller="Proposal"
               asp-action="Download"
               asp-route-id="@Model.ProposalId"
               class="btn-app btn-primary-app">

                <i class="bi bi-download"></i>
                Download Current

            </a>
        }

        <a asp-controller="Proposal"
           asp-action="Index"
           class="btn-app btn-secondary-app">

            <i class="bi bi-arrow-left"></i>
            Back

        </a>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Client & Project</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Client</label>
                <div>
                    <a asp-controller="Client"
                       asp-action="Details"
                       asp-route-id="@Model.ClientId">
                        @(Model.Client?.ClientName ?? "-")
                    </a>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Linked Project</label>
                <div>@(Model.Project?.ProjectName ?? "-")</div>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Proposal Information</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Proposal Title</label>
                <div>@Model.ProposalTitle</div>
            </div>

            <div class="form-group">
                <label class="form-label">Status</label>
                <div>
                    <span class="@badgeClass">@badgeLabel</span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Proposal Date</label>
                <div>@Model.ProposalDate.ToString("dd-MMM-yyyy")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Valid Until</label>
                <div>
                    @if (Model.ValidUntil.HasValue)
                    {
                        @Model.ValidUntil.Value.ToString("dd-MMM-yyyy")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Amount</label>
                <div>
                    @if (Model.ProposalAmount.HasValue)
                    {
                        @($"{Model.Currency} {Model.ProposalAmount.Value:N2}")
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Converted</label>
                <div>
                    @if (Model.IsConverted)
                    {
                        <span class="badge-success">PO/WO Raised</span>
                    }
                    else
                    {
                        <span class="badge-secondary">Pending</span>
                    }
                </div>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Scope & Terms</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Scope of Work</label>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.Scope) ? "-" : Model.Scope)
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Terms & Conditions</label>
                <div>
                    @(string.IsNullOrWhiteSpace(Model.Terms) ? "-" : Model.Terms)
                </div>
            </div>

        </div>

        <div class="form-group mt-3">
            <label class="form-label">Remarks</label>
            <div>
                @(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)
            </div>
        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Document</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">File Name</label>
                <div>@(string.IsNullOrWhiteSpace(Model.FileName) ? "-" : Model.FileName)</div>
            </div>

            <div class="form-group">
                <label class="form-label">Version</label>
                <div>v@Model.VersionNo</div>
            </div>

            <div class="form-group">
                <label class="form-label">File Size</label>
                <div>@(Math.Round(Model.FileSize / 1024.0, 2)) KB</div>
            </div>

        </div>

        <div class="mt-3">
            <a asp-action="Download"
               asp-route-id="@Model.ProposalId"
               class="btn-app btn-success-app">
                <i class="bi bi-download"></i>
                Download Document
            </a>
        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Status & Audit</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Record Status</label>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge-danger">Inactive</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Created On</label>
                <div>@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Last Updated</label>
                <div>@(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</div>
            </div>

        </div>

    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <h5 class="card-title">Proposal Audit Trail</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Action</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Revision</th>
                        <th>Remarks</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.AuditTrail != null && Model.AuditTrail.Any())
                    {
                        @foreach (var item in Model.AuditTrail
                                            .OrderByDescending(x => x.ChangedOn))
                        {
                            <tr>
                                <td>@item.ChangedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>

                                <td>
                                    <strong>@item.ActionType</strong>
                                </td>

                                <td>
                                    @(item.OldStatus ?? "-")
                                    <i class="bi bi-arrow-right"></i>
                                    @(item.NewStatus ?? "-")
                                </td>

                                <td>
                                    @if (item.OldAmount.HasValue || item.NewAmount.HasValue)
                                    {
                                        <span>
                                            @(item.OldAmount?.ToString("N2") ?? "-")
                                            <i class="bi bi-arrow-right"></i>
                                            @(item.NewAmount?.ToString("N2") ?? "-")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                            </td>

                            <td>
                                @(item.OldRevisionNumber ?? "-")
                                <i class="bi bi-arrow-right"></i>
                                @(item.NewRevisionNumber ?? "-")
                            </td>

                            <td>
                                @(string.IsNullOrWhiteSpace(item.Remarks)
                                                            ? "-"
                                                            : item.Remarks)
                        </td>
                    </tr>
                                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No audit entries available.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>
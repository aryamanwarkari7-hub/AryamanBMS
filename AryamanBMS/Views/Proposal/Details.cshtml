@model AryamanBMS.Models.ProposalModel

@{
    ViewData["Title"] = "Proposal Details";

    string badgeClass = Model.Status switch
    {
        "Draft" => "badge-secondary",
        "Sent" => "badge-primary",
        "UnderReview" => "badge-info",
        "Accepted" => "badge-success",
        "Rejected" => "badge-danger",
        "Expired" => "badge-warning",
        _ => "badge-secondary"
    };

    string badgeLabel = Model.Status == "UnderReview"
        ? "Under Review"
        : Model.Status;

    string amountDisplay = Model.ProposalAmount.HasValue
        ? $"{Model.Currency} {Model.ProposalAmount.Value:N2}"
        : "-";
}

<div class="detail-page">

    <div class="module-header">
        <div>
            <h1 class="module-title">@Model.ProposalNumber</h1>
            <p class="module-subtitle">
                Proposal details, document version and audit trail
            </p>
        </div>

        <div class="module-header-actions">

            @if (Model.IsActive && !Model.IsConverted)
            {
                <form asp-controller="Proposal"
                      asp-action="RegenerateDocument"
                      asp-route-id="@Model.ProposalId"
                      method="post"
                      class="m-0">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn-app btn-success-app"
                            onclick="return confirm('Generate a new proposal document version?');">
                        <i class="bi bi-arrow-repeat"></i>
                        Regenerate
                    </button>
                </form>
            }

            <a asp-controller="Proposal"
               asp-action="DocumentHistory"
               asp-route-id="@Model.ProposalId"
               class="btn-app btn-secondary-app">
                <i class="bi bi-clock-history"></i>
                History
            </a>

            @if (!string.IsNullOrWhiteSpace(Model.FilePath))
            {
                <a asp-controller="Proposal"
                   asp-action="Download"
                   asp-route-id="@Model.ProposalId"
                   class="btn-app btn-success-app">
                    <i class="bi bi-download"></i>
                    Download
                </a>
            }

            <a asp-controller="Proposal"
               asp-action="Index"
               class="btn-app btn-secondary-app">
                <i class="bi bi-arrow-left"></i>
                Back
            </a>

        </div>
    </div>

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@badgeClass">@badgeLabel</span>
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Client</div>
            <div class="detail-summary-value">
                @(Model.Client?.ClientName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Amount</div>
            <div class="detail-summary-value">@amountDisplay</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Converted</div>
            <div class="detail-summary-value">
                @if (Model.IsConverted)
                {
                    <span class="badge-success">PO/WO Raised</span>
                }
                else
                {
                    <span class="badge-secondary">Pending</span>
                }
            </div>
        </div>
    </div>

    <div class="detail-grid-2">

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Client & Project</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Client</span>
                        <span class="detail-info-value">
                            <a asp-controller="Client"
                               asp-action="Details"
                               asp-route-id="@Model.ClientId">
                                @(Model.Client?.ClientName ?? "-")
                            </a>
                        </span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Linked Project</span>
                        <span class="detail-info-value">@(Model.Project?.ProjectName ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Proposal Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Title</span>
                        <span class="detail-info-value">@Model.ProposalTitle</span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Proposal Date</span>
                        <span class="detail-info-value">@Model.ProposalDate.ToString("dd-MMM-yyyy")</span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Valid Until</span>
                        <span class="detail-info-value">@(Model.ValidUntil?.ToString("dd-MMM-yyyy") ?? "-")</span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Amount</span>
                        <span class="detail-info-value">@amountDisplay</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="detail-grid-2">

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Scope of Work</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(Model.Scope) ? "No scope provided." : Model.Scope)
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Terms & Conditions</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(Model.Terms) ? "No terms provided." : Model.Terms)
                </div>
            </div>
        </div>

    </div>

    <div class="detail-grid-2">

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Document</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">File Name</span>
                        <span class="detail-info-value">@(string.IsNullOrWhiteSpace(Model.FileName) ? "-" : Model.FileName)</span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Version</span>
                        <span class="detail-info-value">v@Model.VersionNo</span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">File Size</span>
                        <span class="detail-info-value">@(Math.Round(Model.FileSize / 1024.0, 2)) KB</span>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.FilePath))
                {
                    <div class="detail-action-bar mt-3">
                        <a asp-action="Download"
                           asp-route-id="@Model.ProposalId"
                           class="btn-app btn-success-app">
                            <i class="bi bi-download"></i>
                            Download Document
                        </a>
                    </div>
                }
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Status & Audit</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Record Status</span>
                        <span class="detail-info-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge-success">Active</span>
                            }
                            else
                            {
                                <span class="badge-danger">Inactive</span>
                            }
                        </span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Created On</span>
                        <span class="detail-info-value">@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Last Updated</span>
                        <span class="detail-info-value">@(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Remarks</h5>
        </div>

        <div class="card-body">
            <div class="detail-note-box">
                @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks provided." : Model.Remarks)
            </div>
        </div>
    </div>

    <div class="app-card table-card">
        <div class="card-header">
            <h5 class="card-title">Proposal Audit Trail</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Action</th>
                            <th>Status</th>
                            <th>Amount</th>
                            <th>Revision</th>
                            <th>Remarks</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.AuditTrail != null && Model.AuditTrail.Any())
                        {
                            foreach (var item in Model.AuditTrail.OrderByDescending(x => x.ChangedOn))
                            {
                                <tr>
                                    <td>@item.ChangedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>

                                    <td>
                                        <strong>@item.ActionType</strong>
                                    </td>

                                    <td>
                                        @(item.OldStatus ?? "-")
                                        <i class="bi bi-arrow-right"></i>
                                        @(item.NewStatus ?? "-")
                                    </td>

                                    <td>
                                        @if (item.OldAmount.HasValue || item.NewAmount.HasValue)
                                        {
                                            <span>
                                                @(item.OldAmount?.ToString("N2") ?? "-")
                                                <i class="bi bi-arrow-right"></i>
                                                @(item.NewAmount?.ToString("N2") ?? "-")
                                            </span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    <td>
                                        @(item.OldRevisionNumber ?? "-")
                                        <i class="bi bi-arrow-right"></i>
                                        @(item.NewRevisionNumber ?? "-")
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(item.Remarks) ? "-" : item.Remarks)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    No audit entries available.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>


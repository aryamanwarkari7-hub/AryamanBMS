@model AryamanBMS.Models.ProjectTaskModel

@{
    ViewData["Title"] = "Task Details";

    string projectText =
        $"{Model.Project?.ProjectCode ?? "-"} - {Model.Project?.ProjectName ?? "-"}";

    string employeeText = Model.AssignedEmployee != null
        ? $"{Model.AssignedEmployee.EmployeeCode} - {Model.AssignedEmployee.FullName}"
        : "-";

    string statusClass = Model.Status switch
    {
        "Completed" => "badge-success",
        "In Progress" => "badge-info",
        "Overdue" => "badge-danger",
        "On Hold" => "badge-warning",
        _ => "badge-secondary"
    };

    string activeClass = Model.IsActive ? "badge-success" : "badge-danger";
    string activeText = Model.IsActive ? "Active" : "Inactive";
}

<div class="module-header">
    <div>
        <h1 class="module-title">@Model.TaskTitle</h1>
        <p class="module-subtitle">
            Task details, assignment, schedule and progress
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit Task
        </a>

        <a asp-controller="TaskTracker"
           asp-action="Index"
           asp-route-projectTaskId="@Model.Id"
           class="btn-app btn-secondary-app">
            <i class="bi bi-activity"></i>
            Task Updates
        </a>

        @if (User.IsInRole("Employee") &&
                !User.IsInRole("Admin") &&
                !User.IsInRole("HR") &&
                !User.IsInRole("ProjectManager"))
        {
            <a asp-controller="Employee"
               asp-action="MyTasks"
               class="btn-app btn-secondary-app">
                <i class="bi bi-arrow-left"></i>
                Back to My Tasks
            </a>
        }
        else
        {
            <a asp-controller="ProjectTask"
               asp-action="Index"
               asp-route-projectId="@Model.ProjectId"
               class="btn-app btn-secondary-app">
                <i class="bi bi-arrow-left"></i>
                Back to Project Tasks
            </a>
        }
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Task Code</div>
            <div class="detail-summary-value">@Model.TaskCode</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@statusClass">@(Model.Status ?? "-")</span>
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Priority</div>
            <div class="detail-summary-value">@(Model.Priority ?? "-")</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Progress</div>
            <div class="detail-summary-value">@Model.ProgressPercent%</div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Basic Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Task Code</span>
                        <strong class="detail-info-value">@Model.TaskCode</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Task Title</span>
                        <strong class="detail-info-value">@Model.TaskTitle</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Project</span>
                        <strong class="detail-info-value">@projectText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Assigned Employee</span>
                        <strong class="detail-info-value">@employeeText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Department</span>
                        <strong class="detail-info-value">
                            @(Model.AssignedEmployee?.Department?.DepartmentName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Designation</span>
                        <strong class="detail-info-value">
                            @(Model.AssignedEmployee?.Designation?.DesignationName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Active</span>
                        <strong class="detail-info-value">
                            <span class="@activeClass">@activeText</span>
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Schedule and Hours</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Start Date</span>
                        <strong class="detail-info-value">
                            @(Model.StartDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Due Date</span>
                        <strong class="detail-info-value">
                            @(Model.DueDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Estimated Hours</span>
                        <strong class="detail-info-value">
                            @Model.EstimatedHours.ToString("0.##")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Actual Hours Logged</span>
                        <strong class="detail-info-value">
                            @Model.ActualHours.ToString("0.##")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Created On</span>
                        <strong class="detail-info-value">
                            @Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Updated On</span>
                        <strong class="detail-info-value">
                            @(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Description</h5>
        </div>

        <div class="card-body">
            <div class="detail-note-box">
                @if (!string.IsNullOrWhiteSpace(Model.Description))
                {
                    @Model.Description
                }
                else
                {
                    <span>No description provided.</span>
                }
            </div>
        </div>
    </div>

</div>
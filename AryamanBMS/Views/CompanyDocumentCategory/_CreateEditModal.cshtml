@model AryamanBMS.Models.CompanyDocumentCategoryModel

<form asp-action="Save"
      asp-controller="CompanyDocumentCategory"
      method="post"
      id="categoryForm">

    @Html.AntiForgeryToken()

    <input asp-for="DocumentCategoryId" type="hidden" />

    <div class="modal-header">

        <h5 class="modal-title" id="modalTitle">
            Company Document Category
        </h5>

        <button type="button"
                class="btn-close"
                data-bs-dismiss="modal">
        </button>

    </div>

    <div class="modal-body">

        <div asp-validation-summary="ModelOnly"
             class="app-alert-danger">
        </div>

        <div class="form-grid-2">

            <div class="form-group">
                <label asp-for="CategoryCode"
                       class="form-label">
                    Category Code <span class="validation-message">*</span>
                </label>

                <input asp-for="CategoryCode"
                       class="app-input"
                       maxlength="20"
                       placeholder="Ex: GST" />

                <span asp-validation-for="CategoryCode"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryName"
                       class="form-label">
                    Category Name <span class="validation-message">*</span>
                </label>

                <input asp-for="CategoryName"
                       class="app-input"
                       placeholder="Ex: GST Registration" />

                <span asp-validation-for="CategoryName"
                      class="validation-message">
                </span>
            </div>

        </div>

        <div class="form-group">

            <label asp-for="Description"
                   class="form-label">
                Description
            </label>

            <textarea asp-for="Description"
                      class="app-input"
                      rows="3"
                      placeholder="Enter category purpose or notes"></textarea>

            <span asp-validation-for="Description"
                  class="validation-message">
            </span>

        </div>

        <div class="form-grid-3">

            <div class="form-group">
                <label asp-for="DisplayOrder"
                       class="form-label">
                    Display Order
                </label>

                <input asp-for="DisplayOrder"
                       class="app-input"
                       type="number"
                       min="0" />

                <span asp-validation-for="DisplayOrder"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="ExpiryReminderDays"
                       class="form-label">
                    Reminder Days
                </label>

                <input asp-for="ExpiryReminderDays"
                       class="app-input"
                       type="number"
                       min="0" />

                <span asp-validation-for="ExpiryReminderDays"
                      class="validation-message">
                </span>
            </div>

            <div class="form-group">
                <label asp-for="MaxFileSizeMB"
                       class="form-label">
                    Max File Size (MB)
                </label>

                <input asp-for="MaxFileSizeMB"
                       class="app-input"
                       type="number"
                       min="1"
                       placeholder="20" />

                <span asp-validation-for="MaxFileSizeMB"
                      class="validation-message">
                </span>
            </div>

        </div>

        <div class="form-group">

            <label asp-for="AllowedExtensions"
                   class="form-label">
                Allowed Extensions
            </label>

            <input asp-for="AllowedExtensions"
                   class="app-input"
                   placeholder="pdf,jpg,jpeg,png" />

            <span asp-validation-for="AllowedExtensions"
                  class="validation-message">
            </span>

        </div>

        <div class="app-alert-info">
            Use comma-separated extensions without dots. Example: pdf,jpg,jpeg,png
        </div>

        <div class="form-grid-2">

            <label class="form-check">
                <input asp-for="IsMandatory"
                       class="form-check-input" />

                <span class="form-check-label">
                    Mandatory document
                </span>
            </label>

            <label class="form-check">
                <input asp-for="HasExpiry"
                       class="form-check-input" />

                <span class="form-check-label">
                    Has expiry date
                </span>
            </label>

            <label class="form-check">
                <input asp-for="RequireDocumentNumber"
                       class="form-check-input" />

                <span class="form-check-label">
                    Require document number
                </span>
            </label>

            <label class="form-check">
                <input asp-for="AllowMultipleDocuments"
                       class="form-check-input" />

                <span class="form-check-label">
                    Allow multiple documents
                </span>
            </label>

            <label class="form-check">
                <input asp-for="IsActive"
                       class="form-check-input" />

                <span class="form-check-label">
                    Active
                </span>
            </label>

        </div>

    </div>

    <div class="modal-footer">

        <button type="submit"
                class="btn-app btn-primary-app">
            <i class="bi bi-check-circle"></i>
            Save
        </button>

        <button type="button"
                class="btn-app btn-secondary-app"
                data-bs-dismiss="modal">
            Cancel
        </button>

    </div>

</form>
@model IEnumerable<AryamanBMS.Models.CompanyDocumentCategoryModel>

@{
    ViewData["Title"] = "Company Document Categories";
}

<div class="module-header">

    <div>
        <h1 class="module-title">COMPANY DOCUMENT CATEGORIES</h1>
        <p class="module-subtitle">
            Manage document types, expiry rules and upload constraints.
        </p>
    </div>

    <div class="module-header-actions">
        <button type="button"
                class="btn-app btn-primary-app"
                onclick="openCreate()">
            <i class="bi bi-plus-circle"></i>
            Add Category
        </button>
    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Category Register</h2>
            <p class="card-subtitle">
                Define document types, expiry rules and upload constraints.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table"
                   id="categoryTable">

                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Code</th>
                        <th>Category</th>
                        <th>Description</th>
                        <th class="text-center">Mandatory</th>
                        <th class="text-center">Expiry</th>
                        <th class="text-center">Active</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.DisplayOrder</td>

                                <td>
                                    <span class="badge-secondary">
                                        @item.CategoryCode
                                    </span>
                                </td>

                                <td>
                                    <strong>@item.CategoryName</strong>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.Description) ? "-" : item.Description)
                                </td>

                                <td class="text-center">
                                    @if (item.IsMandatory)
                                    {
                                        <span class="badge-success">Yes</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">No</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (item.HasExpiry)
                                    {
                                        <span class="badge-warning">Expires</span>
                                    }
                                    else
                                    {
                                        <span class="badge-info">Lifetime</span>
                                    }
                                </td>

                                <td class="text-center">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Archived</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="table-actions">

                                        <button type="button"
                                                class="btn-app btn-icon btn-primary-app"
                                                onclick="openEdit(@item.DocumentCategoryId)"
                                                title="Edit">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>

                                        @if (item.IsActive)
                                        {
                                            <button type="button"
                                                    class="btn-app btn-icon btn-danger-app"
                                                    onclick="deleteCategory(@item.DocumentCategoryId)"
                                                    title="Archive">
                                                <i class="bi bi-archive"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="btn-app btn-icon btn-success-app"
                                                    onclick="deleteCategory(@item.DocumentCategoryId)"
                                                    title="Activate">
                                                <i class="bi bi-arrow-counterclockwise"></i>
                                            </button>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                class="empty-state">
                                No document categories found.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

<div class="modal fade"
     id="categoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            @await Html.PartialAsync("_CreateEditModal",
            new AryamanBMS.Models.CompanyDocumentCategoryModel())

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        function openCreate() {
            $("#modalTitle").text("Add Company Document Category");
            $("#categoryForm")[0].reset();
            $("#DocumentCategoryId").val(0);
            $("#IsActive").prop("checked", true);
            $("#categoryModal").modal("show");
        }

        function openEdit(id) {
            $.get('/CompanyDocumentCategory/Get/' + id, function (data) {
                $("#modalTitle").text("Edit Company Document Category");

                $("#DocumentCategoryId").val(data.documentCategoryId);
                $("#CategoryCode").val(data.categoryCode);
                $("#CategoryName").val(data.categoryName);
                $("#Description").val(data.description);
                $("#DisplayOrder").val(data.displayOrder);
                $("#ExpiryReminderDays").val(data.expiryReminderDays);
                $("#AllowedExtensions").val(data.allowedExtensions);
                $("#MaxFileSizeMB").val(data.maxFileSizeMB);

                $("#IsMandatory").prop("checked", data.isMandatory);
                $("#HasExpiry").prop("checked", data.hasExpiry);
                $("#RequireDocumentNumber").prop("checked", data.requireDocumentNumber);
                $("#AllowMultipleDocuments").prop("checked", data.allowMultipleDocuments);
                $("#IsActive").prop("checked", data.isActive);

                $("#categoryModal").modal("show");
            });
        }

            function deleteCategory(id) {
            if (!confirm("Do you want to change this category status?")) {
                return;
            }

            var form = $('<form/>', {
                action: '/CompanyDocumentCategory/Delete',
                method: 'post'
            });

            form.append('@Html.AntiForgeryToken()');

            form.append($('<input/>', {
                type: 'hidden',
                name: 'id',
                value: id
            }));

            $('body').append(form);
            form.submit();
        }
    </script>
}
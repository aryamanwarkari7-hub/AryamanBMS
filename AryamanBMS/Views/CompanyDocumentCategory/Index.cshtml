@model IEnumerable<AryamanBMS.Models.CompanyDocumentCategoryModel>

@{
    ViewData["Title"] = "Company Document Categories";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Company Document Categories</h1>
        <p class="module-subtitle">
            Manage company document categories
        </p>
    </div>

    <div class="module-header-actions">
        <button type="button"
                class="btn-app btn-primary-app"
                onclick="openCreate()">

            <i class="bi bi-plus-circle"></i>

            Add Category

        </button>

    </div>

</div>

<div>

    @if (TempData["Success"] != null)
    {
        <div class="app-alert-success">

            @TempData["Success"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="app-alert-danger">

            @TempData["Error"]

            <button class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <div class="app-card">

        <div class="card-body">

            <div class="table-responsive">

                <table class="app-table"
                       id="categoryTable">

                    <thead >

                        <tr>

                            <th>
                                Order
                            </th>

                            <th>
                                Code
                            </th>

                            <th>
                                Category
                            </th>

                            <th>
                                Description
                            </th>

                            <th class="text-center">
                                Mandatory
                            </th>

                            <th class="text-center">
                                Expiry
                            </th>

                            <th class="text-center">
                                Active
                            </th>

                            <th class="text-center">

                                Actions

                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>

                                    @item.DisplayOrder

                                </td>

                                <td>

                                    @item.CategoryCode

                                </td>

                                <td>

                                    <strong>

                                        @item.CategoryName

                                    </strong>

                                </td>

                                <td>

                                    @item.Description

                                </td>

                                <td class="text-center">

                                    @if (item.IsMandatory)
                                    {
                                        <span class="badge-success">

                                            YES

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">

                                            NO

                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    @if (item.HasExpiry)
                                    {
                                        <span class="badge-warning">

                                            Expires

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-info">

                                            Lifetime

                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    @if (item.IsActive)
                                    {
                                        <span class="badge-success">

                                            Active

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">

                                            Inactive

                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <button class="btn-app btn-icon btn-primary-app"
                                            onclick="openEdit(@item.DocumentCategoryId)">

                                        <i class="bi bi-pencil-square"></i>

                                    </button>

                                    <button class="btn-app btn-icon btn-danger-app"
                                            onclick="deleteCategory(@item.DocumentCategoryId)">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                    <button class="btn-app btn-icon btn-secondary-app"
                                            onclick="toggleStatus(@item.DocumentCategoryId)">

                                        <i class="bi bi-power"></i>

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<!-- Bootstrap Modal -->

<div class="modal fade"
     id="categoryModal"
     tabindex="-1">

    <div class="modal-dialog modal-lg">

        <div class="modal-content">

            @await Html.PartialAsync("_CreateEditModal",
                     new AryamanBMS.Models.CompanyDocumentCategoryModel())

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        //----------------------------------------------------
        // Open Create
        //----------------------------------------------------

        function openCreate() {

            $("#modalTitle").text("Add Company Document Category");

            $("#categoryForm")[0].reset();

            $("#DocumentCategoryId").val(0);

            $("#categoryModal").modal("show");
        }


        //----------------------------------------------------
        // Open Edit
        //----------------------------------------------------

        function openEdit(id) {

            $.get('/CompanyDocumentCategory/Get/' + id,

                function (data) {

                    $("#modalTitle")
                        .text("Edit Company Document Category");

                    $("#DocumentCategoryId")
                        .val(data.documentCategoryId);

                    $("#CategoryCode")
                        .val(data.categoryCode);

                    $("#CategoryName")
                        .val(data.categoryName);

                    $("#Description")
                        .val(data.description);

                    $("#DisplayOrder")
                        .val(data.displayOrder);

                    $("#ExpiryReminderDays")
                        .val(data.expiryReminderDays);

                    $("#AllowedExtensions")
                        .val(data.allowedExtensions);

                    $("#MaxFileSizeMB")
                        .val(data.maxFileSizeMB);

                    $("#IsMandatory")
                        .prop("checked", data.isMandatory);

                    $("#HasExpiry")
                        .prop("checked", data.hasExpiry);

                    $("#RequireDocumentNumber")
                        .prop("checked",
                            data.requireDocumentNumber);

                    $("#AllowMultipleDocuments")
                        .prop("checked",
                            data.allowMultipleDocuments);

                    $("#IsActive")
                        .prop("checked", data.isActive);

                    $("#categoryModal").modal("show");

                });

        }


        //----------------------------------------------------
        // Delete
        //----------------------------------------------------

        function deleteCategory(id) {

            Swal.fire({

                title: 'Delete Category?',

                text: 'This action cannot be undone.',

                icon: 'warning',

                showCancelButton: true,

                confirmButtonText: 'Delete',

                cancelButtonText: 'Cancel'

            }).then((result) => {

                if (result.isConfirmed) {

                    var form = $('<form/>', {

                        action: '/CompanyDocumentCategory/Delete',

                        method: 'post'

                    });

                    form.append('@Html.AntiForgeryToken()');

                    form.append($('<input/>', {

                        type: 'hidden',

                        name: 'id',

                        value: id

                    }));

                    $('body').append(form);

                    form.submit();

                }

            });

        }


        //----------------------------------------------------
        // Toggle Active
        //----------------------------------------------------

        function toggleStatus(id) {

            $.post('/CompanyDocumentCategory/ToggleStatus/' + id,

                function () {

                    location.reload();

                });

        }

    </script>
}

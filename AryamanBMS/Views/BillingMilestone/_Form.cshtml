@model AryamanBMS.Models.BillingMilestoneModel

<input asp-for="BillingMilestoneId" type="hidden" />

<div class="app-card">
    <div class="card-header">
        <h5 class="card-title">Milestone Details</h5>
    </div>

    <div class="card-body">
        <div class="form-grid-2">
            <div class="form-group">
                <label asp-for="PurchaseWorkOrderId"
                       class="form-label">
                    PO / WO
                </label>

                <select asp-for="PurchaseWorkOrderId"
                        id="PurchaseWorkOrderId"
                        class="app-select"
                        data-project-url="@Url.Action(
                                        "GetProjectsByPurchaseOrder",
                                        "BillingMilestone")">

                    <option value="">Select PO / WO</option>

                    @foreach (var order in ViewBag.PurchaseOrders)
                    {
                        <option value="@order.PurchaseOrderId">
                            @order.OrderNumber - @order.Client?.ClientName
                        </option>
                    }

                </select>

                <span asp-validation-for="PurchaseWorkOrderId"
                      class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ProjectId"
                       class="form-label">
                    Project
                </label>

                <select asp-for="ProjectId"
                        id="ProjectId"
                        class="app-select"
                        data-selected-project-id="@Model.ProjectId"
                        disabled>

                    <option value="">Select Project</option>

                </select>

                <span asp-validation-for="ProjectId"
                      class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="MilestoneName" class="form-label">Milestone Name</label>
                <input asp-for="MilestoneName" class="app-input" />
                <span asp-validation-for="MilestoneName" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="MilestoneValue" class="form-label">Milestone Value</label>
                <input asp-for="MilestoneValue" class="app-input" type="number" step="0.01" />
                <span asp-validation-for="MilestoneValue" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="CompletionStatus" class="form-label">Status</label>
                <select asp-for="CompletionStatus" class="app-select">
                    <option value="Pending">Pending</option>
                    <option value="Approved">Approved</option>
                    <option value="Completed">Completed</option>
                    <option value="On Hold">On Hold</option>
                </select>
                <span asp-validation-for="CompletionStatus" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="ApprovalDate" class="form-label">Approval Date</label>
                <input asp-for="ApprovalDate" class="app-input" type="date" />
                <span asp-validation-for="ApprovalDate" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="SortOrder" class="form-label">Sort Order</label>
                <input asp-for="SortOrder" class="app-input" type="number" min="0" />
                <span asp-validation-for="SortOrder" class="validation-message"></span>
            </div>

            <div class="form-group">
                <label class="form-label">Active</label>
                <div>
                    <input asp-for="IsActive" type="checkbox" />
                </div>
                <span asp-validation-for="IsActive" class="validation-message"></span>
            </div>
        </div>

        <div class="form-group mt-3">
            <label asp-for="MilestoneDescription" class="form-label">Description</label>
            <textarea asp-for="MilestoneDescription" class="app-textarea" rows="4"></textarea>
            <span asp-validation-for="MilestoneDescription" class="validation-message"></span>
        </div>
    </div>
</div>

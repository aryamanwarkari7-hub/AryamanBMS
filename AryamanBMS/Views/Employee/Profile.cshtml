@model AryamanBMS.Models.EmployeeModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="module-header">
    <div>
        <h1 class="module-title">@Model.FullName</h1>
        <p class="module-subtitle">
            Employee information and employment details
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="MyDashboard" class="btn-app btn-secondary-app">
            <i class="bi bi-speedometer2"></i>
            My Dashboard
        </a>
    </div>
</div>

<div class="detail-page">
    <!-- Top Summary Grid -->
    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee Code</div>
            <div class="detail-summary-value">@Model.EmployeeCode</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Department</div>
            <div class="detail-summary-value">@(Model.Department?.DepartmentName ?? "-")</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Designation</div>
            <div class="detail-summary-value">@(Model.Designation?.DesignationName ?? "-")</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                @if (Model.IsActive)
                {
                    <span class="badge-success">Active</span>
                }
                else
                {
                    <span class="badge-danger">Inactive</span>
                }
            </div>
        </div>
    </div>

    <!-- 2-Column Balanced Cards -->
    <div class="detail-grid-2">
        <!-- Basic Information -->
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-person text-primary"></i> Basic Information
                </h5>
            </div>

            <div class="card-body">
                <div class="profile-stack">
                    <div class="profile-info-row">
                        <span><i class="bi bi-person"></i> Full Name</span>
                        <strong>@Model.FullName</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-gender-ambiguous"></i> Gender</span>
                        <strong>@(Model.Gender ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-calendar-event"></i> Date of Birth</span>
                        <strong>@(Model.DateOfBirth?.ToString("dd-MMM-yyyy") ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-calendar-check"></i> Joining Date</span>
                        <strong>@Model.JoiningDate.ToString("dd-MMM-yyyy")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-briefcase"></i> Employment Type</span>
                        <span class="badge-neutral">@(Model.EmploymentType ?? "-")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Contact Information -->
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-telephone text-primary"></i> Contact Information
                </h5>
            </div>

            <div class="card-body">
                <div class="profile-stack">
                    <div class="profile-info-row">
                        <span><i class="bi bi-phone"></i> Mobile Number</span>
                        <strong>@Model.MobileNumber</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-envelope"></i> Official Email</span>
                        <strong>@(Model.OfficialEmail ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-envelope-open"></i> Personal Email</span>
                        <strong>@(Model.PersonalEmail ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-person-heart"></i> Emergency Contact</span>
                        <strong>@(Model.EmergencyContact ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-telephone-forward"></i> Emergency Phone</span>
                        <strong>@(Model.EmergencyPhone ?? "-")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Address Information -->
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-geo-alt text-primary"></i> Address Information
                </h5>
            </div>

            <div class="card-body">
                <div class="profile-stack">
                    <div class="profile-info-row">
                        <span><i class="bi bi-house"></i> Permanent Address</span>
                        <strong>@(Model.PermanentAddress ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-buildings"></i> City</span>
                        <strong>@(Model.City ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-map"></i> State</span>
                        <strong>@(Model.State ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-pin-map"></i> Pin Code</span>
                        <strong>@(Model.PinCode ?? "-")</strong>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statutory Information -->
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">
                    <i class="bi bi-shield-lock text-primary"></i> Statutory & Identity
                </h5>
            </div>

            <div class="card-body">
                <div class="profile-stack">
                    <div class="profile-info-row">
                        <span><i class="bi bi-card-text"></i> Aadhaar Number</span>
                        <strong>@(Model.AadhaarNo ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-credit-card-2-front"></i> PAN Number</span>
                        <strong>@(Model.PanNo ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-file-earmark-person"></i> UAN Number</span>
                        <strong>@(Model.UanNo ?? "-")</strong>
                    </div>

                    <div class="profile-info-row">
                        <span><i class="bi bi-check-circle"></i> Profile Status</span>
                        @if (Model.IsActive)
                        {
                            <span class="badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge-danger">Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
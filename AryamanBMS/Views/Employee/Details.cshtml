@model AryamanBMS.ViewModels.EmployeeDetailsViewModel

@{
    var employee = Model.Employee;
    ViewData["Title"] = "Employee Details";

    var isMaster = User.IsInRole("Master");

    string employeeStatusClass = employee.IsActive ? "badge-success" : "badge-danger";
    string employeeStatusText = employee.IsActive ? "Active" : "Inactive";

    string FullAddress(params string?[] parts)
    {
        var value = string.Join(", ", parts.Where(x => !string.IsNullOrWhiteSpace(x)));
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }
}

<div class="module-header">
    <div>
        <h1 class="module-title">@employee.FullName</h1>
        <p class="module-subtitle">
            Employee profile, employment information and documents
        </p>
    </div>

    <div class="module-header-actions">
        @if (!isMaster)
        {
            <a asp-action="Edit" asp-route-id="@employee.Id" class="btn-app btn-primary-app">
                <i class="bi bi-pencil"></i>
                Edit Employee
            </a>
        }

        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee Code</div>
            <div class="detail-summary-value">@employee.EmployeeCode</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Department</div>
            <div class="detail-summary-value">
                @(employee.Department?.DepartmentName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Designation</div>
            <div class="detail-summary-value">
                @(employee.Designation?.DesignationName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@employeeStatusClass">@employeeStatusText</span>
            </div>
        </div>
    </div>

    <div class="detail-grid-2 detail-grid-balanced">

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Basic Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Employee Name</span>
                        <strong class="detail-info-value">@employee.FullName</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Gender</span>
                        <strong class="detail-info-value">@(employee.Gender ?? "-")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Date Of Birth</span>
                        <strong class="detail-info-value">
                            @(employee.DateOfBirth?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">System User</span>
                        <strong class="detail-info-value">
                            @(employee.ApplicationUser?.UserName ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Employment Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Department</span>
                        <strong class="detail-info-value">
                            @(employee.Department?.DepartmentName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Designation</span>
                        <strong class="detail-info-value">
                            @(employee.Designation?.DesignationName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Joining Date</span>
                        <strong class="detail-info-value">
                            @employee.JoiningDate.ToString("dd-MMM-yyyy")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Employment Type</span>
                        <strong class="detail-info-value">
                            @(employee.EmploymentType ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Contact Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Mobile Number</span>
                        <strong class="detail-info-value">
                            @(employee.MobileNumber ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Personal Email</span>
                        <strong class="detail-info-value">
                            @(employee.PersonalEmail ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Official Email</span>
                        <strong class="detail-info-value">
                            @(employee.OfficialEmail ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Emergency Contact</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Contact Name</span>
                        <strong class="detail-info-value">
                            @(employee.EmergencyContact ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Contact Number</span>
                        <strong class="detail-info-value">
                            @(employee.EmergencyPhone ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Address Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Permanent Address</span>
                        <strong class="detail-info-value">
                            @FullAddress(employee.PermanentAddress, employee.City, employee.State, employee.PinCode)
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Local Address</span>
                        <strong class="detail-info-value">
                            @FullAddress(employee.LocalAddress, employee.LocalCity, employee.LocalState,
                            employee.LocalPinCode)
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Statutory Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Aadhaar Number</span>
                        <strong class="detail-info-value">@(employee.AadhaarNo ?? "-")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">PAN Number</span>
                        <strong class="detail-info-value">@(employee.PanNo ?? "-")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">UAN Number</span>
                        <strong class="detail-info-value">@(employee.UanNo ?? "-")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">ESIC Number</span>
                        <strong class="detail-info-value">@(employee.EsicNo ?? "-")</strong>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <div class="app-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Statutory Documents</h5>
            @if (!isMaster)
            {
                <button type="button" class="btn-app btn-primary-app btn-sm"
                        onclick="openUploadModal('Statutory', ['Aadhaar Card', 'PAN Card', 'Passport', 'Driving License', 'Voter ID', 'Other Statutory'])">
                    <i class="bi bi-upload"></i>
                    Upload Statutory Doc
                </button>
            }
        </div>

        <div class="card-body">
            @if (!Model.StatutoryDocuments.Any())
            {
                <div class="empty-state">No statutory documents uploaded.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>File</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.StatutoryDocuments
                                .GroupBy(x => x.DocumentType))
                            {
                                <tr>
                                    <td>@group.Key</td>

                                    <td>
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var document in group)
                                            {
                                                <div>
                                                    @document.OriginalFileName
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        @if (!isMaster)
                                        {
                                            <div class="d-flex flex-column align-items-center gap-2">
                                                @foreach (var document in group)
                                                {
                                                    <div class="d-flex align-items-center gap-1">
                                                        <a asp-action="DownloadDocument" asp-route-id="@document.Id"
                                                           class="btn-app btn-primary-app btn-icon"
                                                           title="Download @document.OriginalFileName">
                                                            <i class="bi bi-download"></i>
                                                        </a>

                                                        <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                              onsubmit="return confirm('Are you sure you want to delete @document.OriginalFileName?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@document.Id" />
                                                            <input type="hidden" name="employeeId" value="@Model.Employee.Id" />
                                                            <button type="submit" class="btn-app btn-danger-app btn-icon"
                                                                    title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="app-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Joining Documents</h5>
            @if (!isMaster)
            {
                <button type="button" class="btn-app btn-primary-app btn-sm"
                        onclick="openUploadModal('Joining', ['Resume', 'Offer Letter', 'Appointment Letter', 'Cancelled Cheque / Passbook', 'Passport Photo', 'NDA / Agreement', 'Other Joining'])">
                    <i class="bi bi-upload"></i>
                    Upload Joining Doc
                </button>
            }
        </div>

        <div class="card-body">
            @if (!Model.JoiningDocuments.Any())
            {
                <div class="empty-state">No joining documents uploaded.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="app-table">
                        <thead>
                            <tr>
                                <th>Document</th>
                                <th>File</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var group in Model.JoiningDocuments
                                .GroupBy(x => x.DocumentType))
                            {
                                <tr>
                                    <td>@group.Key</td>

                                    <td>
                                        <div class="d-flex flex-column gap-2">
                                            @foreach (var document in group)
                                            {
                                                <div>
                                                    @document.OriginalFileName
                                                </div>
                                            }
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        @if (!isMaster)
                                        {
                                            <div class="d-flex flex-column align-items-center gap-2">
                                                @foreach (var document in group)
                                                {
                                                    <div class="d-flex align-items-center gap-1">
                                                        <a asp-action="DownloadDocument" asp-route-id="@document.Id"
                                                           class="btn-app btn-primary-app btn-icon"
                                                           title="Download @document.OriginalFileName">
                                                            <i class="bi bi-download"></i>
                                                        </a>

                                                        <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                              onsubmit="return confirm('Are you sure you want to delete @document.OriginalFileName?');">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@document.Id" />
                                                            <input type="hidden" name="employeeId" value="@Model.Employee.Id" />
                                                            <button type="submit" class="btn-app btn-danger-app btn-icon"
                                                                    title="Delete">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </form>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="app-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Previous Employment</h5>
            @if (!isMaster)
            {
                <button type="button" class="btn-app btn-primary-app btn-sm"
                        onclick="openUploadModal('PreviousEmployment', ['Experience Letter', 'Relieving Letter', 'Past Payslip', 'Previous Offer Letter', 'Other Employment Doc'])">
                    <i class="bi bi-upload"></i> Upload Employment Doc
                </button>
            }
        </div>

        <div class="card-body">
            @if (!Model.PreviousEmployments.Any())
            {
                <div class="empty-state">No previous employment records found.</div>
            }
            else
            {
                @for (int i = 0; i < Model.PreviousEmployments.Count; i++)
                {
                    var employment = Model.PreviousEmployments[i];

                    @if (i > 0)
                    {
                        <hr class="my-4" />
                    }

                    <div class="detail-info-list">
                        <div class="detail-info-row">
                            <span class="detail-info-label">Company Name</span>
                            <strong class="detail-info-value">@employment.CompanyName</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Designation</span>
                            <strong class="detail-info-value">@(employment.Designation ?? "-")</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Department</span>
                            <strong class="detail-info-value">@(employment.Department ?? "-")</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Employment Type</span>
                            <strong class="detail-info-value">@(employment.EmploymentType ?? "-")</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Period</span>
                            <strong class="detail-info-value">
                                @employment.StartDate.ToString("dd-MMM-yyyy") to @employment.EndDate.ToString("dd-MMM-yyyy")
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Last Salary</span>
                            <strong class="detail-info-value">
                                @(employment.LastSalary.HasValue ? $"₹{employment.LastSalary.Value:N2}" : "-")
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Reason For Leaving</span>
                            <strong class="detail-info-value">@(employment.ReasonForLeaving ?? "-")</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">HR Contact</span>
                            <strong class="detail-info-value">
                                @FullAddress(employment.HRContactName, employment.HRContactEmail, employment.HRContactNumber)
                            </strong>
                        </div>

                        @if (employment.Documents.Any())
                        {
                            <div class="detail-info-row">
                                <span class="detail-info-label">Documents</span>
                                <div class="detail-info-value w-100">
                                    <div class="table-responsive">
                                        <table class="app-table mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Document</th>
                                                    <th>File</th>
                                                    <th class="text-center">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var doc in employment.Documents)
                                                {
                                                    <tr>
                                                        <td>@doc.DocumentType</td>
                                                        <td>@doc.OriginalFileName</td>
                                                        <td class="text-center">
                                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                                <a asp-action="DownloadDocument" asp-route-id="@doc.Id"
                                                                   class="btn-app btn-primary-app btn-icon" title="Download @doc.OriginalFileName">
                                                                    <i class="bi bi-download"></i>
                                                                </a>
                                                                @if (!isMaster)
                                                                {
                                                                    <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                                          onsubmit="return confirm('Are you sure you want to delete @doc.OriginalFileName?');">
                                                                        @Html.AntiForgeryToken()
                                                                        <input type="hidden" name="id" value="@doc.Id" />
                                                                        <input type="hidden" name="employeeId" value="@Model.Employee.Id" />
                                                                        <button type="submit" class="btn-app btn-danger-app btn-icon" title="Delete">
                                                                            <i class="bi bi-trash"></i>
                                                                        </button>
                                                                    </form>
                                                                }
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        </div>
    </div>

    
    
    <div class="app-card academic-details-card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Academic Information</h5>
            @if (!isMaster)
            {
                <button type="button" class="btn-app btn-primary-app btn-sm"
                        onclick="openUploadModal('Academic', ['Marksheet', 'Degree Certificate', 'Passing Certificate', 'Provisional Certificate', 'Academic Transcript', 'Other Academic'])">
                    <i class="bi bi-upload"></i> Upload Academic Doc
                </button>
            }
        </div>

        <div class="card-body">
            @if (!Model.Academics.Any())
            {
                <div class="empty-state">No academic records found.</div>
            }
            else
            {
                var academicRecords = Model.Academics.OrderByDescending(x => x.PassingYear).ToList();

                <!-- DESKTOP TABLE -->
                <div class="academic-desktop-view">
                    <div class="table-responsive">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Qualification</th>
                                    <th>Course</th>
                                    <th>Institute</th>
                                    <th>University</th>
                                    <th>Year</th>
                                    <th>Result</th>
                                    <th>Highest</th>
                                    <th>File</th>
                                    <th class="text-center">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var academic in academicRecords)
                                {
                                    <tr>
                                        <td><strong>@academic.QualificationLevel</strong></td>
                                        <td>
                                            @(academic.CourseName ?? "-")
                                            @if (!string.IsNullOrWhiteSpace(academic.Specialization))
                                            {
                                                <br /><small class="text-muted">@academic.Specialization</small>
                                            }
                                        </td>
                                        <td>@(academic.InstituteName ?? "-")</td>
                                        <td>@(academic.BoardOrUniversity ?? "-")</td>
                                        <td>@(academic.PassingYear?.ToString() ?? "-")</td>
                                        <td>
                                            @if (academic.ResultType == "Grade")
                                            {
                                                @(academic.Grade ?? "-")
                                            }
                                            else if (academic.Score.HasValue)
                                            {
                                                @academic.Score
                                                <span>@academic.ResultType</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (academic.IsHighestQualification)
                                            {
                                                <span class="badge-success">Yes</span>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                        <td>
                                            @if (academic.Documents.Any())
                                            {
                                                <div class="d-flex flex-column gap-1">
                                                    @foreach (var document in academic.Documents)
                                                    {
                                                        <div>@document.OriginalFileName</div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (academic.Documents.Any())
                                            {
                                                <div class="d-flex flex-column align-items-center gap-1">
                                                    @foreach (var document in academic.Documents)
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center gap-1">
                                                            <a asp-action="DownloadDocument" asp-route-id="@document.Id"
                                                               class="btn-app btn-primary-app btn-icon"
                                                               title="Download @document.OriginalFileName">
                                                                <i class="bi bi-download"></i>
                                                            </a>
                                                            @if (!isMaster)
                                                            {
                                                                <form asp-action="DeleteDocument" method="post" class="d-inline"
                                                                      onsubmit="return confirm('Are you sure you want to delete @document.OriginalFileName?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@document.Id" />
                                                                    <input type="hidden" name="employeeId" value="@Model.Employee.Id" />
                                                                    <button type="submit" class="btn-app btn-danger-app btn-icon"
                                                                            title="Delete">
                                                                        <i class="bi bi-trash"></i>
                                                                    </button>
                                                                </form>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <span>-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>

</div>
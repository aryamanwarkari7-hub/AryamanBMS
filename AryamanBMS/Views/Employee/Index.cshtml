@model PagedListViewModel<EmployeeModel>

@{
    var isMaster = User.IsInRole("Master");
}

<div class="module-header">

    <div>
        <h1 class="module-title">Employee Master</h1>
        <p class="module-subtitle">Manage employee records</p>
    </div>

    <div class="d-flex flex-row gap-2">
        @if (!isMaster)
        {
            <a asp-action="Create" class="btn-app btn-primary-app">
                <i class="bi bi-plus-lg"></i>
                Add Employee
            </a>

            <a asp-action="Export" class="btn-app btn-success-app">
                <i class="bi bi-file-earmark-excel"></i>
                Export
            </a>
        }
    </div>

</div>

<div class="app-card table-card">
    <div class="card-header">
        <h5 class="card-title">Employee List</h5>
    </div>

    <div class="app-card mb-3">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="filter-form-row">

                    <div class="form-group filter-field-wide">
                        <label class="form-label">Search</label>
                        <input type="text" name="searchText" value="@ViewBag.SearchText" class="app-input"
                               placeholder="Search by code, name, mobile or email..." />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Department</label>
                        <select name="departmentId" class="app-select">
                            <option value="">All Departments</option>
                            @if (ViewBag.Departments != null)
                            {
                                foreach (var dept in (List<DepartmentModel>)ViewBag.Departments)
                                {
                                    <option value="@dept.Id" selected="@(ViewBag.DepartmentId == dept.Id)">
                                        @dept.DepartmentName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Designation</label>
                        <select name="designationId" class="app-select">
                            <option value="">All Designations</option>
                            @if (ViewBag.Designations != null)
                            {
                                foreach (var desig in (List<DesignationModel>)ViewBag.Designations)
                                {
                                    <option value="@desig.Id" selected="@(ViewBag.DesignationId == desig.Id)">
                                        @desig.DesignationName
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Status</label>
                        <select name="statusFilter" class="app-select">
                            <option value="All" selected="@(ViewBag.StatusFilter == "All")">All Status</option>
                            <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                            <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Employment Type</label>
                        <select name="employmentType" class="app-select">
                            <option value="">All Types</option>
                            <option value="Permanent" selected="@(ViewBag.EmploymentType == "Permanent")">Permanent
                            </option>
                            <option value="Contract" selected="@(ViewBag.EmploymentType == "Contract")">Contract
                            </option>
                            <option value="Intern" selected="@(ViewBag.EmploymentType == "Intern")">Intern</option>
                            <option value="Consultant" selected="@(ViewBag.EmploymentType == "Consultant")">Consultant
                            </option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">User Account</label>
                        <select name="userFilter" class="app-select">
                            <option value="All" selected="@(ViewBag.UserFilter == "All")">All Users</option>
                            <option value="Mapped" selected="@(ViewBag.UserFilter == "Mapped")">With Account</option>
                            <option value="Unmapped" selected="@(ViewBag.UserFilter == "Unmapped")">Without Account
                            </option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Joining From</label>
                        <input type="date" name="joiningFrom"
                               value="@(ViewBag.JoiningFrom != null ? ((DateTime)ViewBag.JoiningFrom).ToString("yyyy-MM-dd") : "")"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Joining To</label>
                        <input type="date" name="joiningTo"
                               value="@(ViewBag.JoiningTo != null ? ((DateTime)ViewBag.JoiningTo).ToString("yyyy-MM-dd") : "")"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Sort By</label>
                        <select name="sortBy" class="app-select">
                            <option value="EmployeeCode" selected="@(ViewBag.SortBy == "EmployeeCode")">Code</option>
                            <option value="Name" selected="@(ViewBag.SortBy == "Name")">Name</option>
                            <option value="Department" selected="@(ViewBag.SortBy == "Department")">Department</option>
                            <option value="Designation" selected="@(ViewBag.SortBy == "Designation")">Designation
                            </option>
                            <option value="JoiningDate" selected="@(ViewBag.SortBy == "JoiningDate")">Joining Date
                            </option>
                            <option value="Status" selected="@(ViewBag.SortBy == "Status")">Status</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Order</label>
                        <select name="sortOrder" class="app-select">
                            <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Ascending</option>
                            <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Descending</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Per Page</label>
                        <select name="pageSize" class="app-select">
                            <option value="10" selected="@(ViewBag.PageSize == 10)">10</option>
                            <option value="25" selected="@(ViewBag.PageSize == 25)">25</option>
                            <option value="50" selected="@(ViewBag.PageSize == 50)">50</option>
                            <option value="100" selected="@(ViewBag.PageSize == 100)">100</option>
                        </select>
                    </div>

                    <div class="filter-form-actions">
                        <button type="submit" class="btn-app btn-primary-app">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a asp-action="Index" class="btn-app btn-secondary-app">
                            Reset
                        </a>
                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="card-body">
        <div class="table-responsive">
            @if (!Model.Items.Any())
            {
                <div class="empty-state">
                    No records found.
                </div>
            }
            else
            {
                <table class="app-table">

                    <thead>
                        <tr>
                            <th>Code</th>
                            <th>Employee</th>
                            <th>Department</th>
                            <th>Designation</th>
                            <th>Official Email</th>
                            <th>Mobile</th>
                            <th>Employment Type</th>
                            <th>Status</th>
                            <th>User</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var employee in Model.Items)
                        {
                            <tr>

                                <td>
                                    <strong>@employee.EmployeeCode</strong>
                                </td>

                                <td>
                                    <div>
                                        <strong>@employee.FullName</strong>
                                        <br />
                                        <small>
                                            DOJ:
                                            @employee.JoiningDate.ToString("dd-MMM-yyyy")
                                        </small>
                                    </div>
                                </td>

                                <td>
                                    @(employee.Department?.DepartmentName ?? "-")
                                </td>

                                <td>
                                    @(employee.Designation?.DesignationName ?? "-")
                                </td>

                                <td>
                                    @(employee.OfficialEmail ?? "-")
                                </td>

                                <td>
                                    @(employee.MobileNumber ?? "-")
                                </td>

                                <td>
                                    @(employee.EmploymentType ?? "-")
                                </td>

                                <td>
                                    @if (employee.IsActive)
                                    {
                                        <span class="badge-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(employee.ApplicationUser?.UserName ?? "-")
                                </td>

                                <td>
                                    <div class="table-actions">

                                        <a asp-action="Details" asp-route-id="@employee.Id"
                                           class="btn-app btn-primary-app btn-icon">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        @if (!isMaster)
                                        {
                                            <a asp-action="Edit" asp-route-id="@employee.Id"
                                               class="btn-app btn-secondary-app btn-icon">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <a asp-action="Delete" asp-route-id="@employee.Id"
                                               class="btn-app btn-danger-app btn-icon">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        }

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
        </div>

        <partial name="_Pagination" model="Model.Pagination" />

    </div>

</div>

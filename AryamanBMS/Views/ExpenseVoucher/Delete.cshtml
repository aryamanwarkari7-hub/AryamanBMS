@model ExpenseVoucherModel

@{
    ViewData["Title"] = "Delete Expense Voucher";
}

<div class="module-header">

    <div>
        <h1 class="module-title">DELETE EXPENSE VOUCHER</h1>
        <p class="module-subtitle">
            Confirm deletion for @Model.VoucherNumber
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Details"
           asp-route-id="@Model.ExpenseVoucherId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Voucher Information</h2>
            <p class="card-subtitle">
                Review this draft voucher before deleting it.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Voucher Number</label>
                <strong>@Model.VoucherNumber</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Voucher Date</label>
                <strong>@Model.VoucherDate.ToString("dd MMM yyyy")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Status</label>
                <span class="badge-warning">@Model.Status</span>
            </div>

            <div class="form-group">
                <label class="form-label">Category</label>
                <strong>@(Model.Category?.CategoryName ?? "-")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Vendor</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.VendorName) ? "-" : Model.VendorName)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Total Amount</label>
                <strong>₹ @Model.TotalAmount.ToString("N2")</strong>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Delete Confirmation</h2>
            <p class="card-subtitle">
                This will remove the draft voucher from active records.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="app-alert-danger">
            Are you sure you want to delete this expense voucher?
        </div>

        <form asp-action="DeleteConfirmed"
              asp-route-id="@Model.ExpenseVoucherId"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-actions">

                <button type="submit"
                        class="btn-app btn-danger-app">
                    <i class="bi bi-trash"></i>
                    Delete Voucher
                </button>

                <a asp-action="Details"
                   asp-route-id="@Model.ExpenseVoucherId"
                   class="btn-app btn-secondary-app">
                    Keep Voucher
                </a>

            </div>

        </form>

    </div>

</div>
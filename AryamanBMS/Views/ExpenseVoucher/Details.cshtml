@model ExpenseVoucherModel

@{
    ViewData["Title"] = $"Expense Voucher {Model.VoucherNumber}";
}

<div class="module-header">

    <div>
        <h1 class="module-title">EXPENSE VOUCHER DETAILS</h1>
        <p class="module-subtitle">
            Voucher information for @Model.VoucherNumber
        </p>
    </div>

    <div class="module-header-actions">

        @if (Model.Status == "Draft")
        {
            <a asp-action="Edit"
               asp-route-id="@Model.ExpenseVoucherId"
               class="btn-app btn-secondary-app">
                <i class="bi bi-pencil-square"></i>
                Edit
            </a>

            @if (User.IsInRole("Admin") || User.IsInRole("Finance"))
            {
                <form method="post"
                      asp-action="Approve"
                      class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.ExpenseVoucherId" />

                    <button type="submit"
                            class="btn-app btn-success-app"
                            onclick="return confirm('Approve this voucher?')">
                        <i class="bi bi-check-circle"></i>
                        Approve
                    </button>
                </form>
            }

            <a asp-action="Delete"
               asp-route-id="@Model.ExpenseVoucherId"
               class="btn-app btn-danger-app">
                <i class="bi bi-trash"></i>
                Delete
            </a>
        }

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Documents</h2>
            <p class="card-subtitle">
                Upload and manage bills, GST documents and supporting files.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="UploadDocument"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="voucherId"
                   value="@Model.ExpenseVoucherId" />

            <div class="form-grid-4">

                <div class="form-group">
                    <label class="form-label">Document Type</label>

                    <select name="documentType"
                            class="app-select"
                            required>
                        <option value="">Select Type</option>
                        <option value="VendorInvoice">Vendor Invoice</option>
                        <option value="GSTInvoice">GST Invoice</option>
                        <option value="PaymentProof">Payment Proof</option>
                        <option value="ApprovalNote">Approval Note</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">File</label>

                    <input type="file"
                           name="file"
                           class="app-input"
                           required />
                </div>

                <div class="form-group">
                    <label class="form-label">Remarks</label>

                    <input type="text"
                           name="remarks"
                           class="app-input"
                           maxlength="500"
                           placeholder="Optional remarks" />
                </div>

                <div class="form-group">
                    <label class="form-label">&nbsp;</label>

                    <button type="submit"
                            class="btn-app btn-primary-app">
                        <i class="bi bi-upload"></i>
                        Upload
                    </button>
                </div>

            </div>

        </form>

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Type</th>
                        <th>File Name</th>
                        <th>Uploaded By</th>
                        <th>Uploaded On</th>
                        <th>Remarks</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Documents.Any())
                    {
                        foreach (var document in Model.Documents.OrderByDescending(x => x.UploadedOn))
                        {
                            <tr>
                                <td>@document.DocumentType</td>
                                <td>@document.OriginalFileName</td>
                                <td>@document.UploadedByUserId</td>
                                <td>@document.UploadedOn.ToString("dd-MMM-yyyy")</td>
                                <td>@(string.IsNullOrWhiteSpace(document.Remarks) ? "-" : document.Remarks)</td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="DownloadDocument"
                                           asp-route-id="@document.ExpenseVoucherDocumentId"
                                           class="btn-app btn-icon btn-primary-app"
                                           title="Download">
                                            <i class="bi bi-download"></i>
                                        </a>

                                        @if (Model.Status == FinancialConstants.ExpenseVoucherStatus.Draft)
                                        {
                                            <form asp-action="DeleteDocument"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@document.ExpenseVoucherDocumentId" />

                                                <button type="submit"
                                                        class="btn-app btn-icon btn-danger-app"
                                                        onclick="return confirm('Delete this document?')"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6"
                                class="empty-state">
                                No documents uploaded.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Voucher Information</h2>
            <p class="card-subtitle">
                Basic voucher, category and status details.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Voucher Number</label>
                <strong>@Model.VoucherNumber</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Voucher Date</label>
                <strong>@Model.VoucherDate.ToString("dd MMM yyyy")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <strong>@Model.FinancialYear</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Category</label>
                <strong>@(Model.Category?.CategoryName ?? "-")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Status</label>
                @if (Model.Status == "Draft")
                {
                    <span class="badge-warning">Draft</span>
                }
                else if (Model.Status == "Posted")
                {
                    <span class="badge-success">Posted</span>
                }
                else if (Model.Status == "Rejected")
                {
                    <span class="badge-danger">Rejected</span>
                }
            </div>

        </div>

        <div class="form-group">
            <label class="form-label">Description</label>
            <strong>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</strong>
        </div>

    </div>
</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Amount Details</h2>
            <p class="card-subtitle">
                GST breakup and total voucher amount.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-4">

            <div class="form-group">
                <label class="form-label">Amount Before GST</label>
                <strong>₹ @Model.Amount.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">GST Rate</label>
                <strong>@Model.GSTRate.ToString("N2")%</strong>
            </div>

            <div class="form-group">
                <label class="form-label">
                    Supply Type
                </label>

                @if (Model.IsInterState)
                {
                    <span class="badge-info">
                        Interstate
                    </span>
                }
                else
                {
                    <span class="badge-secondary">
                        Intrastate
                    </span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">CGST</label>
                <strong>₹ @Model.CGSTAmount.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">SGST</label>
                <strong>₹ @Model.SGSTAmount.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">IGST</label>
                <strong>₹ @Model.IGSTAmount.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Total GST</label>
                <strong>₹ @Model.TotalGSTAmount.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Total Amount</label>
                <strong>₹ @Model.TotalAmount.ToString("N2")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">ITC Eligible</label>
                @if (Model.ITCEligible)
                {
                    <span class="badge-success">Yes</span>
                }
                else
                {
                    <span class="badge-secondary">No</span>
                }
            </div>

        </div>

    </div>
</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Vendor Information</h2>
            <p class="card-subtitle">
                Vendor bill, GSTIN and remarks.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Vendor Name</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.VendorName) ? "-" : Model.VendorName)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Vendor GSTIN</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.VendorGSTIN) ? "-" : Model.VendorGSTIN)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Vendor Invoice Number</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.InvoiceNumber) ? "-" : Model.InvoiceNumber)</strong>
            </div>

        </div>

        <div class="form-group">
            <label class="form-label">Remarks</label>
            <strong>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</strong>
        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Audit Information</h2>
            <p class="card-subtitle">
                Created, updated and approval timestamps.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Created On</label>
                <strong>@Model.CreatedOn.ToString("dd MMM yyyy HH:mm")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Updated On</label>
                <strong>@(Model.UpdatedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Approved On</label>
                <strong>@(Model.ApprovedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Rejected On</label>
                <strong>
                    @(Model.RejectedOn?.ToString("dd MMM yyyy HH:mm") ?? "-")
                </strong>
            </div>

            <div class="form-group">
                <label class="form-label">Rejection Reason</label>
                <strong>
                    @(string.IsNullOrWhiteSpace(Model.RejectionReason)
                                        ? "-"
                                        : Model.RejectionReason)
                </strong>
            </div>

        </div>

    </div>

</div>
    
@if (Model.Status == FinancialConstants.ExpenseVoucherStatus.Draft &&
    (User.IsInRole("Admin") || User.IsInRole("Finance")))
{
    <div class="app-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Reject Voucher</h2>
                <p class="card-subtitle">
                    Provide a reason before rejecting this voucher.
                </p>
            </div>
        </div>

        <div class="card-body">

            <form asp-controller="ExpenseVoucher"
                  asp-action="Reject"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.ExpenseVoucherId" />

                <div class="form-group">
                    <label class="form-label">
                        Rejection Reason
                    </label>

                    <textarea name="rejectionReason"
                          class="app-textarea"
                          maxlength="500"
                          required></textarea>
                </div>

                <button type="submit"
                        class="btn-app btn-danger-app">
                    <i class="bi bi-x-circle"></i>
                    Reject Voucher
                </button>

            </form>

        </div>

    </div>
}
    

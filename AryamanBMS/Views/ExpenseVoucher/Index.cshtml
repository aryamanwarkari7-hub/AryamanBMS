@model IEnumerable<ExpenseVoucherModel>

@{
    ViewData["Title"] = "Expense Vouchers";
    string status = ViewBag.Status as string ?? "";
    int? categoryId = ViewBag.CategoryId as int?;
    string search = ViewBag.Search as string ?? "";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    string sortBy = ViewBag.SortBy as string ?? "VoucherDate";
    string sortOrder = ViewBag.SortOrder as string ?? "desc";

    bool isFinanceUser =
        User.IsInRole("Admin") ||
        User.IsInRole("Finance");

    bool isEmployeeOnly =
        User.IsInRole("Employee") &&
        !isFinanceUser;
}

<div class="module-header">
    <div>
        <h1 class="module-title">
            @(isEmployeeOnly
                        ? "My Expense Claims"
                        : "Expense Vouchers")
        </h1>
        <p class="module-subtitle">
            @(isEmployeeOnly
                        ? "Create and track your own expense claims"
                        : "Manage company expense vouchers")
        </p>
    </div>
    <div class="module-header-actions">
        <a asp-action="Create"
           class="btn-app btn-primary-app">
            <i class="bi bi-plus-lg"></i>
            @(isEmployeeOnly
                        ? "New Expense Claim"
                        : "New Voucher")
        </a>

        <a asp-action="ExportExcel"
           asp-route-status="@status"
           asp-route-categoryId="@categoryId"
           asp-route-search="@search"
           asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
           asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
           class="btn-app btn-success-app">
            <i class="bi bi-file-earmark-excel"></i>
            Export Excel
        </a>
    </div>
</div>



<div class="app-card table-card">

    <div class="card-header">

        <form method="get" class="w-100">
            <input type="hidden"
                   name="status"
                   value="@status" />

            <div class="filter-form-row">

                <div class="form-group">
                    <label class="form-label">Search</label>
                    <input type="text"
                           name="search"
                           value="@search"
                           class="app-input"
                           placeholder="Voucher / Vendor / Category / Invoice" />
                </div>

                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select name="categoryId" class="app-select">
                        <option value="">All Categories</option>

                        @foreach (var category in ViewBag.Categories)
                        {
                            <option value="@category.ExpenseCategoryId"
                                    selected="@(categoryId.HasValue && categoryId.Value == category.ExpenseCategoryId)">
                                @category.CategoryName
                            </option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Sort By</label>
                    <select name="sortBy" class="app-select">
                        <option value="VoucherDate" selected="@(sortBy == "VoucherDate")">Date</option>
                        <option value="VoucherNo" selected="@(sortBy == "VoucherNo")">Voucher No</option>
                        <option value="Category" selected="@(sortBy == "Category")">Category</option>
                        <option value="Vendor" selected="@(sortBy == "Vendor")">Vendor</option>
                        <option value="Amount" selected="@(sortBy == "Amount")">Amount</option>
                        <option value="TotalAmount" selected="@(sortBy == "TotalAmount")">Total</option>
                        <option value="Status" selected="@(sortBy == "Status")">Status</option>
                        <option value="PaymentStatus" selected="@(sortBy == "PaymentStatus")">Payment Status</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Order</label>
                    <select name="sortOrder" class="app-select">
                        <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">From Date</label>
                    <input type="date"
                           name="fromDate"
                           value="@fromDate?.ToString("yyyy-MM-dd")"
                           class="app-input" />
                </div>

                <div class="form-group">
                    <label class="form-label">To Date</label>
                    <input type="date"
                           name="toDate"
                           value="@toDate?.ToString("yyyy-MM-dd")"
                           class="app-input" />
                </div>

                <div class="filter-form-actions">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-search"></i>
                        Search
                    </button>

                    <a asp-action="Index"
                       class="btn-app btn-secondary-app">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>
                </div>

            </div>
        </form>

    </div>

    <div class="card-body">

        <div class="module-header-actions justify-content-start mb-3">

            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-categoryId="@categoryId"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(string.IsNullOrWhiteSpace(status) ? "btn-primary-app" : "btn-secondary-app")">
                All
            </a>

            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-categoryId="@categoryId"
               asp-route-status="Draft"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(status == "Draft" ? "btn-primary-app" : "btn-secondary-app")">
                Draft
            </a>

            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-categoryId="@categoryId"
               asp-route-status="Submitted"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(status == "Submitted" ? "btn-primary-app" : "btn-secondary-app")">
                Submitted
            </a>

            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-categoryId="@categoryId"
               asp-route-status="Approved"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(status == "Approved" ? "btn-primary-app" : "btn-secondary-app")">
                Approved
            </a>

            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-categoryId="@categoryId"
               asp-route-status="Posted"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(status == "Posted" ? "btn-primary-app" : "btn-secondary-app")">
                Posted
            </a>

            <a asp-action="Index"
               asp-route-search="@search"
               asp-route-categoryId="@categoryId"
               asp-route-status="Rejected"
               asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
               asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(status == "Rejected" ? "btn-primary-app" : "btn-secondary-app")">
                Rejected
            </a>

        </div>

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Voucher No.</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Vendor</th>
                            <th>GST Type</th>
                        <th class="text-end amount-column">Amount</th>
                        <th class="text-end amount-column">Total(with GST)</th>
                        <th class="text-center">Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var voucher in Model)
                    {
                        <tr>
                            <td>
                                <a href="@Url.Action("Details", new { id = voucher.ExpenseVoucherId })">
                                    <strong>@voucher.VoucherNumber</strong>
                                </a>
                            </td>
                            <td>@voucher.VoucherDate.ToString("dd MMM yyyy")</td>
                            <td>@voucher.Category?.CategoryName</td>
                            <td>@(voucher.Vendor?.VendorName ?? voucher.VendorName)</td>
                                <td>
                                    @if (voucher.IsInterState)
                                    {
                                        <span class="badge-info">
                                            Interstate
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">
                                            Intrastate
                                        </span>
                                    }
                                </td>
                            <td class="text-end amount-column">₹ @voucher.Amount.ToString("N2")</td>
                            <td class="text-end amount-column">₹ @voucher.TotalAmount.ToString("N2")</td>
                            <td class="text-center">
                                    @if (voucher.Status == "Draft")
                                {
                                    <span class="badge-warning">Draft</span>
                                }
                                else if (voucher.Status == "Submitted")
                                {
                                    <span class="badge-info">Submitted</span>
                                }
                                else if (voucher.Status == "Approved")
                                {
                                    <span class="badge-secondary">Approved</span>
                                }
                                else if (voucher.Status == "Posted")
                                {
                                    <span class="badge-success">Posted</span>
                                }
                                else if (voucher.Status == "Rejected")
                                {
                                        <span class="badge-danger">Rejected</span>
                                }
                                else if (voucher.Status == "Reversed")
                                {
                                        <span class="badge-danger">Reversed</span>
                                }
                            </td>
                            <td>
                                <div class="table-actions">
                                    @if (voucher.Status == "Draft")
                                    {
                                            <a href="@Url.Action("Details", new { id = voucher.ExpenseVoucherId })"
                                               class="btn-app btn-icon btn-primary-app"
                                               title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>

                                            <a href="@Url.Action("Edit", new { id = voucher.ExpenseVoucherId })"
                                               class="btn-app btn-icon btn-secondary-app"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form method="post" action="@Url.Action("Submit")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@voucher.ExpenseVoucherId" />
                                                <button type="submit" class="btn-app btn-icon btn-success-app" title="Submit" onclick="return confirm('Submit this voucher?')">
                                                    <i class="bi bi-send"></i>
                                                </button>
                                            </form>

                                            <a href="@Url.Action("Delete", new { id = voucher.ExpenseVoucherId })"
                                               class="btn-app btn-icon btn-danger-app"
                                               title="Delete Voucher">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                    }
                                    else if (voucher.Status == "Submitted" &&
                                             (User.IsInRole("Admin") || User.IsInRole("Finance")))
                                    {
                                            <a href="@Url.Action("Details", new { id = voucher.ExpenseVoucherId })"
                                               class="btn-app btn-icon btn-primary-app"
                                               title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form method="post" action="@Url.Action("Approve")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@voucher.ExpenseVoucherId" />
                                                <button type="submit" class="btn-app btn-icon btn-success-app" title="Approve" onclick="return confirm('Approve this voucher?')">
                                                    <i class="bi bi-check-circle"></i>
                                                </button>
                                            </form>
                                    }
                                    else if (voucher.Status == "Approved" &&
                                             (User.IsInRole("Admin") || User.IsInRole("Finance")))
                                    {
                                            <a href="@Url.Action("Details", new { id = voucher.ExpenseVoucherId })"
                                               class="btn-app btn-icon btn-primary-app"
                                               title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <form method="post" action="@Url.Action("Post")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@voucher.ExpenseVoucherId" />
                                                <button type="submit" class="btn-app btn-icon btn-success-app" title="Post" onclick="return confirm('Post this voucher?')">
                                                    <i class="bi bi-journal-check"></i>
                                                </button>
                                            </form>
                                    }
                                    else
                                    {
                                            <a href="@Url.Action("Details", new { id = voucher.ExpenseVoucherId })"
                                               class="btn-app btn-icon btn-primary-app"
                                               title="Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
            <div class="empty-state">
                No expense vouchers found.
            </div>
    }

        @if ((ViewBag.TotalPages ?? 1) > 1)
        {
            <div class="pagination-container">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-status="@status"
                       asp-route-categoryId="@categoryId"
                       asp-route-search="@search"
                       asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortOrder="@sortOrder"
                       class="page-link-app @(i == ViewBag.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }
            </div>
        }
</div>
</div>

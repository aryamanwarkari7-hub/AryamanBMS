
@model AryamanBMS.Models.ProjectRiskModel

@{
    ViewData["Title"] = "Project Risk Details";

    string projectText =
        $"{Model.Project?.ProjectCode ?? "-"} - {Model.Project?.ProjectName ?? "-"}";

    string severityClass = Model.Severity switch
    {
        "Low" => "badge-success",
        "Medium" => "badge-warning",
        "High" => "badge-danger",
        "Critical" => "badge-danger",
        _ => "badge-secondary"
    };

    string statusClass = Model.RiskStatus switch
    {
        "Resolved" => "badge-success",
        "Closed" => "badge-success",
        "Open" => "badge-danger",
        "In Progress" => "badge-info",
        "Mitigated" => "badge-warning",
        _ => "badge-secondary"
    };

    string activeClass = Model.IsActive ? "badge-success" : "badge-danger";
    string activeText = Model.IsActive ? "Active" : "Inactive";
}

<div class="module-header">
    <div>
        <h1 class="module-title">@Model.RiskTitle</h1>
        <p class="module-subtitle">
            Risk assessment, response plan and resolution tracking
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit
        </a>

        <a asp-action="Index"
           asp-route-projectId="@Model.ProjectId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Risk Score</div>
            <div class="detail-summary-value">@Model.RiskScore / 25</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Severity</div>
            <div class="detail-summary-value">
                <span class="@severityClass">@(Model.Severity ?? "-")</span>
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@statusClass">@(Model.RiskStatus ?? "-")</span>
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Target Date</div>
            <div class="detail-summary-value">
                @(Model.TargetResolutionDate?.ToString("dd-MMM-yyyy") ?? "-")
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Risk Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Project</span>
                        <strong class="detail-info-value">@projectText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Risk Title</span>
                        <strong class="detail-info-value">@Model.RiskTitle</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Category</span>
                        <strong class="detail-info-value">@(Model.RiskCategory ?? "-")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Risk Owner</span>
                        <strong class="detail-info-value">
                            @(Model.RiskOwnerEmployee?.FullName ?? "Not Assigned")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Active Status</span>
                        <strong class="detail-info-value">
                            <span class="@activeClass">@activeText</span>
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Assessment and Dates</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Probability</span>
                        <strong class="detail-info-value">@Model.Probability / 5</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Impact</span>
                        <strong class="detail-info-value">@Model.Impact / 5</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Risk Score</span>
                        <strong class="detail-info-value">@Model.RiskScore / 25</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Target Resolution</span>
                        <strong class="detail-info-value">
                            @(Model.TargetResolutionDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Resolved On</span>
                        <strong class="detail-info-value">
                            @(Model.ResolvedOn?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Created On</span>
                        <strong class="detail-info-value">
                            @Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Updated On</span>
                        <strong class="detail-info-value">
                            @(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Risk Description</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(Model.RiskDescription)
                        ? "No risk description provided."
                        : Model.RiskDescription)
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Mitigation Plan</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(Model.MitigationPlan)
                        ? "No mitigation plan provided."
                        : Model.MitigationPlan)
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Contingency Plan</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(Model.ContingencyPlan)
                        ? "No contingency plan provided."
                        : Model.ContingencyPlan)
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Resolution Remarks</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(Model.ResolutionRemarks)
                        ? "No resolution remarks provided."
                        : Model.ResolutionRemarks)
                </div>
            </div>
        </div>
    </div>

</div>
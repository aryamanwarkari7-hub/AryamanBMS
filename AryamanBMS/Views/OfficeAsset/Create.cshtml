@model AryamanBMS.Models.OfficeAssetModel

@{
    ViewData["Title"] = "Add Asset";
}

<div class="module-content">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-box-seames-stacked text-primary"></i>
                Add Office Asset
            </h3>
            <small class="card-subtitle">Register a new company asset</small>
        </div>
        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>

    <div class="app-card">

        <div class="card-header">
            <strong>Asset Details</strong>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

                <div class="row">

                    <!-- Asset Name -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="AssetName" class="form-label">
                            Asset Name <span class="validation-message">*</span>
                        </label>
                        <input asp-for="AssetName" class="app-input"
                               placeholder="e.g. Dell Latitude 5440" required />
                        <span asp-validation-for="AssetName" class="validation-message"></span>
                    </div>

                    <!-- Category -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="AssetCategory" class="form-label">
                            Category <span class="validation-message">*</span>
                        </label>
                        <select asp-for="AssetCategory" class="app-select" required>
                            <option value="">-- Select --</option>
                            <option value="Laptop">Laptop</option>
                            <option value="Furniture">Furniture</option>
                            <option value="AC">AC</option>
                            <option value="Projector">Projector</option>
                            <option value="Printer">Printer</option>
                            <option value="Vehicle">Vehicle</option>
                            <option value="Other">Other</option>
                        </select>
                        <span asp-validation-for="AssetCategory" class="validation-message"></span>
                    </div>

                    <!-- Asset Code -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="AssetCode" class="form-label">Asset Code</label>
                        <input asp-for="AssetCode" class="app-input"
                               placeholder="e.g. AST-0001" />
                        <span asp-validation-for="AssetCode" class="validation-message"></span>
                    </div>

                </div>

                <div class="row">

                    <!-- Purchase Date -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="PurchaseDate" class="form-label">
                            Purchase Date <span class="validation-message">*</span>
                        </label>
                        <input asp-for="PurchaseDate" type="date" class="app-input" required />
                        <span asp-validation-for="PurchaseDate" class="validation-message"></span>
                    </div>

                    <!-- Purchase Value -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="PurchaseValue" class="form-label">
                            Purchase Value <span class="validation-message">*</span>
                        </label>
                        <input asp-for="PurchaseValue" type="number" step="0.01" min="0"
                               class="app-input" placeholder="0.00" required />
                        <span asp-validation-for="PurchaseValue" class="validation-message"></span>
                    </div>

                    <!-- Financial Year -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="FinancialYear" class="form-label">
                            Financial Year <span class="validation-message">*</span>
                        </label>
                        <input asp-for="FinancialYear" class="app-input"
                               placeholder="e.g. 2025-26" required />
                        <span asp-validation-for="FinancialYear" class="validation-message"></span>
                    </div>

                    <!-- Status -->
                    <div class="col-md-3 mb-3">
                        <label asp-for="Status" class="form-label">
                            Status <span class="validation-message">*</span>
                        </label>
                        <select asp-for="Status" class="app-select" required>
                            <option value="InUse">In Use</option>
                            <option value="Idle">Idle</option>
                            <option value="UnderRepair">Under Repair</option>
                            <option value="Disposed">Disposed</option>
                        </select>
                        <span asp-validation-for="Status" class="validation-message"></span>
                    </div>

                </div>

                <div class="row">

                    <!-- Vendor -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorName" class="form-label">Vendor Name</label>
                        <input asp-for="VendorName" class="app-input"
                               placeholder="Where it was purchased from" />
                        <span asp-validation-for="VendorName" class="validation-message"></span>
                    </div>

                    <!-- Assigned To -->
                    <div class="col-md-6 mb-3">
                        <label asp-for="AssignedTo" class="form-label">Assigned To</label>
                        <input asp-for="AssignedTo" class="app-input"
                               placeholder="Employee name or department" />
                        <span asp-validation-for="AssignedTo" class="validation-message"></span>
                    </div>

                </div>

                <div class="row">

                    <!-- Remarks -->
                    <div class="col-md-12 mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="app-input" rows="2"></textarea>
                        <span asp-validation-for="Remarks" class="validation-message"></span>
                    </div>

                </div>

                <hr />

                <div class="d-flex gap-2">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-check-circle"></i> Save Asset
                    </button>
                    <a asp-action="Index" class="btn-app btn-secondary-app">Cancel</a>
                </div>

            </form>
        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
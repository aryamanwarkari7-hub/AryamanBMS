@model AryamanBMS.Models.OfficeAssetModel

@{
    bool isEdit = Model.OfficeAssetId > 0;
    string title = isEdit ? "Edit Office Asset" : "Create Office Asset";
    string formAction = isEdit ? "Edit" : "Create";
    ViewData["Title"] = title;
}

<div class="module-header">
    <div>
        <h1 class="module-title">@title.ToUpper()</h1>
        <p class="module-subtitle">Add asset purchase, warranty, GST, location and lifecycle details.</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="@(isEdit ? "Details" : "Index")"
           asp-route-id="@(isEdit ? Model.OfficeAssetId : null)"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<form asp-action="@formAction" asp-route-id="@(isEdit ? Model.OfficeAssetId : null)" method="post">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input asp-for="OfficeAssetId" type="hidden" />
    }

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Asset Information</h2>
                <p class="card-subtitle">Enter the core asset identity and current lifecycle status.</p>
            </div>
        </div>

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="AssetName" class="form-label">Asset Name <span class="validation-message">*</span></label>
                    <input asp-for="AssetName" class="app-input" placeholder="Enter asset name" />
                    <span asp-validation-for="AssetName" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AssetCategory" class="form-label">Asset Category <span class="validation-message">*</span></label>
                    <select asp-for="AssetCategory" class="app-select">
                        <option value="">Select Category</option>
                        <option value="Laptop">Laptop</option>
                        <option value="Furniture">Furniture</option>
                        <option value="AC">AC</option>
                        <option value="Projector">Projector</option>
                        <option value="Printer">Printer</option>
                        <option value="Vehicle">Vehicle</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="AssetCategory" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AssetCode" class="form-label">Asset Code</label>
                    <input asp-for="AssetCode" class="app-input" placeholder="Unique asset tag or code" />
                    <span asp-validation-for="AssetCode" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label">Status <span class="validation-message">*</span></label>
                    <select asp-for="Status" class="app-select">
                        <option value="Idle">Idle</option>
                        <option value="InUse">In Use</option>
                        <option value="UnderRepair">Under Repair</option>
                        <option value="Disposed">Disposed</option>
                        <option value="Lost">Lost</option>
                        <option value="Damaged">Damaged</option>
                        <option value="Retired">Retired</option>
                    </select>
                    <span asp-validation-for="Status" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SerialNumber" class="form-label">Serial Number</label>
                    <input asp-for="SerialNumber" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="ModelNumber" class="form-label">Model Number</label>
                    <input asp-for="ModelNumber" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="Manufacturer" class="form-label">Manufacturer</label>
                    <input asp-for="Manufacturer" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="Brand" class="form-label">Brand</label>
                    <input asp-for="Brand" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="Barcode" class="form-label">Barcode</label>
                    <input asp-for="Barcode" class="app-input" />
                </div>
            </div>

            <div class="form-group">
                <label asp-for="ConfigurationDetails" class="form-label">Configuration Details</label>
                <textarea asp-for="ConfigurationDetails" class="app-input" rows="3"></textarea>
            </div>
        </div>
    </div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Purchase & Warranty</h2>
                <p class="card-subtitle">Capture purchase value and warranty dates for future tracking.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="PurchaseDate" class="form-label">Purchase Date <span class="validation-message">*</span></label>
                    <input asp-for="PurchaseDate" type="date" class="app-input" />
                    <span asp-validation-for="PurchaseDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PurchaseValue" class="form-label">Purchase Value <span class="validation-message">*</span></label>
                    <input asp-for="PurchaseValue" type="number" step="0.01" min="0" class="app-input" placeholder="0.00" />
                    <span asp-validation-for="PurchaseValue" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="VendorId"
                           class="form-label">
                        Purchase Vendor
                    </label>

                    <select asp-for="VendorId"
                            class="app-select"
                            id="purchaseVendorSelect">

                        <option value="">Select Vendor</option>

                        @foreach (var vendor in ViewBag.Vendors)
                        {
                            <option value="@vendor.VendorId"
                                    data-gstin="@vendor.GSTIN"
                                    data-state="@vendor.State"
                                    data-statecode="@vendor.StateCode">
                                @vendor.VendorName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="VendorId"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="VendorInvoiceNumber" class="form-label">Vendor Invoice Number</label>
                    <input asp-for="VendorInvoiceNumber" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="VendorInvoiceDate" class="form-label">Vendor Invoice Date</label>
                    <input asp-for="VendorInvoiceDate" type="date" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="FinancialYear" class="form-label">Financial Year <span class="validation-message">*</span></label>
                    <input asp-for="FinancialYear" class="app-input" placeholder="2026-27" />
                    <span asp-validation-for="FinancialYear" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="WarrantyStartDate" class="form-label">Warranty Start</label>
                    <input asp-for="WarrantyStartDate" type="date" class="app-input" />
                    <span asp-validation-for="WarrantyStartDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="WarrantyEndDate" class="form-label">Warranty End</label>
                    <input asp-for="WarrantyEndDate" type="date" class="app-input" />
                    <span asp-validation-for="WarrantyEndDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DisposalDate" class="form-label">Disposal Date</label>
                    <input asp-for="DisposalDate" type="date" class="app-input" />
                    <span asp-validation-for="DisposalDate" class="validation-message"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Location & GST</h2>
                <p class="card-subtitle">Track physical location, tax breakup and capitalization value.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="LocationName" class="form-label">Location</label>
                    <input asp-for="LocationName" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="Building" class="form-label">Building</label>
                    <input asp-for="Building" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="Floor" class="form-label">Floor</label>
                    <input asp-for="Floor" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="RoomOrSeat" class="form-label">Room / Seat</label>
                    <input asp-for="RoomOrSeat" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="TaxableAmount" class="form-label">Taxable Amount</label>
                    <input asp-for="TaxableAmount" type="number" step="0.01" min="0" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="CGSTAmount" class="form-label">CGST</label>
                    <input asp-for="CGSTAmount" type="number" step="0.01" min="0" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="SGSTAmount" class="form-label">SGST</label>
                    <input asp-for="SGSTAmount" type="number" step="0.01" min="0" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="IGSTAmount" class="form-label">IGST</label>
                    <input asp-for="IGSTAmount" type="number" step="0.01" min="0" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="ITCStatus" class="form-label">ITC Status</label>
                    <select asp-for="ITCStatus" class="app-select">
                        <option value="Not Applicable">Not Applicable</option>
                        <option value="Pending Verification">Pending Verification</option>
                        <option value="Eligible">Eligible</option>
                        <option value="Blocked">Blocked</option>
                        <option value="Claimed">Claimed</option>
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="DepreciationRate" class="form-label">Depreciation Rate %</label>
                    <input asp-for="DepreciationRate" type="number" step="0.01" min="0" class="app-input" />
                </div>
            </div>

            <div class="form-check">
                <input asp-for="ITCEligible" class="form-check-input" />
                <label asp-for="ITCEligible" class="form-check-label">ITC Eligible</label>
            </div>
        </div>
    </div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">AMC & Disposal</h2>
                <p class="card-subtitle">Capture AMC, disposal, lost and damaged information.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="AmcVendorName" class="form-label">AMC Vendor</label>
                    <input asp-for="AmcVendorName" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="AmcStartDate" class="form-label">AMC Start</label>
                    <input asp-for="AmcStartDate" type="date" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="AmcEndDate" class="form-label">AMC End</label>
                    <input asp-for="AmcEndDate" type="date" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="DisposalValue" class="form-label">Disposal Value</label>
                    <input asp-for="DisposalValue" type="number" step="0.01" min="0" class="app-input" />
                </div>
                <div class="form-group">
                    <label asp-for="LostOrDamagedOn" class="form-label">Lost / Damaged On</label>
                    <input asp-for="LostOrDamagedOn" type="date" class="app-input" />
                </div>
            </div>

            <div class="form-check">
                <input asp-for="HasAmc" class="form-check-input" />
                <label asp-for="HasAmc" class="form-check-label">Covered under AMC</label>
            </div>

            <div class="form-group">
                <label asp-for="DisposalReason" class="form-label">Disposal Reason</label>
                <textarea asp-for="DisposalReason" class="app-input" rows="2"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="LostOrDamagedReason" class="form-label">Lost / Damaged Reason</label>
                <textarea asp-for="LostOrDamagedReason" class="app-input" rows="2"></textarea>
            </div>
        </div>
    </div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Assignment & Notes</h2>
                <p class="card-subtitle">Employee assignment is recorded after save from the details page.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-1">
                <div class="form-group">
                    <label class="form-label">Current Assignment</label>
                <input class="app-input" value="@(isEdit ? (string.IsNullOrWhiteSpace(Model.AssignedTo) ? "Not assigned" : Model.AssignedTo) : "Assign after save from Details")" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="Remarks" class="form-label">Remarks</label>
                    <textarea asp-for="Remarks" class="app-input" rows="4" placeholder="Enter remarks"></textarea>
                    <span asp-validation-for="Remarks" class="validation-message"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-body form-actions">
            <button type="submit" class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                @(isEdit ? "Update" : "Save")
            </button>

            <a asp-action="@(isEdit ? "Details" : "Index")"
               asp-route-id="@(isEdit ? Model.OfficeAssetId : null)"
               class="btn-app btn-secondary-app">
                Cancel
            </a>
        </div>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

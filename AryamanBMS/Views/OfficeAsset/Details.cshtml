@model AryamanBMS.Models.OfficeAssetModel

@{
    ViewData["Title"] = "Asset Details";

    string StatusBadge(string status) => status switch
    {
        "InUse" => "badge-success",
        "Idle" => "badge-secondary",
        "UnderRepair" => "badge-warning",
        "Disposed" => "badge-danger",
        _ => "badge-secondary"
    };

    string StatusLabel(string status) => status == "UnderRepair" ? "Under Repair" : status;
}

<div class="module-content">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="mb-0">
                <i class="bi bi-box-seames-stacked text-primary"></i>
                Asset Details
            </h3>
            <small class="card-subtitle">
                <span class="@StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span>
            </small>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.OfficeAssetId" class="btn-app btn-secondary-app">
                <i class="bi bi-pencil-square"></i> Edit
            </a>
            <a asp-action="Index" class="btn-app btn-secondary-app">
                <i class="bi bi-arrow-left"></i> Back
            </a>
        </div>
    </div>

    <div class="row">

        <div class="col-md-8">
            <div class="app-card">
                <div class="card-header"><strong>Asset Information</strong></div>
                <div class="card-body">

                    <div class="mb-3">
                        <label class="fw-bold">Asset Name</label>
                        <div class="fs-5">@Model.AssetName</div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Category</label>
                            <div>@Model.AssetCategory</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Asset Code</label>
                            <div>@(Model.AssetCode ?? "-")</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Financial Year</label>
                            <div>@Model.FinancialYear</div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Purchase Date</label>
                            <div>@Model.PurchaseDate.ToString("dd-MMM-yyyy")</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Purchase Value</label>
                            <div class="fs-5 fw-bold text-success">₹ @Model.PurchaseValue.ToString("N0")</div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="fw-bold">Vendor</label>
                            <div>@(Model.VendorName ?? "-")</div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="fw-bold">Assigned To</label>
                        <div>@(Model.AssignedTo ?? "Unassigned")</div>
                    </div>

                    <div class="mb-2">
                        <label class="fw-bold">Remarks</label>
                        <div class="border rounded p-3 bg-light">
                            @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks" : Model.Remarks)
                        </div>
                    </div>

                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="app-card">
                <div class="card-header"><strong>Status &amp; Audit</strong></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="fw-bold">Status</label>
                        <div><span class="@StatusBadge(Model.Status) fs-6">@StatusLabel(Model.Status)</span></div>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Created On</label>
                        <div>@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
                    </div>
                    <div class="mb-3">
                        <label class="fw-bold">Last Updated</label>
                        <div>@(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</div>
                    </div>
                </div>
            </div>
        </div>

    </div>

</div>
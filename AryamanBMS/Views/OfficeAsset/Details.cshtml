@model AryamanBMS.Models.OfficeAssetModel

@{
    ViewData["Title"] = "Office Asset Details";

    string StatusLabel(string value) => value switch
    {
        "InUse" => "In Use",
        "UnderRepair" => "Under Repair",
        "Disposed" => "Disposed",
        "Idle" => "Idle",
        _ => value
    };

    string StatusBadge(string value) => value switch
    {
        "InUse" => "badge-success",
        "Idle" => "badge-secondary",
        "UnderRepair" => "badge-warning",
        "Disposed" => "badge-danger",
        _ => "badge-secondary"
    };
}

<div class="module-header">

    <div>
        <h1 class="module-title">Office Asset Details</h1>
        <p class="module-subtitle">
            <span class="badge-secondary">
                @(string.IsNullOrWhiteSpace(Model.AssetCode) ? "No Asset Code" : Model.AssetCode)
            </span>
        </p>
    </div>

    <div class="module-header-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.OfficeAssetId"
           class="btn-app btn-icon btn-primary-app"
           title="Edit">
            <i class="bi bi-pencil"></i>
        </a>

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Asset Information</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Asset Name</label>
                <div>@Model.AssetName</div>
            </div>

            <div class="form-group">
                <label class="form-label">Asset Category</label>
                <div>@Model.AssetCategory</div>
            </div>

            <div class="form-group">
                <label class="form-label">Asset Code</label>
                <div>@(Model.AssetCode ?? "-")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Asset Status</label>
                <div>
                    <span class="@StatusBadge(Model.Status)">
                        @StatusLabel(Model.Status)
                    </span>
                </div>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Purchase Information</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Purchase Date</label>
                <div>@Model.PurchaseDate.ToString("dd-MMM-yyyy")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Purchase Value</label>
                <div>INR @Model.PurchaseValue.ToString("N2")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Vendor Name</label>
                <div>@(Model.VendorName ?? "-")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Financial Year</label>
                <div>@Model.FinancialYear</div>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Assignment & Remarks</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Assigned To</label>
                <div>@(Model.AssignedTo ?? "-")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Record Status</label>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge-danger">Archived</span>
                    }
                </div>
            </div>

        </div>

        <div class="form-group mt-3">
            <label class="form-label">Remarks</label>
            <div>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</div>
        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Audit Information</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Created On</label>
                <div>@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Last Updated</label>
                <div>@(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</div>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-body">

        <div class="table-actions">

            <a asp-action="Edit"
               asp-route-id="@Model.OfficeAssetId"
               class="btn-app btn-icon btn-primary-app"
               title="Edit">
                <i class="bi bi-pencil"></i>
            </a>

            <form asp-action="Delete"
                  asp-route-id="@Model.OfficeAssetId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-app @(Model.IsActive ? "btn-danger-app" : "btn-success-app")"
                        onclick="return confirm('@(Model.IsActive ? "Archive this asset?" : "Activate this asset?")')">
                    <i class="bi @(Model.IsActive ? "bi-archive" : "bi-arrow-clockwise")"></i>
                    @(Model.IsActive ? "Archive Asset" : "Activate Asset")
                </button>
            </form>

            <a asp-action="Index"
               class="btn-app btn-secondary-app">
                Cancel
            </a>

        </div>

    </div>

</div>
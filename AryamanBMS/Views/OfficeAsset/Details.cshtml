@model AryamanBMS.Models.OfficeAssetModel
@using AryamanBMS.Models
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Office Asset Details";

    var history = ViewBag.AssignmentHistory as List<OfficeAssetAssignmentHistoryModel>
        ?? new List<OfficeAssetAssignmentHistoryModel>();
    var activeAssignment = ViewBag.ActiveAssignment as OfficeAssetAssignmentHistoryModel;
    var employeeOptions = ViewBag.EmployeeOptions as List<SelectListItem>
        ?? new List<SelectListItem>();

    string StatusLabel(string value) => value switch
    {
        "InUse" => "In Use",
        "UnderRepair" => "Under Repair",
        "Disposed" => "Disposed",
        "Idle" => "Idle",
        _ => value
    };

    string StatusBadge(string value) => value switch
    {
        "InUse" => "badge-success",
        "Idle" => "badge-secondary",
        "UnderRepair" => "badge-warning",
        "Disposed" => "badge-danger",
        _ => "badge-secondary"
    };
}

<div class="module-header">
    <div>
        <h1 class="module-title">OFFICE ASSET DETAILS</h1>
        <p class="module-subtitle">View asset lifecycle, current assignment and audit trail.</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.OfficeAssetId"
           class="btn-app btn-icon btn-primary-app"
           title="Edit">
            <i class="bi bi-pencil"></i>
        </a>

        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="app-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Asset Information</h2>
            <p class="card-subtitle">Primary identity, lifecycle and current record status.</p>
        </div>
    </div>

    <div class="card-body">
        <div class="details-grid">
            <div class="detail-item">
                <span class="detail-label">Asset Name</span>
                <span class="detail-value">@Model.AssetName</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Asset Category</span>
                <span class="detail-value">@Model.AssetCategory</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Asset Code</span>
                <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.AssetCode) ? "-" : Model.AssetCode)</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Status</span>
                <span class="detail-value"><span class="@StatusBadge(Model.Status)">@StatusLabel(Model.Status)</span></span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Record</span>
                <span class="detail-value">
                    @if (Model.IsActive)
                    {
                        <span class="badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge-secondary">Archived</span>
                    }
                </span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Current Assignment</span>
                <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.AssignedTo) ? "Not assigned" : Model.AssignedTo)</span>
            </div>
        </div>
    </div>
</div>

<div class="app-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Purchase & Warranty</h2>
            <p class="card-subtitle">Purchase value and warranty coverage details.</p>
        </div>
    </div>

    <div class="card-body">
        <div class="details-grid">
            <div class="detail-item">
                <span class="detail-label">Purchase Date</span>
                <span class="detail-value">@Model.PurchaseDate.ToString("dd-MMM-yyyy")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Purchase Value</span>
                <span class="detail-value">INR @Model.PurchaseValue.ToString("N2")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Vendor Name</span>
                <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.VendorName) ? "-" : Model.VendorName)</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Financial Year</span>
                <span class="detail-value">@Model.FinancialYear</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Warranty Start</span>
                <span class="detail-value">@(Model.WarrantyStartDate?.ToString("dd-MMM-yyyy") ?? "-")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Warranty End</span>
                <span class="detail-value">@(Model.WarrantyEndDate?.ToString("dd-MMM-yyyy") ?? "-")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Disposal Date</span>
                <span class="detail-value">@(Model.DisposalDate?.ToString("dd-MMM-yyyy") ?? "-")</span>
            </div>
            <div class="detail-item">
                <span class="detail-label">Remarks</span>
                <span class="detail-value">@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</span>
            </div>
        </div>
    </div>
</div>

<div class="app-card form-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Assignment Control</h2>
            <p class="card-subtitle">Keep assignment changes separate so history remains intact.</p>
        </div>
    </div>

    <div class="card-body">
        @if (activeAssignment == null)
        {
            <form asp-action="Assign" asp-route-id="@Model.OfficeAssetId" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid-3">
                    <div class="form-group">
                        <label class="form-label">Employee</label>
                        <select name="employeeId" class="app-select" required>
                            <option value="">Select Employee</option>
                            @foreach (var employee in employeeOptions)
                            {
                                <option value="@employee.Value">@employee.Text</option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Condition on Assignment</label>
                        <input name="conditionOnAssignment" class="app-input" placeholder="Working, sealed, serviced" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Remarks</label>
                        <input name="remarks" class="app-input" placeholder="Optional assignment note" />
                    </div>
                </div>

                <div class="form-actions mt-3">
                    <button type="submit" class="btn-app btn-primary-app" @(Model.IsActive && Model.Status != "Disposed" ? null : "disabled")>
                        <i class="bi bi-person-plus"></i>
                        Assign Asset
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="details-grid mb-3">
                <div class="detail-item">
                    <span class="detail-label">Assigned Employee</span>
                    <span class="detail-value">@activeAssignment.Employee.FullName</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Assigned On</span>
                    <span class="detail-value">@activeAssignment.AssignedOn.ToString("dd-MMM-yyyy hh:mm tt")</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Condition</span>
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(activeAssignment.ConditionOnAssignment) ? "-" : activeAssignment.ConditionOnAssignment)</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Remarks</span>
                    <span class="detail-value">@(string.IsNullOrWhiteSpace(activeAssignment.Remarks) ? "-" : activeAssignment.Remarks)</span>
                </div>
            </div>

            <form asp-action="Return" asp-route-id="@Model.OfficeAssetId" method="post">
                @Html.AntiForgeryToken()

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Condition on Return</label>
                        <input name="conditionOnReturn" class="app-input" placeholder="Working, damaged, repair required" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Remarks</label>
                        <input name="remarks" class="app-input" placeholder="Optional return note" />
                    </div>
                </div>

                <div class="form-actions mt-3">
                    <button type="submit" class="btn-app btn-warning-app">
                        <i class="bi bi-arrow-return-left"></i>
                        Return Asset
                    </button>
                </div>
            </form>
        }
    </div>
</div>

<div class="app-card table-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Assignment History</h2>
            <p class="card-subtitle">Every assignment and return is preserved for audit.</p>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Employee</th>
                        <th>Assigned On</th>
                        <th>Returned On</th>
                        <th>Assigned By</th>
                        <th>Returned By</th>
                        <th>Condition</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (history.Any())
                    {
                        foreach (var item in history)
                        {
                            <tr>
                                <td>@item.Employee.FullName</td>
                                <td>@item.AssignedOn.ToString("dd-MMM-yyyy hh:mm tt")</td>
                                <td>@(item.ReturnedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</td>
                                <td>@item.AssignedByUserId</td>
                                <td>@(string.IsNullOrWhiteSpace(item.ReturnedByUserId) ? "-" : item.ReturnedByUserId)</td>
                                <td>
                                    Assign: @(string.IsNullOrWhiteSpace(item.ConditionOnAssignment) ? "-" : item.ConditionOnAssignment)
                                    <br />
                                    Return: @(string.IsNullOrWhiteSpace(item.ConditionOnReturn) ? "-" : item.ConditionOnReturn)
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Closed</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="empty-state">No assignment history available.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="app-card">
    <div class="card-body">
        <div class="form-actions">
            <a asp-action="Edit"
               asp-route-id="@Model.OfficeAssetId"
               class="btn-app btn-primary-app">
                <i class="bi bi-pencil"></i>
                Edit
            </a>

            <form asp-action="Delete"
                  asp-route-id="@Model.OfficeAssetId"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-app @(Model.IsActive ? "btn-danger-app" : "btn-success-app")"
                        onclick="return confirm('@(Model.IsActive ? "Archive this asset?" : "Activate this asset?")')">
                    <i class="bi @(Model.IsActive ? "bi-archive" : "bi-arrow-clockwise")"></i>
                    @(Model.IsActive ? "Archive Asset" : "Activate Asset")
                </button>
            </form>

            <a asp-action="Index" class="btn-app btn-secondary-app">
                Cancel
            </a>
        </div>
    </div>
</div>

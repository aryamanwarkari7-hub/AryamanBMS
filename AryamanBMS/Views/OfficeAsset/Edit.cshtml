@model AryamanBMS.Models.OfficeAssetModel

@{
    ViewData["Title"] = "Edit Office Asset";
}

<div class="module-header">
    <div>
        <h1 class="module-title">EDIT OFFICE ASSET</h1>
        <p class="module-subtitle">Update lifecycle, purchase and warranty information without losing assignment history.</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Details" asp-route-id="@Model.OfficeAssetId" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<form asp-action="Edit" asp-route-id="@Model.OfficeAssetId" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="OfficeAssetId" type="hidden" />

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Asset Information</h2>
                <p class="card-subtitle">Revise the asset identity and current lifecycle status.</p>
            </div>
        </div>

        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="AssetName" class="form-label">Asset Name <span class="validation-message">*</span></label>
                    <input asp-for="AssetName" class="app-input" />
                    <span asp-validation-for="AssetName" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AssetCategory" class="form-label">Asset Category <span class="validation-message">*</span></label>
                    <select asp-for="AssetCategory" class="app-select">
                        <option value="">Select Category</option>
                        <option value="Laptop">Laptop</option>
                        <option value="Furniture">Furniture</option>
                        <option value="AC">AC</option>
                        <option value="Projector">Projector</option>
                        <option value="Printer">Printer</option>
                        <option value="Vehicle">Vehicle</option>
                        <option value="Other">Other</option>
                    </select>
                    <span asp-validation-for="AssetCategory" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AssetCode" class="form-label">Asset Code</label>
                    <input asp-for="AssetCode" class="app-input" />
                    <span asp-validation-for="AssetCode" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status" class="form-label">Status <span class="validation-message">*</span></label>
                    <select asp-for="Status" class="app-select">
                        <option value="Idle">Idle</option>
                        <option value="InUse">In Use</option>
                        <option value="UnderRepair">Under Repair</option>
                        <option value="Disposed">Disposed</option>
                    </select>
                    <span asp-validation-for="Status" class="validation-message"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Purchase & Warranty</h2>
                <p class="card-subtitle">Maintain the purchase record and warranty lifecycle.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="PurchaseDate" class="form-label">Purchase Date <span class="validation-message">*</span></label>
                    <input asp-for="PurchaseDate" type="date" class="app-input" />
                    <span asp-validation-for="PurchaseDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PurchaseValue" class="form-label">Purchase Value <span class="validation-message">*</span></label>
                    <input asp-for="PurchaseValue" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="PurchaseValue" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="VendorName" class="form-label">Vendor Name</label>
                    <input asp-for="VendorName" class="app-input" />
                    <span asp-validation-for="VendorName" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FinancialYear" class="form-label">Financial Year <span class="validation-message">*</span></label>
                    <input asp-for="FinancialYear" class="app-input" />
                    <span asp-validation-for="FinancialYear" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="WarrantyStartDate" class="form-label">Warranty Start</label>
                    <input asp-for="WarrantyStartDate" type="date" class="app-input" />
                    <span asp-validation-for="WarrantyStartDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="WarrantyEndDate" class="form-label">Warranty End</label>
                    <input asp-for="WarrantyEndDate" type="date" class="app-input" />
                    <span asp-validation-for="WarrantyEndDate" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DisposalDate" class="form-label">Disposal Date</label>
                    <input asp-for="DisposalDate" type="date" class="app-input" />
                    <span asp-validation-for="DisposalDate" class="validation-message"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card form-card">
        <div class="card-header">
            <div>
                <h2 class="card-title">Assignment & Notes</h2>
                <p class="card-subtitle">Use the details page to assign or return the asset and keep history intact.</p>
            </div>
        </div>

        <div class="card-body">
            <div class="form-grid-1">
                <div class="form-group">
                    <label class="form-label">Current Assignment</label>
                    <input class="app-input" value="@(string.IsNullOrWhiteSpace(Model.AssignedTo) ? "Not assigned" : Model.AssignedTo)" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="Remarks" class="form-label">Remarks</label>
                    <textarea asp-for="Remarks" class="app-input" rows="4"></textarea>
                    <span asp-validation-for="Remarks" class="validation-message"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-body form-actions">
            <button type="submit" class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Update
            </button>

            <a asp-action="Details" asp-route-id="@Model.OfficeAssetId" class="btn-app btn-secondary-app">
                Cancel
            </a>
        </div>
    </div>
</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

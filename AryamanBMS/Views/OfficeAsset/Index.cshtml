@model IEnumerable<AryamanBMS.Models.OfficeAssetModel>

@{
    ViewData["Title"] = "Office Assets";

    var assets = Model?.ToList() ?? new List<AryamanBMS.Models.OfficeAssetModel>();

    string financialYear = ViewBag.FilterFinancialYear as string ?? "";
    string category = ViewBag.FilterCategory as string ?? "";
    string status = ViewBag.FilterStatus as string ?? "";
    string search = ViewBag.Search as string ?? "";
    string sortBy = ViewBag.SortBy as string ?? "PurchaseDate";
    string sortOrder = ViewBag.SortOrder as string ?? "desc";

    string StatusLabel(string value) => value switch
    {
        "InUse" => "In Use",
        "UnderRepair" => "Under Repair",
        "Disposed" => "Disposed",
        "Idle" => "Idle",
        _ => value
    };

    string StatusBadge(string value) => value switch
    {
        "InUse" => "badge-success",
        "Idle" => "badge-secondary",
        "UnderRepair" => "badge-warning",
        "Disposed" => "badge-danger",
        _ => "badge-secondary"
    };
}

<div class="module-header">
    <div>
        <h1 class="module-title">OFFICE ASSETS</h1>
        <p class="module-subtitle">Track office assets, assignment and asset status.</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            Add Asset
        </a>
    </div>
</div>

<div class="app-card form-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Asset Filter</h2>
            <p class="card-subtitle">Filter assets by financial year and category.</p>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Index" method="get">
            <input type="hidden" name="status" value="@status" />

            <div class="filter-form-row">

                <div class="form-group">
                    <label class="form-label">Financial Year</label>
                    <input name="financialYear"
                           value="@financialYear"
                           class="app-input"
                           placeholder="2026-27" />
                </div>

                <div class="form-group">
                    <label class="form-label">Category</label>
                    <select name="category" class="app-select">
                        <option value="">All Categories</option>
                        <option value="Laptop" selected="@(category == "Laptop")">Laptop</option>
                        <option value="Furniture" selected="@(category == "Furniture")">Furniture</option>
                        <option value="AC" selected="@(category == "AC")">AC</option>
                        <option value="Projector" selected="@(category == "Projector")">Projector</option>
                        <option value="Printer" selected="@(category == "Printer")">Printer</option>
                        <option value="Vehicle" selected="@(category == "Vehicle")">Vehicle</option>
                        <option value="Other" selected="@(category == "Other")">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Search</label>
                    <input name="search"
                           value="@search"
                           class="app-input"
                           placeholder="Asset name, code, category, location or assignee" />
                </div>

                <div class="form-group">
                    <label class="form-label">Sort By</label>
                    <select name="sortBy" class="app-select">
                        <option value="PurchaseDate" selected="@(sortBy == "PurchaseDate")">Purchase Date</option>
                        <option value="AssetName" selected="@(sortBy == "AssetName")">Asset Name</option>
                        <option value="AssetCode" selected="@(sortBy == "AssetCode")">Asset Code</option>
                        <option value="Category" selected="@(sortBy == "Category")">Category</option>
                        <option value="Value" selected="@(sortBy == "Value")">Value</option>
                        <option value="AssignedTo" selected="@(sortBy == "AssignedTo")">Assigned To</option>
                        <option value="FinancialYear" selected="@(sortBy == "FinancialYear")">FY</option>
                        <option value="Status" selected="@(sortBy == "Status")">Status</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Order</label>
                    <select name="sortOrder" class="app-select">
                        <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                    </select>
                </div>

                <div class="filter-form-actions">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-search"></i>
                        Search
                    </button>

                    <a asp-action="Index" class="btn-app btn-secondary-app">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>
                </div>

            </div>
        </form>
    </div>
</div>

<div class="app-card table-card">
    <div class="card-header">
        <div>
            <h2 class="card-title">Asset Register</h2>
            <p class="card-subtitle">Use quick filters below to view assets by status.</p>
        </div>
    </div>

    <div class="card-body">

        <div class="module-header-actions justify-content-start mb-3">
            <a asp-action="Index"
               asp-route-financialYear="@financialYear"
               asp-route-category="@category"
               asp-route-search="@search"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               class="btn-app @(string.IsNullOrWhiteSpace(status) ? "btn-primary-app" : "btn-secondary-app")">
                All
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@financialYear"
               asp-route-category="@category"
               asp-route-search="@search"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-status="InUse"
               class="btn-app @(status == "InUse" ? "btn-primary-app" : "btn-secondary-app")">
                In Use
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@financialYear"
               asp-route-category="@category"
               asp-route-search="@search"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-status="Idle"
               class="btn-app @(status == "Idle" ? "btn-primary-app" : "btn-secondary-app")">
                Idle
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@financialYear"
               asp-route-category="@category"
               asp-route-search="@search"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-status="UnderRepair"
               class="btn-app @(status == "UnderRepair" ? "btn-primary-app" : "btn-secondary-app")">
                Under Repair
            </a>

            <a asp-action="Index"
               asp-route-financialYear="@financialYear"
               asp-route-category="@category"
               asp-route-search="@search"
               asp-route-sortBy="@sortBy"
               asp-route-sortOrder="@sortOrder"
               asp-route-status="Disposed"
               class="btn-app @(status == "Disposed" ? "btn-primary-app" : "btn-secondary-app")">
                Disposed
            </a>
        </div>

        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Asset</th>
                        <th>Category</th>
                        <th>Code</th>
                        <th>Purchase Date</th>
                        <th class="text-end">Value</th>
                        <th>Assigned To</th>
                        <th>FY</th>
                        <th>Status</th>
                        <th>Record</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (assets.Any())
                    {
                        foreach (var asset in assets)
                        {
                            <tr>
                                <td>@asset.AssetName</td>
                                <td>@asset.AssetCategory</td>
                                <td>@(asset.AssetCode ?? "-")</td>
                                <td>@asset.PurchaseDate.ToString("dd-MMM-yyyy")</td>
                                <td class="text-end">INR @asset.PurchaseValue.ToString("N2")</td>
                                <td>@(asset.AssignedEmployee?.FullName ?? asset.AssignedTo ?? "-")</td>
                                <td>@asset.FinancialYear</td>
                                <td>
                                    <span class="@StatusBadge(asset.Status)">
                                        @StatusLabel(asset.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (asset.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Archived</span>
                                    }
                                </td>
                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details"
                                           asp-route-id="@asset.OfficeAssetId"
                                           class="btn-app btn-icon btn-primary-app">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@asset.OfficeAssetId"
                                           class="btn-app btn-icon btn-secondary-app">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@asset.OfficeAssetId"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-app btn-icon @(asset.IsActive ? "btn-danger-app" : "btn-success-app")"
                                                    onclick="return confirm('@(asset.IsActive ? "Archive this asset?" : "Activate this asset?")')">
                                                <i class="bi @(asset.IsActive ? "bi-archive" : "bi-arrow-clockwise")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="10" class="empty-state">
                                No office assets found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

    </div>
</div>

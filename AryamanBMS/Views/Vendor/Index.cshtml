@model IEnumerable<VendorModel>

@{
    ViewData["Title"] = "Vendors";
    string search = ViewBag.Search as string ?? "";
}

<div class="module-header">
    <div>
        <h1 class="module-title">VENDORS</h1>
        <p class="module-subtitle">Manage vendor GST, payment and bank details.</p>
    </div>
    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            New Vendor
        </a>
    </div>
</div>



<div class="app-card table-card">
    <div class="card-header">
        <form method="get" class="w-100">
            <div class="filter-form-row">

                <div class="form-group">
                    <label class="form-label">Search</label>
                    <input name="search"
                           value="@search"
                           class="app-input"
                           placeholder="Code / name / GSTIN / PAN"
                           autocomplete="off" />
                </div>

                <div class="form-group">
                    <label class="form-label">Sort By</label>
                    <select name="sortBy" class="app-select">
                        <option value="VendorName" selected="@(ViewBag.SortBy == "VendorName")">Vendor Name</option>
                        <option value="VendorCode" selected="@(ViewBag.SortBy == "VendorCode")">Vendor Code</option>
                        <option value="GSTIN" selected="@(ViewBag.SortBy == "GSTIN")">GSTIN</option>
                        <option value="PAN" selected="@(ViewBag.SortBy == "PAN")">PAN</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Order</label>
                    <select name="sortOrder" class="app-select">
                        <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Descending</option>
                    </select>
                </div>

                <div class="filter-form-actions">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-search"></i>
                        Search
                    </button>

                    <a asp-action="Index" class="btn-app btn-secondary-app">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>
                </div>

            </div>
        </form>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Vendor</th>
                        <th>GSTIN</th>
                        <th>PAN</th>
                        <th>State</th>
                        <th>Payment Terms</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><strong>@item.VendorCode</strong></td>
                            <td>@item.VendorName</td>
                            <td>@(item.GSTIN ?? "-")</td>
                            <td>@(item.PAN ?? "-")</td>
                            <td>@(item.State ?? "-")</td>
                            <td>@(item.PaymentTerms ?? "-")</td>
                            <td>
                                <div class="table-actions">
                                    <a asp-action="Edit" asp-route-id="@item.VendorId" class="btn-app btn-icon btn-secondary-app" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Deactivate" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.VendorId" />
                                        <button type="submit" class="btn-app btn-icon btn-danger-app" title="Deactivate" onclick="return confirm('Deactivate this vendor?')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

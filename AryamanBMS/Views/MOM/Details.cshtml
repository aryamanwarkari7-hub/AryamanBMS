
@model AryamanBMS.ViewModels.ProjectMeetingDetailsViewModel

@{
    ViewData["Title"] = "Meeting Details";

    var meeting = Model.Meeting;

    var employees = Model.Employees
        ?? Enumerable.Empty<AryamanBMS.Models.EmployeeModel>();

    var activeActionItems = meeting.ActionItems
        .Where(a => a.IsActive)
        .ToList();

    string projectText =
        $"{meeting.Project?.ProjectCode ?? "-"} - {meeting.Project?.ProjectName ?? "Project unavailable"}";

    string meetingTimeText = meeting.StartTime.ToString(@"hh\:mm");

    if (meeting.EndTime.HasValue)
    {
        meetingTimeText += $" - {meeting.EndTime.Value.ToString(@"hh\:mm")}";
    }

    string statusClass = meeting.MeetingStatus switch
    {
        "Completed" => "badge-success",
        "Cancelled" => "badge-danger",
        "Scheduled" => "badge-info",
        "Postponed" => "badge-warning",
        _ => "badge-secondary"
    };

    string activeClass = meeting.IsActive ? "badge-success" : "badge-danger";
    string activeText = meeting.IsActive ? "Active" : "Inactive";
}

<div class="module-header">
    <div>
        <h1 class="module-title">@meeting.MeetingTitle</h1>
        <p class="module-subtitle">
            Minutes, attendees and action items
        </p>
    </div>

    <div class="module-header-actions">
        @if (ViewBag.CanEditMeeting == true)
        {
            <a asp-action="Edit"
               asp-route-id="@meeting.Id"
               class="btn-app btn-primary-app">
                <i class="bi bi-pencil"></i>
                Edit
            </a>
        }

        <a asp-action="Index"
           asp-route-projectId="@meeting.ProjectId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Meeting Date</div>
            <div class="detail-summary-value">
                @meeting.MeetingDate.ToString("dd-MMM-yyyy")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Time</div>
            <div class="detail-summary-value">@meetingTimeText</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Mode</div>
            <div class="detail-summary-value">@(meeting.MeetingMode ?? "-")</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@statusClass">@(meeting.MeetingStatus ?? "-")</span>
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Meeting Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Project</span>
                        <strong class="detail-info-value">@projectText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Meeting</span>
                        <strong class="detail-info-value">@meeting.MeetingTitle</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Date</span>
                        <strong class="detail-info-value">
                            @meeting.MeetingDate.ToString("dd-MMM-yyyy")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Time</span>
                        <strong class="detail-info-value">@meetingTimeText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Mode</span>
                        <strong class="detail-info-value">@(meeting.MeetingMode ?? "-")</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Meeting Status</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Location / Link</span>
                        <strong class="detail-info-value">
                            @(meeting.LocationOrLink ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Status</span>
                        <strong class="detail-info-value">
                            <span class="@statusClass">@(meeting.MeetingStatus ?? "-")</span>
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Next Meeting</span>
                        <strong class="detail-info-value">
                            @(meeting.NextMeetingDate?.ToString("dd-MMM-yyyy") ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Active</span>
                        <strong class="detail-info-value">
                            <span class="@activeClass">@activeText</span>
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="detail-grid-3">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Agenda</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(meeting.Agenda) ? "No agenda recorded." : meeting.Agenda)
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Discussion Summary</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(meeting.DiscussionSummary) ? "No discussion summary recorded." : meeting.DiscussionSummary)
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Decisions Taken</h5>
            </div>

            <div class="card-body">
                <div class="detail-note-box">
                    @(string.IsNullOrWhiteSpace(meeting.DecisionsTaken) ? "No decisions recorded." : meeting.DecisionsTaken)
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Meeting Attendees</h5>
        </div>

        <div class="card-body">
            @if (ViewBag.CanEditMeeting == true)
            {
            <form asp-action="AddAttendee" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="meetingId" value="@meeting.Id" />

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Employee</label>
                        <select name="employeeId" class="app-select" required>
                            <option value="">Select Employee</option>
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">
                                    @employee.EmployeeCode - @employee.FullName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Attendance</label>
                        <select name="isPresent" class="app-select">
                            <option value="true">Present</option>
                            <option value="false">Absent</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Remarks</label>
                        <input type="text" name="remarks" class="app-input" />
                    </div>

                    <div class="form-group d-flex align-items-end">
                        <button type="submit" class="btn-app btn-primary-app">
                            <i class="bi bi-plus-lg"></i>
                            Add Attendee
                        </button>
                    </div>
                </div>
            </form>
            }

            <div class="table-responsive mt-4">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Attendance</th>
                            <th>Remarks</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (meeting.Attendees.Any())
                        {
                            foreach (var attendee in meeting.Attendees)
                            {
                                <tr>
                                    <td>
                                        @attendee.Employee?.EmployeeCode -
                                        @attendee.Employee?.FullName
                                    </td>

                                    <td>
                                        @if (attendee.IsPresent)
                                        {
                                            <span class="badge-success">Present</span>
                                        }
                                        else
                                        {
                                            <span class="badge-danger">Absent</span>
                                        }
                                    </td>

                                    <td>@(attendee.Remarks ?? "-")</td>

                                    <td>
                                        @if (ViewBag.CanEditMeeting == true)
                                        {
                                            <form asp-action="DeleteAttendee" method="post">
                                                @Html.AntiForgeryToken()
                                            
                                                <input type="hidden" name="id" value="@attendee.Id" />
                                            
                                                <button type="submit"
                                                        class="btn-app btn-icon btn-danger-app"
                                                        title="Remove">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="empty-state">
                                    No attendees added.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Action Items</h5>
        </div>

        <div class="card-body">
            @if (ViewBag.CanEditMeeting == true)
{
            <form asp-action="AddActionItem" method="post">
                @Html.AntiForgeryToken()

                <input type="hidden" name="MeetingId" value="@meeting.Id" />

                <div class="form-grid-2">
                    <div class="form-group">
                        <label class="form-label">Action Title</label>
                        <input type="text" name="ActionTitle" class="app-input" required />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Assigned Employee</label>
                        <select name="AssignedEmployeeId" class="app-select">
                            <option value="">Not Assigned</option>
                            @foreach (var employee in employees)
                            {
                                <option value="@employee.Id">
                                    @employee.EmployeeCode - @employee.FullName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Due Date</label>
                        <input type="date"
                               name="DueDate"
                               min="@meeting.MeetingDate.ToString("yyyy-MM-dd")"
                               class="app-input" />
                    </div>

                    <div class="form-group">
                        <label class="form-label">Description</label>
                        <input type="text" name="Description" class="app-input" />
                    </div>
                </div>

                <button type="submit" class="btn-app btn-primary-app mt-3">
                    <i class="bi bi-plus-lg"></i>
                    Add Action Item
                </button>
            </form>
            }

            <div class="table-responsive mt-4">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>Assigned To</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th>Completed On</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (activeActionItems.Any())
                        {
                            foreach (var item in activeActionItems)
                            {
                                <tr>
                                    <td>
                                        <strong>@item.ActionTitle</strong>

                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <div class="text-muted">@item.Description</div>
                                        }
                                    </td>

                                    <td>@(item.AssignedEmployee?.FullName ?? "Not Assigned")</td>
                                    <td>@(item.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                                    <td>@item.ActionStatus</td>
                                    <td>@(item.CompletedOn?.ToString("dd-MMM-yyyy") ?? "-")</td>

                                    <td>
                                        <div class="action-buttons d-flex flex-row gap-1">
                                            <a asp-action="EditActionItem"
                                               asp-route-id="@item.Id"
                                               class="btn-icon btn-secondary-app"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>
        @if (ViewBag.CanEditMeeting == true)
        {
                                            <form asp-action="DeleteActionItem" method="post">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="id" value="@item.Id" />

                                                <button type="submit"
                                                        class="btn-icon btn-danger-app"
                                                        title="Deactivate">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="empty-state">
                                    No action items added.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

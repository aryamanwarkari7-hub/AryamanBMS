@model List<AryamanBMS.Models.HolidayModel>

@{
    ViewData["Title"] = "Holiday Register";

    int selectedYear = ViewBag.Year;
    int? selectedMonth = ViewBag.Month as int?;
    string selectedStatus = ViewBag.Status as string ?? "All";
    int currentPage = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 12;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count;
    int totalPages = ViewBag.TotalPages ?? 1;
    string sortBy = ViewBag.SortBy as string ?? "HolidayDate";
    string sortOrder = ViewBag.SortOrder as string ?? "asc";

    var pagination = new AryamanBMS.ViewModels.PaginationViewModel
    {
        CurrentPage = currentPage,
        PageSize = pageSize,
        TotalRecords = totalRecords,
        ControllerName = "Holiday",
        ActionName = "Index",
        RouteValues = new Dictionary<string, string>
        {
            ["year"] = selectedYear.ToString(),
            ["sortBy"] = sortBy,
            ["sortOrder"] = sortOrder
        }
    };

    if (selectedMonth.HasValue)
    {
        pagination.RouteValues["month"] = selectedMonth.Value.ToString();
    }

    if (selectedStatus != "All")
    {
        pagination.RouteValues["status"] = selectedStatus;
    }
}

<div class="module-header">
    <div>
        <h1 class="module-title">Holiday Register</h1>
        <p class="module-subtitle">
            Manage yearly office holidays used for attendance and payroll.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="DownloadTemplate" class="btn-app btn-outline-app">
            <i class="bi bi-download"></i>
            Blank Template
        </a>
        <a asp-action="ExportExcel"
           asp-route-year="@selectedYear"
           asp-route-month="@selectedMonth"
           asp-route-status="@selectedStatus"
           class="btn-app btn-success-app">
            <i class="bi bi-file-earmark-excel"></i>
            Export Excel
        </a>
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-header">
        <div class="card-heading">
            <h2 class="card-title">Filters</h2>
            <p class="card-subtitle">Filter holidays by year, month, and status.</p>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Year</label>
                <input type="number"
                       name="year"
                       value="@selectedYear"
                       class="app-input" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Month</label>
                <select name="month" class="app-input">
                    <option value="">All Months</option>
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m" selected="@(selectedMonth == m)">
                            @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="app-input">
                    <option value="All" selected="@(selectedStatus == "All")">All</option>
                    <option value="Active" selected="@(selectedStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(selectedStatus == "Inactive")">Inactive</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="app-input">
                    <option value="HolidayDate" selected="@(sortBy == "HolidayDate")">Date</option>
                    <option value="HolidayName" selected="@(sortBy == "HolidayName")">Holiday Name</option>
                    <option value="HolidayType" selected="@(sortBy == "HolidayType")">Type</option>
                    <option value="Status" selected="@(sortBy == "Status")">Status</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label">Order</label>
                <select name="sortOrder" class="app-input">
                    <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                    <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-app btn-primary-app flex-fill">
                    <i class="bi bi-funnel"></i>
                    Apply
                </button>

                <a asp-action="Index" class="btn-app btn-secondary-app">
                    Reset
                </a>
            </div>
        </form>
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-header">
        <div class="card-heading">
            <h2 class="card-title">Import Holiday Excel</h2>
            <p class="card-subtitle">Upload Excel with columns: Month, Date, Day, Festival.</p>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="ImportExcel"
              method="post"
              enctype="multipart/form-data"
              class="row g-3 align-items-end">

            @Html.AntiForgeryToken()

            <input type="hidden" name="year" value="@selectedYear" />

            <div class="col-md-8">
                <label class="form-label">Holiday Excel</label>
                <input type="file"
                       name="file"
                       class="app-input"
                       accept=".xlsx"
                       required />
            </div>

            <div class="col-md-4">
                <button type="submit" class="btn-app btn-primary-app w-100">
                    <i class="bi bi-upload"></i>
                    Import Holidays
                </button>
            </div>
        </form>
    </div>
</div>

<div class="app-card">
    <div class="card-header">
        <div class="card-heading">
            <h2 class="card-title">Holiday List</h2>
            <p class="card-subtitle">@totalRecords holiday(s) found.</p>
        </div>
    </div>

    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="app-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Month</th>
                        <th>Holiday Name</th>
                        <th>Type</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No holidays found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        for (int index = 0; index < Model.Count; index++)
                        {
                            var item = Model[index];
                            int serialNumber = ((currentPage - 1) * pageSize) + index + 1;

                            <tr>
                                <td>@serialNumber</td>
                                <td>@item.HolidayDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.DayName</td>
                                <td>@item.MonthName</td>
                                <td>@item.HolidayName</td>
                                <td>@item.HolidayType</td>
                                <td>
                                    <span class="status-badge @(item.IsActive ? "success" : "muted")">
                                        @(item.IsActive ? "Active" : "Inactive")
                                    </span>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <partial name="_Pagination" model="pagination" />
    </div>
</div>

@model AryamanBMS.ViewModels.CompanyDocumentViewModel

@{
    ViewData["Title"] = "Upload Company Document";
}

<div class="module-content">

    <div class="row mb-3">

        <div class="col-md-12">

            <h3>
                <i class="bi bi-upload text-primary"></i>
                Upload Company Document
            </h3>

            <hr />

        </div>

    </div>

    <div class="app-card">

        <div class="card-body">

            <form asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                <div asp-validation-summary="ModelOnly"
                     class="app-alert-danger">
                </div>

                <partial name="_DocumentForm" model="Model" />

                <hr />

                <div class="text-end">

                    <button type="submit"
                            class="btn-app btn-primary-app">

                        <i class="bi bi-check-circle"></i>

                        Save

                    </button>

                    <a asp-action="Index"
                       class="btn-app btn-secondary-app">

                        <i class="bi bi-arrow-left"></i>

                        Back

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
@model IEnumerable<AryamanBMS.Models.CompanyDocumentModel>

@{
    ViewData["Title"] = "Company Documents";

    string search = ViewBag.Search as string ?? "";
    int? categoryId = ViewBag.CategoryId as int?;
    string statusFilter = ViewBag.Status as string ?? "";
    string sortBy = ViewBag.SortBy as string ?? "CreatedOn";
    string sortOrder = ViewBag.SortOrder as string ?? "desc";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Company Documents</h1>
        <p class="module-subtitle">
            Manage company legal and compliance documents
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            Upload Document
        </a>
    </div>
</div>

<div>
    <div class="app-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Document Register</h2>
                <p class="card-subtitle">
                    Search and manage uploaded company documents.
                </p>
            </div>
        </div>

        <div class="card-body">
            <form method="get" class="w-100 mb-3">
                <input type="hidden"
                       name="status"
                       value="@statusFilter" />

                <div class="filter-row">
                    <div class="filter-field filter-field-wide">
                        <input name="search"
                               value="@search"
                               class="app-input"
                               placeholder="Document, category, number or issuer" />
                    </div>

                    <div class="filter-field">
                        <select name="categoryId" class="app-select">
                            <option value="">All Categories</option>
                            @foreach (var category in ViewBag.Categories)
                            {
                                <option value="@category.DocumentCategoryId"
                                        selected="@(categoryId.HasValue && categoryId.Value == category.DocumentCategoryId)">
                                    @category.CategoryName
                                </option>
                            }
                        </select>
                    </div>

                    <div class="filter-field">
                        <select name="sortBy" class="app-select">
                            <option value="CreatedOn" selected="@(sortBy == "CreatedOn")">Sort by Uploaded</option>
                            <option value="Document" selected="@(sortBy == "Document")">Sort by Document</option>
                            <option value="Category" selected="@(sortBy == "Category")">Sort by Category</option>
                            <option value="DocumentNo" selected="@(sortBy == "DocumentNo")">Sort by Document No</option>
                            <option value="IssueDate" selected="@(sortBy == "IssueDate")">Sort by Issue Date</option>
                            <option value="ExpiryDate" selected="@(sortBy == "ExpiryDate")">Sort by Expiry Date</option>
                            <option value="Active" selected="@(sortBy == "Active")">Sort by Active</option>
                        </select>
                    </div>

                    <div class="filter-field">
                        <select name="sortOrder" class="app-select">
                            <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                            <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                        </select>
                    </div>

                    <div class="filter-actions">
                        <button type="submit" class="btn-app btn-primary-app">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        <a asp-action="Index" class="btn-app btn-secondary-app">
                            <i class="bi bi-arrow-clockwise"></i>
                            Reset
                        </a>
                    </div>
                </div>
            </form>

            <div class="module-header-actions justify-content-start mb-3">
                <a asp-action="Index"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   class="btn-app @(string.IsNullOrWhiteSpace(statusFilter) ? "btn-primary-app" : "btn-secondary-app")">
                    All
                </a>

                <a asp-action="Index"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-status="Active"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   class="btn-app @(statusFilter == "Active" ? "btn-primary-app" : "btn-secondary-app")">
                    Active
                </a>

                <a asp-action="Index"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-status="Archived"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   class="btn-app @(statusFilter == "Archived" ? "btn-primary-app" : "btn-secondary-app")">
                    Archived
                </a>

                <a asp-action="Index"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-status="Expiring"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   class="btn-app @(statusFilter == "Expiring" ? "btn-primary-app" : "btn-secondary-app")">
                    Expiring
                </a>

                <a asp-action="Index"
                   asp-route-search="@search"
                   asp-route-categoryId="@categoryId"
                   asp-route-status="Expired"
                   asp-route-sortBy="@sortBy"
                   asp-route-sortOrder="@sortOrder"
                   class="btn-app @(statusFilter == "Expired" ? "btn-primary-app" : "btn-secondary-app")">
                    Expired
                </a>
            </div>

            <div class="table-responsive">

                <table class="app-table"
                       id="documentTable">

                    <thead >

                        <tr>

                            <th>Document</th>

                            <th>Category</th>

                            <th>Document No.</th>

                            <th>Issue Date</th>

                            <th>Expiry Date</th>

                            <th>Status</th>

                           <th class="text-center">Active</th>

                            <th>Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var status = "Valid";
                                var badge = "badge-success";

                                if (item.ExpiryDate.HasValue)
                                {
                                    if (item.ExpiryDate.Value < DateTime.Today)
                                    {
                                        status = "Expired";
                                        badge = "badge-danger";
                                    }
                                    else if (item.ExpiryDate.Value <= DateTime.Today.AddDays(30))
                                    {
                                        status = "Expiring";
                                        badge = "badge-warning";
                                    }
                                }

                                <tr>

                                    <td>

                                        <strong>
                                            @item.DocumentName
                                        </strong>

                                    </td>

                                    <td>

                                        @item.Category?.CategoryName

                                    </td>

                                    <td>

                                        @item.DocumentNumber

                                    </td>

                                    <td>

                                        @(item.IssueDate?.ToString("dd-MMM-yyyy"))

                                    </td>

                                    <td>

                                        @(item.ExpiryDate?.ToString("dd-MMM-yyyy"))

                                    </td>

                                    <td>

                                        <span class="@badge">

                                            @status

                                        </span>

                                    </td>

                                    <td class="text-center">
                                        @if (item.IsActive)
                                        {
                                            <span class="badge-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge-secondary">Archived</span>
                                        }
                                    </td>

                                        <td class="text-center">
                                            <div class="table-actions">

                                                <a asp-action="Details"
                                                   asp-route-id="@item.CompanyDocumentId"
                                                   class="btn-app btn-icon btn-primary-app"
                                                   title="Details">
                                                    <i class="bi bi-eye"></i>
                                                </a>

                                                <a asp-action="Edit"
                                                   asp-route-id="@item.CompanyDocumentId"
                                                   class="btn-app btn-icon btn-secondary-app"
                                                   title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                @if (item.IsActive)
                                                {
                                                    <a asp-action="Download"
                                                       asp-route-id="@item.CompanyDocumentId"
                                                       class="btn-app btn-icon btn-success-app"
                                                       title="Download">
                                                        <i class="bi bi-download"></i>
                                                    </a>
                                                }

                                                <a asp-action="Delete"
                                                   asp-route-id="@item.CompanyDocumentId"
                                                   class="btn-app btn-icon btn-danger-app"
                                                   title="Archive / Activate">
                                                    <i class="bi bi-archive"></i>
                                                </a>

                                            </div>
                                        </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                    <td colspan="8"
                                        class="empty-state">
                                        No company documents found.
                                    </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@model IEnumerable<AryamanBMS.Models.CompanyDocumentModel>

@{
    ViewData["Title"] = "Company Documents";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Company Documents</h1>
        <p class="module-subtitle">
            Manage company legal and compliance documents
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            Upload Document
        </a>
    </div>
</div>

<div>

    @if (TempData["Success"] != null)
    {
        <div class="app-alert-success">
            @TempData["Success"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="app-alert-danger">
            @TempData["Error"]
            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Filters</h5>

            <div class="row">

                <div class="col-md-4">

                    <input type="text"
                           id="searchBox"
                           class="app-input"
                           placeholder="Search Document..." />

                </div>

            </div>

        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="app-table"
                       id="documentTable">

                    <thead >

                        <tr>

                            <th>Document</th>

                            <th>Category</th>

                            <th>Document No.</th>

                            <th>Issue Date</th>

                            <th>Expiry Date</th>

                            <th>Status</th>

                            <th width="220">Action</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            @foreach (var item in Model)
                            {
                                var status = "Valid";
                                var badge = "badge-success";

                                if (item.ExpiryDate.HasValue)
                                {
                                    if (item.ExpiryDate.Value < DateTime.Today)
                                    {
                                        status = "Expired";
                                        badge = "badge-danger";
                                    }
                                    else if (item.ExpiryDate.Value <= DateTime.Today.AddDays(30))
                                    {
                                        status = "Expiring";
                                        badge = "badge-warning";
                                    }
                                }

                                <tr>

                                    <td>

                                        <strong>
                                            @item.DocumentName
                                        </strong>

                                    </td>

                                    <td>

                                        @item.Category?.CategoryName

                                    </td>

                                    <td>

                                        @item.DocumentNumber

                                    </td>

                                    <td>

                                        @(item.IssueDate?.ToString("dd-MMM-yyyy"))

                                    </td>

                                    <td>

                                        @(item.ExpiryDate?.ToString("dd-MMM-yyyy"))

                                    </td>

                                    <td>

                                        <span class="@badge">

                                            @status

                                        </span>

                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@item.CompanyDocumentId"
                                           class="btn-app btn-icon btn-primary-app">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.CompanyDocumentId"
                                           class="btn-app btn-icon btn-secondary-app">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>

                                        <a asp-action="Download"
                                           asp-route-id="@item.CompanyDocumentId"
                                           class="btn-app btn-icon btn-success-app">

                                            <i class="bi bi-download"></i>

                                        </a>

                                        <form asp-action="Delete"
                                              asp-route-id="@item.CompanyDocumentId"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="btn-app btn-icon btn-danger-app"
                                                    onclick="return confirm('Delete this document?');">

                                                <i class="bi bi-trash"></i>

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7"
                                    class="text-center text-muted">

                                    No Company Documents Found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchBox")
        .addEventListener("keyup", function(){

        let value=this.value.toLowerCase();

        let rows=document.querySelectorAll("#documentTable tbody tr");

        rows.forEach(function(row){

        row.style.display=row.innerText.toLowerCase().includes(value)
        ? ""
        : "none";

        });

        });

    </script>

}

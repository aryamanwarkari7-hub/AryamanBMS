@model AryamanBMS.ViewModels.CompanyDocumentViewModel

@{
    ViewData["Title"] = "Edit Company Document";
}

<div class="module-content">

    <div class="row mb-3">

        <div class="col-md-12">

            <h3>
                <i class="bi bi-file-earmark-text-pen text-warning"></i>
                Edit Company Document
            </h3>

            <hr />

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">

            <strong>
                Update Document Information
            </strong>

        </div>

        <div class="card-body">

            <form asp-action="Edit"
                  asp-route-id="@Model.Document.CompanyDocumentId"
                  method="post"
                  enctype="multipart/form-data">

                <input asp-for="Document.CompanyDocumentId" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="app-alert-danger">
                </div>

                <partial name="_DocumentForm" model="Model" />

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn-app btn-secondary-app">

                        <i class="bi bi-arrow-left"></i>

                        Back

                    </a>

                    <button type="submit"
                            class="btn-app btn-secondary-app">

                        <i class="bi bi-check-circle"></i>

                        Update Document

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
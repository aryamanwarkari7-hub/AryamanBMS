@model AryamanBMS.ViewModels.CompanyDocumentViewModel

<input asp-for="Document.CompanyDocumentId" type="hidden" />

<div class="form-grid-2">

    <div class="form-group">
        <label asp-for="Document.DocumentCategoryId" class="form-label">
            Document Category <span class="validation-message">*</span>
        </label>

        <select asp-for="Document.DocumentCategoryId"
                asp-items="Model.Categories"
                class="app-select">
            <option value="">Select Category</option>
        </select>

        <span asp-validation-for="Document.DocumentCategoryId"
              class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="Document.DocumentName" class="form-label">
            Document Name <span class="validation-message">*</span>
        </label>

        <input asp-for="Document.DocumentName"
               class="app-input"
               placeholder="Enter document name" />

        <span asp-validation-for="Document.DocumentName"
              class="validation-message"></span>
    </div>

</div>

<div class="form-grid-2">

    <div class="form-group">
        <label asp-for="Document.DocumentNumber" class="form-label">
            Document Number
        </label>

        <input asp-for="Document.DocumentNumber"
               class="app-input"
               placeholder="Enter document number" />

        <span asp-validation-for="Document.DocumentNumber"
              class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="Document.IssuedBy" class="form-label">
            Issued By
        </label>

        <input asp-for="Document.IssuedBy"
               class="app-input"
               placeholder="Issuing authority" />

        <span asp-validation-for="Document.IssuedBy"
              class="validation-message"></span>
    </div>

</div>

<div class="form-grid-2">

    <div class="form-group">
        <label asp-for="Document.IssueDate" class="form-label">
            Issue Date
        </label>

        <input asp-for="Document.IssueDate"
               type="date"
               class="app-input" />

        <span asp-validation-for="Document.IssueDate"
              class="validation-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="Document.ExpiryDate" class="form-label">
            Expiry Date
        </label>

        <input asp-for="Document.ExpiryDate"
               type="date"
               class="app-input" />

        <span asp-validation-for="Document.ExpiryDate"
              class="validation-message"></span>
    </div>

</div>

<div class="form-group">

    <label asp-for="UploadFile" class="form-label">
        Upload Document
        @if (Model.Document.CompanyDocumentId == 0)
        {
            <span class="validation-message">*</span>
        }
    </label>

    <input asp-for="UploadFile"
           class="app-input"
           accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png" />

    <p class="card-subtitle">
        Supported formats: PDF, DOC, DOCX, XLS, XLSX, JPG, JPEG, PNG.
    </p>

    <span asp-validation-for="UploadFile"
          class="validation-message"></span>

</div>

@if (Model.Document.CompanyDocumentId > 0 &&
    !string.IsNullOrWhiteSpace(Model.Document.FileName))
{
    <div class="app-alert-info">

        <div class="form-grid-2">

            <div>
                <h2 class="card-title">
                    Current Uploaded File
                </h2>

                <p>
                    <strong>File Name:</strong>
                    @Model.Document.FileName
                </p>

                <p>
                    <strong>File Size:</strong>
                    @(Math.Round(Model.Document.FileSize / 1024.0, 2)) KB
                </p>

                @if (Model.Document.UpdatedOn.HasValue)
                {
                    <p>
                        <strong>Last Updated:</strong>
                        @Model.Document.UpdatedOn.Value.ToString("dd-MMM-yyyy hh:mm tt")
                    </p>
                }
                else
                {
                    <p>
                        <strong>Uploaded On:</strong>
                        @Model.Document.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")
                    </p>
                }
            </div>

            <div class="form-actions">
                <a asp-action="Download"
                   asp-route-id="@Model.Document.CompanyDocumentId"
                   class="btn-app btn-success-app">
                    <i class="bi bi-download"></i>
                    Download
                </a>
            </div>

        </div>

        <p class="card-subtitle">
            Choose another file above only if you want to replace the existing document.
        </p>

    </div>
}

<div class="form-group">

    <label asp-for="Document.Remarks"
           class="form-label">
        Remarks
    </label>

    <textarea asp-for="Document.Remarks"
              rows="4"
              class="app-input"
              placeholder="Enter remarks, renewal notes or compliance reference"></textarea>

    <span asp-validation-for="Document.Remarks"
          class="validation-message"></span>

</div>
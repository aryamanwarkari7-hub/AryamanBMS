@model AryamanBMS.Models.CompanyDocumentModel

@{
    ViewData["Title"] = "Company Document Details";

    string expiryStatus = "No Expiry";
    string expiryBadge = "badge-secondary";

    if (Model.ExpiryDate.HasValue)
    {
        if (Model.ExpiryDate.Value < DateTime.Today)
        {
            expiryStatus = "Expired";
            expiryBadge = "badge-danger";
        }
        else if (Model.ExpiryDate.Value <= DateTime.Today.AddDays(30))
        {
            expiryStatus = "Expiring Soon";
            expiryBadge = "badge-warning";
        }
        else
        {
            expiryStatus = "Valid";
            expiryBadge = "badge-success";
        }
    }
}

<div class="module-header">

    <div>
        <h1 class="module-title">COMPANY DOCUMENT DETAILS</h1>
        <p class="module-subtitle">
            View document information, validity and uploaded file details.
        </p>
    </div>

    <div class="module-header-actions">

        <a asp-action="Edit"
           asp-route-id="@Model.CompanyDocumentId"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit
        </a>

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Document Information</h2>
            <p class="card-subtitle">
                Core document and compliance details.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Category</label>
                <strong>@(Model.Category?.CategoryName ?? "-")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Document Name</label>
                <strong>@Model.DocumentName</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Document Number</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.DocumentNumber) ? "-" : Model.DocumentNumber)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Issued By</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.IssuedBy) ? "-" : Model.IssuedBy)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Issue Date</label>
                <strong>@(Model.IssueDate?.ToString("dd-MMM-yyyy") ?? "-")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Expiry Date</label>
                <div>
                    <span class="@expiryBadge">@expiryStatus</span>
                    <strong>
                        @(Model.ExpiryDate?.ToString("dd-MMM-yyyy") ?? "-")
                    </strong>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Status</label>
                @if (Model.IsActive)
                {
                    <span class="badge-success">Active</span>
                }
                else
                {
                    <span class="badge-secondary">Archived</span>
                }
            </div>

            <div class="form-group">
                <label class="form-label">Version</label>
                <strong>@Model.VersionNo</strong>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Uploaded File</h2>
            <p class="card-subtitle">
                Stored file information and download action.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">File Name</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.FileName) ? "-" : Model.FileName)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">File Size</label>
                <strong>@(Math.Round(Model.FileSize / 1024.0, 2)) KB</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Created On</label>
                <strong>@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Uploaded By User ID</label>
                <strong>@(string.IsNullOrWhiteSpace(Model.UploadedByUserId) ? "-" : Model.UploadedByUserId)</strong>
            </div>

            <div class="form-group">
                <label class="form-label">Last Updated</label>
                <strong>@(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</strong>
            </div>

        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Remarks</h2>
            <p class="card-subtitle">
                Additional notes or compliance reference.
            </p>
        </div>
    </div>

    <div class="card-body">
        @(string.IsNullOrWhiteSpace(Model.Remarks) ? "No remarks added." : Model.Remarks)
    </div>

</div>

<div class="app-card">

    <div class="card-body form-actions">

        @if (Model.IsActive)
        {
            <a asp-action="Download"
               asp-route-id="@Model.CompanyDocumentId"
               class="btn-app btn-success-app">
                <i class="bi bi-download"></i>
                Download
            </a>
        }

        <a asp-action="Edit"
           asp-route-id="@Model.CompanyDocumentId"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit
        </a>

    </div>

</div>

@model DailyWorkReportModel

@{
    bool isCreate = Model.DailyWorkReportId == 0;
    string title = isCreate ? "New Daily Work Report" : "Edit Daily Work Report";
    ViewData["Title"] = title;
    bool isMine = ViewBag.IsMine == true;
}

<div class="module-header">
    <div>
        <h1 class="module-title">@title</h1>
        <p class="module-subtitle">Record your daily executed activities and outline tomorrow's planned tasks.</p>
    </div>
    <div class="module-header-actions">
        <a asp-action="Index" asp-route-mine="@(isMine ? "true" : null)" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
    </div>
</div>

<form asp-action="@(isCreate ? "Create" : "Edit")" asp-route-mine="@(isMine ? "true" : null)" method="post"
      id="dailyReportForm">
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="app-alert-danger mb-3"></div>
    }

    @if (!isCreate)
    {
        <input type="hidden" asp-for="DailyWorkReportId" />
        <input type="hidden" asp-for="EmployeeId" />
    }

    <!-- CARD 1: Report Meta & Date Information -->
    <div class="app-card mb-3 dwr-overflow-visible">
        <div class="card-header">
            <h5 class="card-title">Report Details</h5>
            <div class="card-actions">
                <!-- Column Customizer Dropdown -->
                <div class="dropdown">
                    <button class="btn-app btn-secondary-app dropdown-toggle" type="button" data-bs-toggle="dropdown"
                            data-bs-auto-close="outside" aria-expanded="false">
                        <i class="bi bi-sliders"></i> Customize View
                    </button>
                    <div class="dropdown-menu shadow-sm dropdown-menu-end dwr-dropdown-menu">
                        <h6 class="dropdown-header dwr-dropdown-heading">Visible Columns</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input col-toggle-checkbox" type="checkbox" id="toggleCol_planned"
                                   data-col="planned" checked>
                            <label class="form-check-label" for="toggleCol_planned">Planned Efforts</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input col-toggle-checkbox" type="checkbox"
                                   id="toggleCol_description" data-col="description" checked>
                            <label class="form-check-label" for="toggleCol_description">Description</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input col-toggle-checkbox" type="checkbox"
                                   id="toggleCol_dependencies" data-col="dependencies" checked>
                            <label class="form-check-label" for="toggleCol_dependencies">Dependencies</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input col-toggle-checkbox" type="checkbox" id="toggleCol_issues"
                                   data-col="issues" checked>
                            <label class="form-check-label" for="toggleCol_issues">Issues / Blockers</label>
                        </div>
                    </div>
                </div>
                @if (isCreate)
                {
                    <button type="button" class="btn-app btn-secondary-app" id="btnImportPrevious">
                        <i class="bi bi-arrow-down-left-square"></i> Import Yesterday's Plan
                    </button>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ReportDate" class="form-label">Report Date</label>
                    <input type="date" asp-for="ReportDate" class="app-input" id="reportDateInput" required />
                    <span asp-validation-for="ReportDate" class="validation-message"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Employee</label>
                    <input type="text" class="app-input" value="@ViewBag.EmployeeName" readonly />
                </div>
            </div>
        </div>
    </div>

    <!-- CARD 2: Today's Work Details (Table Card) -->
    <div class="app-card table-card mb-3">
        <div class="card-header">
            <h5 class="card-title">Today's Work Details</h5>
            <div class="card-actions">
                <button type="button" class="btn-app btn-primary-app" id="btnAddDetail">
                    <i class="bi bi-plus-lg"></i> Add Activity
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="app-table dwr-editable-table w-100" id="workDetailsTable">
                    <thead>
                        <tr>
                            <th class="dwr-col-sr">Sr.</th>
                            <th class="dwr-col-project">Project Name</th>
                            <th class="dwr-col-activity">Activity</th>
                            <th class="col-description">Description</th>
                            <th class="dwr-col-hours col-planned">Planned (h)</th>
                            <th class="dwr-col-hours">Actual (h)</th>
                            <th class="dwr-col-deps col-dependencies">Dependencies</th>
                            <th class="dwr-col-issues col-issues">Issues / Blockers</th>
                            <th class="dwr-col-action">Action</th>
                        </tr>
                    </thead>
                    <tbody id="workDetailsBody">
                        @if (Model.WorkDetails != null && Model.WorkDetails.Any())
                        {
                            int index = 0;
                            foreach (var item in Model.WorkDetails.OrderBy(x => x.SortOrder))
                            {
                                <tr class="work-detail-row">
                                    <td class="text-center align-middle sr-no text-muted">@(index + 1)</td>
                                    <td>
                                        <input type="text" name="WorkDetails[@index].ProjectName" value="@item.ProjectName"
                                               class="app-input" placeholder="Project name" required />
                                    </td>
                                    <td>
                                        <input type="text" name="WorkDetails[@index].Activity" value="@item.Activity"
                                               class="app-input" placeholder="Activity headline" required />
                                    </td>
                                    <td>
                                        <input type="text" name="WorkDetails[@index].Description" value="@item.Description"
                                               class="app-input col-description" placeholder="Description of work done" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.25" min="0" max="24"
                                               name="WorkDetails[@index].PlannedEffortHours" value="@item.PlannedEffortHours"
                                               class="app-input text-end planned-hours-input col-planned" placeholder="0.00" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.25" min="0" max="24"
                                               name="WorkDetails[@index].ActualEffortHours" value="@item.ActualEffortHours"
                                               class="app-input text-end actual-hours-input" placeholder="0.00" required />
                                    </td>
                                    <td>
                                        <input type="text" name="WorkDetails[@index].Dependencies" value="@item.Dependencies"
                                               class="app-input col-dependencies" placeholder="Dependencies" />
                                    </td>
                                    <td>
                                        <input type="text" name="WorkDetails[@index].Issues" value="@item.Issues"
                                               class="app-input col-issues" placeholder="Blockers or issues" />
                                    </td>
                                    <td class="text-center align-middle">
                                        <button type="button" class="btn-app btn-icon btn-secondary-app btn-delete-row"
                                                title="Delete row">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="dwr-table-total-row">
                            <td colspan="4" class="dwr-table-total-label">Total Today's Hours:</td>
                            <td class="text-end text-muted col-planned" id="totalPlannedDisplay">0.00 hrs</td>
                            <td class="text-end text-success fw-bold" id="totalActualDisplay">0.00 hrs</td>
                            <td colspan="3"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- CARD 3: Next Day's Plan (Table Card) -->
    <div class="app-card table-card mb-3">
        <div class="card-header">
            <h5 class="card-title">Next Day's Plan</h5>
            <div class="card-actions">
                <button type="button" class="btn-app btn-primary-app" id="btnAddPlan">
                    <i class="bi bi-plus-lg"></i> Add Plan Item
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="app-table dwr-editable-table w-100" id="nextDayPlansTable">
                    <thead>
                        <tr>
                            <th class="dwr-col-sr">Sr.</th>
                            <th class="dwr-col-project">Project Name</th>
                            <th class="dwr-col-activity">Activity</th>
                            <th class="col-description">Description</th>
                            <th class="dwr-col-hours">Est. Hours</th>
                            <th class="dwr-col-priority">Priority</th>
                            <th class="dwr-col-deps col-dependencies">Dependencies</th>
                            <th class="dwr-col-issues col-issues">Anticipated Risks</th>
                            <th class="dwr-col-action">Action</th>
                        </tr>
                    </thead>
                    <tbody id="nextDayPlansBody">
                        @if (Model.NextDayPlans != null && Model.NextDayPlans.Any())
                        {
                            int pIndex = 0;
                            foreach (var plan in Model.NextDayPlans.OrderBy(x => x.SortOrder))
                            {
                                <tr class="plan-row">
                                    <td class="text-center align-middle sr-no text-muted">@(pIndex + 1)</td>
                                    <td>
                                        <input type="text" name="NextDayPlans[@pIndex].ProjectName" value="@plan.ProjectName"
                                               class="app-input" placeholder="Project name" required />
                                    </td>
                                    <td>
                                        <input type="text" name="NextDayPlans[@pIndex].Activity" value="@plan.Activity"
                                               class="app-input" placeholder="Task name" required />
                                    </td>
                                    <td>
                                        <input type="text" name="NextDayPlans[@pIndex].Description" value="@plan.Description"
                                               class="app-input col-description" placeholder="Plan details" />
                                    </td>
                                    <td>
                                        <input type="number" step="0.25" min="0" max="24"
                                               name="NextDayPlans[@pIndex].EstimatedEffortHours" value="@plan.EstimatedEffortHours"
                                               class="app-input text-end estimated-hours-input" placeholder="0.00" />
                                    </td>
                                    <td>
                                        <select name="NextDayPlans[@pIndex].Priority" class="app-select">
                                            <option value="High" selected="@(plan.Priority == "High")">High</option>
                                            <option value="Medium" selected="@(plan.Priority == "Medium")">Medium</option>
                                            <option value="Low" selected="@(plan.Priority == "Low")">Low</option>
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" name="NextDayPlans[@pIndex].Dependencies" value="@plan.Dependencies"
                                               class="app-input col-dependencies" placeholder="Dependencies" />
                                    </td>
                                    <td>
                                        <input type="text" name="NextDayPlans[@pIndex].Issues" value="@plan.Issues"
                                               class="app-input col-issues" placeholder="Blockers or risks" />
                                    </td>
                                    <td class="text-center align-middle">
                                        <button type="button" class="btn-app btn-icon btn-secondary-app btn-delete-row"
                                                title="Delete row">
                                            <i class="bi bi-trash text-danger"></i>
                                        </button>
                                    </td>
                                </tr>
                                pIndex++;
                            }
                        }
                    </tbody>
                    <tfoot>
                        <tr class="dwr-table-total-row">
                            <td colspan="4" class="dwr-table-total-label">Total Estimated Plan:</td>
                            <td class="text-end fw-bold text-primary" id="totalEstimatedDisplay">0.00 hrs</td>
                            <td colspan="4"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- CARD 4: General Remarks & Submission Actions (Unified Footer) -->
    <div class="app-card mb-4">
        <div class="card-header">
            <h5 class="card-title">General Remarks & Submission</h5>
        </div>
        <div class="card-body">
            <div class="form-group mb-4">
                <label asp-for="GeneralRemarks" class="form-label">Optional Daily Notes / Remarks</label>
                <textarea asp-for="GeneralRemarks" class="app-input" rows="3"
                          placeholder="Enter any general notes or remarks for the day..."></textarea>
                <span asp-validation-for="GeneralRemarks" class="validation-message"></span>
            </div>
            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                <a asp-action="Index" asp-route-mine="@(isMine ? "true" : null)" class="btn-app btn-secondary-app">
                    Cancel
                </a>
                <button type="submit" class="btn-app btn-primary-app">
                    <i class="bi bi-check-circle"></i> @(isCreate ? "Save Daily Work Report" : "Update Daily Work Report")
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script src="~/js/daily-work-report.js" asp-append-version="true"></script>
}

    <script src="~/js/daily-work-report.js" asp-append-version="true"></script>
}
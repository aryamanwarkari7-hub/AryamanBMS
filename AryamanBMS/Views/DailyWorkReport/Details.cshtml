@model DailyWorkReportModel

@{
    ViewData["Title"] = $"Daily Work Report - {Model.ReportDate:dd MMM yyyy}";
    bool isMine = Context.Request.Query["mine"] == "true";
    decimal variance = Model.TotalActualHours - Model.TotalPlannedHours;

    bool IsRealIssue(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return false;
        var t = text.Trim();
        return t != "-" && t != "--" && t != "—" && t != "–"
            && !t.Equals("NA", StringComparison.OrdinalIgnoreCase)
            && !t.Equals("N/A", StringComparison.OrdinalIgnoreCase)
            && !t.Equals("None", StringComparison.OrdinalIgnoreCase)
            && !t.Equals("Nil", StringComparison.OrdinalIgnoreCase)
            && !t.Equals("No", StringComparison.OrdinalIgnoreCase);
    }
}

<div class="module-header">
    <div>
        <h1 class="module-title">Daily Work Report Details</h1>
        <p class="module-subtitle">Report for <strong>@Model.ReportDate.ToString("dddd, dd MMMM yyyy")</strong></p>
    </div>
    <div class="module-header-actions">
        <a asp-action="Index" asp-route-mine="@(isMine ? "true" : null)" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i> Back to Reports
        </a>
        <a asp-action="Edit" asp-route-id="@Model.DailyWorkReportId" asp-route-mine="@(isMine ? "true" : null)"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i> Edit Report
        </a>
    </div>
</div>

<div class="detail-page">
    <!-- Standard BMS Detail Summary Cards Grid -->
    <div class="detail-summary-grid dwr-summary-grid-5 mb-4">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Report Date</div>
            <div class="detail-summary-value">@Model.ReportDate.ToString("dd-MMM-yyyy")</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee</div>
            <div class="detail-summary-value">@(Model.Employee?.FullName ?? "N/A")</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Planned Hours</div>
            <div class="detail-summary-value text-muted">@Model.TotalPlannedHours.ToString("N2") hrs</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Actual Hours</div>
            <div class="detail-summary-value text-success">@Model.TotalActualHours.ToString("N2") hrs</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Hours Variance</div>
            <div
                class="detail-summary-value @(variance > 0 ? "text-danger" : variance < 0 ? "text-success" : "text-muted")">
                @(variance > 0 ? $"+{variance:N2}" : variance.ToString("N2")) hrs
            </div>
        </div>
    </div>
    
    <!-- Today's Work Details (Matches Register Card on Index Exactly) -->
    <div class="app-card table-card mb-3">
        <div class="card-header">
            <h5 class="card-title">Today's Work Details</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th class="dwr-col-sr">Sr.</th>
                            <th class="dwr-col-project">Project Name</th>
                            <th class="dwr-col-activity">Activity</th>
                            <th>Description</th>
                            <th class="dwr-col-hours">Planned (h)</th>
                            <th class="dwr-col-hours">Actual (h)</th>
                            <th class="dwr-col-deps">Dependencies</th>
                            <th class="dwr-col-issues">Issues / Blockers</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.WorkDetails != null && Model.WorkDetails.Any())
                        {
                            int sr = 1;
                            foreach (var d in Model.WorkDetails.OrderBy(x => x.SortOrder))
                            {
                                <tr>
                                    <td class="text-center text-muted">@sr</td>
                                    <td><span class="badge-neutral">@d.ProjectName</span></td>
                                    <td><strong>@d.Activity</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(d.Description) ? "—" : d.Description)</td>
                                    <td class="text-end text-muted">@d.PlannedEffortHours.ToString("N2")</td>
                                    <td class="text-end fw-bold text-success">@d.ActualEffortHours.ToString("N2")</td>
                                    <td>@(IsRealIssue(d.Dependencies) ? d.Dependencies : "—")</td>
                                    <td>
                                        @if (IsRealIssue(d.Issues))
                                        {
                                            <span class="badge-danger">
                                                <i class="bi bi-exclamation-triangle me-1"></i>@d.Issues
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                                sr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No activity items logged.</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="dwr-table-total-row">
                            <td colspan="4" class="dwr-table-total-label">Total Today:</td>
                            <td class="text-end text-muted">@Model.TotalPlannedHours.ToString("N2") hrs</td>
                            <td class="text-end text-success">@Model.TotalActualHours.ToString("N2") hrs</td>
                            <td colspan="2"></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <!-- Next Day's Plan (Matches Register Card on Index Exactly) -->
    <div class="app-card table-card mb-3">
        <div class="card-header">
            <h5 class="card-title">Next Day's Plan</h5>
        </div>

        <div class="card-body">
            <div class="table-responsive">
                <table class="app-table">
                    <thead>
                        <tr>
                            <th class="dwr-col-sr">Sr.</th>
                            <th class="dwr-col-project">Project Name</th>
                            <th class="dwr-col-activity">Activity</th>
                            <th>Description</th>
                            <th class="dwr-col-hours">Est. Hours</th>
                            <th class="dwr-col-priority">Priority</th>
                            <th class="dwr-col-deps">Dependencies</th>
                            <th class="dwr-col-issues">Anticipated Risks</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.NextDayPlans != null && Model.NextDayPlans.Any())
                        {
                            int pSr = 1;
                            foreach (var p in Model.NextDayPlans.OrderBy(x => x.SortOrder))
                            {
                                <tr>
                                    <td class="text-center text-muted">@pSr</td>
                                    <td><span class="badge-neutral">@p.ProjectName</span></td>
                                    <td><strong>@p.Activity</strong></td>
                                    <td>@(string.IsNullOrWhiteSpace(p.Description) ? "—" : p.Description)</td>
                                    <td class="text-end fw-semibold">@p.EstimatedEffortHours.ToString("N2")</td>
                                    <td class="text-center">
                                        @if (p.Priority == "High")
                                        {
                                            <span class="badge-danger">High</span>
                                        }
                                        else if (p.Priority == "Medium")
                                        {
                                            <span class="badge-warning">Medium</span>
                                        }
                                        else
                                        {
                                            <span class="badge-neutral">Low</span>
                                        }
                                    </td>
                                    <td>@(IsRealIssue(p.Dependencies) ? p.Dependencies : "—")</td>
                                    <td>@(IsRealIssue(p.Issues) ? p.Issues : "—")</td>
                                </tr>
                                pSr++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">No planning items logged for
                                    tomorrow.
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="dwr-table-total-row">
                            <td colspan="4" class="dwr-table-total-label">Total Estimated:</td>
                            <td class="text-end text-primary">@(Model.NextDayPlans?.Sum(x =>
                                                                                                                                                                                                                                                                                                        x.EstimatedEffortHours).ToString("N2") ?? "0.00") hrs</td>
                                <td colspan="3"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>

        <!-- General Remarks & Timestamps -->
        <div class="app-card mb-4">
            <div class="card-header">
                <h5 class="card-title">General Remarks & Timestamps</h5>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4 dwr-remarks-text">
                    @(string.IsNullOrWhiteSpace(Model.GeneralRemarks) ? "No additional remarks entered." :
                    Model.GeneralRemarks)
                </p>

                <div class="dwr-timestamps-row">
                    <span><i class="bi bi-clock me-1 text-primary"></i> Created On:
                        @Model.CreatedOn.ToString("dd-MM-yyyy hh:mm tt")</span>
                        @if (Model.UpdatedOn.HasValue)
                        {
                            <span><i class="bi bi-pencil-square me-1 text-primary"></i> Last Updated:
                                @Model.UpdatedOn.Value.ToString("dd-MM-yyyy hh:mm tt")</span>
                            }
                        </div>
                    </div>
                </div>
            </div>

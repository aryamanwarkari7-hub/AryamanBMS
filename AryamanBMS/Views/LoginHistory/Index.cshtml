@model AryamanBMS.ViewModels.LoginHistoryListViewModel

@{
    ViewData["Title"] = "Login History";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Login History</h1>
        <p class="module-subtitle">
            Review successful and failed login attempts
        </p>
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-body">

        <form method="get"
              class="row g-3 align-items-end">

            <div class="col-md-3">
                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="searchText"
                       value="@Model.SearchText"
                       class="form-control"
                       placeholder="Username, employee or IP address" />
            </div>

            <div class="col-md-2">
                <label class="form-label">
                    Event Type
                </label>

                <select name="eventType"
                        class="form-select">

                    <option value="">All events</option>

                    <option value="LoginSuccess"
                            selected="@(Model.EventType == "LoginSuccess")">
                        Successful Login
                    </option>

                    <option value="InvalidPassword"
                            selected="@(Model.EventType == "InvalidPassword")">
                        Invalid Password
                    </option>

                    <option value="UnknownUser"
                            selected="@(Model.EventType == "UnknownUser")">
                        Unknown User
                    </option>

                    <option value="InactiveAccount"
                            selected="@(Model.EventType == "InactiveAccount")">
                        Inactive Account
                    </option>

                    <option value="AccountLocked"
                            selected="@(Model.EventType == "AccountLocked")">
                        Account Locked
                    </option>

                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">
                    Result
                </label>

                <select name="result"
                        class="form-select">

                    <option value="">All</option>

                    <option value="Success"
                            selected="@(Model.Result == "Success")">
                        Success
                    </option>

                    <option value="Failed"
                            selected="@(Model.Result == "Failed")">
                        Failed
                    </option>

                </select>
            </div>

            <div class="col-md-2">
                <label class="form-label">
                    Month
                </label>

                <select name="month"
                        class="form-select">
            
                    <option value="">All months</option>
            
                    @for (int monthNumber = 1;
                          monthNumber <= 12;
                          monthNumber++)
                    {
                        string monthName =
                            System.Globalization.CultureInfo
                                .CurrentCulture
                                .DateTimeFormat
                                .GetMonthName(monthNumber);
            
                        <option value="@monthNumber"
                                selected="@(Model.Month == monthNumber)">
                            @monthName
                        </option>
                    }
            
                </select>
</div>

<div class="col-md-2">
    <label class="form-label">
        Year
    </label>

    <select name="year"
            class="form-select">

        <option value="">All years</option>

        @foreach (var availableYear in Model.AvailableYears)
        {
            <option value="@availableYear"
                    selected="@(Model.Year == availableYear)">
                @availableYear
            </option>
        }

    </select>
</div>

            <div class="col-md-3">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Reset
                </a>
            </div>

        </form>

    </div>
</div>

<div class="app-card table-card">

    <div class="card-header">
        <h5 class="card-title">
            Login Records
        </h5>

        <span class="text-muted">
            @Model.TotalRecords records
        </span>
    </div>

    <div class="card-body">

        @if (!Model.Records.Any())
        {
            <div class="empty-state">
                No login history found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="app-table">

                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>Username</th>
                            <th>Event</th>
                            <th>Result</th>
                            <th>IP Address</th>
                            <th>Failure Reason</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in Model.Records)
                        {
                            <tr>
                                <td>
                                    @record.OccurredOn.ToString(
                                        "dd-MM-yyyy hh:mm tt")
                                </td>

                                <td>
                                    <strong>
                                        @record.AttemptedUserName
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        record.User?.FullName))
                                    {
                                        <div class="text-muted small">
                                            @record.User.FullName
                                        </div>
                                    }
                                </td>

                                <td>
                                    @record.EventType
                                </td>

                                <td>
                                    @if (record.IsSuccessful)
                                    {
                                        <span class="badge-success">
                                            Success
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">
                                            Failed
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(record.IpAddress ?? "-")
                                </td>

                                <td>
                                    @(record.FailureReason ?? "-")
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3">
                    <ul class="pagination justify-content-center">

                        @for (int i = 1;
                             i <= Model.TotalPages;
                             i++)
                        {
                            <li class="page-item
                                @(i == Model.CurrentPage
                                    ? "active"
                                    : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchText="@Model.SearchText"
                                   asp-route-eventType="@Model.EventType"
                                   asp-route-result="@Model.Result"
                                   asp-route-month="@Model.Month"
                                   asp-route-year="@Model.Year">
                                    @i
                                </a>

                            </li>
                        }

                    </ul>
                </nav>
            }

        }

    </div>
</div>
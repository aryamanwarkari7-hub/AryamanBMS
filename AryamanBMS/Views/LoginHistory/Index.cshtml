@model AryamanBMS.ViewModels.LoginHistoryListViewModel

@{
    ViewData["Title"] = "Login History";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Login History</h1>
        <p class="module-subtitle">
            Review successful and failed login attempts
        </p>
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-body">

        <form method="get"
              class="row g-3 align-items-end">

            <!-- Search -->
            <div class="col-md-3">
                <label class="form-label">
                    Search
                </label>

                <input type="text"
                       name="searchText"
                       value="@Model.SearchText"
                       class="form-control"
                       placeholder="Username, employee or IP address" />
            </div>

            <!-- Event -->
            <div class="col-md-2">
                <label class="form-label">
                    Event Type
                </label>

                <select name="eventType"
                        class="form-select">

                    <option value="">All events</option>

                    <option value="Login"
                            selected="@(Model.EventType == "Login")">
                        Successful Login
                    </option>

                    <option value="InvalidPassword"
                            selected="@(Model.EventType == "InvalidPassword")">
                        Invalid Password
                    </option>

                    <option value="UnknownUser"
                            selected="@(Model.EventType == "UnknownUser")">
                        Unknown User
                    </option>

                    <option value="InactiveAccount"
                            selected="@(Model.EventType == "InactiveAccount")">
                        Inactive Account
                    </option>

                    <option value="AccountLocked"
                            selected="@(Model.EventType == "AccountLocked")">
                        Account Locked
                    </option>

                </select>
            </div>

            <!-- Result -->
            <div class="col-md-2">
                <label class="form-label">
                    Result
                </label>

                <select name="result"
                        class="form-select">

                    <option value="">All</option>

                    <option value="Success"
                            selected="@(Model.Result == "Success")">
                        Success
                    </option>

                    <option value="Failed"
                            selected="@(Model.Result == "Failed")">
                        Failed
                    </option>

                </select>
            </div>

            <!-- Month -->
            <div class="col-md-2">
                <label class="form-label">
                    Month
                </label>

                <select name="month"
                        class="form-select">

                    <option value="">All months</option>

                    @for (int monthNumber = 1;
                          monthNumber <= 12;
                          monthNumber++)
                    {
                        string monthName =
                            System.Globalization.CultureInfo
                                .CurrentCulture
                                .DateTimeFormat
                                .GetMonthName(monthNumber);

                        <option value="@monthNumber"
                                selected="@(Model.Month == monthNumber)">
                            @monthName
                        </option>
                    }

                </select>
            </div>

            <!-- Year -->
            <div class="col-md-2">
                <label class="form-label">
                    Year
                </label>

                <select name="year"
                        class="form-select">

                    <option value="">All years</option>

                    @foreach (var availableYear in Model.AvailableYears)
                    {
                        <option value="@availableYear"
                                selected="@(Model.Year == availableYear)">
                            @availableYear
                        </option>
                    }

                </select>
            </div>

            <!-- Actions -->
            <div class="col-md-3">

                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Reset
                </a>

            </div>

        </form>

    </div>
</div>

<div class="app-card table-card">

    <div class="card-header">

        <h5 class="card-title">
            Login Records
        </h5>

        <span class="text-muted">
            @Model.TotalRecords records
        </span>

    </div>

    <div class="card-body">

        @if (!Model.Records.Any())
        {
            <div class="empty-state">

                <i class="bi bi-shield-lock"></i>

                <p class="mb-0">
                    No login history found.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="app-table">

                    <thead>
                        <tr>
                            <th>Date & Time</th>
                            <th>User</th>
                            <th>Event</th>
                            <th>Result</th>
                            <th>IP Address</th>
                            <th>Device ID</th>
                            <th>Browser</th>
                            <th>Failure Reason</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var record in Model.Records)
                        {
                            <tr>

                                <!-- Date -->
                                <td>
                                    @record.OccurredOn.ToString(
                                        "dd-MMM-yyyy hh:mm tt")
                                </td>

                                <!-- User -->
                                <td>

                                    <strong>
                                        @record.AttemptedUserName
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(
                                        record.User?.FullName))
                                    {
                                        <div class="text-muted small">
                                            @record.User.FullName
                                        </div>
                                    }

                                </td>

                                <!-- Event -->
                                <td>

                                    @switch (record.EventType)
                                    {
                                        case "Login":
                                            <span class="badge-primary">
                                                Login
                                            </span>
                                            break;

                                        case "InvalidPassword":
                                            <span class="badge-warning">
                                                Invalid Password
                                            </span>
                                            break;

                                        case "UnknownUser":
                                            <span class="badge-danger">
                                                Unknown User
                                            </span>
                                            break;

                                        case "InactiveAccount":
                                            <span class="badge-warning">
                                                Inactive Account
                                            </span>
                                            break;

                                        case "AccountLocked":
                                            <span class="badge-danger">
                                                Account Locked
                                            </span>
                                            break;

                                        default:
                                            <span class="badge-secondary">
                                                @record.EventType
                                            </span>
                                            break;
                                    }

                                </td>

                                <!-- Result -->
                                <td>

                                    @if (record.IsSuccessful)
                                    {
                                        <span class="badge-success">
                                            Success
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">
                                            Failed
                                        </span>
                                    }

                                </td>

                                <!-- IP -->
                                <td>
                                    <span class="text-nowrap">
                                        @(record.IpAddress ?? "-")
                                    </span>
                                </td>

                                <!-- Device Id -->
                                <td>
                                    <span class="login-device-id"
                                          title="@record.DeviceId">
                                        @(record.DeviceId ?? "-")
                                    </span>
                                </td>

                                <!-- User Agent -->
                                <td>
                                    @{
                                        string browser = "Unknown Browser";
                                        string operatingSystem = "Unknown OS";

                                        if (!string.IsNullOrWhiteSpace(record.UserAgent))
                                        {
                                            string ua = record.UserAgent;

                                            if (ua.Contains("Edg/", StringComparison.OrdinalIgnoreCase))
                                            {
                                                browser = "Edge";
                                            }
                                            else if (ua.Contains("Chrome/", StringComparison.OrdinalIgnoreCase))
                                            {
                                                browser = "Chrome";
                                            }
                                            else if (ua.Contains("Firefox/", StringComparison.OrdinalIgnoreCase))
                                            {
                                                browser = "Firefox";
                                            }
                                            else if (ua.Contains("Safari/", StringComparison.OrdinalIgnoreCase))
                                            {
                                                browser = "Safari";
                                            }

                                            if (ua.Contains("Windows", StringComparison.OrdinalIgnoreCase))
                                            {
                                                operatingSystem = "Windows";
                                            }
                                            else if (ua.Contains("Android", StringComparison.OrdinalIgnoreCase))
                                            {
                                                operatingSystem = "Android";
                                            }
                                            else if (ua.Contains("iPhone", StringComparison.OrdinalIgnoreCase) ||
                                                     ua.Contains("iPad", StringComparison.OrdinalIgnoreCase))
                                            {
                                                operatingSystem = "iOS";
                                            }
                                            else if (ua.Contains("Mac OS X", StringComparison.OrdinalIgnoreCase))
                                            {
                                                operatingSystem = "macOS";
                                            }
                                            else if (ua.Contains("Linux", StringComparison.OrdinalIgnoreCase))
                                            {
                                                operatingSystem = "Linux";
                                            }
                                        }
                                    }

                                    <span>@browser on @operatingSystem</span>
                                </td>

                                <!-- Failure -->
                                <td>
                                    @(record.FailureReason ?? "-")
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- Pagination -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-3"
                     aria-label="Login history pagination">

                    <ul class="pagination justify-content-center">

                        @for (int i = 1;
                              i <= Model.TotalPages;
                              i++)
                        {
                            <li class="page-item
                                @(i == Model.CurrentPage
                                    ? "active"
                                    : "")">

                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-searchText="@Model.SearchText"
                                   asp-route-eventType="@Model.EventType"
                                   asp-route-result="@Model.Result"
                                   asp-route-month="@Model.Month"
                                   asp-route-year="@Model.Year">
                                    @i
                                </a>

                            </li>
                        }

                    </ul>

                </nav>
            }

        }

    </div>

</div>
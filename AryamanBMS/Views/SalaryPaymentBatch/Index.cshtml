@model IEnumerable<AryamanBMS.Models.SalaryPaymentBatchModel>

@{
    ViewData["Title"] = "Salary Payment Batches";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Salary Payment Batches</h1>
        <p class="module-subtitle">Process finalized unpaid payroll as payment batches</p>
    </div>
</div>

<div class="app-card">
    <div class="card-body">
        <form asp-action="CreateBatch" method="post" class="form-grid-2">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Month</label>
                <input name="month" type="number" min="1" max="12" class="app-input" value="@DateTime.Today.Month" />
            </div>

            <div class="form-group">
                <label class="form-label">Year</label>
                <input name="year" type="number" class="app-input" value="@DateTime.Today.Year" />
            </div>

            <div class="form-group">
                <label class="form-label">Bank Account</label>
                <input name="bankAccount" class="app-input" />
            </div>

            <div class="form-group">
                <label class="form-label">&nbsp;</label>
                <button type="submit" class="btn-app btn-primary-app">Create Batch</button>
            </div>
        </form>
    </div>
</div>

<div class="app-card table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="app-table">
                <thead>
                    <tr>
                        <th>Period</th>
                        <th>Employees</th>
                        <th class="text-end">Net Salary</th>
                        <th>Status</th>
                        <th>Payment Date</th>
                        <th>Reference</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Month/@item.Year</td>
                            <td>@item.TotalEmployees</td>
                            <td class="text-end">@item.TotalNetSalary.ToString("N2")</td>
                            <td><span class="badge-secondary">@item.PaymentStatus</span></td>
                            <td>@(item.PaymentDate?.ToString("dd-MMM-yyyy") ?? "-")</td>
                            <td>@(item.TransactionReference ?? "-")</td>
                            <td class="text-center">
                                @if (item.PaymentStatus == "Processing")
                                {
                                    <form asp-action="MarkPaid" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.SalaryPaymentBatchId" />
                                        <input type="hidden" name="transactionReference" value="Manual payment confirmation" />
                                        <button type="submit" class="btn-app btn-success-app btn-icon" title="Mark Paid">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

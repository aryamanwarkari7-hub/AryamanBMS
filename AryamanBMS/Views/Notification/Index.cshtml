@model IEnumerable<AryamanBMS.Models.NotificationModel>

@{
    ViewData["Title"] = "Notifications";
    int unreadCount = Model.Count(x => !x.IsRead);
    int currentPage = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 15;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count();
    string? selectedType = ViewBag.NotificationType as string;
    string? selectedReadStatus = ViewBag.ReadStatus as string;

    var pagination = new AryamanBMS.ViewModels.PaginationViewModel
    {
        CurrentPage = currentPage,
        PageSize = pageSize,
        TotalRecords = totalRecords,
        ControllerName = "Notification",
        ActionName = "Index",
        RouteValues = new Dictionary<string, string>()
    };

    if (!string.IsNullOrWhiteSpace(ViewBag.SearchText as string))
    {
        pagination.RouteValues["searchText"] = (ViewBag.SearchText as string)!;
    }
    if (!string.IsNullOrWhiteSpace(selectedType)) pagination.RouteValues["notificationType"] = selectedType!;
    if (!string.IsNullOrWhiteSpace(selectedReadStatus)) pagination.RouteValues["readStatus"] = selectedReadStatus!;
}

<div class="module-header">

    <div>
        <h1 class="module-title">Notifications</h1>

        <p class="module-subtitle">
            Review your recent system activity
        </p>
    </div>

    <div class="module-header-actions">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Audit"
               class="btn-app btn-secondary-app">
                <i class="bi bi-shield-check"></i>
                Audit
            </a>
        }

        @if (unreadCount > 0)
        {
            <form asp-action="MarkAllAsRead"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn-app btn-secondary-app">

                    <i class="bi bi-check2-all"></i>
                    Mark all as read

                </button>

            </form>
        }
    </div>

</div>

<div class="app-card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="filter-form-row">
            <input type="text"
                   name="searchText"
                   value="@ViewBag.SearchText"
                   class="app-input flex-grow-1"
                   placeholder="Search notifications" />

            <select name="notificationType" class="app-select">
                <option value="">All Types</option>
                @foreach (var type in (IEnumerable<string>)(ViewBag.NotificationTypes ?? Array.Empty<string>()))
                {
                    <option value="@type" selected="@(selectedType == type)">@type</option>
                }
            </select>

            <select name="readStatus" class="app-select">
                <option value="">All Statuses</option>
                <option value="Unread" selected="@(selectedReadStatus == "Unread")">Unread</option>
                <option value="Read" selected="@(selectedReadStatus == "Read")">Read</option>
            </select>

            <button type="submit" class="btn-app btn-primary-app">
                <i class="bi bi-funnel"></i>
                Apply
            </button>
            <a asp-action="Index" class="btn-app btn-secondary-app">Reset</a>
        </form>
    </div>
</div>

<div class="app-card">

    <div class="card-header">

        <h5 class="card-title">
            Notification List
        </h5>

        @if (unreadCount > 0)
        {
            <span class="badge-warning">
                @unreadCount unread
            </span>
        }

    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-bell-slash"></i>
                <p>No notifications found.</p>
            </div>
        }
        else
        {
            <div class="notification-page-list">

                @foreach (var notification in Model)
                {
                    <a asp-controller="Notification"
                       asp-action="Open"
                       asp-route-id="@notification.Id"
                       class="notification-page-item
                              @(notification.IsRead
                                  ? ""
                                  : "notification-page-unread")">

                <div class="notification-icon">

                    @switch (notification.NotificationType)
                            {
                                case "TaskAssigned":
                                    <i class="bi bi-person-check"></i>
                                    break;

                                case "TaskDueTomorrow":
                                    <i class="bi bi-calendar-event"></i>
                                    break;

                                case "TaskDueToday":
                                    <i class="bi bi-alarm"></i>
                                    break;

                                case "TaskOverdue":
                                    <i class="bi bi-exclamation-triangle"></i>
                                    break;

                                case "Login":
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    break;

                                case "LeaveRequest":
                                    <i class="bi bi-calendar-plus"></i>
                                    break;

                                case "LeaveApproved":
                                    <i class="bi bi-calendar-check"></i>
                                    break;

                                case "LeaveRejected":
                                    <i class="bi bi-calendar-x"></i>
                                    break;

                                case "LeaveCancellationRequested":
                                    <i class="bi bi-calendar-minus"></i>
                                    break;

                                case "LeaveCancellationApproved":
                                    <i class="bi bi-calendar2-x"></i>
                                    break;

                                case "LeaveCancellationRejected":
                                    <i class="bi bi-calendar2-check"></i>
                                    break;

                                case "CompOffRequested":
                                    <i class="bi bi-clock-history"></i>
                                    break;

                                case "CompOffApproved":
                                    <i class="bi bi-clock"></i>
                                    break;

                                case "CompOffRejected":
                                    <i class="bi bi-clock-fill"></i>
                                    break;

                                case "InvoiceDue":
                                    <i class="bi bi-receipt"></i>
                                    break;

                                case "PaymentReceived":
                                    <i class="bi bi-cash-coin"></i>
                                    break;
                                case "InvoiceDueTomorrow":
                                    <i class="bi bi-calendar-event"></i>
                                    break;

                                case "InvoiceDueToday":
                                    <i class="bi bi-receipt-cutoff"></i>
                                    break;

                                case "InvoiceOverdue":
                                    <i class="bi bi-exclamation-octagon"></i>
                                    break;

                                case "ExpenseSubmitted":
                                    <i class="bi bi-send"></i>
                                    break;

                                case "ExpenseApproved":
                                    <i class="bi bi-check-circle"></i>
                                    break;

                                case "ExpenseRejected":
                                    <i class="bi bi-x-circle"></i>
                                    break;

                                case "ExpensePosted":
                                    <i class="bi bi-journal-check"></i>
                                    break;

                                case "ExpenseReversed":
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                    break;

                                case "InvoiceSettled":
                                    <i class="bi bi-check-circle"></i>
                                    break;

                                case "OfficeAssetReturned":
                                    <i class="bi bi-arrow-return-left"></i>
                                    break;

                                case "OfficeAssetUnderRepair":
                                    <i class="bi bi-tools"></i>
                                    break;

                                case "OfficeAssetMaintenanceCompleted":
                                    <i class="bi bi-wrench-adjustable-circle"></i>
                                    break;

                                case "InvoiceIssued":
                                    <i class="bi bi-send-check"></i>
                                    break;

                                case "InvoiceCancelled":
                                    <i class="bi bi-file-earmark-x"></i>
                                    break;

                                case "PaymentReceiptCancelled":
                                    <i class="bi bi-receipt-cutoff"></i>
                                    break;

                                case "PayslipReleased":
                                    <i class="bi bi-file-earmark-person"></i>
                                    break;

                                case "SalaryPaid":
                                    <i class="bi bi-wallet2"></i>
                                    break;

                                case "VendorPaymentMade":
                                    <i class="bi bi-bank2"></i>
                                    break;

                                case "SalaryAdvanceCreated":
                                    <i class="bi bi-cash-stack"></i>
                                    break;

                                case "FullAndFinalCreated":
                                    <i class="bi bi-file-earmark-lock"></i>
                                    break;

                                case "ProjectMeetingCreated":
                                    <i class="bi bi-people"></i>
                                    break;

                                case "MomActionAssigned":
                                    <i class="bi bi-list-check"></i>
                                    break;

                                case "ProjectRiskAssigned":
                                    <i class="bi bi-shield-exclamation"></i>
                                    break;

                                case "ProjectRiskStatusChanged":
                                    <i class="bi bi-arrow-repeat"></i>
                                    break;

                                case "ProjectRiskSeverityChanged":
                                    <i class="bi bi-exclamation-diamond"></i>
                                    break;

                                case "GstSnapshotGenerated":
                                    <i class="bi bi-calculator"></i>
                                    break;

                                case "GstSnapshotRegenerated":
                                    <i class="bi bi-arrow-repeat"></i>
                                    break;

                                case "GstSnapshotVerified":
                                    <i class="bi bi-patch-check"></i>
                                    break;

                                case "Gstr1Filed":
                                    <i class="bi bi-file-earmark-check"></i>
                                    break;

                                case "Gstr3BFiled":
                                    <i class="bi bi-file-earmark-check-fill"></i>
                                    break;

                                case "GstChallanPaid":
                                    <i class="bi bi-bank"></i>
                                    break;

                                case "GstSnapshotLocked":
                                    <i class="bi bi-lock"></i>
                                    break;

                                case "GstSnapshotReopened":
                                    <i class="bi bi-unlock"></i>
                                    break;

                                default:
                                    <i class="bi bi-info-circle"></i>
                                    break;
                            }

                        </div>

                        <div class="notification-content">

                            <div class="notification-title">
                                @notification.Title
                            </div>

                            <div class="notification-message">
                                @notification.Message
                            </div>

                            <div class="notification-time">
                                @notification.CreatedOn.ToString(
                                    "dd MMM yyyy, hh:mm tt")
                            </div>

                        </div>

                        @if (!notification.IsRead)
                        {
                            <span class="notification-unread-dot"></span>
                        }

                    </a>
                }

            </div>
        }

    </div>

    <partial name="_Pagination" model="pagination" />

</div>

@model AryamanBMS.Models.EmployeeSalaryStructureModel

@{
    ViewData["Title"] = "Add Salary Structure";
}

<div class="module-header">

    <div>
        <h1 class="module-title">
            Add Salary Structure
        </h1>

        <p class="module-subtitle">
            Add employee salary amount from an effective date
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            Back
        </a>
    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">
            Salary Details
        </h5>
    </div>

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="form-grid">

                <div class="form-group">

                    <label asp-for="EmployeeId"
                           class="form-label">
                        Employee
                    </label>

                    <select asp-for="EmployeeId"
                            class="app-select"
                            required>

                        <option value="">
                            Select Employee
                        </option>

                        @foreach (var employee in ViewBag.Employees)
                        {
                            <option value="@employee.Id">
                                @employee.EmployeeCode - @employee.FullName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="EmployeeId"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label asp-for="EffectiveFrom"
                           class="form-label">
                        Effective From
                    </label>

                    <input asp-for="EffectiveFrom"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="EffectiveFrom"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label asp-for="EffectiveTo"
                           class="form-label">
                        Effective To
                    </label>

                    <input asp-for="EffectiveTo"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="EffectiveTo"
                          class="text-danger"></span>

                </div>

                <div class="form-group">

                    <label asp-for="ActualSalary"
                           class="form-label">
                        Actual Salary
                    </label>

                    <input asp-for="ActualSalary"
                           type="number"
                           step="0.01"
                           min="0"
                           class="app-input" />

                    <span asp-validation-for="ActualSalary"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Salary Breakup</label>

                    <button type="button"
                            id="calculateSalaryBreakup"
                            class="btn-app btn-primary-app">
                        <i class="bi bi-calculator"></i>
                        Calculate Breakup
                    </button>

                    <small class="form-text">
                        Uses Basic 50% of Actual | HRA 40% of Basic | Balance as Special Allowance.
                    </small>
                </div>

                <div class="form-group">
                    <label asp-for="BasicSalary" class="form-label">Basic Salary</label>
                    <input asp-for="BasicSalary" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="BasicSalary" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="HRA" class="form-label">HRA</label>
                    <input asp-for="HRA" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="HRA" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DA" class="form-label">DA</label>
                    <input asp-for="DA" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="DA" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Conveyance" class="form-label">Conveyance</label>
                    <input asp-for="Conveyance" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="Conveyance" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="MedicalAllowance" class="form-label">Medical Allowance</label>
                    <input asp-for="MedicalAllowance" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="MedicalAllowance" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="EducationAllowance" class="form-label">Education Allowance</label>
                    <input asp-for="EducationAllowance" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="EducationAllowance" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="SpecialAllowance" class="form-label">Special Allowance</label>
                    <input asp-for="SpecialAllowance" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="SpecialAllowance" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="OtherAllowances" class="form-label">Other Allowances</label>
                    <input asp-for="OtherAllowances" type="number" step="0.01" min="0" class="app-input" />
                    <span asp-validation-for="OtherAllowances" class="text-danger"></span>
                </div>

                <div class="form-check mt-4">
                    <input asp-for="IsPfApplicable" class="form-check-input" />
                    <label asp-for="IsPfApplicable" class="form-check-label">PF Applicable</label>
                </div>

                <div class="form-check mt-4">
                    <input asp-for="IsEsicApplicable" class="form-check-input" />
                    <label asp-for="IsEsicApplicable" class="form-check-label">ESIC Applicable</label>
                </div>

                <div class="form-check mt-4">
                    <input asp-for="IsPtApplicable" class="form-check-input" />
                    <label asp-for="IsPtApplicable" class="form-check-label">PT Applicable</label>
                </div>

                <div class="form-check mt-4">
                    <input asp-for="IsTdsApplicable" class="form-check-input" />
                    <label asp-for="IsTdsApplicable" class="form-check-label">TDS Applicable</label>
                </div>

                <div class="form-check mt-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                        Active
                    </label>

                </div>

            </div>

            <div class="form-actions">

                <button type="submit"
                        class="btn-app btn-primary-app">
                    Save
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Cancel
                </a>

            </div>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/salary-structure-breakup.js" asp-append-version="true"></script>
}
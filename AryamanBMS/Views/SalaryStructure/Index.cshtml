@model List<AryamanBMS.Models.EmployeeSalaryStructureModel>

@{
    ViewData["Title"] = "Salary Structure";
}

<div class="module-header">

    <div>
        <h1 class="module-title">
            Salary Structure
        </h1>

        <p class="module-subtitle">
            Employee salary amounts with effective dates
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create"
           class="btn-app btn-primary-app">
            <i class="bi bi-plus-lg"></i>
            Add Salary
        </a>
    </div>

</div>

<div class="app-card">
    <div class="card-body">

        <form method="get" class="w-100">
            <div class="filter-form-row">

                <div class="form-group">
                    <label class="form-label">Search</label>
                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           class="app-input"
                           placeholder="Employee code or name"
                           autocomplete="off" />
                </div>

                <div class="form-group">
                    <label class="form-label">Sort By</label>
                    <select name="sortBy" class="app-select">
                        <option value="EmployeeCode" selected="@(ViewBag.SortBy == "EmployeeCode")">Employee Code</option>
                        <option value="EmployeeName" selected="@(ViewBag.SortBy == "EmployeeName")">Employee Name</option>
                        <option value="EffectiveFrom" selected="@(ViewBag.SortBy == "EffectiveFrom")">Effective From</option>
                        <option value="ActualSalary" selected="@(ViewBag.SortBy == "ActualSalary")">Actual Salary</option>
                        <option value="Status" selected="@(ViewBag.SortBy == "Status")">Status</option>
                        <option value="UpdatedOn" selected="@(ViewBag.SortBy == "UpdatedOn")">Updated On</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Order</label>
                    <select name="sortOrder" class="app-select">
                        <option value="asc" selected="@(ViewBag.SortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(ViewBag.SortOrder == "desc")">Descending</option>
                    </select>
                </div>

                <div class="filter-form-actions">
                    <button type="submit" class="btn-app btn-primary-app">
                        <i class="bi bi-search"></i>
                        Search
                    </button>

                    <a asp-action="Index" class="btn-app btn-secondary-app">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>
                </div>

            </div>
        </form>

    </div>
</div>

<div class="app-card table-card">

    <div class="card-header">
        <h5 class="card-title">
            Salary Structure List
        </h5>
    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="empty-state">
                No salary structures found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="app-table">

                    <thead>
                        <tr>
                            <th>Employee</th>
                            <th>Effective From</th>
                            <th>Effective To</th>
                            <th>Actual Salary</th>
                            @* <th>Breakup</th>
                            <th>Applicability</th> *@
                            <th>Status</th>
                            <th>Updated On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.Employee?.FullName
                                    </strong>

                                    <br />

                                    <small>
                                        @item.Employee?.EmployeeCode
                                    </small>
                                </td>

                                <td>
                                    @item.EffectiveFrom.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @(item.EffectiveTo?.ToString("dd-MMM-yyyy") ?? "Open")
                                </td>

                                <td>
                                    <strong>
                                        @item.ActualSalary.ToString("N2")
                                    </strong>
                                </td>

                                @* <td>
                                    Basic @item.BasicSalary.ToString("N2")<br />
                                    HRA @item.HRA.ToString("N2")<br />
                                    Other @((item.DA + item.Conveyance + item.MedicalAllowance + item.EducationAllowance + item.SpecialAllowance + item.OtherAllowances).ToString("N2"))
                                </td>

                                <td>
                                    <small>
                                        PF: @(item.IsPfApplicable ? "Yes" : "No") |
                                        ESIC: @(item.IsEsicApplicable ? "Yes" : "No")<br />
                                        PT: @(item.IsPtApplicable ? "Yes" : "No") |
                                        TDS: @(item.IsTdsApplicable ? "Yes" : "No")
                                    </small>
                                </td> *@

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-danger">
                                            Inactive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(item.UpdatedOn?.ToString("dd-MMM-yyyy HH:mm") ?? "-")
                                </td>

                                <td class="text-end">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn-app btn-secondary-app btn-sm-app">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>

                                    <form asp-action="ToggleActive"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-app btn-outline-app btn-sm-app">
                                            @(item.IsActive ? "Deactivate" : "Activate")
                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }

    </div>

</div>

@model IEnumerable<AryamanBMS.Models.NoticeModel>

@{
    ViewData["Title"] = "Statutory Notices";

    var notices = Model.ToList();

    string? selectedDepartment = ViewBag.Department as string;
    string? selectedStatus = ViewBag.Status as string;
    string search = ViewBag.Search as string ?? "";
    DateTime? fromDate = ViewBag.FromDate as DateTime?;
    DateTime? toDate = ViewBag.ToDate as DateTime?;
    string sortBy = ViewBag.SortBy as string ?? "NoticeDate";
    string sortOrder = ViewBag.SortOrder as string ?? "desc";

    int openCount = notices.Count(x => x.Status == FinancialConstants.NoticeStatus.Open);
    int repliedCount = notices.Count(x => x.Status == FinancialConstants.NoticeStatus.Replied);
    int closedCount = notices.Count(x => x.Status == FinancialConstants.NoticeStatus.Closed);
    int escalatedCount = notices.Count(x => x.Status == FinancialConstants.NoticeStatus.Escalated);
}

<div class="module-header">

    <div>
        <h1 class="module-title">STATUTORY NOTICES</h1>
        <p class="module-subtitle">
            Track notices from GST, PF, ESIC, Income Tax, Labour, ROC and other authorities.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Create"
           class="btn-app btn-primary-app">
            <i class="bi bi-plus-circle"></i>
            Add Notice
        </a>

        <a asp-action="ExportCsv"
           asp-route-department="@selectedDepartment"
           asp-route-status="@selectedStatus"
           asp-route-search="@search"
           asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
           asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
           class="btn-app btn-secondary-app">
            <i class="bi bi-download"></i>
            Export
        </a>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <div class="app-alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="app-alert-danger">
        @TempData["Error"]
    </div>
}

<div class="dashboard-grid">

    <div class="stats-card">
        <div class="stats-label">Open</div>
        <div class="stats-number">@openCount</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Replied</div>
        <div class="stats-number">@repliedCount</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Escalated</div>
        <div class="stats-number">@escalatedCount</div>
    </div>

    <div class="stats-card">
        <div class="stats-label">Closed</div>
        <div class="stats-number">@closedCount</div>
    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Notice Register</h2>
            <p class="card-subtitle">
                Use filters below to view statutory notices by department and status.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form method="get"
              asp-action="Index">

            <div class="filter-row">

                <div class="filter-field">
                    <select name="department"
                            class="app-select">
                        <option value="">All Departments</option>

                        <option value="@FinancialConstants.NoticeDepartment.GST" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.GST ? "selected" : null)">GST</option>
                        <option value="@FinancialConstants.NoticeDepartment.PF" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.PF ? "selected" : null)">PF</option>
                        <option value="@FinancialConstants.NoticeDepartment.ESIC" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.ESIC ? "selected" : null)">ESIC</option>
                        <option value="@FinancialConstants.NoticeDepartment.IncomeTax" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.IncomeTax ? "selected" : null)">Income Tax</option>
                        <option value="@FinancialConstants.NoticeDepartment.Labour" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.Labour ? "selected" : null)">Labour</option>
                        <option value="@FinancialConstants.NoticeDepartment.ROC" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.ROC ? "selected" : null)">ROC</option>
                        <option value="@FinancialConstants.NoticeDepartment.Other" selected="@(selectedDepartment == FinancialConstants.NoticeDepartment.Other ? "selected" : null)">Other</option>
                    </select>
                </div>

                <div class="filter-field">
                    <select name="status"
                            class="app-select">
                        <option value="">All Status</option>

                        <option value="@FinancialConstants.NoticeStatus.Open" selected="@(selectedStatus == FinancialConstants.NoticeStatus.Open ? "selected" : null)">Open</option>
                        <option value="@FinancialConstants.NoticeStatus.Replied" selected="@(selectedStatus == FinancialConstants.NoticeStatus.Replied ? "selected" : null)">Replied</option>
                        <option value="@FinancialConstants.NoticeStatus.Closed" selected="@(selectedStatus == FinancialConstants.NoticeStatus.Closed ? "selected" : null)">Closed</option>
                        <option value="@FinancialConstants.NoticeStatus.Escalated" selected="@(selectedStatus == FinancialConstants.NoticeStatus.Escalated ? "selected" : null)">Escalated</option>
                    </select>
                </div>

                <div class="filter-field filter-field-wide">
                    <input name="search"
                           value="@search"
                           class="app-input"
                           placeholder="Notice no, subject, department or remarks" />
                </div>

                <div class="filter-field">
                    <select name="sortBy" class="app-select">
                        <option value="NoticeDate" selected="@(sortBy == "NoticeDate")">Sort by Notice Date</option>
                        <option value="NoticeNo" selected="@(sortBy == "NoticeNo")">Sort by Notice No</option>
                        <option value="Department" selected="@(sortBy == "Department")">Sort by Department</option>
                        <option value="Subject" selected="@(sortBy == "Subject")">Sort by Subject</option>
                        <option value="DueDate" selected="@(sortBy == "DueDate")">Sort by Due Date</option>
                        <option value="Status" selected="@(sortBy == "Status")">Sort by Status</option>
                        <option value="Active" selected="@(sortBy == "Active")">Sort by Active</option>
                    </select>
                </div>

                <div class="filter-field">
                    <select name="sortOrder" class="app-select">
                        <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                        <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                    </select>
                </div>

                <div class="filter-field">
                    <input type="date"
                           name="fromDate"
                           value="@fromDate?.ToString("yyyy-MM-dd")"
                           class="app-input" />
                </div>

                <div class="filter-field">
                    <input type="date"
                           name="toDate"
                           value="@toDate?.ToString("yyyy-MM-dd")"
                           class="app-input" />
                </div>

                <div class="filter-actions">
                    <button type="submit"
                            class="btn-app btn-primary-app">
                        <i class="bi bi-funnel"></i>
                        Filter
                    </button>

                    <a asp-action="Index"
                       class="btn-app btn-secondary-app">
                        <i class="bi bi-arrow-clockwise"></i>
                        Reset
                    </a>
                </div>

            </div>

        </form>

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Notice No.</th>
                        <th>Department</th>
                        <th>Subject</th>
                        <th>Notice Date</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th>Record</th>
                        <th class="text-center">Documents</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (notices.Any())
                    {
                        foreach (var item in notices)
                        {
                            string statusBadge = item.Status switch
                            {
                                FinancialConstants.NoticeStatus.Open => "badge-warning",
                                FinancialConstants.NoticeStatus.Replied => "badge-info",
                                FinancialConstants.NoticeStatus.Closed => "badge-success",
                                FinancialConstants.NoticeStatus.Escalated => "badge-danger",
                                _ => "badge-secondary"
                            };

                            bool isOverdue =
                            item.DueDate.HasValue &&
                            item.DueDate.Value.Date < DateTime.Today &&
                            item.Status != FinancialConstants.NoticeStatus.Closed;

                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(item.NoticeNumber) ? "-" : item.NoticeNumber)</td>

                                <td>
                                    <span class="badge-secondary">
                                        @item.Department
                                    </span>
                                </td>

                                <td>
                                    <strong>@item.Subject</strong>

                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="card-subtitle">
                                            @(item.Description.Length > 80
                                                                            ? item.Description.Substring(0, 80) + "..."
                                                                            : item.Description)
                            </div>
                                                        }
                                </td>

                                <td>@item.NoticeDate.ToString("dd-MMM-yyyy")</td>

                                <td>
                                    @if (item.DueDate.HasValue)
                                    {
                                        <span class="@(isOverdue ? "badge-danger" : "")">
                                            @item.DueDate.Value.ToString("dd-MMM-yyyy")
                                        </span>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    <span class="@statusBadge">
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Archived</span>
                                    }
                                </td>

                                <td class="text-center">
                                    <span class="badge-secondary">
                                        @(item.Documents?.Count ?? 0)
                                    </span>
                                </td>

                                <td>
                                    <div class="table-actions">
                                        <a asp-action="Details"
                                           asp-route-id="@item.NoticeId"
                                           class="btn-app btn-icon btn-primary-app"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.NoticeId"
                                           class="btn-app btn-icon btn-secondary-app"
                                           title="Edit">
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.NoticeId"
                                           class="btn-app btn-icon btn-danger-app"
                                           title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9"
                                class="empty-state">
                                No statutory notices found.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

        @if ((ViewBag.TotalPages ?? 1) > 1)
        {
            <div class="pagination-container">
                @for (int i = 1; i <= ViewBag.TotalPages; i++)
                {
                    <a asp-action="Index"
                       asp-route-page="@i"
                       asp-route-department="@selectedDepartment"
                       asp-route-status="@selectedStatus"
                       asp-route-search="@search"
                       asp-route-fromDate="@fromDate?.ToString("yyyy-MM-dd")"
                       asp-route-toDate="@toDate?.ToString("yyyy-MM-dd")"
                       asp-route-sortBy="@sortBy"
                       asp-route-sortOrder="@sortOrder"
                       class="page-link-app @(i == ViewBag.CurrentPage ? "active" : "")">
                        @i
                    </a>
                }
            </div>
        }

    </div>

</div>

@model AryamanBMS.Models.NoticeModel

@{
    ViewData["Title"] = "Notice Details";

    string statusBadge = Model.Status switch
    {
        FinancialConstants.NoticeStatus.Open => "badge-warning",
        FinancialConstants.NoticeStatus.Replied => "badge-info",
        FinancialConstants.NoticeStatus.Closed => "badge-success",
        FinancialConstants.NoticeStatus.Escalated => "badge-danger",
        _ => "badge-secondary"
    };
}

<div class="module-header">

    <div>
        <h1 class="module-title">NOTICE DETAILS</h1>
        <p class="module-subtitle">
            View statutory notice, reply status and uploaded documents.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Edit"
           asp-route-id="@Model.NoticeId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-pencil"></i>
        </a>

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

@if (TempData["Success"] != null)
{
    <div class="app-alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="app-alert-danger">
        @TempData["Error"]
    </div>
}

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">@Model.Subject</h2>
            <p class="card-subtitle">
                @(string.IsNullOrWhiteSpace(Model.NoticeNumber) ? "No notice number" : Model.NoticeNumber)
            </p>
        </div>

        <span class="@statusBadge">
            @Model.Status
        </span>
    </div>

    <div class="card-body">

        <div class="form-grid-3">

            <div class="form-group">
                <label class="form-label">Department</label>
                <div>@Model.Department</div>
            </div>

            <div class="form-group">
                <label class="form-label">Notice Date</label>
                <div>@Model.NoticeDate.ToString("dd-MMM-yyyy")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Received Date</label>
                <div>@Model.ReceivedDate.ToString("dd-MMM-yyyy")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Due Date</label>
                <div>@(Model.DueDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Reply Date</label>
                <div>@(Model.ReplyDate?.ToString("dd-MMM-yyyy") ?? "-")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Documents</label>
                <div>@(Model.Documents?.Count ?? 0)</div>
            </div>

            <div class="form-group">
                <label class="form-label">Record</label>
                @if (Model.IsActive)
                {
                    <span class="badge-success">Active</span>
                }
                else
                {
                    <span class="badge-secondary">Archived</span>
                }
            </div>

        </div>

        <div class="form-group">
            <label class="form-label">Description</label>
            <div>@(string.IsNullOrWhiteSpace(Model.Description) ? "-" : Model.Description)</div>
        </div>

        <div class="form-group">
            <label class="form-label">Reply Details</label>
            <div>@(string.IsNullOrWhiteSpace(Model.ReplyDetails) ? "-" : Model.ReplyDetails)</div>
        </div>

        <div class="form-group">
            <label class="form-label">Remarks</label>
            <div>@(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)</div>
        </div>

    </div>

</div>

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Upload Document</h2>
            <p class="card-subtitle">
                Upload notice copy, reply copy or supporting evidence.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="UploadDocument"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="noticeId"
                   value="@Model.NoticeId" />

            <div class="form-grid-4">

                <div class="form-group">
                    <label class="form-label">Document Type</label>

                    <select name="documentType"
                            class="app-select"
                            required>
                        <option value="">Select Type</option>
                        <option value="NoticeCopy">Notice Copy</option>
                        <option value="ReplyCopy">Reply Copy</option>
                        <option value="SupportingEvidence">Supporting Evidence</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">File</label>

                    <input type="file"
                           name="file"
                           class="app-input"
                           accept=".pdf,.doc,.docx,.xls,.xlsx,.jpg,.jpeg,.png"
                           required />
                    <small class="form-text">
                        PDF, Word, Excel, JPG or PNG only. Maximum size: 10 MB.
                    </small>
                </div>

                <div class="form-group">
                    <label class="form-label">Remarks</label>

                    <input type="text"
                           name="remarks"
                           class="app-input"
                           placeholder="Optional remarks" />
                </div>

                <div class="form-group">
                    <label class="form-label">&nbsp;</label>

                    <button type="submit"
                            class="btn-app btn-primary-app">
                        <i class="bi bi-upload"></i>
                        Upload
                    </button>
                </div>

            </div>

        </form>

    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Documents</h2>
            <p class="card-subtitle">
                Uploaded files linked with this notice.
            </p>
        </div>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table">

                <thead>
                    <tr>
                        <th>Type</th>
                        <th>File</th>
                        <th>Uploaded By</th>
                        <th>Uploaded On</th>
                        <th>Status</th>
                        <th>Remarks</th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Documents?.Any() == true)
                    {
                        foreach (var doc in Model.Documents)
                        {
                            <tr>
                                <td>@doc.DocumentType</td>

                                <td>
                                    <a asp-controller="Notice"
                                       asp-action="DownloadDocument"
                                       asp-route-id="@doc.NoticeDocumentId"
                                       class="app-link">
                                        <i class="bi bi-download"></i>
                                        @doc.FileName
                                    </a>
                                </td>

                                <td>@(string.IsNullOrWhiteSpace(doc.UploadedByUserId) ? "-" : doc.UploadedByUserId)</td>

                                <td>@doc.UploadedOn.ToString("dd-MMM-yyyy")</td>

                                <td>
                                    @if (doc.IsActive)
                                    {
                                        <span class="badge-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge-secondary">Archived</span>
                                    }
                                </td>

                                <td>@(string.IsNullOrWhiteSpace(doc.Remarks) ? "-" : doc.Remarks)</td>

                                <td>
                                    <div class="table-actions">
                                        <form asp-action="DeleteDocument"
                                              method="post">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@doc.NoticeDocumentId" />

                                            <input type="hidden"
                                                   name="noticeId"
                                                    value="@Model.NoticeId" />

                                            <button type="submit"
                                                    class="btn-app btn-icon @(doc.IsActive ? "btn-danger-app" : "btn-success-app")"
                                                    onclick="return confirm('Change document status?')">
                                                <i class="bi @(doc.IsActive ? "bi-trash" : "bi-arrow-counterclockwise")"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                class="empty-state">
                                No documents uploaded.
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

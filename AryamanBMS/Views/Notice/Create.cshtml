@model AryamanBMS.Models.NoticeModel
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Add Notice";

    var departments = new List<SelectListItem>
    {
        new() { Text = "GST", Value = FinancialConstants.NoticeDepartment.GST },
        new() { Text = "PF", Value = FinancialConstants.NoticeDepartment.PF },
        new() { Text = "ESIC", Value = FinancialConstants.NoticeDepartment.ESIC },
        new() { Text = "Income Tax", Value = FinancialConstants.NoticeDepartment.IncomeTax },
        new() { Text = "Labour", Value = FinancialConstants.NoticeDepartment.Labour },
        new() { Text = "ROC", Value = FinancialConstants.NoticeDepartment.ROC },
        new() { Text = "Other", Value = FinancialConstants.NoticeDepartment.Other }
    };

    var statuses = new List<SelectListItem>
    {
        new() { Text = "Open", Value = FinancialConstants.NoticeStatus.Open },
        new() { Text = "Replied", Value = FinancialConstants.NoticeStatus.Replied },
        new() { Text = "Closed", Value = FinancialConstants.NoticeStatus.Closed },
        new() { Text = "Escalated", Value = FinancialConstants.NoticeStatus.Escalated }
    };
}

<div class="module-header">

    <div>
        <h1 class="module-title">ADD STATUTORY NOTICE</h1>
        <p class="module-subtitle">
            Record a notice received from a statutory authority.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<div class="app-card form-card">

    <div class="card-header">
        <div>
            <h2 class="card-title">Notice Information</h2>
            <p class="card-subtitle">
                Enter authority, dates, subject and current reply status.
            </p>
        </div>
    </div>

    <div class="card-body">

        <form asp-action="Create"
              method="post">

            <div asp-validation-summary="All"
                 class="app-alert-danger"></div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Department"
                           class="form-label"></label>

                    <select asp-for="Department"
                            asp-items="departments"
                            class="app-select">
                    </select>

                    <span asp-validation-for="Department"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NoticeNumber"
                           class="form-label"></label>

                    <input asp-for="NoticeNumber"
                           class="app-input"
                           placeholder="Enter notice number" />

                    <span asp-validation-for="NoticeNumber"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="NoticeDate"
                           class="form-label"></label>

                    <input asp-for="NoticeDate"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="NoticeDate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ReceivedDate"
                           class="form-label"></label>

                    <input asp-for="ReceivedDate"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="ReceivedDate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="DueDate"
                           class="form-label"></label>

                    <input asp-for="DueDate"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="DueDate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Status"
                           class="form-label"></label>

                    <select asp-for="Status"
                            asp-items="statuses"
                            class="app-select">
                    </select>

                    <span asp-validation-for="Status"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Subject"
                       class="form-label"></label>

                <input asp-for="Subject"
                       class="app-input"
                       placeholder="Enter notice subject" />

                <span asp-validation-for="Subject"
                      class="validation-message"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"
                       class="form-label"></label>

                <textarea asp-for="Description"
                          class="app-input"
                          rows="4"
                          placeholder="Enter notice details"></textarea>

                <span asp-validation-for="Description"
                      class="validation-message"></span>
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="ReplyDate"
                           class="form-label"></label>

                    <input asp-for="ReplyDate"
                           type="date"
                           class="app-input" />

                    <span asp-validation-for="ReplyDate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Remarks"
                           class="form-label"></label>

                    <input asp-for="Remarks"
                           class="app-input"
                           placeholder="Optional remarks" />

                    <span asp-validation-for="Remarks"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="ReplyDetails"
                       class="form-label"></label>

                <textarea asp-for="ReplyDetails"
                          class="app-input"
                          rows="4"
                          placeholder="Enter reply details if already replied"></textarea>

                <span asp-validation-for="ReplyDetails"
                      class="validation-message"></span>
            </div>

            <div class="form-actions">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-check-circle"></i>
                    Save Notice
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Cancel
                </a>
            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
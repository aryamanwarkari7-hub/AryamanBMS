@model AryamanBMS.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<div class="auth-page corporate-login">

    <section class="login-brand-panel" aria-label="Enterprise Branding">
        <div class="login-brand-content">

            <div class="login-logo-wrap">
                <img src="~/images/aryaman_logo.svg"
                     asp-append-version="true"
                     alt="Aryaman Technologies Logo"
                     class="login-logo" />
            </div>

            <div class="login-brand-text">
                <p class="login-eyebrow">
                    Aryaman Technologies Private Limited
                </p>
                <h1>
                    Business Management System
                </h1>
                <p class="login-copy">
                    Secure unified access for HR workflows, payroll cycles, attendance tracking, master employee matrices, projects, and automated operations.
                </p>
            </div>

            <div class="login-highlights">
                <div>
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>Role-based access</span>
                </div>
                <div>
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Employee lifecycle</span>
                </div>
                <div>
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                    <span>Operational visibility</span>
                </div>
            </div>

        </div>
    </section>

    <main class="login-form-panel">
        <div class="login-card">

            <header class="login-card-header">
                <p class="login-card-kicker">Secure sign in</p>
                <h2>Welcome back</h2>
                <p>Enter your system credentials to access your secure profile workspace.</p>
            </header>

            <form asp-action="Login" method="post" class="login-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

                <div class="form-group">
                    <label asp-for="UserName" class="form-label">Username</label>
                    <input asp-for="UserName"
                           class="app-input"
                           autocomplete="username"
                           placeholder="Enter username" />
                    <span asp-validation-for="UserName" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <div class="login-label-row">
                        <label asp-for="Password" class="form-label">Password</label>
                        <a asp-action="ForgotPassword" asp-controller="Account" class="login-inline-link" tabindex="-1">Forgot password?</a>
                    </div>
                    <div class="app-input-action-wrapper">
                        <input asp-for="Password"
                               type="password"
                               class="app-input"
                               autocomplete="current-password"
                               placeholder="Enter password" />
                        <button type="button" class="btn-input-action" id="passwordToggle" aria-label="Toggle password visibility">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="validation-message"></span>
                </div>

                <div class="login-form-options">
                    <label class="form-check d-flex align-items-center gap-2 m-0">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <span class="form-check-label">Remember me</span>
                    </label>
                </div>

                <button type="submit" class="btn-app btn-primary-app login-submit">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign in</span>
                </button>

                <div class="auth-divider">
                    <span>or corporate identity provider</span>
                </div>

                <div class="sso-providers">
                    <button type="button" class="btn-app btn-secondary-app w-100 gap-2">
                        <i class="bi bi-microsoft text-primary"></i> Single Sign-On (SSO)
                    </button>
                </div>

            </form>

            <footer class="login-support">
                Need account workspace initialization assistance?<br />
                <span class="text-dark font-weight-bold">Contact your system administrator.</span>
            </footer>

        </div>
    </main>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/password-toggle.js" asp-append-version="true"></script>
}

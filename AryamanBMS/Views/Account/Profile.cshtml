@model AryamanBMS.ViewModels.AccountProfileViewModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="module-header">
    <div>
        <h1 class="module-title">My Profile</h1>
        <p class="module-subtitle">Account and linked employee information</p>
    </div>

    <div class="module-header-actions">
        <a asp-controller="Account"
           asp-action="ChangePassword"
           class="btn-app btn-secondary-app">
            <i class="bi bi-key"></i>
            Change Password
        </a>
    </div>
</div>

<div class="main-dashboard-layout">
    <div class="app-card dashboard-section-card">
        <div class="card-body text-center">
            <div class="profile-photo-wrap">
                @if (!string.IsNullOrWhiteSpace(Model.User.ProfilePhotoPath))
                {
                    <img src="@Model.User.ProfilePhotoPath"
                         alt="Profile photo"
                         class="profile-photo" />
                }
                else
                {
                    <div class="profile-photo profile-photo-initials">
                        @Model.Initials
                    </div>
                }
            </div>

            <h3 class="mt-3 mb-1">
                @(Model.Employee?.FullName ?? Model.User.FullName ?? Model.User.UserName)
            </h3>

            <p class="text-muted mb-2">
                @Model.RoleName
            </p>

            @if (Model.User.IsActive)
            {
                <span class="badge-success">Active Account</span>
            }
            else
            {
                <span class="badge-danger">Inactive Account</span>
            }

            <form asp-action="UploadProfilePhoto"
                  method="post"
                  enctype="multipart/form-data"
                  class="mt-4">

                @Html.AntiForgeryToken()

                <div class="form-group text-start">
                    <label class="form-label">Profile Photo</label>
                    <input type="file"
                           name="profilePhoto"
                           id="profilePhotoInput"
                           class="app-input"
                           accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                    <input type="hidden"
                           name="croppedProfilePhoto"
                           id="croppedProfilePhoto" />
                    <small class="form-text">JPG, PNG or WEBP. Maximum 2 MB.</small>
                </div>

                <button type="submit" class="btn-app btn-primary-app mt-3">
                    <i class="bi bi-upload"></i>
                    Upload Photo
                </button>
            </form>
        </div>
    </div>

    <div class="modal fade" id="profileCropModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Adjust Profile Photo</h5>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="profile-crop-wrap">
                        <img id="profileCropImage" alt="Crop preview" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button"
                            class="btn-app btn-secondary-app"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            id="applyProfileCrop"
                            class="btn-app btn-primary-app">
                        Apply Photo
                    </button>
                </div>

            </div>
        </div>
    </div>

    <div class="app-card dashboard-section-card">
        <div class="card-header">
            <h5 class="card-title">Account Information</h5>
        </div>

        <div class="card-body">
            <div class="profile-stack">
                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-person"></i>
                        Username
                    </span>
                    <strong>@(Model.User.UserName ?? "-")</strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-envelope"></i>
                        Email
                    </span>
                    <strong>
                        @(
                                                !string.IsNullOrWhiteSpace(Model.User.Email)
                                                ? Model.User.Email
                                                : Model.Employee?.OfficialEmail ?? "-"
                                                )
                    </strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-telephone"></i>
                        Phone
                    </span>
                    <strong>
                        @(
                                                !string.IsNullOrWhiteSpace(Model.User.PhoneNumber)
                                                ? Model.User.PhoneNumber
                                                : Model.Employee?.MobileNumber ?? "-"
                                                )
                    </strong>
                </div>

                <div class="profile-info-row">
                    <span>
                        <i class="bi bi-shield-check"></i>
                        Role
                    </span>
                    <strong>@Model.RoleName</strong>
                </div>
            </div>
            <div class="profile-summary-grid mt-4">

                <div class="profile-summary-item">
                    <i class="bi bi-circle-fill activity-@Model.User.ActivityStatus.ToLower().Replace(" ", "-")"></i>
                    <span>Activity</span>
                    <strong>@Model.User.ActivityStatus</strong>
                </div>

                <div class="profile-summary-item">
                    <i class="bi bi-bell"></i>
                    <span>Notifications</span>
                    <strong>
                        @(Model.User.EnableRealtimeNotifications ? "Enabled" : "Disabled")
                    </strong>
                </div>

                <div class="profile-summary-item">
                    <i class="bi bi-clock-history"></i>
                    <span>Last Seen</span>
                    <strong>
                        @(Model.User.LastSeenOn?.ToString("dd MMM, hh:mm tt") ?? "-")
                    </strong>
                </div>

                <div class="profile-summary-item">
                    <i class="bi bi-image"></i>
                    <span>Profile Photo</span>
                    <strong>
                        @(string.IsNullOrWhiteSpace(Model.User.ProfilePhotoPath) ? "Not Added" : "Added")
                    </strong>
                </div>

            </div>
        </div>
    </div>

    <div class="app-card mt-4">

        <div class="card-header">
            <h5 class="card-title">Activity Status</h5>
        </div>

        <div class="card-body">

            <form asp-controller="Account"
                  asp-action="UpdateActivityStatus"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="form-grid-2">

                    <div class="form-group">
                        <label class="form-label">Current Status</label>

                        <select name="activityStatus"
                                class="app-select">

                            <option value="Available" selected="@(Model.User.ActivityStatus == "Available" ? "selected" : null)">
                                Available
                            </option>

                            <option value="Busy" selected="@(Model.User.ActivityStatus == "Busy" ? "selected" : null)">
                                Busy
                            </option>

                            @* <option value="Away" selected="@(Model.User.ActivityStatus == "Away" ? "selected" : null)">
                                Away
                            </option> *@

                            <option value="Do Not Disturb" selected="@(Model.User.ActivityStatus == "Do Not Disturb" ? "selected" : null)">
                                Do Not Disturb
                            </option>

                            @* <option value="Offline" selected="@(Model.User.ActivityStatus == "Offline" ? "selected" : null)">
                                Offline
                            </option> *@

                        </select>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Status Message</label>

                        <input type="text"
                               name="activityStatusMessage"
                               value="@Model.User.ActivityStatusMessage"
                               maxlength="150"
                               class="app-input"
                               placeholder="Optional message" />
                    </div>

                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn-app btn-primary-app">
                        Update Status
                    </button>
                </div>

            </form>

        </div>

    </div>

    <div class="app-card mt-4">

        <div class="card-header">
            <h5 class="card-title">Notification Preferences</h5>
        </div>

        <div class="card-body">

            <form asp-controller="Notification"
                  asp-action="UpdatePreferences"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@Context.Request.Path@Context.Request.QueryString" />

                <div class="form-grid-2">

                    <label class="form-check-app">
                        <input type="checkbox"
                               name="enableRealtimeNotifications"
                               value="true"
                               checked="@Model.User.EnableRealtimeNotifications" />
                        <input type="hidden"
                               name="enableRealtimeNotifications"
                               value="false" />
                        <span>
                            <strong>Real-time notifications</strong>
                            <small>Required for live bell updates, toast popups and sound.</small>
                        </span>
                    </label>

                    <label class="form-check-app">
                        <input type="checkbox"
                               name="enableNotificationToast"
                               value="true"
                               checked="@Model.User.EnableNotificationToast" />
                        <input type="hidden"
                               name="enableNotificationToast"
                               value="false" />
                        <span>
                            <strong>Toast popup</strong>
                            <small>Show a small popup when a live notification arrives.</small>
                        </span>
                    </label>

                    <label class="form-check-app">
                        <input type="checkbox"
                               name="enableNotificationSound"
                               value="true"
                               checked="@Model.User.EnableNotificationSound" />
                        <input type="hidden"
                               name="enableNotificationSound"
                               value="false" />
                        <span>
                            <strong>Notification sound</strong>
                            <small>Play a soft sound with live notifications. Real-time must be enabled.</small>
                        </span>
                    </label>

                </div>

                <div class="mt-4">
                    <button type="submit"
                            class="btn-app btn-primary-app">
                        Save Preferences
                    </button>
                </div>

            </form>

        </div>

    </div>

    @if (Model.HasEmployeeProfile)
    {
        <div class="app-card dashboard-section-card dashboard-finance-card">
            <div class="card-header">
                <h5 class="card-title">Employee Information</h5>
            </div>

            <div class="card-body">
                <div class="profile-info-grid profile-info-grid-compact">
                    <div>
                        <label>Employee Code</label>
                        <strong>@(Model.Employee?.EmployeeCode ?? "-")</strong>
                    </div>

                    <div>
                        <label>Department</label>
                        <strong>@(Model.Employee?.Department?.DepartmentName ?? "-")</strong>
                    </div>

                    <div>
                        <label>Designation</label>
                        <strong>@(Model.Employee?.Designation?.DesignationName ?? "-")</strong>
                    </div>

                    <div>
                        <label>Joining Date</label>
                        <strong>@Model.Employee?.JoiningDate.ToString("dd-MMM-yyyy")</strong>
                    </div>

                    <div>
                        <label>Official Email</label>
                        <strong>@(Model.Employee?.OfficialEmail ?? "-")</strong>
                    </div>

                    <div>
                        <label>Mobile</label>
                        <strong>@(Model.Employee?.MobileNumber ?? "-")</strong>
                    </div>

                    <div>
                        <label>Employment Type</label>
                        <strong>@(Model.Employee?.EmploymentType ?? "-")</strong>
                    </div>

                    <div>
                        <label>Employee Status</label>
                        @if (Model.Employee?.IsActive == true)
                        {
                            <span class="badge-success">Active</span>
                        }
                        else
                        {
                            <span class="badge-danger">Inactive</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <link rel="stylesheet" href="~/lib/cropper/cropper.min.css" asp-append-version="true" />
    <script src="~/lib/cropper/cropper.min.js" asp-append-version="true"></script>
    <script src="~/js/profile-photo-crop.js" asp-append-version="true"></script>
}

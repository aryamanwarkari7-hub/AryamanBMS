@model AryamanBMS.ViewModels.ResetPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Establish New Password";
}

<div class="auth-page corporate-login">

    <section class="login-brand-panel" aria-label="Enterprise Branding">
        <div class="login-brand-content">
            <div class="login-logo-wrap">
                <img src="~/images/aryaman_logo.svg" asp-append-version="true" alt="Aryaman Logo" class="login-logo" />
            </div>
            <div class="login-brand-text">
                <p class="login-eyebrow">Aryaman Technologies Private Limited</p>
                <h1>Business Management System</h1>
                <p class="login-copy">
                    Secure unified access for HR workflows, payroll cycles, attendance tracking, master employee matrices, projects, and automated operations.
                </p>
            </div>
            <div class="login-highlights">
                <div><i class="bi bi-shield-check"></i> <span>Role-based access</span></div>
                <div><i class="bi bi-people"></i> <span>Employee lifecycle</span></div>
                <div><i class="bi bi-graph-up-arrow"></i> <span>Operational visibility</span></div>
            </div>
        </div>
    </section>

    <main class="login-form-panel">
        <div class="login-card">

            <header class="login-card-header">
                <p class="login-card-kicker">Security Enforcement</p>
                <h2>Create new password</h2>
                <p>Please provide a highly secure, fresh credential password combo to lock down your corporate profile.</p>
            </header>

            <form asp-action="ResetPassword" method="post" class="login-form">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <input type="hidden" asp-for="UserId" />
                <input type="hidden" asp-for="Token" />

                <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

                <div class="form-group mb-2">
                    <label asp-for="NewPassword" class="form-label">New Workspace Password</label>
                    <input asp-for="NewPassword" type="password" class="app-input" autocomplete="new-password" required />
                    <span asp-validation-for="NewPassword" class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="app-input" autocomplete="new-password" required />
                    <span asp-validation-for="ConfirmPassword" class="validation-message"></span>
                </div>

                <button type="submit" class="btn-app btn-primary-app login-submit mt-3">
                    <i class="bi bi-shield-lock"></i>
                    <span>Apply updated credentials</span>
                </button>
            </form>

        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
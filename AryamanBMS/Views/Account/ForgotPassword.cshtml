@model AryamanBMS.ViewModels.ForgotPasswordViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot Password";
}

<div class="auth-page corporate-login">

    <section class="login-brand-panel" aria-label="Enterprise Branding">
        <div class="login-brand-content">

            <div class="login-logo-wrap">
                <img src="~/images/aryaman_logo.svg"
                     asp-append-version="true"
                     alt="Aryaman Technologies Logo"
                     class="login-logo" />
            </div>

            <div class="login-brand-text">
                <p class="login-eyebrow">
                    Aryaman Technologies Private Limited
                </p>
                <h1>
                    Business Management System
                </h1>
                <p class="login-copy">
                    Secure unified access for HR workflows, payroll cycles, attendance tracking, master employee matrices, projects, and automated operations.
                </p>
            </div>

            <div class="login-highlights">
                <div>
                    <i class="bi bi-shield-check" aria-hidden="true"></i>
                    <span>Role-based access</span>
                </div>
                <div>
                    <i class="bi bi-people" aria-hidden="true"></i>
                    <span>Employee lifecycle</span>
                </div>
                <div>
                    <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
                    <span>Operational visibility</span>
                </div>
            </div>

        </div>
    </section>

    <main class="login-form-panel">
        <div class="login-card">

            <header class="login-card-header">
                <p class="login-card-kicker">Account Recovery</p>
                <h2>Reset password</h2>
                <p>Enter your verified corporate email address and we will send you instructions to securely reset your credentials.</p>
            </header>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="app-alert-success mb-3">
                    <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                </div>
            }

            <form asp-action="ForgotPassword" method="post" class="login-form">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Corporate Email Address</label>
                    <input asp-for="Email"
                           type="email"
                           class="app-input"
                           autocomplete="email"
                           placeholder="username@aryaman.com" required />
                    <span asp-validation-for="Email" class="validation-message"></span>
                </div>

                <button type="submit" class="btn-app btn-primary-app login-submit mt-2">
                    <i class="bi bi-envelope-send"></i>
                    <span>Send recovery link</span>
                </button>

                <div class="text-center mt-3">
                    <a asp-action="Login" class="login-back-link">
                        <i class="bi bi-arrow-left"></i> Back to sign in
                    </a>
                </div>

            </form>

            <footer class="login-support">
                Still experiencing issues? <br />
                <span class="text-dark font-weight-bold">Contact your system administrator.</span>
            </footer>

        </div>
    </main>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
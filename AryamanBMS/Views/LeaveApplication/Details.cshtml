@model AryamanBMS.Models.LeaveApplicationModel

@{
    ViewData["Title"] = "Leave Application Details";

    string statusClass = Model.Status switch
    {
        "Pending" => "badge-warning",
        "Approved" => "badge-success",
        "Rejected" => "badge-danger",
        "Cancelled" => "badge-secondary",
        _ => "badge-secondary"
    };

    string employeeText =
        $"{Model.Employee?.FullName ?? "-"} ({Model.Employee?.EmployeeCode ?? "-"})";

    var paidLeaveSnapshot =
    ViewBag.PaidLeaveSnapshot as AryamanBMS.ViewModels.PaidLeaveBalanceSnapshotViewModel;

    var leaveDays = Model.LeaveDays?
        .OrderBy(x => x.LeaveDate)
        .ToList() ?? new List<LeaveApplicationDayModel>();

    string GetDayStatusClass(string status)
    {
        return status switch
        {
            "Active" => "badge-success",
            "CancellationRequested" => "badge-warning",
            "Cancelled" => "badge-secondary",
            _ => "badge-secondary"
        };
    }
}

<div class="module-header">
    <div>
        <h1 class="module-title">@Model.ApplicationNumber</h1>
        <p class="module-subtitle">
            Leave application details and approval status
        </p>
    </div>

    <div class="module-header-actions">
        @if ((User.IsInRole("Admin") || User.IsInRole("HR"))
                && Model.Status == "Pending")
        {
            <form asp-action="Approve"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn-app btn-success-app"
                        onclick="return confirm('Approve this leave application?');">
                <i class="bi bi-check-lg"></i>
                Approve
                </button>
            </form>

            <form asp-action="Reject"
                  method="post"
                  class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden"
                       name="id"
                       value="@Model.Id" />

                <button type="submit"
                        class="btn-app btn-danger-app"
                        onclick="return confirm('Reject this leave application?');">
                <i class="bi bi-x-lg"></i>
                Reject
                </button>
            </form>
        }

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Application No</div>
            <div class="detail-summary-value">@Model.ApplicationNumber</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee</div>
            <div class="detail-summary-value">@employeeText</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Leave Type</div>
            <div class="detail-summary-value">
                @(Model.LeaveType?.LeaveName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@statusClass">@Model.Status</span>
            </div>
        </div>
    </div>

    <div class="detail-grid-2">

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Leave Period</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">From Date</span>
                        <strong class="detail-info-value">
                            @Model.FromDate.ToString("dd-MMM-yyyy")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">To Date</span>
                        <strong class="detail-info-value">
                            @Model.ToDate.ToString("dd-MMM-yyyy")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Number Of Days</span>
                        <strong class="detail-info-value">
                            @Model.NumberOfDays.ToString("0.##")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Paid Days</span>
                        <span class="detail-info-value">
                            @Model.PaidDays.ToString("0.##")
                        </span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Unpaid Days</span>
                        <span class="detail-info-value">
                            @Model.UnpaidDays.ToString("0.##")
                        </span>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Duration</span>
                        <strong class="detail-info-value">
                            @if (Model.IsHalfDay)
                            {
                                @(Model.HalfDaySession == "FirstHalf" ? "Half Day - First Half" : "Half Day - Second Half")
                            }
                            else
                            {
                                @("Full Day")
                            }
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Leave Type</span>
                        <strong class="detail-info-value">
                            @(Model.LeaveType?.LeaveName ?? "-")
                        </strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Application Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Employee</span>
                        <strong class="detail-info-value">@employeeText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Applied On</span>
                        <strong class="detail-info-value">
                            @Model.AppliedOn.ToString("dd-MMM-yyyy hh:mm tt")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Status</span>
                        <strong class="detail-info-value">
                            <span class="@statusClass">@Model.Status</span>
                        </strong>
                    </div>

                    @if (paidLeaveSnapshot != null)
                    {
                        <div class="app-alert-info mt-3">
                            <strong>Approval Split:</strong>
                            FY @paidLeaveSnapshot.FinancialYearLabel |
                            Available: @paidLeaveSnapshot.PaidLeaveBalance.ToString("0.##") |
                            Paid: @paidLeaveSnapshot.PaidDaysForRequest.ToString("0.##") |
                            Unpaid: @paidLeaveSnapshot.UnpaidDaysForRequest.ToString("0.##")
                        </div>
                    }


                </div>
            </div>
        </div>

    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Reason</h5>
        </div>

        <div class="card-body">
            <div class="detail-note-box">
                @(Model.Reason ?? "-")
            </div>
        </div>
    </div>

    @if (leaveDays.Any())
    {
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Leave Day Details</h5>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Days</th>
                                <th>Paid</th>
                                <th>Unpaid</th>
                                <th>Status</th>
                                <th>Cancellation</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var leaveDay in leaveDays)
                            {
                                <tr>
                                    <td>
                                        @leaveDay.LeaveDate.ToString("dd-MMM-yyyy")
                                    </td>
                                    <td>
                                        @leaveDay.DayValue.ToString("0.##")
                                    </td>
                                    <td>
                                        @leaveDay.PaidDays.ToString("0.##")
                                    </td>
                                    <td>
                                        @leaveDay.UnpaidDays.ToString("0.##")
                                    </td>
                                    <td>
                                        <span class="@GetDayStatusClass(leaveDay.Status)">
                                            @leaveDay.Status
                                        </span>
                                    </td>
                                    <td>
                                        @if (leaveDay.Status == "Active")
                                        {
                                            @("-")
                                        }
                                        else
                                        {
                                            <div>
                                                <strong>Reason:</strong>
                                                @(leaveDay.CancellationReason ?? "-")
                                            </div>
                                            <div>
                                                <strong>Requested:</strong>
                                                @(leaveDay.CancellationRequestedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                                            </div>
                                            <div>
                                                <strong>Reviewed:</strong>
                                                @(leaveDay.CancellationReviewedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.CancellationStatus) ||
        !string.IsNullOrWhiteSpace(Model.CancellationReason) ||
        !string.IsNullOrWhiteSpace(Model.CancellationRemarks))
    {
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Cancellation Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-grid-3">
                    <div class="detail-info-list">
                        <div class="detail-info-row">
                            <span class="detail-info-label">Cancellation Status</span>
                            <strong class="detail-info-value">
                                @(Model.CancellationStatus ?? "-")
                            </strong>
                        </div>
                    </div>

                    <div class="detail-info-list">
                        <div class="detail-info-row">
                            <span class="detail-info-label">Requested On</span>
                            <strong class="detail-info-value">
                                @(Model.CancellationRequestedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                            </strong>
                        </div>
                    </div>

                    <div class="detail-info-list">
                        <div class="detail-info-row">
                            <span class="detail-info-label">Reviewed On</span>
                            <strong class="detail-info-value">
                                @(Model.CancellationReviewedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                            </strong>
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="detail-note-box">
                        <strong>Reason:</strong>
                        @(Model.CancellationReason ?? "-")
                    </div>
                </div>

                <div class="mt-3">
                    <div class="detail-note-box">
                        <strong>Remarks:</strong>
                        @(Model.CancellationRemarks ?? "-")
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Approval Information</h5>
        </div>

        <div class="card-body">
            <div class="detail-grid-3">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Approved By</span>
                        <strong class="detail-info-value">
                            @(Model.ApprovedBy ?? "-")
                        </strong>
                    </div>
                </div>

                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Approved On</span>
                        <strong class="detail-info-value">
                            @(Model.ApprovedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                        </strong>
                    </div>
                </div>

                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Approval Status</span>
                        <strong class="detail-info-value">
                            <span class="@statusClass">@Model.Status</span>
                        </strong>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <div class="detail-note-box">
                    <strong>Remarks:</strong>
                    @(Model.ApprovalRemarks ?? "-")
                </div>
            </div>
        </div>
    </div>

</div>

@model AryamanBMS.Models.LeaveApplicationModel

@{
    ViewData["Title"] = "Leave Application Details";

    string statusClass = Model.Status switch
    {
        "Pending" => "badge-warning",
        "Approved" => "badge-success",
        "Rejected" => "badge-danger",
        "Cancelled" => "badge-neutral",
        _ => "badge-neutral"
    };

    string employeeText = $"{Model.Employee?.FullName ?? "-"} ({Model.Employee?.EmployeeCode ?? "-"})";

    var paidLeaveSnapshot = ViewBag.PaidLeaveSnapshot as AryamanBMS.ViewModels.PaidLeaveBalanceSnapshotViewModel;

    var leaveDays = Model.LeaveDays?
        .OrderBy(x => x.LeaveDate)
        .ToList() ?? new List<LeaveApplicationDayModel>();

    string GetDayStatusClass(string status) => status switch
    {
        "Active" => "badge-success",
        "CancellationRequested" => "badge-warning",
        "Cancelled" => "badge-neutral",
        _ => "badge-neutral"
    };

    bool isPermanent = string.Equals(Model.Employee?.EmploymentType, "Permanent", StringComparison.OrdinalIgnoreCase);

    bool isCompOff = string.Equals(
        Model.LeaveType?.LeaveCode,
        "COMP",
        StringComparison.OrdinalIgnoreCase);

    bool isBirthdayLeave = string.Equals(
        Model.LeaveType?.LeaveCode,
        "BDL",
        StringComparison.OrdinalIgnoreCase);
}

<div class="module-header">
    <div>
        <h1 class="module-title">@Model.ApplicationNumber</h1>
        <p class="module-subtitle">
            Leave application details and approval status
        </p>
    </div>

    <div class="module-header-actions">
        @if ((User.IsInRole("Admin") || User.IsInRole("HR")) && Model.Status == "Pending")
        {
            <form asp-action="Approve" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-app btn-success-app"
                        onclick="return confirm('Approve this leave application?');">
                    <i class="bi bi-check-lg"></i> Approve
                </button>
            </form>

            <form asp-action="Reject" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn-app btn-danger-app"
                        onclick="return confirm('Reject this leave application?');">
                    <i class="bi bi-x-lg"></i> Reject
                </button>
            </form>
        }

        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i> Back
        </a>
    </div>
</div>

<div class="detail-page">

    <!-- Top Summary Grid -->
    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Application No</div>
            <div class="detail-summary-value">@Model.ApplicationNumber</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee</div>
            <div class="detail-summary-value">@employeeText</div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Leave Type</div>
            <div class="detail-summary-value">
                @(Model.LeaveType?.LeaveName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Status</div>
            <div class="detail-summary-value">
                <span class="@statusClass">@Model.Status</span>
            </div>
        </div>
    </div>

    <!-- 2 Balanced Information Cards -->
    <div class="detail-grid-2">

        <!-- Leave Period & Details -->
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Leave Details</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">From Date</span>
                        <strong class="detail-info-value">@Model.FromDate.ToString("dd-MMM-yyyy")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">To Date</span>
                        <strong class="detail-info-value">@Model.ToDate.ToString("dd-MMM-yyyy")</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Duration</span>
                        <strong class="detail-info-value">
                            @if (Model.IsHalfDay)
                            {
                                @(Model.HalfDaySession == "FirstHalf" ? "Half Day (First Half)" : "Half Day (Second Half)")
                            }
                            else
                            {
                                @("Full Day")
                            }
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Total Days</span>
                        <strong class="detail-info-value">@Model.NumberOfDays.ToString("0.##") Day(s)</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Employment Type</span>
                        <strong class="detail-info-value">
                            <span class="badge-neutral">@(Model.Employee?.EmploymentType ?? "-")</span>
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Leave Split</span>
                        <strong class="detail-info-value">
                            @if (isPermanent)
                            {
                                <span>@Model.PaidDays.ToString("0.##") Paid / @Model.UnpaidDays.ToString("0.##")
                                    Unpaid</span>
                                }
                            else if (isCompOff)
                                {
                                    <span class="badge-info">Comp Off</span>
                                }
                                else
                                {
                                    <span class="badge-neutral">Unpaid (Stipend / Intern)</span>
                                }
                            </strong>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Application & Approval Information -->
            <div class="app-card">
                <div class="card-header">
                    <h5 class="card-title">Application & Review</h5>
                </div>

                <div class="card-body">
                    <div class="detail-info-list">
                        <div class="detail-info-row">
                            <span class="detail-info-label">Applied On</span>
                            <strong class="detail-info-value">@Model.AppliedOn.ToString("dd-MMM-yyyy hh:mm tt")</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Current Status</span>
                            <strong class="detail-info-value">
                                <span class="@statusClass">@Model.Status</span>
                            </strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Reviewed By</span>
                            <strong class="detail-info-value">@(Model.ApprovedBy ?? "-")</strong>
                        </div>

                        <div class="detail-info-row">
                            <span class="detail-info-label">Reviewed On</span>
                            <strong class="detail-info-value">
                                @(Model.ApprovedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                            </strong>
                        </div>
                    </div>

                    <!-- Contextual Leave Balance Notice -->
                    <div class="mt-3">
                        @if (isPermanent)
                        {
                            if (isCompOff)
                            {
                                <div class="detail-note-box">
                                    <i class="bi bi-info-circle text-primary"></i>
                                    Comp Off is granted from earned comp-off credits and does not deduct from the Annual Paid Leave
                                    pool.
                                </div>
                            }
                            else if (isBirthdayLeave)
                            {
                                <div class="detail-note-box">
                                    <i class="bi bi-gift text-primary"></i>
                                    Birthday leave is a special annual benefit and does not deduct from regular paid leave balance.
                                </div>
                            }
                            else if (paidLeaveSnapshot != null)
                            {
                                <div class="leave-split-preview is-success">
                                    <div class="leave-split-preview-icon">
                                        <i class="bi bi-calculator"></i>
                                    </div>
                                    <div>
                                        <strong>FY @paidLeaveSnapshot.FinancialYearLabel Paid Leave Balance</strong>
                                        <div class="leave-split-preview-values">
                                            <span class="leave-split-chip leave-split-chip-paid">
                                                <strong>@Model.PaidDays.ToString("0.##")</strong>
                                                <small>Paid day(s)</small>
                                            </span>
                                            <span class="leave-split-chip leave-split-chip-unpaid">
                                                <strong>@Model.UnpaidDays.ToString("0.##")</strong>
                                                <small>Unpaid day(s)</small>
                                            </span>
                                        </div>
                                        <span class="leave-split-preview-note">
                                            Available balance before this request:
                                            @paidLeaveSnapshot.PaidLeaveBalance.ToString("0.##") day(s)
                                        </span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            if (isCompOff)
                            {
                                <div class="detail-note-box">
                                    <i class="bi bi-info-circle text-primary"></i>
                                    Comp Off Leave: Claimed against verified extra hours worked.
                                </div>
                            }
                            else
                            {
                                <div class="detail-note-box">
                                    <i class="bi bi-info-circle text-primary"></i>
                                    <strong>Stipend / Non-Permanent:</strong> Only permanent employees accrue Annual Paid Leaves.
                                    This leave is recorded as Unpaid.
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>

        </div>

        <!-- Reason & Remarks -->
        <div class="detail-grid-2">
            <div class="app-card">
                <div class="card-header">
                    <h5 class="card-title">Reason for Leave</h5>
                </div>
                <div class="card-body">
                    <div class="detail-note-box">
                        @(Model.Reason ?? "-")
                    </div>
                </div>
            </div>

            <div class="app-card">
                <div class="card-header">
                    <h5 class="card-title">Approval Remarks</h5>
                </div>
                <div class="card-body">
                    <div class="detail-note-box">
                        @(Model.ApprovalRemarks ?? "No remarks entered.")
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Breakdown Table -->
        @if (leaveDays.Any())
        {
            <div class="app-card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Daily Leave Breakdown</h5>
                </div>

                <div class="card-body">
                    <div class="table-responsive">
                        <table class="app-table">
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Days</th>
                                    @if (isPermanent)
                                    {
                                        <th>Paid</th>
                                        <th>Unpaid</th>
                                    }
                                    else
                                    {
                                        <th>Type</th>
                                    }
                                    <th>Status</th>
                                    <th>Cancellation Details</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var leaveDay in leaveDays)
                                {
                                    <tr>
                                        <td><strong>@leaveDay.LeaveDate.ToString("dd-MMM-yyyy")</strong></td>
                                        <td>@leaveDay.DayValue.ToString("0.##")</td>
                                        @if (isPermanent)
                                        {
                                            <td>@leaveDay.PaidDays.ToString("0.##")</td>
                                            <td>@leaveDay.UnpaidDays.ToString("0.##")</td>
                                        }
                                        else
                                        {
                                            <td>
                                                @if (isCompOff)
                                                {
                                                    <span class="badge-info">Comp Off</span>
                                                }
                                                else
                                                {
                                                    <span class="badge-neutral">Unpaid</span>
                                                }
                                            </td>
                                        }
                                        <td>
                                            <span class="@GetDayStatusClass(leaveDay.Status)">
                                                @leaveDay.Status
                                            </span>
                                        </td>
                                        <td>
                                            @if (leaveDay.Status == "Active")
                                            {
                                                <span>-</span>
                                            }
                                            else
                                            {
                                                <div class="d-flex flex-column gap-1">
                                                    <span><strong>Reason:</strong> @(leaveDay.CancellationReason ?? "-")</span>
                                                    <small class="text-muted">
                                                        Req: @(leaveDay.CancellationRequestedOn?.ToString("dd-MMM-yyyy hh:mm tt") ??
                                                                                                                                                                                                                                                                        "-")
                                                    </small>
                                                </div>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <!-- Cancellation Information (if application has cancellation activity) -->
        @if (!string.IsNullOrWhiteSpace(Model.CancellationStatus) ||
             !string.IsNullOrWhiteSpace(Model.CancellationReason) ||
             !string.IsNullOrWhiteSpace(Model.CancellationRemarks))
        {
            <div class="app-card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Cancellation Information</h5>
                </div>

                <div class="card-body">
                    <div class="detail-grid-2 mb-3">
                        <div class="detail-info-list">
                            <div class="detail-info-row">
                                <span class="detail-info-label">Cancellation Status</span>
                                <strong class="detail-info-value">
                                    <span class="badge-warning">@(Model.CancellationStatus ?? "-")</span>
                                </strong>
                            </div>
                            <div class="detail-info-row">
                                <span class="detail-info-label">Requested On</span>
                                <strong class="detail-info-value">
                                    @(Model.CancellationRequestedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                                </strong>
                            </div>
                        </div>

                        <div class="detail-info-list">
                            <div class="detail-info-row">
                                <span class="detail-info-label">Reviewed On</span>
                                <strong class="detail-info-value">
                                    @(Model.CancellationReviewedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                                </strong>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                    {
                        <div class="mb-2">
                            <span class="detail-info-label d-block mb-1">Reason for Cancellation</span>
                            <div class="detail-note-box">@Model.CancellationReason</div>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.CancellationRemarks))
                    {
                        <div>
                            <span class="detail-info-label d-block mb-1">Cancellation Remarks</span>
                            <div class="detail-note-box">@Model.CancellationRemarks</div>
                        </div>
                    }
                </div>
            </div>
        }

    </div>
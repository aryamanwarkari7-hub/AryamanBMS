@model List<AryamanBMS.ViewModels.EmployeePaidLeaveBalanceViewModel>

@{
    ViewData["Title"] = "Paid Leave Balance Register";
    int selectedYear = ViewBag.SelectedYear;
    string? searchText = ViewBag.SearchText;
    int currentPage = ViewBag.Page ?? 1;
    int pageSize = ViewBag.PageSize ?? 10;
    int totalRecords = ViewBag.TotalRecords ?? Model.Count;
    string sortBy = ViewBag.SortBy as string ?? "EmployeeCode";
    string sortOrder = ViewBag.SortOrder as string ?? "asc";

    var pagination = new AryamanBMS.ViewModels.PaginationViewModel
    {
        CurrentPage = currentPage,
        PageSize = pageSize,
        TotalRecords = totalRecords,
        ControllerName = "LeaveApplication",
        ActionName = "PaidLeaveBalanceRegister",
        RouteValues = new Dictionary<string, string>
        {
            ["year"] = selectedYear.ToString(),
            ["sortBy"] = sortBy,
            ["sortOrder"] = sortOrder
        }
    };

    if (!string.IsNullOrWhiteSpace(searchText))
    {
        pagination.RouteValues["searchText"] = searchText;
    }
}

<div class="module-header">
    <div>
        <h1 class="module-title">Paid Leave Balance Register</h1>
        <p class="module-subtitle">Employee-wise financial year paid leave balances</p>
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-body">
        <form method="get" class="form-grid-3">
            <div class="form-group">
                <label class="form-label">Financial Year Start</label>
                <input type="number"
                       name="year"
                       value="@selectedYear"
                       class="app-input" />
            </div>

            <div class="form-group">
                <label class="form-label">Search Employee</label>
                <input type="text"
                       name="searchText"
                       value="@searchText"
                       class="app-input"
                       placeholder="Code or name" />
            </div>

            <div class="form-group d-flex flex-row align-items-end gap-2">
                <button type="submit" class="btn-app btn-primary-app">
                    <i class="bi bi-search"></i>
                    Apply
                </button>

                <a asp-action="PaidLeaveBalanceRegister"
                   asp-controller="LeaveApplication"
                   class="btn-app btn-secondary-app">
                    <i class="bi bi-arrow-counterclockwise"></i>
                    Reset
                </a>
            </div>

            <div class="form-group">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="app-input">
                    <option value="EmployeeCode" selected="@(sortBy == "EmployeeCode")">Employee Code</option>
                    <option value="EmployeeName" selected="@(sortBy == "EmployeeName")">Employee Name</option>
                    <option value="JoiningDate" selected="@(sortBy == "JoiningDate")">Joining Date</option>
                    <option value="PaidBalance" selected="@(sortBy == "PaidBalance")">Paid Balance</option>
                    <option value="BirthdayLeave" selected="@(sortBy == "BirthdayLeave")">Birthday Leave</option>
                </select>
            </div>

            <div class="form-group">
                <label class="form-label">Order</label>
                <select name="sortOrder" class="app-input">
                    <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                    <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                </select>
            </div>
        </form>
    </div>
</div>

<div class="app-card">
    <div class="card-header">
        <div>
            <h5 class="card-title">FY @selectedYear-@(selectedYear + 1)</h5>
            <p class="card-subtitle">Regular paid leave: 18 days annually | Birthday Leave: 1 paid day separately</p>
        </div>
    </div>

    <div class="card-body">
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Employee Code</th>
                        <th>Employee Name</th>
                        <th>Joining Date</th>
                        <th>FY Period</th>
                        <th>Entitlement</th>
                        <th>Used Paid</th>
                        <th>Balance</th>
                        <th>Birthday Leave</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        for (int index = 0; index < Model.Count; index++)
                        {
                            var item = Model[index];
                            <tr>
                                <td>@(((currentPage - 1) * pageSize) + index + 1)</td>
                                <td>@item.EmployeeCode</td>
                                <td>@item.EmployeeName</td>
                                <td>@item.JoiningDate.ToString("dd-MMM-yyyy")</td>
                                <td>@item.FinancialYearLabel</td>
                                <td>@item.ProratedEntitlement.ToString("0.##")</td>
                                <td>@item.PaidUsed.ToString("0.##")</td>
                                <td>
                                    <strong>@item.PaidBalance.ToString("0.##")</strong>
                                </td>
                                <td>
                                    <span>
                                        @item.BirthdayLeave.Available.ToString("0.##")
                                        available
                                    </span>
                                    <small class="text-muted d-block">
                                        Used: @item.BirthdayLeave.Used.ToString("0.##") / 1
                                    </small>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted">
                                No employees found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="pagination" />
    </div>
</div>

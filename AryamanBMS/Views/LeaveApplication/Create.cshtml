@model AryamanBMS.Models.LeaveApplicationModel

@{
    ViewData["Title"] = "Apply Leave";
    var paidLeaveSnapshot =
        ViewBag.PaidLeaveSnapshot as AryamanBMS.ViewModels.PaidLeaveBalanceSnapshotViewModel;
}



<div class="module-header">
    <div>
        <h1 class="module-title">Apply Leave</h1>
        <p class="module-subtitle">Submit a new leave application</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           asp-route-mine="@(Context.Request.Query["mine"] == "true" ? "true" : null)" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back 
        </a>
    </div>
</div>

<div class="app-card form-card">
    @if (paidLeaveSnapshot != null)
    {
        <div class="leave-apply-summary">
            <div class="leave-apply-summary-heading">
                <div class="leave-apply-summary-icon">
                    <i class="bi bi-calendar2-check"></i>
                </div>

                <div>
                    <div class="leave-apply-summary-title">
                        Paid Leave Balance
                    </div>
                    <div class="leave-apply-summary-period">
                        FY @paidLeaveSnapshot.FinancialYearLabel
                    </div>
                </div>
            </div>

            <div class="leave-apply-summary-grid">
                <div>
                    <span>Earned This FY</span>
                    <strong>@paidLeaveSnapshot.ProratedEntitlement.ToString("0.##")</strong>
                </div>

                <div>
                    <span>Carry Forward</span>
                    <strong>@paidLeaveSnapshot.CarryForwardDays.ToString("0.##")</strong>
                </div>

                <div>
                    <span>Total Leave Pool</span>
                    <strong>
                        @((paidLeaveSnapshot.ProratedEntitlement + paidLeaveSnapshot.CarryForwardDays).ToString("0.##"))
                    </strong>
                </div>

                <div>
                    <span>Available</span>
                    <strong>@paidLeaveSnapshot.PaidLeaveBalance.ToString("0.##")</strong>
                </div>

                <div>
                    <span>Used</span>
                    <strong>@paidLeaveSnapshot.PaidLeaveUsed.ToString("0.##")</strong>
                </div>

                <div>
                    <span>Pending Approvals</span>
                    <strong>@paidLeaveSnapshot.PendingPaidLeaveReserved.ToString("0.##")</strong>
                </div>

                <div>
                    <span>Birthday Leave</span>
                    <strong>
                        @paidLeaveSnapshot.BirthdayLeave.Available.ToString("0.##")
                        /
                        @paidLeaveSnapshot.BirthdayLeave.Entitlement.ToString("0.##")
                    </strong>
                </div>
            </div>
        </div>

        <div class="leave-split-preview is-empty" id="leaveSplitPreview">
            <div class="leave-split-preview-icon">
                <i class="bi bi-calculator"></i>
            </div>

            <div>
                <strong>Paid / unpaid preview</strong>
                <span id="leaveSplitPreviewText">
                    Select leave type and dates to preview the split.
                </span>
            </div>
        </div>
    }
    <div class="card-header">
        
        
        <div>
            <h5 class="card-title">Leave Details</h5>
            <p class="card-subtitle">Select leave type, date range and reason</p>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message mb-3">
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="LeaveTypeId" class="form-label">Leave Type</label>

                    <select asp-for="LeaveTypeId" class="app-select">
                        <option value="">Select Leave Type</option>

                        @foreach (var leaveType in ViewBag.LeaveTypes)
                        {
                            <option value="@leaveType.Id"
                                    data-leave-code="@leaveType.LeaveCode">
                                @leaveType.LeaveCode - @leaveType.LeaveName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="LeaveTypeId"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label class="form-label">Estimated Days</label>

                    <div class="app-input readonly-field" id="estimatedDays">
                        -
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Leave Duration</label>

                    <select asp-for="IsHalfDay"
                            class="app-select"
                            id="leaveDuration">
                        <option value="false">Full Day</option>
                        <option value="true">Half Day</option>
                    </select>
                </div>

                <div class="form-group" id="halfDaySessionGroup">
                    <label asp-for="HalfDaySession" class="form-label">Half Day</label>

                    <select asp-for="HalfDaySession"
                            class="app-select"
                            id="halfDaySession">
                        <option value="">Select Half</option>
                        <option value="FirstHalf">First Half</option>
                        <option value="SecondHalf">Second Half</option>
                    </select>

                    <span asp-validation-for="HalfDaySession"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="FromDate" class="form-label">From Date</label>

                    <input asp-for="FromDate"
                           type="date"
                           class="app-input"
                           id="fromDate" />

                    <span asp-validation-for="FromDate"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="ToDate" class="form-label">To Date</label>

                    <input asp-for="ToDate"
                           type="date"
                           class="app-input"
                           id="toDate" />

                    <span asp-validation-for="ToDate"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group form-span-2">
                    <label asp-for="Reason" class="form-label">Reason</label>

                    <textarea asp-for="Reason"
                              class="app-textarea"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter reason for leave"></textarea>

                    <span asp-validation-for="Reason"
                          class="validation-message">
                    </span>
                </div>

            </div>

            <div class="form-actions mt-4">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-send"></i>
                    Submit Application
                </button>

                <a asp-action="Index"
                   asp-route-mine="@(Context.Request.Query["mine"] == "true" ? "true" : null)"
                   class="btn-app btn-secondary-app">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const fromDateInput = document.getElementById('fromDate');
            const toDateInput = document.getElementById('toDate');
            const estimatedDays = document.getElementById('estimatedDays');
            const leaveDuration = document.getElementById('leaveDuration');

            const leaveTypeSelect = document.getElementById('LeaveTypeId');

            const availableBirthdayLeaves =
               Number("@(paidLeaveSnapshot?.BirthdayLeave.Available ?? 0)");
            const halfDaySessionGroup = document.getElementById('halfDaySessionGroup');

            const availablePaidLeaves =
                Number("@(paidLeaveSnapshot?.PaidLeaveBalance ?? 0)");

            function setSplitPreview(days) {
                let preview = document.getElementById('leaveSplitPreview');
                const previewText = document.getElementById('leaveSplitPreviewText');

                if (!preview) {
                    return;
                }

                function updatePreview(message, state) {
                    preview.classList.remove('is-empty', 'is-success', 'is-warning');
                    preview.classList.add(state);

                    if (previewText) {
                        previewText.textContent = message;
                    } else {
                        preview.textContent = message;
                    }
                }

                function renderSplitPreview(paidDays, unpaidDays, note, state) {
                    preview.classList.remove('is-empty', 'is-success', 'is-warning');
                    preview.classList.add(state);

                    if (!previewText) {
                        preview.textContent =
                            `${paidDays} paid day(s), ${unpaidDays} unpaid day(s).`;
                        return;
                    }

                    const values = document.createElement('div');
                    values.className = 'leave-split-preview-values';

                    const paidChip = document.createElement('span');
                    paidChip.className = 'leave-split-chip leave-split-chip-paid';

                    const paidValue = document.createElement('strong');
                    paidValue.textContent = paidDays;

                    const paidLabel = document.createElement('small');
                    paidLabel.textContent = 'Paid day(s)';

                    paidChip.appendChild(paidValue);
                    paidChip.appendChild(paidLabel);

                    const unpaidChip = document.createElement('span');
                    unpaidChip.className =
                        unpaidDays > 0
                            ? 'leave-split-chip leave-split-chip-unpaid has-unpaid'
                            : 'leave-split-chip leave-split-chip-unpaid';

                    const unpaidValue = document.createElement('strong');
                    unpaidValue.textContent = unpaidDays;

                    const unpaidLabel = document.createElement('small');
                    unpaidLabel.textContent = 'Unpaid day(s)';

                    unpaidChip.appendChild(unpaidValue);
                    unpaidChip.appendChild(unpaidLabel);

                    values.appendChild(paidChip);
                    values.appendChild(unpaidChip);

                    previewText.replaceChildren(values);

                    if (note) {
                        const noteElement = document.createElement('span');
                        noteElement.className = 'leave-split-preview-note';
                        noteElement.textContent = note;
                        previewText.appendChild(noteElement);
                    }
                }

                if (!days || days <= 0) {
                    updatePreview(
                        'Select leave type and dates to preview the split.',
                        'is-empty');
                    return;
                }

                        const selectedOption =
            leaveTypeSelect.options[leaveTypeSelect.selectedIndex];

        const isBirthdayLeave =
            selectedOption &&
            selectedOption.dataset.leaveCode?.toUpperCase() === 'BDL';

        if (isBirthdayLeave) {
            const paidDays = Math.min(days, availableBirthdayLeaves);
            const unpaidDays = Math.max(0, days - paidDays);

            renderSplitPreview(
                paidDays,
                unpaidDays,
                'Birthday leave does not reduce regular paid leave balance.',
                unpaidDays > 0 ? 'is-warning' : 'is-success');

            return;
        }

                const paidDays = Math.min(days, availablePaidLeaves);
                const unpaidDays = Math.max(0, days - paidDays);

                renderSplitPreview(
                    paidDays,
                    unpaidDays,
                    '',
                    unpaidDays > 0 ? 'is-warning' : 'is-success');
            }

            function updateEstimatedDays() {
                const isHalfDay = leaveDuration.value === 'true';

                halfDaySessionGroup.style.display = isHalfDay ? '' : 'none';

                if (isHalfDay && fromDateInput.value) {
                    toDateInput.value = fromDateInput.value;
                    toDateInput.setAttribute('readonly', 'readonly');
                    estimatedDays.textContent = '0.5 day';
                    setSplitPreview(0.5);
                    return;
                }

                if (!fromDateInput.value || !toDateInput.value) {
                    estimatedDays.textContent = '-';
                    setSplitPreview(0);

                    if (!isHalfDay) {
                        toDateInput.removeAttribute('readonly');
                    }

                    return;
                }

                if (isHalfDay) {
                    estimatedDays.textContent = '0.5 day';
                    setSplitPreview(0.5);
                    return;
                }

                toDateInput.removeAttribute('readonly');

                const fromDate = new Date(fromDateInput.value);
                const toDate = new Date(toDateInput.value);

                if (Number.isNaN(fromDate.getTime()) || Number.isNaN(toDate.getTime())) {
                    estimatedDays.textContent = '-';
                    setSplitPreview(0);
                    return;
                }

                if (toDate < fromDate) {
                    estimatedDays.textContent = 'Invalid range';
                    setSplitPreview(0);
                    return;
                }

                const diffTime = toDate.getTime() - fromDate.getTime();
                const diffDays = Math.floor(diffTime / 86400000) + 1;

                estimatedDays.textContent =
                    diffDays + (diffDays === 1 ? ' day' : ' days');

                setSplitPreview(diffDays);
            }

            fromDateInput.addEventListener('change', updateEstimatedDays);
            toDateInput.addEventListener('change', updateEstimatedDays);
            leaveDuration.addEventListener('change', updateEstimatedDays);
            leaveTypeSelect.addEventListener('change', updateEstimatedDays);

            updateEstimatedDays();
        })();
    </script>
}

@model AryamanBMS.Models.LeaveApplicationModel

@{
    ViewData["Title"] = "Apply Leave";
    var paidLeaveSnapshot =
        ViewBag.PaidLeaveSnapshot as AryamanBMS.ViewModels.PaidLeaveBalanceSnapshotViewModel;
}



<div class="module-header">
    <div>
        <h1 class="module-title">Apply Leave</h1>
        <p class="module-subtitle">Submit a new leave application</p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index" class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back 
        </a>
    </div>
</div>

<div class="app-card form-card">
    @if (paidLeaveSnapshot != null)
    {
        <div class="app-alert-info">
            <strong>Paid Leave Balance:</strong>
            FY @paidLeaveSnapshot.FinancialYearLabel |
            Entitlement: @paidLeaveSnapshot.ProratedEntitlement.ToString("0.##") |
            Used: @paidLeaveSnapshot.PaidLeaveUsed.ToString("0.##") |
            Balance: @paidLeaveSnapshot.PaidLeaveBalance.ToString("0.##")
        </div>

        <div class="app-alert-warning mt-2" id="leaveSplitPreview">
            Select leave dates to preview paid/unpaid split.
        </div>
    }
    <div class="card-header">
        
        
        <div>
            <h5 class="card-title">Leave Details</h5>
            <p class="card-subtitle">Select leave type, date range and reason</p>
        </div>
    </div>

    <div class="card-body">
        <form asp-action="Create" method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-message mb-3">
            </div>

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="LeaveTypeId" class="form-label">Leave Type</label>

                    <select asp-for="LeaveTypeId" class="app-select">
                        <option value="">Select Leave Type</option>

                        @foreach (var leaveType in ViewBag.LeaveTypes)
                        {
                            <option value="@leaveType.Id">
                                @leaveType.LeaveCode - @leaveType.LeaveName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="LeaveTypeId"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label class="form-label">Estimated Days</label>

                    <div class="app-input readonly-field" id="estimatedDays">
                        -
                    </div>
                </div>

                <div class="form-group">
                    <label class="form-label">Leave Duration</label>

                    <select asp-for="IsHalfDay"
                            class="app-select"
                            id="leaveDuration">
                        <option value="false">Full Day</option>
                        <option value="true">Half Day</option>
                    </select>
                </div>

                <div class="form-group" id="halfDaySessionGroup">
                    <label asp-for="HalfDaySession" class="form-label">Half Day</label>

                    <select asp-for="HalfDaySession"
                            class="app-select"
                            id="halfDaySession">
                        <option value="">Select Half</option>
                        <option value="FirstHalf">First Half</option>
                        <option value="SecondHalf">Second Half</option>
                    </select>

                    <span asp-validation-for="HalfDaySession"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="FromDate" class="form-label">From Date</label>

                    <input asp-for="FromDate"
                           type="date"
                           class="app-input"
                           id="fromDate" />

                    <span asp-validation-for="FromDate"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group">
                    <label asp-for="ToDate" class="form-label">To Date</label>

                    <input asp-for="ToDate"
                           type="date"
                           class="app-input"
                           id="toDate" />

                    <span asp-validation-for="ToDate"
                          class="validation-message">
                    </span>
                </div>

                <div class="form-group form-span-2">
                    <label asp-for="Reason" class="form-label">Reason</label>

                    <textarea asp-for="Reason"
                              class="app-textarea"
                              rows="4"
                              maxlength="500"
                              placeholder="Enter reason for leave"></textarea>

                    <span asp-validation-for="Reason"
                          class="validation-message">
                    </span>
                </div>

            </div>

            <div class="form-actions mt-4">
                <button type="submit"
                        class="btn-app btn-primary-app">
                    <i class="bi bi-send"></i>
                    Submit Application
                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">
                    Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function () {
            const fromDateInput = document.getElementById('fromDate');
            const toDateInput = document.getElementById('toDate');
            const estimatedDays = document.getElementById('estimatedDays');
            const leaveDuration = document.getElementById('leaveDuration');
            const halfDaySessionGroup = document.getElementById('halfDaySessionGroup');

            const availablePaidLeaves =
                Number("@(paidLeaveSnapshot?.PaidLeaveBalance ?? 0)");

            function setSplitPreview(days) {
                let preview = document.getElementById('leaveSplitPreview');

                if (!preview) {
                    return;
                }

                if (!days || days <= 0) {
                    preview.textContent =
                        'Select leave dates to preview paid/unpaid split.';
                    return;
                }

                const paidDays = Math.min(days, availablePaidLeaves);
                const unpaidDays = Math.max(0, days - paidDays);

                preview.textContent =
                    `Estimated split: ${paidDays} paid day(s), ${unpaidDays} unpaid day(s).`;
            }

            function updateEstimatedDays() {
                const isHalfDay = leaveDuration.value === 'true';

                halfDaySessionGroup.style.display = isHalfDay ? '' : 'none';

                if (isHalfDay && fromDateInput.value) {
                    toDateInput.value = fromDateInput.value;
                    toDateInput.setAttribute('readonly', 'readonly');
                    estimatedDays.textContent = '0.5 day';
                    setSplitPreview(0.5);
                    return;
                }

                if (!fromDateInput.value || !toDateInput.value) {
                    estimatedDays.textContent = '-';
                    setSplitPreview(0);

                    if (!isHalfDay) {
                        toDateInput.removeAttribute('readonly');
                    }

                    return;
                }

                if (isHalfDay) {
                    estimatedDays.textContent = '0.5 day';
                    setSplitPreview(0.5);
                    return;
                }

                toDateInput.removeAttribute('readonly');

                const fromDate = new Date(fromDateInput.value);
                const toDate = new Date(toDateInput.value);

                if (Number.isNaN(fromDate.getTime()) || Number.isNaN(toDate.getTime())) {
                    estimatedDays.textContent = '-';
                    setSplitPreview(0);
                    return;
                }

                if (toDate < fromDate) {
                    estimatedDays.textContent = 'Invalid range';
                    setSplitPreview(0);
                    return;
                }

                const diffTime = toDate.getTime() - fromDate.getTime();
                const diffDays = Math.floor(diffTime / 86400000) + 1;

                estimatedDays.textContent =
                    diffDays + (diffDays === 1 ? ' day' : ' days');

                setSplitPreview(diffDays);
            }

            fromDateInput.addEventListener('change', updateEstimatedDays);
            toDateInput.addEventListener('change', updateEstimatedDays);
            leaveDuration.addEventListener('change', updateEstimatedDays);

            updateEstimatedDays();
        })();
    </script>
}

@model AryamanBMS.Models.PurchaseOrderModel

@{
    ViewData["Title"] = "PO / WO Details";

    string statusBadge = Model.Status switch
    {
        "Open" => "badge-primary",
        "Acknowledged" => "badge-info",
        "InProgress" => "badge-warning",
        "Delivered" => "badge-success",
        "Closed" => "badge-secondary",
        "Cancelled" => "badge-danger",
        _ => "badge-secondary"
    };

    string statusLabel = Model.Status == "InProgress"
        ? "In Progress"
        : Model.Status;

    bool overdue =
        Model.DeliveryDueDate.HasValue &&
        Model.DeliveryDueDate.Value < DateTime.Today &&
        Model.Status != "Delivered" &&
        Model.Status != "Closed" &&
        Model.Status != "Cancelled";
}

<div class="module-header">

    <div>
        <h1 class="module-title">PO / WO Details</h1>
        <p class="module-subtitle">
            <span class="badge-secondary">@Model.OrderNumber</span>
            <span class="@(Model.OrderType == "PO" ? "badge-info" : "badge-secondary")">
                @Model.OrderType
            </span>
            <span class="@statusBadge">@statusLabel</span>
        </p>
    </div>

    <div class="module-header-actions">

        <a asp-action="Download"
           asp-route-id="@Model.PurchaseOrderId"
           class="btn-app btn-success-app">
            <i class="bi bi-download"></i>
            Download
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.PurchaseOrderId"
           class="btn-app btn-primary-app">
            <i class="bi bi-pencil"></i>
            Edit PO / WO
        </a>

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Order Information</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Order Number</label>
                <div>@Model.OrderNumber</div>
            </div>

            <div class="form-group">
                <label class="form-label">Order Type</label>
                <div>
                    <span class="@(Model.OrderType == "PO" ? "badge-info" : "badge-secondary")">
                        @Model.OrderType
                    </span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Client</label>
                <div>
                    @if (Model.Client != null)
                    {
                        <a asp-controller="Client"
                           asp-action="Details"
                           asp-route-id="@Model.ClientId">
                            @Model.Client.ClientName
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Linked Proposal</label>
                <div>
                    @if (Model.Proposal != null)
                    {
                        <a asp-controller="Proposal"
                           asp-action="Details"
                           asp-route-id="@Model.ProposalId">
                            @Model.Proposal.ProposalNumber
                        </a>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

        </div>

        <div class="form-group mt-3">
            <label class="form-label">Order Title</label>
            <div>@Model.OrderTitle</div>
        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Commercial Information</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Order Date</label>
                <div>@Model.OrderDate.ToString("dd-MMM-yyyy")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Delivery Due Date</label>
                <div>
                    @if (Model.DeliveryDueDate.HasValue)
                    {
                        if (overdue)
                        {
                            <span class="validation-message">
                                @Model.DeliveryDueDate.Value.ToString("dd-MMM-yyyy")
                                <i class="bi bi-exclamation-triangle"></i>
                            </span>
                        }
                        else
                        {
                            @Model.DeliveryDueDate.Value.ToString("dd-MMM-yyyy")
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Amount</label>
                <div>
                    @if (Model.OrderAmount.HasValue)
                    {
                        <strong>@Model.Currency @Model.OrderAmount.Value.ToString("N0")</strong>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Vendor / Client Reference</label>
                <div>@(Model.VendorReference ?? "-")</div>
            </div>

        </div>

        <div class="form-group mt-3">
            <label class="form-label">Remarks</label>
            <div>
                @(string.IsNullOrWhiteSpace(Model.Remarks) ? "-" : Model.Remarks)
            </div>
        </div>

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Document</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">File Name</label>
                <div>@(string.IsNullOrWhiteSpace(Model.FileName) ? "-" : Model.FileName)</div>
            </div>

            <div class="form-group">
                <label class="form-label">File Size</label>
                <div>
                    @if (Model.FileSize > 0)
                    {
                        @(Math.Round(Model.FileSize / 1024.0, 2)) <span>KB</span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>

        </div>

        @if (!string.IsNullOrWhiteSpace(Model.FileName))
        {
            <div class="mt-3">
                <a asp-action="Download"
                   asp-route-id="@Model.PurchaseOrderId"
                   class="btn-app btn-success-app">
                    <i class="bi bi-download"></i>
                    Download Document
                </a>
            </div>
        }

    </div>

</div>

<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Status & Audit</h5>
    </div>

    <div class="card-body">

        <div class="form-grid-2">

            <div class="form-group">
                <label class="form-label">Order Status</label>
                <div>
                    <span class="@statusBadge">@statusLabel</span>
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Record Status</label>
                <div>
                    @if (Model.IsActive)
                    {
                        <span class="badge-success">Active</span>
                    }
                    else
                    {
                        <span class="badge-danger">Inactive</span>
                    }
                </div>
            </div>

            <div class="form-group">
                <label class="form-label">Created On</label>
                <div>@Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")</div>
            </div>

            <div class="form-group">
                <label class="form-label">Last Updated</label>
                <div>@(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")</div>
            </div>

        </div>

    </div>

</div>
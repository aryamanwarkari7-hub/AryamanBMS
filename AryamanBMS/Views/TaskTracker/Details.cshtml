@model AryamanBMS.Models.ProjectTaskProgressModel

@{
    ViewData["Title"] = "Task Update Details";

    string projectText =
        $"{Model.ProjectTask?.Project?.ProjectCode ?? "-"} - {Model.ProjectTask?.Project?.ProjectName ?? "-"}";

    string taskText =
        $"{Model.ProjectTask?.TaskCode ?? "-"} - {Model.ProjectTask?.TaskTitle ?? "-"}";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Task Update Details</h1>
        <p class="module-subtitle">
            Review the complete audit record for this employee task update.
        </p>
    </div>

    <div class="module-header-actions">
        
        <a asp-action="Index"
           asp-route-projectTaskId="@Model.ProjectTaskId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>
</div>

<div class="detail-page">

    <div class="detail-summary-grid">
        <div class="detail-summary-item">
            <div class="detail-summary-label">Update Date</div>
            <div class="detail-summary-value">
                @Model.ProgressDate.ToString("dd-MMM-yyyy")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Employee</div>
            <div class="detail-summary-value">
                @(Model.UpdatedByEmployee?.FullName ?? "-")
            </div>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Progress</div>
            <div class="detail-summary-value">
                @Model.CompletionPercentage%
            </div>
        </div>

        <div class="detail-summary-item">
            <span class="detail-info-label">Hours Worked</span>
            <strong class="detail-info-value">
                @Model.HoursWorked.ToString("0.00")
            </strong>
        </div>

        <div class="detail-summary-item">
            <div class="detail-summary-label">Task Status</div>
            <div class="detail-summary-value">
                @Model.TaskStatus
            </div>
        </div>
    </div>

    <div class="detail-grid-2">
        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Project & Task Information</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">
                    <div class="detail-info-row">
                        <span class="detail-info-label">Project</span>
                        <strong class="detail-info-value">@projectText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Task</span>
                        <strong class="detail-info-value">@taskText</strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Updated By</span>
                        <strong class="detail-info-value">
                            @(Model.UpdatedByEmployee?.FullName ?? "-")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Employee Code</span>
                        <strong class="detail-info-value">
                            @(Model.UpdatedByEmployee?.EmployeeCode ?? "-")
                        </strong>
                    </div>

                    
                </div>
            </div>
        </div>

        <div class="app-card">
            <div class="card-header">
                <h5 class="card-title">Update Summary</h5>
            </div>

            <div class="card-body">
                <div class="detail-info-list">

                    <div class="detail-info-row">
    <span class="detail-info-label">Task Status</span>
    <strong class="detail-info-value">
        @Model.TaskStatus
    </strong>
</div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Progress</span>
                        <strong class="detail-info-value">
                            @Model.CompletionPercentage%
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Created On</span>
                        <strong class="detail-info-value">
                            @Model.CreatedOn.ToString("dd-MMM-yyyy hh:mm tt")
                        </strong>
                    </div>

                    <div class="detail-info-row">
                        <span class="detail-info-label">Updated On</span>
                        <strong class="detail-info-value">
                            @(Model.UpdatedOn?.ToString("dd-MMM-yyyy hh:mm tt") ?? "-")
                        </strong>
                    </div>
                </div>

                <div class="mt-3">
                    <div class="progress progress-compact">
                        <div class="progress-bar"
                             role="progressbar"
                             style="width: @Model.CompletionPercentage%;"
                             aria-valuenow="@Model.CompletionPercentage"
                             aria-valuemin="0"
                             aria-valuemax="100">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-header">
            <h5 class="card-title">Work Update</h5>
        </div>

        <div class="card-body">
            <div class="detail-note-box">
                @if (!string.IsNullOrWhiteSpace(Model.ProgressNotes))
                {
                    @Model.ProgressNotes
                }
                else
                {
                    <span>No work update was provided.</span>
                }
            </div>
        </div>
    </div>

</div>
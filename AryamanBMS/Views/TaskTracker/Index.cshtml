@model IEnumerable<AryamanBMS.Models.ProjectTaskProgressModel>

@using AryamanBMS.Models

@{
    ViewData["Title"] = "Task Updates";

    var tasks =
        ViewBag.Tasks as IEnumerable<ProjectTaskModel>
        ?? Enumerable.Empty<ProjectTaskModel>();

    var projects = tasks
        .Where(t => t.Project != null)
        .GroupBy(t => t.ProjectId)
        .Select(group => group.First().Project!)
        .OrderBy(p => p.ProjectName)
        .ToList();

    string search = ViewBag.Search as string ?? "";
    string sortBy = ViewBag.SortBy as string ?? "ProgressDate";
    string sortOrder = ViewBag.SortOrder as string ?? "desc";
}

<div class="module-header">

    <div>
        <h1 class="module-title">Task Tracker</h1>

        <p class="module-subtitle">
            View employee task update history and progress.
        </p>
    </div>

    <div class="module-header-actions">

        @if (ViewBag.ProjectId != null)
        {
            <a asp-controller="Project"
               asp-action="Dashboard"
               asp-route-id="@ViewBag.ProjectId"
               class="btn-app btn-secondary-app">
                <i class="bi bi-kanban"></i>
                Workspace
            </a>
        }


    </div>

</div>


<div class="app-card">

    <div class="card-header">
        <h5 class="card-title">Filters</h5>
    </div>

    <div class="card-body">

        <form asp-action="Index"
              method="get">

            <!-- ===========================
                 PROJECT / TASK
            ============================ -->

            <div class="form-grid-2">

                <div class="form-group">

                    <label>Project</label>

                    <select name="projectId"
                            id="projectFilter"
                            class="app-select">

                        <option value="">All Projects</option>

                        @foreach (var project in projects)
                        {
                            <option value="@project.Id"
                                    selected="@(ViewBag.ProjectId == project.Id)">

                                @project.ProjectCode -
                                @project.ProjectName

                            </option>
                        }

                    </select>

                </div>

                <div class="form-group">

                    <label>Project Task</label>

                    <select name="projectTaskId"
                            id="taskFilter"
                            class="app-select">

                        <option value="">All Tasks</option>

                        @foreach (var task in tasks)
                        {
                            <option value="@task.Id"
                                    data-project-id="@task.ProjectId"
                                    selected="@(ViewBag.ProjectTaskId == task.Id)">

                                @task.Project?.ProjectCode -
                                @task.TaskCode -
                                @task.TaskTitle

                            </option>
                        }

                    </select>

                </div>

            </div>

            <!-- ===========================
                 SEARCH
            ============================ -->

            <div class="form-group mt-3">

                <label>Search</label>

                <input name="search"
                       value="@search"
                       class="app-input"
                       placeholder="Search project, task or work update..." />

            </div>

            <!-- ===========================
                 SORTING
            ============================ -->

            <div class="form-grid-2 mt-3">

                <div class="form-group">

                    <label>Sort By</label>

                    <select name="sortBy"
                            class="app-select">

                        <option value="ProgressDate"
                                selected="@(sortBy == "ProgressDate")">
                            Update Date
                        </option>

                        <option value="Project"
                                selected="@(sortBy == "Project")">
                            Project
                        </option>

                        <option value="Task"
                                selected="@(sortBy == "Task")">
                            Task
                        </option>

                        <option value="Hours"
                                selected="@(sortBy == "Hours")">
                            Hours Worked
                        </option>

                        <option value="Completion"
                                selected="@(sortBy == "Completion")">
                            Progress
                        </option>

                        <option value="Status"
                                selected="@(sortBy == "Status")">
                            Task Status
                        </option>

                    </select>

                </div>

                <div class="form-group">

                    <label>Sort Order</label>

                    <select name="sortOrder"
                            class="app-select">

                        <option value="desc"
                                selected="@(sortOrder == "desc")">
                            Descending
                        </option>

                        <option value="asc"
                                selected="@(sortOrder == "asc")">
                            Ascending
                        </option>

                    </select>

                </div>

            </div>

            <!-- ===========================
                 ACTIONS
            ============================ -->

            <div class="filter-form-actions mt-4">

                <button type="submit"
                        class="btn-app btn-primary-app">

                    <i class="bi bi-funnel"></i>
                    Filter

                </button>

                <a asp-action="Index"
                   class="btn-app btn-secondary-app">

                    Reset

                </a>

            </div>

        </form>

    </div>

</div>

<div class="app-card table-card">

    <div class="card-header">
        <h5 class="card-title">Task Update History</h5>
    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table class="app-table">

                <thead>

                    <tr>
                        <th>Project</th>
                        <th>Task</th>
                        <th>Employee</th>
                        <th>Update Date</th>
                        <th>Hours</th>
                        <th>Progress</th>
                        <th>Work Update</th>
                        <th>Task Status</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var progress in Model)
                        {
                            <tr>

                                <td>
                                    @progress.ProjectTask?.Project?.ProjectCode
                                </td>

                                <td>

                                    <strong>
                                        @progress.ProjectTask?.TaskCode
                                    </strong>

                                    <div class="text-muted">
                                        @progress.ProjectTask?.TaskTitle
                                    </div>

                                </td>
                                <td>

                                    <strong>
                                        @(progress.UpdatedByEmployee?.EmployeeCode ?? "-")
                                    </strong>

                                    <div class="text-muted">
                                        @(progress.UpdatedByEmployee?.FullName ?? "")
                                    </div>

                                </td>

                                <td>
                                    @progress.ProgressDate.ToString("dd-MMM-yyyy")
                                </td>

                                <td>
                                    @progress.HoursWorked.ToString("0.##") hrs
                                </td>

                                <td>

                                    <div class="d-flex align-items-center gap-2">

                                        <div class="progress flex-grow-1 progress-thin">

                                            <div class="progress-bar"
                                                 style="width:@progress.CompletionPercentage%">
                                            </div>

                                        </div>

                                        <strong>
                                            @progress.CompletionPercentage%
                                        </strong>

                                    </div>

                                    
                                </td>

                                <td>
                                    <div class="text-truncate"
                                         style="max-width:420px;"
                                         title="@progress.ProgressNotes">

                                        @progress.ProgressNotes

                                    </div>
                                </td>

                                <td>

                                    <span class="status-badge
                                          @(progress.TaskStatus switch
                                          {
                                              "Completed" => "status-active",
                                              "In Progress" => "status-info",
                                              "On Hold" => "status-warning",
                                              _ => "status-inactive"
                                          })">

                                           @progress.TaskStatus

                                    </span>

                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@progress.Id"
                                           class="btn-app btn-icon btn-primary-app"
                                           title="View Details">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="8"
                                class="empty-state">

                                No task history available.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {
    <script src="~/js/task-tracker.js" asp-append-version="true"></script>
}

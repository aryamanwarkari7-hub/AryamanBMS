@model AryamanBMS.Models.FullAndFinalSettlementModel

@{
    ViewData["Title"] = "Create Full and Final Settlement";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Create Full and Final Settlement</h1>
        <p class="module-subtitle">Calculate final payable and recovery amounts</p>
    </div>

    <a asp-action="Index" class="btn-app btn-secondary-app">Back</a>
</div>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="app-alert-danger"></div>

    <div class="app-card">
        <div class="card-body">
            <div class="form-grid-2">
                <div class="form-group">
                    <label asp-for="EmployeeId" class="form-label">Employee</label>
                    <select asp-for="EmployeeId" class="app-select">
                        <option value="">Select Employee</option>
                        @foreach (var employee in ViewBag.Employees)
                        {
                            <option value="@employee.Id">@employee.EmployeeCode - @employee.FullName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="LastWorkingDate" class="form-label">Last Working Date</label>
                    <input asp-for="LastWorkingDate" type="date" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="SalaryUpToLastWorkingDate" class="form-label">Salary Up To Last Working Date</label>
                    <input asp-for="SalaryUpToLastWorkingDate" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="LeaveEncashment" class="form-label">Leave Encashment</label>
                    <input asp-for="LeaveEncashment" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="BonusOrIncentive" class="form-label">Bonus / Incentive</label>
                    <input asp-for="BonusOrIncentive" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="NoticePay" class="form-label">Notice Pay</label>
                    <input asp-for="NoticePay" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="SalaryAdvanceRecovery" class="form-label">Salary Advance Recovery</label>
                    <input asp-for="SalaryAdvanceRecovery" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="LoanRecovery" class="form-label">Loan Recovery</label>
                    <input asp-for="LoanRecovery" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="AssetRecovery" class="form-label">Asset Recovery</label>
                    <input asp-for="AssetRecovery" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="OtherPayableAmount" class="form-label">Other Payable</label>
                    <input asp-for="OtherPayableAmount" type="number" step="0.01" class="app-input" />
                </div>

                <div class="form-group">
                    <label asp-for="OtherRecoverableAmount" class="form-label">Other Recoverable</label>
                    <input asp-for="OtherRecoverableAmount" type="number" step="0.01" class="app-input" />
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="card-body">
            <button type="submit" class="btn-app btn-primary-app">Save Settlement</button>
            <a asp-action="Index" class="btn-app btn-secondary-app">Cancel</a>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

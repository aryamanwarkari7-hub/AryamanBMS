@model IEnumerable<AryamanBMS.Models.WorkingDayOverrideModel>

@{
    ViewData["Title"] = "Saturday Switcher";
    string selectedStatus = ViewBag.Status as string ?? "All";
    string sortBy = ViewBag.SortBy as string ?? "OverrideDate";
    string sortOrder = ViewBag.SortOrder as string ?? "asc";
}

<div class="module-header">
    <div>
        <h1 class="module-title">Saturday Switcher</h1>
        <p class="module-subtitle">
            Manage exceptional Saturday working days and holidays.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="ExportExcel" class="btn-app btn-success-app">
            <i class="bi bi-file-earmark-excel"></i>
            Export Excel
        </a>

        <a asp-action="Create" class="btn-app btn-primary-app">
            <i class="bi bi-calendar2-plus"></i>
            Add Schedule Change
        </a>
    </div>
</div>

<div class="app-card mb-3">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="app-input">
                    <option value="All" selected="@(selectedStatus == "All")">All</option>
                    <option value="Active" selected="@(selectedStatus == "Active")">Active</option>
                    <option value="Inactive" selected="@(selectedStatus == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Sort By</label>
                <select name="sortBy" class="app-input">
                    <option value="OverrideDate" selected="@(sortBy == "OverrideDate")">Date</option>
                    <option value="OverrideType" selected="@(sortBy == "OverrideType")">Schedule</option>
                    <option value="Status" selected="@(sortBy == "Status")">Status</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Order</label>
                <select name="sortOrder" class="app-input">
                    <option value="asc" selected="@(sortOrder == "asc")">Ascending</option>
                    <option value="desc" selected="@(sortOrder == "desc")">Descending</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn-app btn-primary-app flex-fill">
                    <i class="bi bi-funnel"></i>
                    Apply
                </button>
                <a asp-action="Index" class="btn-app btn-secondary-app">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="app-card table-card">
    <div class="card-header">
        <div class="card-heading">
            <h2 class="card-title">Saturday Schedule Changes</h2>
            <p class="card-subtitle">
                Review and manage date-specific Saturday changes.
            </p>
        </div>
    </div>
    <div class="card-body">

    @if (!Model.Any())
    {
        <div class="card-body">
            <div class="app-alert-info">
                No Saturday schedule changes have been created.
            </div>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table app-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Date</th>
                        <th>Day</th>
                        <th>Schedule</th>
                        <th>Reason</th>
                        <th>Status</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @{ int serialNumber = 1; }
                    @foreach (var item in Model)
                    {
                        var scheduleText =
                        item.OverrideType == "Working Day"
                        ? "Working Saturday"
                        : item.OverrideType;

                        <tr>
                            <td>@serialNumber</td>
                            <td>
                                @item.OverrideDate.ToString("dd-MMM-yyyy")
                            </td>

                            <td>
                                @item.OverrideDate.ToString("dddd")
                            </td>

                            <td>
                                @if (item.OverrideType == "Working Day")
                                {
                                    <span class="status-badge status-approved">
                                        <i class="bi bi-check-circle"></i>
                                        @scheduleText
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-rejected">
                                        <i class="bi bi-calendar-x"></i>
                                        @scheduleText
                                    </span>
                                }
                        </td>

                        <td>
                            @(string.IsNullOrWhiteSpace(item.Reason)
                                                    ? "-"
                                                    : item.Reason)
                    </td>

                            <td>
                        @if (item.IsActive)
                                {
                                    <span class="badge-success status-badge status-approved">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-danger status-badge status-cancelled">
                                        Inactive
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="table-actions">
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn-app btn-secondary-app btn-icon"
                                   title="Edit schedule change">
                                    <i class="bi bi-pencil"></i>
                                </a>

                                @if (item.IsActive)
                                {
                                    <form asp-action="Deactivate"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline"
                                          onsubmit="return confirm('Deactivate this schedule change?');">
                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn-app btn-danger-app btn-icon"
                                                title="Deactivate schedule change">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                }
                                    </div>
                            </td>
                        </tr>
                        serialNumber++;
                    }
                </tbody>
            </table>
        </div>
    }
    </div>
</div>

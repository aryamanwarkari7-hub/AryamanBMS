@model ExpenseCategoryModel

@{
    string title = Model.ExpenseCategoryId == 0
        ? "Create Expense Category"
        : "Edit Expense Category";

    ViewData["Title"] = title;
}

<div class="module-header">

    <div>
        <h1 class="module-title">@title.ToUpper()</h1>
        <p class="module-subtitle">
            Configure GST, ITC and GL mapping for expense vouchers.
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<form method="post">

    @Html.AntiForgeryToken()

    @if (Model.ExpenseCategoryId != 0)
    {
        <input type="hidden" asp-for="ExpenseCategoryId" />
    }

    <div asp-validation-summary="ModelOnly"
         class="app-alert-danger">
    </div>

    <div class="app-card form-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Category Information</h2>
                <p class="card-subtitle">
                    Enter category code, name and description.
                </p>
            </div>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="CategoryCode"
                           class="form-label">
                        Category Code
                    </label>

                    <input asp-for="CategoryCode"
                           class="app-input"
                           placeholder="e.g., TRAVEL, MEALS, OFFICE"
                           maxlength="50" />

                    <span asp-validation-for="CategoryCode"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="CategoryName"
                           class="form-label">
                        Category Name
                    </label>

                    <input asp-for="CategoryName"
                           class="app-input"
                           placeholder="e.g., Travel Expenses"
                           maxlength="100" />

                    <span asp-validation-for="CategoryName"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-group">
                <label asp-for="Description"
                       class="form-label">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="app-input"
                          rows="3"
                          placeholder="Enter category description"
                          maxlength="500"></textarea>

                <span asp-validation-for="Description"
                      class="validation-message"></span>
            </div>

        </div>

    </div>

    <div class="app-card form-card">

        <div class="card-header">
            <div>
                <h2 class="card-title">Accounting Defaults</h2>
                <p class="card-subtitle">
                    Set default GST rate, ITC eligibility and GL account.
                </p>
            </div>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="DefaultGSTRate"
                           class="form-label">
                        Default GST Rate %
                    </label>

                    <input asp-for="DefaultGSTRate"
                           type="number"
                           class="app-input"
                           placeholder="0"
                           min="0"
                           max="100"
                           step="0.01" />

                    <span asp-validation-for="DefaultGSTRate"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="GLAccountCode"
                           class="form-label">
                        GL Account Code
                    </label>

                    <input asp-for="GLAccountCode"
                           class="app-input"
                           placeholder="e.g., 6100"
                           maxlength="50" />

                    <span asp-validation-for="GLAccountCode"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-check">
                <input asp-for="ITCEligible"
                       class="form-check-input" />

                <label asp-for="ITCEligible"
                       class="form-check-label">
                    Input Tax Credit Eligible
                </label>
            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-body form-actions">

            <button type="submit"
                    class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Save
            </button>

            <a asp-action="Index"
               class="btn-app btn-secondary-app">
                Cancel
            </a>

        </div>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
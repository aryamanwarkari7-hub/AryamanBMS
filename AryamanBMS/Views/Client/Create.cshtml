@model AryamanBMS.ViewModels.ClientViewModel

@{
    ViewData["Title"] = "Add Client";
}

<div class="module-header">

    <div>
        <h1 class="module-title">Add Client</h1>
        <p class="module-subtitle">
            Create a client master record for accounts and finance documents
        </p>
    </div>

    <div class="module-header-actions">
        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>
    </div>

</div>

<form asp-action="Create" method="post">

    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly"
         class="app-alert-danger">
    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Basic Information</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.ClientName" class="form-label">
                        Client Name
                    </label>
                    <input asp-for="Client.ClientName" class="app-input" />
                    <span asp-validation-for="Client.ClientName"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.ClientType" class="form-label">
                        Client Type
                    </label>
                    <select asp-for="Client.ClientType" class="app-select">
                        <option value="">Select Type</option>
                        <option value="Private">Private</option>
                        <option value="Government">Government</option>
                        <option value="NGO">NGO</option>
                        <option value="Individual">Individual</option>
                    </select>
                    <span asp-validation-for="Client.ClientType"
                          class="validation-message"></span>
                </div>

            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Contact Information</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.ContactPerson" class="form-label">
                        Contact Person
                    </label>
                    <input asp-for="Client.ContactPerson" class="app-input" />
                    <span asp-validation-for="Client.ContactPerson"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.Phone" class="form-label">
                        Phone
                    </label>
                    <input asp-for="Client.Phone" class="app-input" />
                    <span asp-validation-for="Client.Phone"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.Email" class="form-label">
                        Email
                    </label>
                    <input asp-for="Client.Email" class="app-input" />
                    <span asp-validation-for="Client.Email"
                          class="validation-message"></span>
                </div>

            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Tax Information</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.GSTNumber" class="form-label">
                        GST Number
                    </label>
                    <input asp-for="Client.GSTNumber" class="app-input" />
                    <span asp-validation-for="Client.GSTNumber"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.RegistrationType" class="form-label">
                        Registration Type
                    </label>

                    <select asp-for="Client.RegistrationType" class="app-select">
                        <option value="Unregistered">Unregistered</option>
                        <option value="Regular">Regular</option>
                        <option value="Composition">Composition</option>
                        <option value="SEZ">SEZ</option>
                    </select>

                    <span asp-validation-for="Client.RegistrationType"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.StateCode" class="form-label">
                        State Code
                    </label>

                    <select asp-for="Client.StateCode"
                            id="stateCodeDropdown"
                            class="app-select">
                        <option value="">Select State Code</option>

                        @foreach (var state in ViewBag.States)
                        {
                            <option value="@state.StateCode"
                                    data-state-name="@state.StateName">
                                @state.StateCode - @state.StateName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Client.StateCode"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.PANNumber" class="form-label">
                        PAN Number
                    </label>
                    <input asp-for="Client.PANNumber" class="app-input" />
                    <span asp-validation-for="Client.PANNumber"
                          class="validation-message"></span>
                </div>

            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Address & Remarks</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.State"
                           class="form-label">
                        State
                    </label>

                    <select asp-for="Client.State"
                            id="stateDropdown"
                            class="app-select">

                        <option value="">Select State</option>

                        @foreach (var state in ViewBag.States)
                        {
                            <option value="@state.StateName"
                                    data-state-id="@state.Id">
                                @state.StateName
                            </option>
                        }

                    </select>

                    <span asp-validation-for="Client.State"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.City"
                           class="form-label">
                        City
                    </label>

                    <select asp-for="Client.City"
                            id="cityDropdown"
                            class="app-select"
                            data-current-city="@(Model.Client.City ?? "")"
                            data-cities-url="@Url.Action("GetCities", "Location")"
                            disabled>

                        <option value="">Select City</option>

                    </select>

                    <span asp-validation-for="Client.City"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-grid-2 mt-3">
                <div class="form-group">
                    <label asp-for="Client.PlaceOfSupply" class="form-label">
                        Place of Supply
                    </label>

                    <select asp-for="Client.PlaceOfSupply"
                            id="placeOfSupplyDropdown"
                            class="app-select">
                        <option value="">Select Place of Supply</option>

                        @foreach (var state in ViewBag.States)
                        {
                            <option value="@state.StateName"
                                    data-state-code="@state.StateCode">
                                @state.StateName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Client.PlaceOfSupply"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.PlaceOfSupplyStateCode" class="form-label">
                        Place of Supply State Code
                    </label>

                    <select asp-for="Client.PlaceOfSupplyStateCode"
                            id="placeOfSupplyStateCodeDropdown"
                            class="app-select">
                        <option value="">Select State Code</option>

                        @foreach (var state in ViewBag.States)
                        {
                            <option value="@state.StateCode"
                                    data-state-name="@state.StateName">
                                @state.StateCode - @state.StateName
                            </option>
                        }
                    </select>

                    <span asp-validation-for="Client.PlaceOfSupplyStateCode"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.CreditPeriod" class="form-label">
                        Credit Period
                    </label>

                    <input asp-for="Client.CreditPeriod"
                           type="number"
                           min="0"
                           class="app-input" />

                    <span asp-validation-for="Client.CreditPeriod"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.PaymentTerms" class="form-label">
                        Payment Terms
                    </label>

                    <input asp-for="Client.PaymentTerms" class="app-input" />

                    <span asp-validation-for="Client.PaymentTerms"
                          class="validation-message"></span>
                </div>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Client.BillingAddress" class="form-label">
                    Billing Address
                </label>

                <textarea asp-for="Client.BillingAddress"
                          class="app-textarea"></textarea>

                <span asp-validation-for="Client.BillingAddress"
                      class="validation-message"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Client.Address" class="form-label">
                    Address
                </label>
                <textarea asp-for="Client.Address"
                          class="app-textarea"></textarea>
                <span asp-validation-for="Client.Address"
                      class="validation-message"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Client.Remarks" class="form-label">
                    Remarks
                </label>
                <textarea asp-for="Client.Remarks"
                          class="app-textarea"></textarea>
                <span asp-validation-for="Client.Remarks"
                      class="validation-message"></span>
            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-body">

            <button type="submit"
                    class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Save Client
            </button>

            <a asp-action="Index"
               class="btn-app btn-secondary-app">
                Cancel
            </a>

        </div>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/client-location.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const stateDropdown = document.getElementById("stateDropdown");
            const stateCodeDropdown = document.getElementById("stateCodeDropdown");
            const placeOfSupplyDropdown = document.getElementById("placeOfSupplyDropdown");
            const placeOfSupplyStateCodeDropdown = document.getElementById("placeOfSupplyStateCodeDropdown");

            if (stateDropdown && stateCodeDropdown) {
                stateDropdown.addEventListener("change", function () {
                    const selectedOption = stateDropdown.options[stateDropdown.selectedIndex];
                    const selectedStateName = selectedOption?.value || "";

                    const matchingCodeOption = Array.from(stateCodeDropdown.options)
                        .find(option => option.getAttribute("data-state-name") === selectedStateName);

                    if (matchingCodeOption) {
                        stateCodeDropdown.value = matchingCodeOption.value;
                    }

                    if (placeOfSupplyDropdown && !placeOfSupplyDropdown.value) {
                        placeOfSupplyDropdown.value = selectedStateName;
                        placeOfSupplyDropdown.dispatchEvent(new Event("change"));
                    }
                });
            }

            if (placeOfSupplyDropdown && placeOfSupplyStateCodeDropdown) {
                placeOfSupplyDropdown.addEventListener("change", function () {
                    const selectedOption = placeOfSupplyDropdown.options[placeOfSupplyDropdown.selectedIndex];
                    const selectedStateCode = selectedOption?.getAttribute("data-state-code") || "";

                    placeOfSupplyStateCodeDropdown.value = selectedStateCode;
                });
            }
        });
    </script>
}

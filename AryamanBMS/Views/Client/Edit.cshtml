@model AryamanBMS.ViewModels.ClientViewModel

@{
    ViewData["Title"] = "Edit Client";
}

<div class="module-header">

    <div>
        <h1 class="module-title">Edit Client</h1>
        <p class="module-subtitle">
            Update client master details
        </p>
    </div>

    <div class="module-header-actions">

        <a asp-action="Details"
           asp-route-id="@Model.Client.ClientId"
           class="btn-app btn-secondary-app">
            <i class="bi bi-eye"></i>
            Details
        </a>

        <a asp-action="Index"
           class="btn-app btn-secondary-app">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

    </div>

</div>

<form asp-action="Edit"
      asp-route-id="@Model.Client.ClientId"
      method="post">

    @Html.AntiForgeryToken()

    <input asp-for="Client.ClientId" type="hidden" />
    <input asp-for="Client.ClientCode" type="hidden" />
    <input asp-for="Client.CreatedOn" type="hidden" />

    <div asp-validation-summary="ModelOnly"
         class="app-alert-danger">
    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Basic Information</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label class="form-label">Client Code</label>
                    <input asp-for="Client.ClientCode"
                           class="app-input"
                           disabled />
                </div>

                <div class="form-group">
                    <label asp-for="Client.IsActive"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Client.IsActive"
                            class="app-select">
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                <div class="form-group">
                    <label asp-for="Client.ClientName"
                           class="form-label">
                        Client Name
                    </label>

                    <input asp-for="Client.ClientName"
                           class="app-input" />

                    <span asp-validation-for="Client.ClientName"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.ClientType"
                           class="form-label">
                        Client Type
                    </label>

                    <select asp-for="Client.ClientType"
                            class="app-select">
                        <option value="">Select Type</option>
                        <option value="Private">Private</option>
                        <option value="Government">Government</option>
                        <option value="NGO">NGO</option>
                        <option value="Individual">Individual</option>
                    </select>

                    <span asp-validation-for="Client.ClientType"
                          class="validation-message"></span>
                </div>

            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Contact Information</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.ContactPerson"
                           class="form-label">
                        Contact Person
                    </label>

                    <input asp-for="Client.ContactPerson"
                           class="app-input" />

                    <span asp-validation-for="Client.ContactPerson"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.Phone"
                           class="form-label">
                        Phone
                    </label>

                    <input asp-for="Client.Phone"
                           class="app-input" />

                    <span asp-validation-for="Client.Phone"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.Email"
                           class="form-label">
                        Email
                    </label>

                    <input asp-for="Client.Email"
                           class="app-input" />

                    <span asp-validation-for="Client.Email"
                          class="validation-message"></span>
                </div>

            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Tax Information</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.GSTNumber"
                           class="form-label">
                        GST Number
                    </label>

                    <input asp-for="Client.GSTNumber"
                           class="app-input" />

                    <span asp-validation-for="Client.GSTNumber"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.PANNumber"
                           class="form-label">
                        PAN Number
                    </label>

                    <input asp-for="Client.PANNumber"
                           class="app-input" />

                    <span asp-validation-for="Client.PANNumber"
                          class="validation-message"></span>
                </div>

            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-header">
            <h5 class="card-title">Address & Remarks</h5>
        </div>

        <div class="card-body">

            <div class="form-grid-2">

                <div class="form-group">
                    <label asp-for="Client.State"
                           class="form-label">
                        State
                    </label>

                    <select asp-for="Client.State"
                            id="stateDropdown"
                            class="app-select">

                        <option value="">Select State</option>

                        @foreach (var state in ViewBag.States)
                        {
                            if (state.StateName == Model.Client.State)
                            {
                                <option value="@state.StateName"
                                        data-state-id="@state.Id"
                                        selected>
                                    @state.StateName
                                </option>
                            }
                            else
                            {
                                <option value="@state.StateName"
                                        data-state-id="@state.Id">
                                    @state.StateName
                                </option>
                            }
                        }

                    </select>

                    <span asp-validation-for="Client.State"
                          class="validation-message"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Client.City"
                           class="form-label">
                        City
                    </label>

                    <select asp-for="Client.City"
                            id="cityDropdown"
                            class="app-select"
                            disabled>

                        <option value="">Select City</option>

                    </select>

                    <span asp-validation-for="Client.City"
                          class="validation-message"></span>
                </div>

            </div>

            <div class="form-group mt-3">
                <label asp-for="Client.Address"
                       class="form-label">
                    Address
                </label>

                <textarea asp-for="Client.Address"
                          class="app-textarea"></textarea>

                <span asp-validation-for="Client.Address"
                      class="validation-message"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Client.Remarks"
                       class="form-label">
                    Remarks
                </label>

                <textarea asp-for="Client.Remarks"
                          class="app-textarea"></textarea>

                <span asp-validation-for="Client.Remarks"
                      class="validation-message"></span>
            </div>

        </div>

    </div>

    <div class="app-card">

        <div class="card-body">

            <button type="submit"
                    class="btn-app btn-primary-app">
                <i class="bi bi-check-circle"></i>
                Update Client
            </button>

            <a asp-action="Details"
               asp-route-id="@Model.Client.ClientId"
               class="btn-app btn-secondary-app">
                Cancel
            </a>

        </div>

    </div>

</form>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const stateDropdown =
                document.getElementById("stateDropdown");

            const cityDropdown =
                document.getElementById("cityDropdown");

            const currentCity =
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.Client.City ?? ""));

        async function loadCities(selectedCity = "") {

            cityDropdown.innerHTML =
                '<option value="">Select City</option>';

            cityDropdown.disabled = true;

            const selectedState =
                stateDropdown.options[
                    stateDropdown.selectedIndex
                ];

            const stateId =
                selectedState?.dataset.stateId;

            if (!stateId) {
                return;
            }

            const response = await fetch(
                `/Location/GetCities?stateId=${encodeURIComponent(stateId)}`
            );

            if (!response.ok) {
                alert("Cities could not be loaded.");
                return;
            }

            const cities = await response.json();

            cities.forEach(function (city) {

                const option =
                    document.createElement("option");

                option.value = city.name;
                option.textContent = city.name;
                option.selected =
                    city.name === selectedCity;

                cityDropdown.appendChild(option);
            });

            cityDropdown.disabled = false;
        }

        stateDropdown.addEventListener(
            "change",
            function () {
                loadCities("");
            });

        if (stateDropdown.value) {
            loadCities(currentCity);
        }
    });
</script>
}